<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- MÀN HÌNH DANH SÁCH LỊCH HỌC CHO APP PHỤ HUYNH             -->
    <!-- ========================================================= -->
    <template id="ekids_phuhuynh.lichhoc_list_mobile_template" name="Lịch học của bé Mobile">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
                <style>
                    body {
                        background-color: #F1F5F9;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                        margin: 0;
                        padding-bottom: 70px;
                        color: #1E293B;
                    }

                    /* Header App */
                    .app-top-navbar {
                        background: #2563EB;
                        color: #FFFFFF;
                        padding: 14px 16px;
                        display: flex;
                        align-items: center;
                        position: sticky;
                        top: 0;
                        z-index: 100;
                        box-shadow: 0 2px 10px rgba(37, 99, 235, 0.2);
                    }
                    .btn-app-back {
                        background: rgba(255, 255, 255, 0.2);
                        color: #FFFFFF;
                        border: none;
                        width: 34px;
                        height: 34px;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 15px;
                        text-decoration: none;
                    }
                    .app-header-title {
                        flex-grow: 1;
                        text-align: center;
                        font-weight: 700;
                        font-size: 17px;
                        margin-right: 34px;
                    }

                    /* Banner thông tin học sinh */
                    .student-info-banner {
                        background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
                        color: #FFFFFF;
                        margin: 12px 14px;
                        padding: 14px 16px;
                        border-radius: 14px;
                        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }

                    /* Thẻ Lịch Học Hiện Đại */
                    .schedule-card-item {
                        background: #FFFFFF;
                        margin: 12px 14px;
                        border-radius: 14px;
                        border: 1px solid #E2E8F0;
                        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
                        overflow: hidden;
                        display: block;
                    }

                    .card-header-bar {
                        padding: 12px 14px;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        border-bottom: 1px solid #F1F5F9;
                    }
                    .card-type-box {
                        display: flex;
                        align-items: center;
                        gap: 10px;
                    }
                    .card-type-icon {
                        width: 38px;
                        height: 38px;
                        border-radius: 10px;
                        background: #EFF6FF;
                        color: #2563EB;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 17px;
                        flex-shrink: 0;
                    }
                    .card-title-text {
                        font-size: 15.5px;
                        font-weight: 800;
                        color: #0F172A;
                    }

                    /* Badge Trạng thái hiệu lực */
                    .status-tag {
                        font-size: 11.5px;
                        font-weight: 700;
                        padding: 4px 10px;
                        border-radius: 20px;
                        white-space: nowrap;
                    }
                    .st-active { background: #DCFCE7; color: #15803D; }
                    .st-expired { background: #FEE2E2; color: #B91C1C; }

                    /* Thân Card */
                    .card-body-section {
                        padding: 12px 14px;
                        display: flex;
                        flex-direction: column;
                        gap: 10px;
                    }

                    /* Dải Thứ Trong Tuần (T2 - CN) */
                    .weekday-badges-flow {
                        display: flex;
                        gap: 6px;
                        flex-wrap: wrap;
                        align-items: center;
                    }
                    .weekday-pill {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 12px;
                        font-weight: 800;
                        border: 1px solid #E2E8F0;
                        color: #94A3B8;
                        background-color: #F8FAFC;
                    }
                    .weekday-pill.active {
                        background-color: #2563EB;
                        color: #FFFFFF;
                        border-color: #1D4ED8;
                        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
                    }

                    /* Khung thời gian  khung giờ */
                    .time-grid-box {
                        background: #F8FAFC;
                        border: 1px solid #E2E8F0;
                        border-radius: 10px;
                        padding: 10px 12px;
                        display: flex;
                        flex-direction: column;
                        gap: 6px;
                    }
                    .time-item-row {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        font-size: 13px;
                        color: #334155;
                    }
                    .time-highlight-badge {
                        font-size: 13px;
                        font-weight: 800;
                        color: #1E40AF;
                        background: #DBEAFE;
                        padding: 2px 8px;
                        border-radius: 6px;
                    }

                    /* Khối Giáo viên  Ghi chú */
                    .info-cell-box {
                        background: #FFFFFF;
                        border: 1px solid #CBD5E1;
                        border-radius: 8px;
                        padding: 8px 10px;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                    }
                    .info-cell-lbl {
                        font-size: 11.5px;
                        font-weight: 700;
                        text-transform: uppercase;
                        color: #64748B;
                        display: flex;
                        align-items: center;
                        gap: 4px;
                    }
                    .info-cell-val {
                        font-size: 13.5px;
                        font-weight: 700;
                        color: #0F172A;
                    }

                    .empty-notice-box {
                        text-align: center;
                        padding: 50px 20px;
                        color: #94A3B8;
                    }
                </style>
            </t>

            <!-- THANH TOPBAR -->
            <div class="app-top-navbar">
                <a href="/ph/home" class="btn-app-back">
                    <i class="fa fa-chevron-left"></i>
                </a>
                <div class="app-header-title">LỊCH HỌC CỦA BÉ</div>
            </div>



            <!-- DANH SÁCH LỊCH HỌC / CA CAN THIỆP -->
            <div class="schedule-cards-container">
                <t t-if="not ca_canthiep_list">
                    <div class="empty-notice-box">
                        <i class="fa fa-calendar-times-o" style="font-size: 46px; margin-bottom: 12px; color: #CBD5E1;"></i>
                        <div>Bé chưa có lịch học/ca can thiệp nào được thiết lập.</div>
                    </div>
                </t>

                <t t-foreach="ca_canthiep_list" t-as="ca">
                    <div class="schedule-card-item">

                        <!-- 1. HEADER: LOẠI HÌNH CA &amp; TRẠNG THÁI HIỆU LỰC -->
                        <div class="card-header-bar">
                            <div class="card-type-box">
                                <div class="card-type-icon">
                                    <i class="fa fa-clock-o"></i>
                                </div>
                                <div>
                                    <div class="card-title-text">
                                        <span t-esc="ca.dm_ca_id.name or 'Ca can thiệp'"/>
                                    </div>
                                    <div style="font-size: 12px; color: #64748B;">
                                        Mức phí: <strong style="color: #1E293B;"><span t-field="ca.tien" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <t t-if="ca.trangthai == '1'">
                                    <span class="status-tag st-active"><i class="fa fa-check-circle"></i> Còn hiệu lực</span>
                                </t>
                                <t t-else="">
                                    <span class="status-tag st-expired"><i class="fa fa-times-circle"></i> Hết hiệu lực</span>
                                </t>
                            </div>
                        </div>

                        <!-- 2. THÂN NỘI DUNG -->
                        <div class="card-body-section">

                            <!-- CÁC THỨ HỌC TRONG TUẦN -->
                            <div>
                                <div style="font-size: 12px; font-weight: 700; color: #64748B; text-transform: uppercase; margin-bottom: 6px;">
                                    <i class="fa fa-calendar-check-o" style="color: #2563EB;"></i> Ngày học trong tuần:
                                </div>
                                <div class="weekday-badges-flow">
                                    <span t-attf-class="weekday-pill #{ca.t2 and 'active' or ''}">T2</span>
                                    <span t-attf-class="weekday-pill #{ca.t3 and 'active' or ''}">T3</span>
                                    <span t-attf-class="weekday-pill #{ca.t4 and 'active' or ''}">T4</span>
                                    <span t-attf-class="weekday-pill #{ca.t5 and 'active' or ''}">T5</span>
                                    <span t-attf-class="weekday-pill #{ca.t6 and 'active' or ''}">T6</span>
                                    <span t-attf-class="weekday-pill #{ca.t7 and 'active' or ''}">T7</span>
                                    <span t-attf-class="weekday-pill #{ca.t8 and 'active' or ''}">CN</span>
                                </div>
                            </div>

                            <!-- KHUNG GIỜ HỌC VÀ THỜI GIAN ÁP DỤNG -->
                            <div class="time-grid-box">
                                <div class="time-item-row">
                                    <span style="font-weight: 600;">
                                        <i class="fa fa-hourglass-half" style="color: #2563EB; margin-right: 4px;"></i> Khung giờ học:
                                    </span>
                                    <span class="time-highlight-badge">
                                        <t t-if="ca.tu and ca.den">
                                            <span t-esc="ca.tu"/> - <span t-esc="ca.den"/>
                                        </t>
                                        <t t-elif="ca.tu">
                                            Từ <span t-esc="ca.tu"/>
                                        </t>
                                        <t t-else="">
                                            Theo lịch xếp lớp
                                        </t>
                                    </span>
                                </div>

                                <div class="time-item-row" style="border-top: 1px dashed #E2E8F0; padding-top: 5px;">
                                    <span style="font-size: 12.5px; color: #64748B;">
                                        <i class="fa fa-calendar-o" style="margin-right: 4px;"></i> Thời gian áp dụng:
                                    </span>
                                    <span style="font-size: 13px; font-weight: 700; color: #334155;">
                                        <t t-if="ca.tu_ngay or ca.den_ngay">
                                            <span t-field="ca.tu_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/> -
                                            <span t-field="ca.den_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                        </t>
                                        <t t-else="">
                                            Cố định hàng tháng
                                        </t>
                                    </span>
                                </div>
                            </div>

                            <!-- GIÁO VIÊN PHỤ TRÁCH -->
                            <div class="info-cell-box">
                                <div class="info-cell-lbl">
                                    <i class="fa fa-user-md" style="color: #EA580C;"></i> Giáo viên can thiệp:
                                </div>
                                <div class="info-cell-val">
                                    <span t-esc="ca.giaovien_id.name or 'Chưa phân công'"/>
                                </div>
                            </div>

                            <!-- GHI CHÚ (NẾU CÓ) -->
                            <t t-if="ca.desc">
                                <div style="font-size: 12.5px; font-style: italic; color: #64748B; padding-left: 4px;">
                                    <i class="fa fa-info-circle"></i> <t t-out="ca.desc"/>
                                </div>
                            </t>

                        </div>

                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>