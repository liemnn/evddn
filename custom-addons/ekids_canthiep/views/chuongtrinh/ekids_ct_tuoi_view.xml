<odoo>
    <data>

        <record id="ekids_canthiep.ct_tuoi_list" model="ir.ui.view">
            <field name="name">MỤC TIÊU</field>
            <field name="model">ekids.ct_tuoi</field>
            <field name="arch" type="xml">
                <list default_order="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="sequence" width="50"/>
                    <field name="name"/>
                    <field name="desc" />
                </list>
            </field>
        </record>

        <record id="ekids_canthiep.ct_tuoi_kanban" model="ir.ui.view">
            <field name="name">TUỔI</field>
            <field name="model">ekids.ct_tuoi</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <kanban archivable="false">
                    <field name="name"/>
                    <field name="desc"/>
                    <field name="tong_muctieu"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_dropdown_kanban dropdown" style="position: absolute; right: 10px; top: 10px; z-index: 10;">
                                <a class="dropdown-toggle o-no-caret btn btn-sm text-muted" role="button" data-bs-toggle="dropdown" href="#">
                                    <i class="fa fa-ellipsis-v fa-lg"></i>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item text-primary">
                                        <i class="fa fa-pencil me-2"></i> Chỉnh sửa
                                    </a>
                                    <a role="menuitem" type="delete"
                                       confirm="Xóa bản ghi này sẽ làm mất dữ liệu. Bạn có chắc chắn không?"
                                       class="dropdown-item text-danger">
                                        <i class="fa fa-trash-o me-2"></i> Xóa
                                    </a>
                                </div>
                            </div>
                            <div t-attf-class="oe_kanban_global_click o_kanban_record d-flex flex-column p-0 book-card"
                                 style="border: 1px solid #e2e8f0; border-left: 12px solid #28a745; border-radius: 4px 12px 12px 4px; box-shadow: 6px 8px 15px rgba(0,0,0,0.06); background-color: #fdfbf7; overflow: hidden; position: relative;">

                                <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 15px; background: linear-gradient(to right, rgba(0,0,0,0.08), transparent);"></div>

                                <div class="p-4 d-flex flex-column h-100" style="position: relative; z-index: 1;">

                                    <div class="book-ribbon" style="position: absolute; top: -10px; right: 20px; width: 30px; height: 40px; background-color: #3b82f6; clip-path: polygon(100% 0, 100% 100%, 50% 75%, 0 100%, 0 0); box-shadow: 2px 2px 5px rgba(0,0,0,0.1);"></div>

                                    <div class="d-flex justify-content-between align-items-start mb-3" style="border-bottom: 2px solid #cbd5e1; padding-bottom: 12px;">
                                        <h3 class="fw-bolder m-0" style="color: #0f172a; font-family: 'Georgia', serif; font-size: 1.25rem; letter-spacing: 0.5px; padding-right: 35px;">
                                            <i class="fa fa-child text-success me-2" style="font-size: 1.5rem;"/>
                                            <field name="name"/>
                                        </h3>
                                    </div>

                                    <div style="font-size: 0.9rem;font-style: italic; color: #475569;">
                                        <field name="desc"/>
                                    </div>

                                    <div class="mt-auto">
                                        <button name="action_xem_muctieu" type="object"
                                                class="btn btn-link text-decoration-none w-100 p-3 stat-box d-flex align-items-center justify-content-between"
                                                style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); color: inherit;">

                                            <div class="text-start">
                                                <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px;">
                                                    <i class="fa fa-bullseye me-2" style="color: #e11d48; font-size: 1.1rem;"></i>Tổng số Mục tiêu
                                                </div>
                                            </div>

                                            <div style="font-size: 2.2rem; font-weight: 300; color: #e11d48; line-height: 1;">
                                                <field name="tong_muctieu"/>
                                            </div>

                                        </button>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="ekids_canthiep.ct_tuoi_form" model="ir.ui.view">
            <field name="name">ekids.ct_tuoi.form</field>
            <field name="model">ekids.ct_tuoi</field>
            <field name="arch" type="xml">
                <form string="Cấu hình Độ tuổi Can thiệp">
                    <sheet class="p-4 bg-white">

                        <style>
                            /* 1. Vòng tròn số thứ tự hiển thị (Sky Blue Gradient) */
                            .ekids_circle_index {
                                width: 52px;
                                height: 52px;
                                background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                flex-shrink: 0;
                                box-shadow: 0 4px 10px rgba(14, 165, 233, 0.12);
                            }
                            /* Triệt tiêu khung viền input mặc định của Odoo bên trong vòng tròn */
                            .ekids_circle_index input {
                                background: transparent !important;
                                border: none !important;
                                text-align: center !important;
                                font-size: 22px !important;
                                font-weight: 900 !important;
                                color: #0284C7 !important;
                                width: 100% !important;
                                padding: 0 !important;
                            }

                            /* 2. Ô nhập tên mốc tuổi gạch chân nét đứt tinh tế */
                            .ekids_premium_title_input input {
                                font-size: 22px !important;
                                font-weight: 800 !important;
                                color: #1E293B !important;
                                border-top: none !important;
                                border-left: none !important;
                                border-right: none !important;
                                border-bottom: 2px dashed #E2E8F0 !important;
                                border-radius: 0 !important;
                                padding-bottom: 4px !important;
                                padding-left: 0 !important;
                                background: transparent !important;
                                transition: all 0.2s;
                            }
                            .ekids_premium_title_input input:focus {
                                border-bottom-color: #0284C7 !important;
                                border-bottom-style: solid !important;
                                box-shadow: none !important;
                            }

                            /* 3. Khối ruy-băng chỉ thị nội dung đặc điểm tâm sinh lý độ tuổi */
                            .ekids_blue_ribbon_box {
                                border-left: 4px solid #0284C7 !important; /* Ruy băng màu xanh Sky tươi sáng */
                                background-color: #F9FAFB;
                                border-radius: 0 16px 16px 0;
                                padding: 20px;
                                box-shadow: 0 1px 2px rgba(0,0,0,0.01);
                            }
                        </style>

                        <div class="row align-items-center g-3 mb-4">

                            <div class="col-auto">
                                <div class="ekids_circle_index" title="Đổi thứ tự sắp xếp hiển thị">
                                    <field name="sequence" string="" placeholder="0"/>
                                </div>
                            </div>

                            <div class="col ekids_premium_title_input">
                                <field name="name" nolabel="1" placeholder="Nhập độ tuổi..."/>
                            </div>

                        </div>

                        <div class="ekids_blue_ribbon_box mt-4">

                            <h5 class="fw-extrabold d-flex align-items-center mb-3" style="color: #0369A1; font-size: 13.5px; letter-spacing: 0.5px;">
                                <i class="fa fa-info-circle me-2" style="font-size: 16px;"></i> MÔ TẢ
                            </h5>

                            <div class="bg-transparent">
                                <field name="desc"
                                       nolabel="1"
                                       placeholder="Mô tả chi tiết (nếu có)..."
                                       style="width: 100%; min-height: 220px; border: none !important; background: transparent;"/>
                            </div>

                        </div>

                    </sheet>
                </form>
            </field>
        </record>



    </data>
</odoo>
