<odoo>
    <data>

        <record model="ir.ui.view" id="ekids_canthiep.ct_dm_roiloan_list">
            <field name="name">Danh mục rối loạn</field>
            <field name="model">ekids.ct_dm_roiloan</field>
            <field name="arch" type="xml">
               <list editable="bottom" default_order="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="name" width="300"/>
                    <field name="desc"/>
                    <field name="trangthai"
                        decoration-success="trangthai == '1'"
                        decoration-danger="trangthai == '0'"/>
                </list>
            </field>
        </record>

        <record id="ekids_canthiep.ct_dm_roiloan_kanban" model="ir.ui.view">
            <field name="name">Danh mục loại rối loạn</field>
            <field name="model">ekids.ct_dm_roiloan</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <kanban archivable="false">
                    <t t-name="kanban-box">
                        <div class="box">

                            <!-- Icon Section -->

                            <!-- Title Section -->
                            <h2 class="title">
                                <field name="name"/>
                            </h2>
                            <!-- Description Section -->

                            <p class="description">
                               <field name="desc"/>
                            </p>
                            <!-- Button Section -->

                        </div>
                    </t>
                </kanban>
            </field>
        </record>

         <record id="ekids_canthiep.ct_dm_roiloan_form" model="ir.ui.view">
            <field name="name">Form</field>
            <field name="model">ekids.ct_dm_roiloan</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="coso_id" invisible="1"/>
                        <group>
                             <div class="row">
                                <div class="col-md-10">
                                  <h3>
                                      <field name="name" placeholder="Tên"/>
                                  </h3>
                                </div>
                              </div>
                        </group>
                        <group>
                            <field name="desc"/>

                        </group>


                    </sheet>
                </form>
            </field>
        </record>


    </data>
</odoo>
