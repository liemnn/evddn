<odoo>
    <data>
         <record id="ekids_canthiep.ct_chuongtrinh_list_view" model="ir.ui.view">
            <field name="name">Chương trình</field>
            <field name="model">ekids.ct_chuongtrinh</field>
            <field name="arch" type="xml">
                <list>
                    <field name="ma"/>
                    <field name="name" />
                    <field name="desc" />

                </list>
            </field>
        </record>

        <record id="ekids_canthiep.ct_chuongtrinh_kanban" model="ir.ui.view">
            <field name="name">CHƯƠNG TRÌNH</field>
            <field name="model">ekids.ct_chuongtrinh</field>
            <field name="type">kanban</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <kanban archivable="false" sample="1" action="action_xem_muctieu">
                    <field name="name"/>
                    <field name="desc"/>
                    <field name="tong_tuoi"/>
                    <field name="tong_linhvuc"/>
                    <field name="tong_muctieu"/>

                    <templates>
                        <t t-name="kanban-box">

                            <div t-attf-class="oe_kanban_global_click o_kanban_record d-flex flex-column p-0 book-card"
                                 type="object"
                                 name="action_xem_muctieu"
                                 style="border: 1px solid #e2e8f0; border-left: 12px solid #017e84; border-radius: 4px 12px 12px 4px; box-shadow: 6px 8px 15px rgba(0,0,0,0.06); background-color: #fdfbf7; overflow: hidden; position: relative;">

                                <div class="o_dropdown_kanban dropdown" style="position: absolute; right: 10px; top: 10px; z-index: 10;">
                                    <a class="dropdown-toggle o-no-caret btn btn-sm text-muted" role="button" data-bs-toggle="dropdown" href="#">
                                        <i class="fa fa-ellipsis-v fa-lg"></i>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item text-primary">
                                            <i class="fa fa-pencil me-2"></i> Chỉnh sửa
                                        </a>
                                        <a role="menuitem" type="delete"
                                           confirm="Xóa bản ghi này sẽ làm mất dữ liệu. Bạn có chắc chắn không?"
                                           class="dropdown-item text-danger">
                                            <i class="fa fa-trash-o me-2"></i> Xóa
                                        </a>
                                    </div>
                                </div>

                                <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 15px; background: linear-gradient(to right, rgba(0,0,0,0.08), transparent);"></div>

                                <div class="p-4 d-flex flex-column h-100" style="position: relative; z-index: 1;">

                                    <div class="book-ribbon" style="position: absolute; top: -10px; right: 20px; width: 30px; height: 40px; background-color: #f59e0b; clip-path: polygon(100% 0, 100% 100%, 50% 75%, 0 100%, 0 0); box-shadow: 2px 2px 5px rgba(0,0,0,0.1);"></div>

                                    <div class="d-flex justify-content-between align-items-start mb-3" style="border-bottom: 2px solid #cbd5e1; padding-bottom: 12px;">
                                        <h3 class="fw-bolder m-0" style="color: #0f172a; font-family: 'Georgia', serif; font-size: 1.25rem; letter-spacing: 0.5px; padding-right: 35px;">
                                            <i class="fa fa-book text-muted me-2" style="font-size: 1.1rem;"></i>
                                            <field name="name"/>
                                        </h3>
                                    </div>

                                    <div style="font-size: 0.9rem;color: #475569;">
                                        <field name="desc"/>
                                    </div>

                                    <div class="d-flex justify-content-around py-2 mt-auto"
                                         style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);">

                                        <button name="action_xem_tuoi" type="object" class="btn btn-link text-decoration-none text-center flex-fill border-end p-2 stat-box" style="color: inherit;">
                                            <div style="font-size: 1.8rem; font-weight: 300; color: #017e84; line-height: 1;">
                                                <field name="tong_tuoi"/>
                                            </div>
                                            <div style="font-size: 0.65rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; margin-top: 6px;">
                                                <i class="fa fa-users me-1" style="color: #94a3b8;"></i> Độ tuổi
                                            </div>
                                        </button>

                                        <button name="action_xem_linhvuc" type="object" class="btn btn-link text-decoration-none text-center flex-fill border-end p-2 stat-box" style="color: inherit;">
                                            <div style="font-size: 1.8rem; font-weight: 300; color: #017e84; line-height: 1;">
                                                <field name="tong_linhvuc"/>
                                            </div>
                                            <div style="font-size: 0.65rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; margin-top: 6px;">
                                                <i class="fa fa-sitemap me-1" style="color: #94a3b8;"></i> Lĩnh vực
                                            </div>
                                        </button>

                                        <button name="action_xem_muctieu" type="object" class="btn btn-link text-decoration-none text-center flex-fill p-2 stat-box" style="color: inherit;">
                                            <div style="font-size: 1.8rem; font-weight: 300; color: #e11d48; line-height: 1;">
                                                <field name="tong_muctieu"/>
                                            </div>
                                            <div style="font-size: 0.65rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; margin-top: 6px;">
                                                <i class="fa fa-bullseye me-1" style="color: #94a3b8;"></i> Mục tiêu
                                            </div>
                                        </button>

                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ekids_canthiep.ct_chuongtrinh_form" model="ir.ui.view">
            <field name="name">Form</field>
            <field name="model">ekids.ct_chuongtrinh</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                             <div class="row">
                                <div class="col-md-2">
                                  <h3>
                                      <field name="ma" placeholder="Mã" />
                                  </h3>
                                </div>
                                <div class="col-md-10">
                                  <h3>
                                      <field name="name" placeholder="Tên"/>
                                  </h3>
                                </div>
                              </div>
                        </group>
                        <group>
                            <field name="desc"/>
                        </group>

                         <group>
                            <separator string="CÁC CƠ SỞ ÁP DỤNG CHO CHƯƠNG TRÌNH NÀY (để trống là toàn bộ)" />
                            <field name="coso_ids" widget="many2many_tags"/>
                        </group>

                        <notebook invisible=" not id">
                            <page name="linhvuc_ids " string="LĨNH VỰC">
                                <field name="linhvuc_ids" context="{'default_chuongtrinh_id':id}"/>
                            </page>
                            <page name="tuoi_ids " string="ĐỘ TUỔI">
                                <field name="tuoi_ids" context="{'default_chuongtrinh_id':id}"/>
                            </page>
                        </notebook>


                       </sheet>
                </form>
            </field>
        </record>



        <!-- actions opening views on models -->

        <record model="ir.actions.act_window" id="ekids_canthiep.ct_chuongtrinh_action_window">
            <field name="name">CHƯƠNG TRÌNH</field>
            <field name="res_model">ekids.ct_chuongtrinh</field>
            <field name="view_mode">kanban,list,form</field>
        </record>





    </data>
</odoo>
