<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ekids_canthiep.ct_muctieu_list" model="ir.ui.view">
        <field name="name">ekids.ct_muctieu.list</field>
        <field name="model">ekids.ct_muctieu</field>
        <field name="arch" type="xml">

            <list default_order="sequence" create="1" edit="1" delete="1" multi_edit="1">



                <field name="sequence"/>
                <field name="name" string="Nội dung mục tiêu / Chỉ số hành vi mẫu" decoration-bf="1"/>

                <field name="chucnang" string="Chức năng cốt lõi &amp; Lập luận lâm sàng" optional="hide"/>
                <field name="thietke" string="Thiết kế hoạt động (ABC)" optional="hide"/>

                <field name="tieuchi_chuadat" string="Chưa đạt (-)" optional="hide" decoration-danger="1"/>
                <field name="tieuchi_hinhthanh" string="Đang hình thành (+/-)" optional="hide" decoration-warning="1"/>
                <field name="tieuchi_dat" string="Đạt (+)" optional="hide" decoration-success="1"/>
                <button name="action_luachon_ct_muctieu_vao_kehoach"
                    string="Chọn"
                    type="object"
                    class="btn-primary"
                    icon="fa-plus-circle"
                    title="Nạp mục tiêu này vào kế hoạch"/>
            </list>
        </field>
    </record>


</odoo>