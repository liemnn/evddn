<odoo>
  <data>
    <record id="ekids_canthiep.hocsinh_duyet_kehoach_inherit_list" model="ir.ui.view">
        <field name="name">Kế hoạch can thiệp</field>
        <field name="model">ekids.hocsinh</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" limit="200" default_order="id asc">
                <field name="is_tao_ketluan" column_invisible="True"/>
                <field name="is_lap_kehoach" column_invisible="True"/>
                <field name="is_sua_kehoach" column_invisible="True"/>
                <field name="is_kiemduyet" column_invisible="True"/>
                <field name="is_canthiep" column_invisible="True"/>

                <field name="sequence" width="25"/>
                <field name="name" width="170"/>
                <field name="bietdanh" string="Biệt danh" optional="hide"/>
                <field name="gioitinh"/>
                <field name="ngaysinh" optional="hide"/>
                <field name="tuoi"/>
                <field name="ngay_nhaphoc" string="Nhập học" width="100"/>
                <field name="thoigian_hoc" string="Thời gian học" optional="hide"/>

                <field name="dm_xa_id" optional="hide"/>
                <field name="trangthai" string="Trạng thái"
                        decoration-success="trangthai == '1'"
                        decoration-info="trangthai == '2'"
                        decoration-danger="trangthai == '3'" width="100"/>
                <field name="trangthai_ketluan" string="Kết luận"/>

                <button name="action_taomoi_ketluan"
                        string="Tạo kết luận"
                        type="object"
                        class="btn-dark btn-sm"
                        icon="fa-flag-checkered"
                        invisible="is_tao_ketluan == False"
                        title="Kết thúc đợt can thiệp, tiến hành viết đánh giá tổng kết sự tiến bộ của học sinh"
                />

               <button name="action_xem_danhsach_ketluan"
                        string=""
                        type="object"
                        class="btn-secondary btn-sm"
                        icon="fa-list-ul"
                        invisible="trangthai_ketluan in ['-2']"
                        title="Danh sách [Kết luận] cua trẻ"
                />

                <field name="trangthai_kehoach" string="Kế hoạch"/>



                <button name="action_lap_kehoach"
                        string="Lập"
                        type="object"
                        class="btn-primary btn-sm"
                        icon="fa-calendar-plus-o"
                        invisible="is_lap_kehoach == False"
                        title="Lập [Kế hoạch] can thiệp cho trẻ"
                />

                <button name="action_sua_kehoach"
                        string="Sửa"
                        type="object"
                        class="btn-warning btn-sm text-dark fw-bold"
                        icon="fa-pencil-square-o"
                        invisible="is_sua_kehoach == False"
                        title="Sửa lại [Kế hoạch] đang soạn thảo"
                />

               <button name="action_duyet_kehoach"
                        string="Duyệt"
                        type="object"
                        class="btn-info btn-sm text-white"
                        icon="fa-paper-plane"
                        invisible="is_kiemduyet == False"
                        title="Kế hoạch này cần Duyệt để đưa vào can thiệp"
                />

                <button name="action_xem_danhsach_kehoach"
                        string=""
                        type="object"
                        class="btn-secondary btn-sm"
                        icon="fa-list-ul"
                        invisible="trangthai_kehoach in ['-2']"
                        title="Xem lịch sử danh sách [Kế hoạch] đã can thiệp cho trẻ"
                />

                <button name="action_canthiep"
                        string="Can thiệp"
                        type="object"
                        class="btn-success btn-sm fw-bold text-uppercase"
                        icon="fa-play-circle"
                        invisible="is_canthiep==False"
                        title="Bấm vào đây để mở bảng đánh giá và ghi nhận kết quả học tập hàng ngày của trẻ"
                />

            </list>
        </field>
    </record>





  </data>
</odoo>