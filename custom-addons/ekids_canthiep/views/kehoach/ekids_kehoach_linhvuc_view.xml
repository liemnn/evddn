<odoo>
  <data>
      <record id="ekids_canthiep.lap_kehoach_linhvuc_kanban" model="ir.ui.view">
            <field name="name">ekids.kehoach_linhvuc.kanban</field>
            <field name="model">ekids.kehoach_linhvuc</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="linhvuc_id"/>
                    <field name="tuoi_id"/>


                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click w-100" style="flex: 0 0 100%; border: 1px solid #E2E8F0; border-radius: 12px; background: white; margin-bottom: 15px; padding: 0; box-shadow: 0 4px 15px rgba(0,0,0,0.02); transition: 0.2s;">

                                <div style="background: #F8FAFC; padding: 15px 20px; border-bottom: 1px solid #E2E8F0; border-radius: 12px 12px 0 0; display: flex; justify-content: space-between; align-items: center;">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="fa fa-folder-open" style="color: #F59E0B; font-size: 1.2rem;"></i>
                                        <strong style="color: #1E3A8A; font-size: 1.1rem; text-transform: uppercase;">
                                            <field name="linhvuc_id"/>
                                        </strong>
                                        <span class="text-muted">|</span>
                                        <span style="background: #F3E8FF; color: #7E22CE; font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.85rem;">
                                            <field name="tuoi_id"/>
                                        </span>
                                    </div>
                                    <span class="btn btn-sm btn-light border text-primary fw-bold" style="background: white;">
                                        <i class="fa fa-edit me-1"></i> Mở rộng &amp; Cập nhật
                                    </span>
                                </div>

                                <div class="p-3">
                                    <div class="text-muted small fw-bold mb-2"><i class="fa fa-list-ul me-1"></i> CÁC MỤC TIÊU ĐANG CÓ:</div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>




  </data>
</odoo>