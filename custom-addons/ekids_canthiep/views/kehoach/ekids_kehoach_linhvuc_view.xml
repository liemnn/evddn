<odoo>
  <data>
      <record id="ekids_canthiep.lap_kehoach_linhvuc_kanban" model="ir.ui.view">
            <field name="name">ekids.kehoach_linhvuc.kanban</field>
            <field name="model">ekids.kehoach_linhvuc</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="linhvuc_id"/>
                    <field name="tuoi_id"/>


                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click w-100" style="flex: 0 0 100%; border: 1px solid #E2E8F0; border-radius: 12px; background: white; margin-bottom: 15px; padding: 0; box-shadow: 0 4px 15px rgba(0,0,0,0.02); transition: 0.2s;">

                                <div style="background: #F8FAFC; padding: 15px 20px; border-bottom: 1px solid #E2E8F0; border-radius: 12px 12px 0 0; display: flex; justify-content: space-between; align-items: center;">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="fa fa-folder-open" style="color: #F59E0B; font-size: 1.2rem;"></i>
                                        <strong style="color: #1E3A8A; font-size: 1.1rem; text-transform: uppercase;">
                                            <field name="linhvuc_id"/>
                                        </strong>
                                        <span class="text-muted">|</span>
                                        <span style="background: #F3E8FF; color: #7E22CE; font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.85rem;">
                                            <field name="tuoi_id"/>
                                        </span>
                                    </div>
                                    <span class="btn btn-sm btn-light border text-primary fw-bold" style="background: white;">
                                        <i class="fa fa-edit me-1"></i> Mở rộng &amp; Cập nhật
                                    </span>
                                </div>

                                <div class="p-3">
                                    <div class="text-muted small fw-bold mb-2"><i class="fa fa-list-ul me-1"></i> CÁC MỤC TIÊU ĐANG CÓ:</div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ekids_canthiep.kehoach_linhvuc_form" model="ir.ui.view">
            <field name="name">ekids.kehoach_linhvuc.form</field>
            <field name="model">ekids.kehoach_linhvuc</field>
            <field name="arch" type="xml">

                <form string="Chi tiết Lĩnh vực &amp; Mục tiêu" edit="false" create="false" delete="false">

                    <style>
                        .ekids_compact_kanban .o_kanban_renderer .o_kanban_record {
                            width: 100% !important;
                            flex: 0 0 100% !important;
                            max-width: 100% !important;
                            margin: 0 0 6px 0 !important;
                            padding: 0 !important;
                            background: transparent !important;
                            border: none !important;
                            box-shadow: none !important;
                        }
                        .ekids_row_strip:hover {
                            border-color: #CBD5E1 !important;
                            background-color: #F8FAFC !important;
                            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05) !important;
                        }
                    </style>

                    <sheet>
                        <div class="d-flex gap-3 mb-4 p-3 rounded" style="background: #EFF6FF; border: 1px solid #BFDBFE;">
                            <div class="flex-grow-1">
                                <span class="fw-bold text-uppercase text-primary" style="font-size: 11px; letter-spacing: 0.5px; opacity: 0.8;">
                                    Lĩnh vực can thiệp
                                </span>
                                <div class="fs-4 fw-bold text-dark mt-1">
                                    <field name="linhvuc_id" readonly="1" options="{'no_open': True}"/>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <span class="fw-bold text-uppercase text-danger" style="font-size: 11px; letter-spacing: 0.5px; opacity: 0.8;">
                                    Độ tuổi phát triển
                                </span>
                                <div class="mt-1">
                                    <field name="tuoi_id" readonly="1" options="{'no_open': True}"
                                           class="badge rounded-pill bg-danger fw-bold fs-6 px-3 py-2" style="background-color: #DC2626 !important;"/>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h5 class="fw-bold text-secondary mb-3" style="font-size: 14px; letter-spacing: 0.3px;">
                                <i class="fa fa-list-ol me-2 text-primary"></i>HỆ THỐNG MỤC TIÊU LÂM SÀNG DIỄN TIẾN
                            </h5>

                            <field name="kehoach_muctieu_ids" mode="kanban" nolabel="1" class="ekids_compact_kanban">
                                <kanban default_order="sequence" create="0" delete="0" edit="0">
                                    <field name="id"/>
                                    <field name="index"/>
                                    <field name="name"/>

                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="d-flex align-items-center justify-content-between py-2 px-3 bg-white rounded-2 border ekids_row_strip"
                                                 style="border-color: #E2E8F0 !important; min-height: 42px; transition: all 0.15s; width: 100%;">

                                                <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0;">
                                                    <div class="d-flex align-items-center justify-content-center font-monospace rounded-circle text-white fw-bold"
                                                         style="width: 22px; height: 22px; background: linear-gradient(135deg, #38BDF8 0%, #0284C7 100%); font-size: 11px; flex-shrink: 0; box-shadow: 0 1px 3px rgba(2, 132, 199, 0.12);">
                                                        <t t-esc="record.index.raw_value"/>
                                                    </div>
                                                    <div class="fw-bold text-secondary" style="font-size: 13px; line-height: 1.3; white-space: normal; color: #334155 !important;">
                                                        <t t-esc="record.name.raw_value"/>
                                                    </div>
                                                </div>

                                                <div class="ms-3 flex-shrink-0">
                                                    <a type="open" class="btn btn-sm fw-bold px-2.5 py-0.5"
                                                       style="border-radius: 5px; font-size: 11.5px; border: 1px solid #D1D5DB; color: #4B5563; background: #FFFFFF; cursor: pointer;">
                                                        <i class="fa fa-search-plus me-1 text-muted"></i>Xem thêm
                                                    </a>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </div>
                    </sheet>

                    <footer>
                        <button string="Đóng cửa sổ" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>

                </form>
            </field>
        </record>


  </data>
</odoo>