     <record id="ekids_canthiep.kehoach_muctieu_kiemduyet_ketqua_form" model="ir.ui.view">
        <field name="name">ekids.kehoach_muctieu.form</field>
        <field name="model">ekids.kehoach_muctieu</field>
        <field name="arch" type="xml">
            <form string="Chi tiết Can thiệp">

               <style>
                 /* =================================================== */
                 /* CSS TÔ MÀU VÀ ĐỒNG BỘ NÚT BẤM DẠNG VUÔNG COMPACT    */
                 /* =================================================== */

                 /* Cấu hình chung cho tất cả nút bấm trong vùng chuyên môn */
                 .custom_ketqua_badge .o_selection_badge {
                     margin-right: 12px !important;
                     margin-bottom: 8px !important;
                     border-radius: 0px !important;        /* ÉP NÚT PHẲNG VUÔNG THEO YÊU CẦU */
                     padding: 10px 20px !important;        /* Tăng padding giúp nút trông to, khỏe và ấn tượng hơn */
                     font-size: 14px !important;           /* 🌟 Chữ to hơn chút (từ 13px lên 14px) dễ đọc, rõ ràng */
                     font-weight: bold !important;         /* 🌟 Mặc định chữ đậm cho tất cả trạng thái */
                     border: 2px solid #cbd5e1 !important; /* Viền mặc định xám nhạt tinh tế */
                     background-color: #f8fafc !important; /* Nền mặc định xám trắng dịu mắt */
                     color: #475569 !important;            /* Màu chữ mặc định xám tối */
                     cursor: pointer;
                     transition: all 0.2s ease-in-out !important; /* Hiệu ứng chuyển đổi màu mượt mà */
                 }

                 /* 🌟 HÀNH ĐỘNG CHÍ MẠNG: ẨN TRẠNG THÁI '0' (CHỜ DUYỆT) KHÔNG CHO HIỂN THỊ ĐỂ CHỌN */
                 .custom_ketqua_badge span.o_selection_badge[value='"0"'] {
                     display: none !important;
                 }

                 /* =================================================== */
                 /* 🌟 1. ĐẠT (VALUE = "1") -> Tone Xanh Lá Emerald     */
                 /* =================================================== */
                 /* Trạng thái Hover hoặc được chọn Active */
                 .custom_ketqua_badge span.o_selection_badge[value='"1"']:hover,
                 .custom_ketqua_badge span.o_selection_badge[value='"1"'].active {
                     background-color: #10b981 !important; /* Xanh lá hiện đại */
                     border-color: #059669 !important;     /* Viền xanh đậm tạo chiều sâu */
                     color: #ffffff !important;            /* Chữ trắng tương phản cao */
                     box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.3) !important; /* Đổ bóng nhẹ theo tone màu */
                 }

                 /* =================================================== */
                 /* 🌟 2. KHÔNG ĐẠT [CHUYỂN] (VALUE = "-1") -> Tone Vàng Hổ Phách */
                 /* =================================================== */
                 /* Trạng thái Hover hoặc được chọn Active */
                 .custom_ketqua_badge span.o_selection_badge[value='"-1"']:hover,
                 .custom_ketqua_badge span.o_selection_badge[value='"-1"'].active {
                     background-color: #f59e0b !important; /* Vàng hổ phách (thay cho màu yellow nguyên bản bị chói) */
                     border-color: #d97706 !important;     /* Viền vàng đậm */
                     color: #ffffff !important;            /* Chữ trắng nổi bật, sang trọng */
                     box-shadow: 0 4px 6px -1px rgba(245, 158, 11, 0.3) !important;
                 }

                 /* =================================================== */
                 /* 🌟 3. KHÔNG ĐẠT [DỪNG] (VALUE = "-2") -> Tone Đỏ Toàn Phần */
                 /* =================================================== */
                 /* Trạng thái Hover hoặc được chọn Active */
                 .custom_ketqua_badge span.o_selection_badge[value='"-2"']:hover,
                 .custom_ketqua_badge span.o_selection_badge[value='"-2"'].active {
