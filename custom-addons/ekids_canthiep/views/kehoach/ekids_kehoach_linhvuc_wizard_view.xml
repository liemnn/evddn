<odoo>
  <data>

        <record id="ekids_canthiep.kehoach_linhvuc_wizard_form" model="ir.ui.view">
            <field name="name">ekids.kehoach_linhvuc_wizard.form</field>
            <field name="model">ekids.kehoach_linhvuc_wizard</field>
            <field name="arch" type="xml">
                <form string="BỔ SUNG MỤC TIÊU CHO KẾ HOẠCH">
                    <style>
                        .modal-dialog { max-width: 85vw !important; margin: 4vh auto !important; }
                        .form-label-custom { font-weight: 800; font-size: 13px; text-transform: uppercase; margin-bottom: 6px; display: block;}
                    </style>
                    <sheet>

                        <field name="kehoach_linhvuc_id" invisible="1"/>

                        <div class="d-flex gap-3 mb-3 p-3 rounded" style="background: #EFF6FF; border: 1px solid #BFDBFE;">
                            <div class="flex-grow-1">
                                <label for="linhvuc_id" class="form-label-custom text-primary"/>
                                <field name="linhvuc_id" readonly="1" options="{'no_open': True}" class="fw-bold fs-5 text-primary"/>
                            </div>
                            <div class="flex-grow-1">
                                <label for="tuoi_id" class="form-label-custom text-danger"/>
                                <field name="tuoi_id" readonly="1" options="{'no_open': True}" class="fw-bold fs-5 text-danger"/>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label for="muctieu_ids" class="form-label-custom text-dark">
                                <i class="fa fa-list-check me-1"></i> Danh sách mục tiêu mẫu phù hợp (Vui lòng tích chọn):
                            </label>
                            <field name="muctieu_ids"
                                   widget="many2many_list"
                                   domain="[('linhvuc_id','=',linhvuc_id),('tuoi_id','=',tuoi_id)]"
                            >
                                <list create="false" delete="false" edit="false">
                                    <field name="name" string="Nội dung mục tiêu / Chỉ số hành vi mẫu" decoration-bf="1"/>
                                    <field name="chucnang" string="Chức năng cốt lõi" optional="hide"/>
                                    <field name="thietke" string="Thiết kế hoạt động" optional="hide"/>
                                </list>
                            </field>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_xac_nhan_luu" string="Thêm vào kế hoạch" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Đóng cửa sổ" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>


  </data>
</odoo>