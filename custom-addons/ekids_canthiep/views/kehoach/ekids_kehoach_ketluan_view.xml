<odoo>
  <data>


        <record id="ekids_canthiep.kehoach_ketluan_kanban" model="ir.ui.view">
            <field name="name">Phiếu Kết luận - Premium SaaS Design V2</field>
            <field name="model">ekids.kehoach_ketluan</field>
            <field name="arch" type="xml">
                <kanban default_order="id desc" sample="1" class="ekids_premium_kanban_v2">

                    <field name="id"/>
                    <field name="index"/>
                    <field name="name"/>
                    <field name="hocsinh_id"/>
                    <field name="ngay_danhgia"/>
                    <field name="gv_danhgia"/>
                    <field name="dm_roiloan_ids"/>
                    <field name="mucdo"/>
                    <field name="lieuluong"/>
                    <field name="lichhen"/>
                    <field name="gv_lapkehoach_id"/>
                    <field name="gv_kiemduyet_id"/>
                    <field name="gv_canthiep_id"/>
                    <field name="kehoach_linhvuc_ids"/>
                    <field name="trangthai"/>

                    <templates>
                        <t t-name="kanban-box">

                            <style>
                                /* Khóa khung bao của Odoo */
                                .ekids_premium_kanban_v2 .o_kanban_record {
                                    width: 100% !important;
                                    flex: 0 0 100% !important;
                                    margin: 0 0 16px 0 !important;
                                    padding: 0 !important;
                                    background: transparent !important;
                                    border: none !important;
                                }

                                /* --- 📱 STYLE MẶC ĐỊNH CHO DI ĐỘNG (MOBILE FIRST) --- */
                                .k_master_card {
                                    background: #FFFFFF !important;
                                    border: 1px solid #E2E8F0 !important;
                                    border-radius: 24px !important; /* Bo góc lớn kiểu App hiện đại */
                                    box-shadow: 0 4px 20px rgba(148, 163, 184, 0.06) !important;
                                    padding: 16px !important;
                                    display: flex !important;
                                    flex-direction: column !important;
                                    gap: 12px !important;
                                    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                                }

                                /* Thanh Header chính của thẻ */
                                .k_card_header {
                                    display: flex !important;
                                    align-items: center !important;
                                    justify-content: space-between !important;
                                    padding-bottom: 12px !important;
                                    border-bottom: 1px solid #F1F5F9 !important;
                                }

                                /* Vòng tròn số ID cá tính */
                                .k_avatar_index {
                                    width: 38px !important;
                                    height: 38px !important;
                                    border-radius: 12px !important; /* Bo vuông bo góc kiểu công nghệ */
                                    background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%) !important;
                                    color: #0369A1 !important;
                                    font-weight: 800 !important;
                                    font-size: 15px !important;
                                    display: flex !important;
                                    align-items: center !important;
                                    justify-content: center !important;
                                }

                                /* Tên học sinh */
                                .k_student_name {
                                    font-size: 16px !important;
                                    font-weight: 800 !important;
                                    color: #0F172A !important;
                                    margin: 0 !important;
                                    letter-spacing: -0.3px !important;
                                }

                                /* Hộp kén chức năng phân vùng nội dung (Inner Pods) */
                                .k_inner_pod {
                                    background: #F8FAFC !important;
                                    border: 1px solid #F1F5F9 !important;
                                    border-radius: 16px !important;
                                    padding: 12px !important;
                                }

                                .k_pod_title {
                                    font-size: 11px !important;
                                    font-weight: 700 !important;
                                    color: #94A3B8 !important;
                                    text-transform: uppercase !important;
                                    letter-spacing: 0.5px !important;
                                    margin-bottom: 8px !important;
                                    display: flex !important;
                                    align-items: center !important;
                                    gap: 6px !important;
                                }

                                /* Thiết lập dòng nhân sự gọn gàng */
                                .k_teacher_row {
                                    display: flex !important;
                                    align-items: center !important;
                                    justify-content: space-between !important;
                                    font-size: 12.5px !important;
                                    padding: 4px 0 !important;
                                    border-bottom: 1px dashed #E2E8F0 !important;
                                }
                                .k_teacher_row:last-child {
                                    border-bottom: none !important;
                                }

                                /* Nhãn trạng thái viên thuốc chuẩn App Apple */
                                .k_status_pill {
                                    padding: 4px 10px !important;
                                    border-radius: 10px !important;
                                    font-size: 12px !important;
                                    font-weight: 700 !important;
                                    display: inline-flex !important;
                                    align-items: center !important;
                                    gap: 4px !important;
                                }
                                .status_dang_tao { background: #FEF3C7 !important; color: #D97706 !important; }
                                .status_cho_lap { background: #D1FAE5 !important; color: #065F46 !important; }
                                .status_het_han { background: #FEE2E2 !important; color: #991B1B !important; }

                                /* Nút bấm Premium có đổ bóng mềm */
                                .k_btn_action {
                                    background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%) !important;
                                    color: #FFFFFF !important;
                                    font-weight: 800 !important;
                                    font-size: 13px !important;
                                    padding: 12px 16px !important;
                                    border-radius: 14px !important;
                                    border: none !important;
                                    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25) !important;
                                    display: flex !important;
                                    align-items: center !important;
                                    justify-content: center !important;
                                    gap: 6px !important;
                                    width: 100% !important;
                                    transition: all 0.2s ease;
                                }
                                .k_btn_action:hover {
                                    transform: translateY(-1px) !important;
                                    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35) !important;
                                }

                                /* --- 💻 ĐỀ GIAO DIỆN KHI XEM TRÊN MÁY TÍNH (DESKTOP MÀN HÌNH RỘNG) --- */
                                @media (min-width: 992px) {
                                    .k_master_card {
                                        flex-direction: row !important;
                                        align-items: center !important;
                                        padding: 16px 20px !important;
                                        gap: 20px !important;
                                    }
                                    .k_card_header {
                                        border-bottom: none !important;
                                        padding-bottom: 0 !important;
                                        flex-direction: column !important;
                                        align-items: flex-start !important;
                                        justify-content: center !important;
                                        gap: 6px !important;
                                    }
                                    .k_inner_pod {
                                        background: transparent !important;
                                        border: none !important;
                                        padding: 0 !important;
                                        border-radius: 0 !important;
                                    }
                                    .k_teacher_row {
                                        border-bottom: none !important;
                                        justify-content: flex-start !important;
                                        gap: 8px !important;
                                        padding: 2px 0 !important;
                                    }
                                    .k_btn_action {
                                        width: auto !important;
                                    }

                                    /* Chia cột phẳng đối xứng trên Web */
                                    .k-col-1 { flex: 1.3 !important; min-width: 240px !important; }
                                    .k-col-2 { flex: 1.1 !important; min-width: 200px !important; border-left: 1px solid #E2E8F0 !important; padding-left: 16px !important; }
                                    .k-col-3 { flex: 1.4 !important; min-width: 260px !important; border-left: 1px solid #E2E8F0 !important; padding-left: 16px !important; }
                                    .k-col-4 { flex: 1.0 !important; min-width: 180px !important; border-left: 1px solid #E2E8F0 !important; padding-left: 16px !important; display: flex !important; flex-direction: column !important; align-items: flex-end !important; justify-content: space-between !important; min-height: 85px; }
                                }
                            </style>

                            <div class="k_master_card">

                                <div class="k-col-1 d-flex flex-column gap-2">
                                    <div class="k_card_header">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="k_avatar_index"><t t-esc="record.index.raw_value"/></div>
                                            <div>
                                                <h4 class="k_student_name"><field name="hocsinh_id"/></h4>
                                                <div class="text-muted font-monospace mt-0.5" style="font-size: 11.5px;">
                                                    <i class="fa fa-calendar me-1"></i><field name="ngay_danhgia"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-md-none">
                                            <t t-if="record.trangthai.raw_value == 'dang_tao'"><span class="k_status_pill status_dang_tao">Soạn thảo</span></t>
                                            <t t-elif="record.trangthai.raw_value == 'choplan_lap_kehoach'"><span class="k_status_pill status_cho_lap">Được lập KH</span></t>
                                            <t t-else=""><span class="k_status_pill status_het_han">Hết hạn</span></t>
                                        </div>
                                    </div>

                                    <div class="text-wrap">
                                        <field name="dm_roiloan_ids" widget="many2many_tags"/>
                                    </div>
                                    <div class="text-muted" style="font-size: 12px;">
                                        <i class="fa fa-user-md me-1 text-primary"></i>Chuyên gia: <span class="text-dark font-weight-bold" style="font-weight:600;"><field name="gv_danhgia"/></span>
                                    </div>
                                </div>

                                <div class="k-col-2 k_inner_pod">
                                    <div class="k_pod_title"><i class="fa fa-compass text-warning"></i> Định hướng can thiệp</div>
                                    <div class="d-flex flex-column gap-1.5" style="font-size: 13px;">
                                        <div>
                                            <span class="text-muted">Mức độ:</span>
                                            <t t-if="record.mucdo.raw_value == '1'"><b class="text-primary" style="font-weight:700;">Cần can thiệp</b></t>
                                            <t t-elif="record.mucdo.raw_value == '2'"><b class="text-warning" style="font-weight:700;">Can thiệp nhiều</b></t>
                                            <t t-else=""><b class="text-danger" style="font-weight:700;">Can thiệp rất nhiều</b></t>
                                        </div>
                                        <div>
                                            <span class="text-muted">Tần suất:</span> <span class="text-dark font-weight-bold" style="font-weight:700;"><field name="lieuluong"/></span>
                                        </div>
                                        <div>
                                            <span class="text-muted">Lịch hẹn:</span>
                                            <t t-if="record.lichhen.raw_value"><span class="text-danger font-weight-bold" style="font-weight:700;"><i class="fa fa-clock-o me-1"></i><field name="lichhen"/></span></t>
                                            <t t-else=""><span class="text-slate-400 font-italic">Chưa hẹn</span></t>
                                        </div>
                                    </div>
                                </div>

                                <div class="k-col-3 k_inner_pod">
                                    <div class="k_pod_title"><i class="fa fa-users text-info"></i> Ban nhân sự phụ trách</div>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="k_teacher_row">
                                            <span class="text-muted" style="font-size:11.5px;"><i class="fa fa-pencil text-muted me-1"></i>Lập kế hoạch:</span>
                                            <span class="text-slate-800 font-weight-bold" style="font-weight:600;"><field name="gv_lapkehoach_id"/></span>
                                        </div>
                                        <div class="k_teacher_row">
                                            <span class="text-muted" style="font-size:11.5px;"><i class="fa fa-shield text-muted me-1"></i>Kiểm duyệt:</span>
                                            <span class="text-slate-800 font-weight-bold" style="font-weight:600;"><field name="gv_kiemduyet_id"/></span>
                                        </div>
                                        <div class="k_teacher_row">
                                            <span class="text-muted" style="font-size:11.5px;"><i class="fa fa-graduation-cap text-muted me-1"></i>Dạy can thiệp:</span>
                                            <span class="text-primary font-weight-bold" style="font-weight:700;"><field name="gv_canthiep_id"/></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="k-col-4">
                                    <div class="d-none d-md-block">
                                        <t t-if="record.trangthai.raw_value == '0'">
                                            <span class="k_status_pill status_dang_tao">
                                                <field name="trangthai"/>
                                            </span>
                                        </t>
                                        <t t-elif="record.trangthai.raw_value == '1'">
                                            <span class="k_status_pill status_cho_lap">
                                                <i class="fa fa-circle me-1" style="font-size:5px;"></i>
                                                <field name="trangthai"/>
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="k_status_pill status_het_han">
                                            <i class="fa fa-circle me-1" style="font-size:5px;"></i>
                                                <field name="trangthai"/>
                                            </span>
                                        </t>
                                    </div>


                                    <button type="object" name="action_lap_kehoach" class="k_btn_action" onclick="event.stopPropagation();">
                                        <i class="fa fa-calendar-plus-o"></i> Lập kế hoạch
                                    </button>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ekids_canthiep.kehoach_ketluan_form" model="ir.ui.view">
            <field name="name">Phiếu Kết luận - Premium UI Professional</field>
            <field name="model">ekids.kehoach_ketluan</field>
            <field name="arch" type="xml">
                <form class="o_premium_layout">
                    <header>
                        <field name="trangthai" widget="statusbar" statusbar_visible="0,1,-1" options="{'clickable': true}"/>
                    </header>
                    <sheet>

                        <field name="coso_id" invisible="1" />
                        <field name="is_readonly" invisible="1"/>

                        <div class="w-100">

                            <div class="o_premium_header d-flex align-items-center justify-content-between p-3 mb-4 bg-white rounded-3 border shadow-sm">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar_circle bg-primary text-white d-flex align-items-center justify-content-center rounded-circle" style="width: 45px; height: 45px; font-weight: 700; font-size: 16px;">
                                        <field name="index"/>
                                    </div>
                                    <div class="student_info">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-primary" style="padding: 4px 8px; font-size: 11px;">HỌC SINH:</span>
                                            <field name="hocsinh_id"
                                                   readonly="1"
                                                   force_save="1"
                                                   options="{'no_open': True}"
                                                   class="font-weight-bold text-dark m-0" style="font-size: 18px;"/>
                                        </div>
                                        <div class="d-flex align-items-center gap-3 mt-1 text-muted" style="font-size: 13px;">
                                            <span><i class="fa fa-calendar-minus-o me-1"></i>Thời gian đánh giá:
                                                <field name="ngay_danhgia" readonly="is_readonly" class="d-inline-block"/>
                                            </span>
                                            <span><i class="fa fa-user-md me-1"></i>Người đánh giá:
                                                <field name="gv_danhgia" readonly="is_readonly" class="d-inline-block" options="{'no_open': True}"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="kh-card mb-4">
                                <div class="kh-card-title d-flex align-items-center gap-2 mb-3">
                                    <i class="fa fa-stethoscope"></i>
                                    <span>ĐÁNH GIÁ LÂM SÀNG</span>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <group col="12" class="p-0 m-0 class_dense_fields">
                                            <field name="dm_roiloan_ids" readonly="is_readonly" string="Hội chứng rối loạn" widget="many2many_tags" options="{'no_create': True}" colspan="12"/>
                                        </group>
                                    </div>
                                </div>

                                <div class="row border-top pt-3">
                                    <div class="col-md-6">
                                        <group col="12" class="p-0 m-0 class_dense_fields">
                                            <field name="mucdo" readonly="is_readonly" string="Mức độ can thiệp" colspan="12"/>
                                        </group>
                                    </div>
                                    <div class="col-md-6 border-start-md">
                                        <group col="12" class="p-0 m-0 class_dense_fields">
                                            <field name="lieuluong" readonly="is_readonly" string="Tần suất can thiệp" colspan="12" placeholder="Ví dụ: 2 giờ/ngày, 5 ngày/tuần..."/>
                                        </group>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="kh-card mb-0">
                                        <group col="12" class="p-0 m-0">
                                            <field name="phuongphap" readonly="is_readonly" string="Phương pháp cốt lõi" colspan="12" placeholder="Ví dụ: PECS, ABA, TEACCH..."/>
                                        </group>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="kh-card mb-0">
                                        <group col="12" class="p-0 m-0">
                                            <field name="kythuat" readonly="is_readonly" string="Kỹ thuật bổ trợ" colspan="12" placeholder="Mô tả kỹ thuật hành vi bổ trợ cụ thể..."/>
                                        </group>
                                    </div>
                                </div>
                            </div>

                            <div class="kh-card mb-4">
                                <div class="kh-card-title d-flex align-items-center gap-2 mb-2">
                                    <i class="fa fa-compass text-success" style="font-size: 14px;"></i>
                                    <span class="font-weight-bold" style="font-size: 13px; text-transform: uppercase; letter-spacing: 0.02em;">Cấu trúc chương trình can thiệp</span>
                                </div>

                                <div class="row mb-2 mx-0">
                                    <div class="col-12 p-0">
                                        <group col="12" class="p-0 m-0 class_dense_fields">
                                            <field name="chuongtrinh_ids" readonly="is_readonly" nolabel="1" widget="many2many_tags" options="{'no_create': True}" placeholder="Bấm chọn Chương trình can thiệp áp dụng cho trẻ..." colspan="12"/>
                                        </group>
                                    </div>
                                </div>

                                <div class="o_table_responsive border rounded-3 overflow-hidden shadow-sm">
                                    <field name="kehoach_linhvuc_ids" readonly="is_readonly" nolabel="1">
                                        <list editable="bottom" class="o_list_premium m-0 border-0">
                                            <field name="sequence" widget="handle"/>

                                            <field name="chuongtrinh_id" string="Chương trình"
                                                   readonly="parent.is_readonly"
                                                   domain="[('id', 'in', parent.chuongtrinh_ids)]"
                                                   options="{'no_create': True}" width="300"/>

                                            <field name="linhvuc_id" string="Lĩnh vực"
                                                   readonly="parent.is_readonly"
                                                   domain="[('chuongtrinh_id', '=', chuongtrinh_id)]"
                                                   options="{'no_create': True}"  width="300"/>

                                            <field name="tuoi_id" string="Độ tuổi"
                                                   readonly="parent.is_readonly"
                                                   domain="[('chuongtrinh_id', '=', chuongtrinh_id)]"
                                                   options="{'no_create': True}"/>
                                        </list>
                                    </field>
                                </div>
                            </div>

                            <div class="kh-card mb-4">
                                <div class="kh-card-title d-flex align-items-center gap-2 mb-3">
                                    <i class="fa fa-users text-warning"></i>
                                    <span>PHÂN CÔNG GIÁO VIÊN</span>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <group col="12" class="p-0 m-0">
                                            <field name="gv_lapkehoach_id"
                                                   string="lập kế hoạch"
                                                   readonly="is_readonly"
                                                   options="{'no_open': True}"
                                                   domain="[('coso_id','=',coso_id)]"
                                                   colspan="12"/>
                                        </group>
                                    </div>
                                    <div class="col-md-4 border-start-md">
                                        <group col="12" class="p-0 m-0">
                                            <field name="gv_kiemduyet_id"
                                                   string="Phê duyệt"
                                                   readonly="is_readonly"
                                                   options="{'no_open': True}"
                                                   domain="[('coso_id','=',coso_id)]"
                                                   colspan="12"/>
                                        </group>
                                    </div>
                                    <div class="col-md-4 border-start-md">
                                        <group col="12" class="p-0 m-0">
                                            <field name="gv_canthiep_id"
                                                   string="Can thiệp"
                                                   readonly="is_readonly"
                                                   options="{'no_open': True}"
                                                   domain="[('coso_id','=',coso_id)]"
                                                   colspan="12"/>
                                        </group>
                                    </div>
                                </div>
                            </div>

                            <div class="kh-card mb-4">
                                <div class="kh-card-title d-flex align-items-center gap-2 mb-2">
                                    <i class="fa fa-file-text-o text-muted"></i>
                                    <span>Mô tả chỉ dẫn chi tiết</span>
                                </div>
                                <group col="12" class="p-0 m-0">
                                    <field name="desc" readonly="is_readonly" nolabel="1" placeholder="Nhập các mô tả diễn biến hành vi, lưu ý lâm sàng cụ thể..." colspan="12"/>
                                </group>
                            </div>

                            <div class="kh-card mb-4 border-0 shadow-none bg-transparent p-0">
                                <div class="kh-card-title d-flex align-items-center gap-2 mb-2">
                                    <i class="fa fa-calendar-check-o text-muted" style="font-size: 14px;"></i>
                                    <span>Kế hoạch hẹn đánh giá lần sau</span>
                                </div>

                                <group col="12" class="p-0 m-0 class_dense_fields">
                                    <field name="lichhen" readonly="is_readonly" nolabel="1" placeholder="Bấm để lựa chọn ngày hẹn tái đánh giá định kỳ..." colspan="12"/>
                                </group>
                            </div>
                        </div>

                    </sheet>
                </form>
            </field>
        </record>

  </data>
</odoo>