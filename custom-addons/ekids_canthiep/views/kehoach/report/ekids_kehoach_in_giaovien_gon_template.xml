<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ekids_canthiep.in_kehoach_cho_giaovien_gon_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">
                <!-- THANH CÔNG CỤ: IN & CHIA SẺ ĐỒNG BỘ THEO HỒ SƠ CAN THIỆP -->
                <div class="btn-print-container" style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin-bottom: 14px;">
                    <!-- Nút In ấn -->
                    <button type="button"
                            onclick="window.print()"
                            class="btn btn-sm d-inline-flex align-items-center gap-1.5"
                            title="In kế hoạch can thiệp"
                            style="font-size: 14px; font-weight: 600; border-radius: 20px; padding: 5px 16px; border: 1px solid #CBD5E1; color: #475569; background: #F8FAFC; cursor: pointer; text-decoration: none;">
                        <i class="fa fa-print text-primary" style="font-size: 14px; margin-right: 5px;"/>
                        <span>In</span>
                    </button>

                    <!-- Nút Chia sẻ đồng bộ giao diện viên thuốc -->
                    <button type="button"
                            class="btn btn-sm d-inline-flex align-items-center gap-1.5"
                            t-att-data-url="o.share_short_url"
                            onclick="copyShareUrl(this)"
                            title="Sao chép liên kết chia sẻ kế hoạch"
                            style="font-size: 14px; font-weight: 600; border-radius: 20px; padding: 5px 16px; border: 1px solid #CBD5E1; color: #475569; background: #F8FAFC; cursor: pointer; text-decoration: none;">
                        <i class="fa fa-link text-primary" style="font-size: 14px; margin-right: 5px;"/>
                        <span class="copy-btn-text">Chia sẻ</span>
                    </button>
                </div>

                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">

                    <style>
                        /* 1. THIẾT LẬP IN TRANG GIẤY KHỔ A4 TRỰC QUAN */
                        @page {
                            size: A4 landscape;
                            margin: 5mm 6mm !important;
                        }

                        * {
                            box-sizing: border-box;
                            margin: 0;
                            padding: 0;
                            -webkit-print-color-adjust: exact;
                            print-color-adjust: exact;
                        }

                        /* FONT CHỮ CƠ BẢN TOÀN BẢN IN TỐI THIỂU 14px - 15px */
                        .o_compact_print_body {
                            font-family: 'Times New Roman', Times, serif !important;
                            color: #000000 !important;
                            font-size: 14.5px !important;
                            line-height: 1.45;
                            width: 100%;
                        }

                        /* ================= BẢNG TIÊU ĐỀ TRÊN CÙNG ================= */
                        .header-main-table { width: 100%; margin-bottom: 12px; }
                        .header-main-table td {
                            padding: 2px 4px;
                            vertical-align: middle;
                            color: #000000 !important;
                            font-size: 14.5px !important;
                        }
                        .top-title-area { width: 45%; text-align: right; }
                        .top-main-title {
                            font-size: 19px !important;
                            font-weight: bold !important;
                            text-transform: uppercase;
                            color: #000000 !important;
                        }
                        .top-sub-title {
                            font-size: 14px !important;
                            font-style: italic;
                            color: #000000 !important;
                            margin-top: 2px;
                        }

                        /* BẢNG HÀNH CHÍNH */
                        .profile-grid-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; table-layout: fixed; }
                        .profile-grid-table td {
                            border: 1px solid #000000 !important;
                            padding: 6px 8px;
                            font-size: 14.5px !important;
                            vertical-align: middle;
                            color: #000000 !important;
                        }
                        .col-lbl-left { width: 12%; font-weight: bold !important; background-color: #eeeeee !important; }
                        .col-val-left { width: 21%; }
                        .col-linhvuc  { width: 33.5%; }
                        .col-tuoi     { width: 33.5%; text-align: center; }

                        /* ======================================================== */
                        /* HỆ THỐNG MỤC TIÊU CO GIÃN ĐỘNG TRANG SAU */
                        /* ======================================================== */
                        .tracking-page-section {
                            page-break-before: always;
                            width: 100%;
                        }

                        .tracking-table-title {
                            font-size: 16.5px !important;
                            font-weight: bold !important;
                            text-transform: uppercase;
                            color: #000000 !important;
                            margin-bottom: 12px;
                            border-left: 5px solid #000000 !important;
                            padding-left: 8px;
                        }

                        /* Khung bao quanh mỗi mục tiêu */
                        .goal-block-item {
                            width: 100%;
                            border: 1px solid #000000 !important;
                            padding: 10px 12px;
                            margin-bottom: 10px;
                            page-break-inside: avoid;
                            background-color: #ffffff !important;
                        }

                        /* HÀNG TRÊN */
                        .goal-top-row {
                            width: 100%;
                            display: flex;
                            flex-wrap: wrap;
                            align-items: center;
                            justify-content: flex-start;
                            margin-bottom: 8px;
                            gap: 10px;
                        }

                        /* 🌟 TIÊU ĐỀ MỤC TIÊU CHUẨN 16px */
                        .goal-title-cell {
                            font-size: 16px !important;

                            line-height: 1.4;
                            display: inline-block;
                            color: #000000 !important;
                            flex: 1;
                            min-width: 320px;
                        }

                        .goal-note-text {
                            font-size: 14px !important;
                            font-weight: normal !important;
                            font-style: italic;
                            color: #000000 !important;
                            margin-top: 3px;
                            display: block;
                        }

                        .goal-meta-cell {
                            display: flex;
                            flex-wrap: wrap;
                            align-items: center;
                            gap: 6px;
                            margin-left: auto;
                        }

                        .meta-label-tag {
                            display: inline-block;
                            background: transparent !important;
                            border: 1px dashed #000000 !important;
                            padding: 3px 8px;
                            border-radius: 4px;
                            font-size: 14px !important;
                            font-weight: 500;
                            color: #000000 !important;
                            white-space: nowrap;
                        }

                        /* DỮ LIỆU BAN ĐẦU */
                        .meta-baseline-tag {
                            display: inline-block;
                            background-color: #f5f5f5 !important;
                            border: 1px solid #000000 !important;
                            padding: 3px 9px;
                            border-radius: 3px;
                            font-size: 14px !important;
                            color: #000000 !important;
                            white-space: nowrap;
                            font-weight: bold;
                        }

                        /* HÀNG DƯỚI */
                        .goal-bottom-row {
                            width: 100%;
                            display: flex;
                            flex-direction: column;
                            gap: 6px;
                            padding-top: 6px;
                            border-top: 1px dashed #000000 !important;
                        }

                        .tracking-container-row {
                            display: flex;
                            flex-direction: column;
                            gap: 5px;
                            width: 100%;
                        }

                        .tracking-header-row {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            width: 100%;
                            margin-bottom: 3px;
                        }

                        .tracking-header-label {
                            font-size: 14px !important;
                            font-weight: bold;
                            color: #000000 !important;
                        }

                        .day-boxes-horizontal-flow {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 3.5px;
                            width: 100%;
                        }

                        /* 🌟 Ô CHẤM ĐIỂM 3 TẦNG: Nới kích thước để chứa chữ $\ge$ 14px */
                        .day-tracking-box {
                            width: 32px;
                            height: 52px;
                            border: 1px solid #000000 !important;
                            border-radius: 2px;
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                            align-items: center;
                            background-color: #ffffff !important;
                            overflow: hidden;
                        }

                        /* Tầng 1: Ngày/tháng */
                        .day-num-indicator {
                            font-size: 11px !important;
                            font-weight: bold !important;
                            color: #000000 !important;
                            line-height: 15px;
                            background-color: #f0f0f0 !important;
                            width: 100%;
                            text-align: center;
                            border-bottom: 1px solid #000000 !important;
                            height: 15px;
                        }

                        /* Tầng 2: Điểm đạt / Chữ N */
                        .day-write-space {
                            height: 21px;
                            width: 100%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 14px !important;
                            font-weight: bold !important;
                            color: #000000 !important;
                            border-bottom: 1px dotted #000000 !important;
                        }

                        /* Tầng 3: Tỷ lệ % */
                        .day-rate-space {
                            height: 15px;
                            width: 100%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 10px !important;
                            font-weight: bold !important;
                            color: #000000 !important;
                            line-height: 1;
                        }

                        /* Ngày nghỉ / ngày tương lai */
                        .box-print-rest {
                            background-color: #eeeeee !important;
                        }
                        .box-print-rest .day-num-indicator {
                            background-color: #dddddd !important;
                            color: #000000 !important;
                        }

                        .lbl-summary-chuadat,
                        .lbl-summary-hinhthanh,
                        .lbl-summary-dat {
                            color: #000000 !important;
                            font-weight: bold !important;
                            font-size: 15px !important;
                        }

                        .goal-summary-badge-row {
                            width: 100%;
                            font-size: 14.5px !important;
                            color: #000000 !important;
                            border-top: 1px dashed #000000 !important;
                            padding-top: 6px;
                            margin-top: 2px;
                            text-align: left;
                        }

                        .goal-kiemduyet-row {
                            width: 100%;
                            font-size: 14.5px !important;
                            color: #000000 !important;
                            border-top: 1px dashed #000000 !important;
                            padding-top: 6px;
                            margin-top: 2px;
                            display: flex;
                            flex-wrap: wrap;
                            align-items: center;
                            gap: 8px;
                        }

                        .tag-kiemduyet-status {
                            display: inline-block;
                            border: 1px solid #000000 !important;
                            padding: 2px 10px;
                            border-radius: 3px;
                            font-weight: bold !important;
                            font-size: 14px !important;
                            text-transform: uppercase;
                            background-color: #f5f5f5 !important;
                        }

                        .goal-kiemduyet-ghichu {
                            width: 100%;
                            font-size: 14px !important;
                            font-style: italic;
                            color: #000000 !important;
                            padding-left: 8px;
                            margin-top: 3px;
                        }

                        .text-bold { font-weight: bold !important; }

                        @media print {
                            .btn-print-container { display: none !important; }
                            .goal-block-item { border: 1px solid #000000 !important; }
                            .day-tracking-box { border: 1px solid #000000 !important; }
                            .box-print-rest { background-color: #eeeeee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                            .meta-label-tag { border: 1px dashed #000000 !important; color: #000000 !important; }
                            .meta-baseline-tag { border: 1px solid #000000 !important; background-color: #f5f5f5 !important; }
                            .tag-kiemduyet-status { border: 1px solid #000000 !important; background-color: #f5f5f5 !important; }
                        }
                    </style>

                    <div class="o_compact_print_body">

                        <!-- ================= TRANG 1: HEADER TIÊU ĐỀ TRÊN CÙNG ================= -->
                        <table class="header-main-table">
                            <tr>
                                <td style="width: 10%;">
                                    <t t-if="o.coso_id and o.coso_id.logo">
                                       <span t-field="o.coso_id.logo" t-options="{'widget': 'image', 'style': 'max-height: 48px; max-width: 100%; display: block; margin-bottom: 2px;'}"/>
                                    </t>
                                    <t t-if="not (o.coso_id and o.coso_id.logo)">
                                        <div style="display: inline-block; width: 48px; height: 26px; border: 1px dashed #000; text-align: center; line-height: 26px; font-weight: bold; font-size: 11px; margin-bottom: 2px; color: #000000;">LOGO</div>
                                    </t>
                                </td>
                                <td style="width: 45%;">
                                    <t t-if="o.coso_id and o.coso_id.header_thu_hocphi">
                                        <span t-out="o.coso_id.header_thu_hocphi"/>
                                    </t>
                                    <t t-else="">
                                        <span t-out="o.coso_id.name"/>
                                    </t>
                                </td>
                                <td class="top-title-area" style="width: 45%; text-align: right;">
                                    <div class="top-main-title">KẾ HOẠCH CAN THIỆP CÁ NHÂN <span t-field="o.name"/></div>
                                    <div class="top-sub-title">
                                        (Từ ngày <span t-field="o.tu_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                        đến ngày <span t-field="o.den_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>)
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ================= BẢNG HÀNH CHÍNH & LĨNH VỰC ================= -->
                        <t t-set="lv_list" t-value="o.kehoach_linhvuc_ids"/>
                        <t t-set="total_lv" t-value="len(lv_list)"/>
                        <t t-set="max_rows" t-value="total_lv if total_lv &gt; 7 else 7"/>

                        <table class="profile-grid-table">
                            <tr>
                                <td class="col-lbl-left">Họ và tên HS:</td>
                                <td class="col-val-left text-bold"><span t-field="o.hocsinh_id.name"/></td>
                                <td colspan="2" style="font-weight: bold; text-align: center; font-size: 15px; background-color: #eeeeee; text-transform: uppercase; color: #000000;">

                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Tuổi thực tế:</td>
                                <td class="col-val-left"><span t-field="o.hocsinh_id.tuoi"/></td>
                                <td class="col-linhvuc" style="font-weight: bold !important; text-align: center; background-color: #f5f5f5 !important;">
                                    Lĩnh vực
                                </td>
                                <td class="col-tuoi" style="font-weight: bold !important; text-align: center; background-color: #f5f5f5 !important;">
                                    Độ tuổi phát triển tương ứng
                                </td>
                            </tr>

                            <t t-foreach="range(max_rows)" t-as="idx">
                                <t t-set="current_lv" t-value="lv_list[idx] if idx &lt; total_lv else False"/>
                                <tr>
                                    <t t-if="idx == 0">
                                        <td class="col-lbl-left">Giới tính:</td>
                                        <td class="col-val-left"><span t-field="o.hocsinh_id.gioitinh"/></td>
                                    </t>
                                    <t t-if="idx == 1">
                                        <td class="col-lbl-left">Ngày sinh:</td>
                                        <td class="col-val-left"><span t-field="o.hocsinh_id.ngaysinh" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                                    </t>
                                    <t t-if="idx == 2">
                                        <td class="col-lbl-left">Liều lượng CT:</td>
                                        <td class="col-val-left"><span t-field="o.ketluan_id.dm_lieuluong_id"/></td>
                                    </t>
                                    <t t-if="idx == 3">
                                        <td class="col-lbl-left" rowspan="2">Dạng rối loạn:</td>
                                        <td class="col-val-left" rowspan="2"><span t-out="', '.join(o.ketluan_id.dm_roiloan_ids.mapped('name')) if o.ketluan_id.dm_roiloan_ids else ''"/></td>
                                    </t>
                                    <t t-if="idx == 4">
                                    </t>
                                    <t t-if="idx == 5">
                                        <td class="col-lbl-left">Mức độ:</td>
                                        <td class="col-val-left"><span t-field="o.ketluan_id.dm_mucdo_id"/></td>
                                    </t>
                                    <t t-if="idx == 6">
                                        <td class="col-lbl-left">Hình thức CT:</td>
                                        <td class="col-val-left">Bán trú / Cá nhân 1/1</td>
                                    </t>
                                    <t t-if="idx &gt; 6">
                                        <td class="col-lbl-left" style="background:#ffffff;"></td>
                                        <td class="col-val-left" style="background:#ffffff;"></td>
                                    </t>

                                    <td class="col-linhvuc">
                                        <span t-if="current_lv" t-field="current_lv.linhvuc_id.name"/>
                                        <span t-if="not current_lv">....</span>
                                    </td>
                                    <td class="col-tuoi">
                                        <span t-if="current_lv" t-field="current_lv.tuoi_id.name"/>
                                        <span t-if="not current_lv">...</span>
                                    </td>
                                </tr>
                            </t>

                            <tr>
                                <td class="col-lbl-left">Chương trình chính:</td>
                                <td colspan="3" class="text-bold">
                                    <span t-out="o.with_context(lang='vi_VN').ketluan_id.chuongtrinh if o.ketluan_id and o.ketluan_id.chuongtrinh else 'CHƯƠNG TRÌNH CAN THIỆP TOÀN DIỆN TỪ SƠN DÀNH CHO TRẺ RỐI LẠN PHÁT TRIỂN'"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Quản lý chuyên môn:</td>
                                <td class="col-val-left"><span t-field="o.gv_kiemduyet_id.name"/></td>
                                <td class="col-lbl-left" style="text-align:right;">Giáo viên dạy:</td>
                                <td class="text-bold"><span t-field="o.gv_lapkehoach_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Tâm lý và hành vi:</td>
                                <td colspan="3">
                                    - Điều trẻ thích: .........................................................................................<br/>
                                    - Điều trẻ sợ: ............................................................................................
                                </td>
                            </tr>

                            <tr>
                                <td class="col-lbl-left">Ghi chú:</td>
                                <td colspan="3"><span t-field="o.ketluan_id.desc"/></td>
                            </tr>
                        </table>

                        <!-- ================= TRANG 2 TRỞ ĐI: THEO DÕI MỤC TIÊU ================= -->
                        <div class="tracking-page-section">
                            <div class="tracking-table-title">Hệ thống Mục tiêu can thiệp và Nhật ký đánh giá mức độ thành thục</div>

                            <t t-foreach="o.kehoach_linhvuc_ids" t-as="lv">
                                <t t-foreach="lv.kehoach_muctieu_ids" t-as="muctieu">

                                    <div class="goal-block-item">

                                        <!-- HÀNG TRÊN: TIÊU ĐỀ (FONT 16px) + METADATA (FONT >= 14px) -->
                                        <div class="goal-top-row">
                                            <div class="goal-title-cell">
                                                <span>Mục tiêu <t t-out="muctieu_index + 1"/>:</span> <span t-field="muctieu.name"/>
                                                <t t-if="muctieu.ghichu">
                                                    <span class="goal-note-text">Ghi chú: <span t-field="muctieu.ghichu"/></span>
                                                </t>
                                            </div>

                                            <div class="goal-meta-cell">
                                                <span class="meta-label-tag">Lĩnh vực: <span t-field="lv.linhvuc_id.name"/></span>
                                                <span class="meta-label-tag">Tuổi: <span t-field="lv.tuoi_id.name"/></span>
                                                <span class="meta-label-tag">CT: <span t-field="lv.chuongtrinh_id.name"/></span>
                                            </div>
                                        </div>

                                        <!-- HÀNG DƯỚI: THEO DÕI HÀNG NGANG -->
                                        <div class="goal-bottom-row">

                                            <div class="tracking-container-row">
                                                <div class="tracking-header-row">
                                                    <div class="tracking-header-label">
                                                        Theo dõi
                                                        <span style="font-weight: normal;">
                                                            (Số lần thử là <strong style="color:red;"><span t-field="muctieu.solan_thu"/></strong> lần)
                                                        </span>
                                                    </div>

                                                    <div class="meta-baseline-tag">
                                                        Dữ liệu ban đầu: Đạt (+)
                                                        <strong><span t-field="muctieu.solan_thu_dat"/></strong>/<strong><span t-field="muctieu.solan_thu"/></strong> lần
                                                        <t t-if="muctieu.tyle_thu">
                                                            (<strong><span t-field="muctieu.tyle_thu"/>%</strong>)
                                                        </t>
                                                    </div>
                                                </div>

                                                <div class="day-boxes-horizontal-flow">
                                                    <t t-if="muctieu.ketqua2muctieu_ids">
                                                        <t t-foreach="muctieu.ketqua2muctieu_ids" t-as="kq">

                                                            <t t-set="is_future_status" t-value="kq.is_date_status == '1'"/>
                                                            <t t-set="rest_class" t-value="(kq.loai in ['0', '-1'] or is_future_status) and 'box-print-rest' or ''"/>

                                                            <div t-attf-class="day-tracking-box #{rest_class}">
                                                                <!-- Tầng 1: Ngày/Tháng -->
                                                                <span class="day-num-indicator">
                                                                    <span t-field="kq.ngay" t-options="{'widget': 'date', 'format': 'dd/MM'}"/>
                                                                </span>

                                                                <!-- Tầng 2: Điểm đạt / Ký hiệu N (14px) -->
                                                                <div class="day-write-space">
                                                                    <t t-if="is_future_status"></t>
                                                                    <t t-else="">
                                                                        <t t-if="kq.loai == '-1'">N</t>
                                                                        <t t-elif="kq.loai == '0'"></t>
                                                                        <t t-else="">
                                                                            <t t-if="kq.trangthai != '0' and kq.solan_thu &gt; 0">
                                                                                <span t-field="kq.solan_thu_dat"/>
                                                                            </t>
                                                                        </t>
                                                                    </t>
                                                                </div>

                                                                <!-- Tầng 3: Tỷ lệ % -->
                                                                <div class="day-rate-space">
                                                                    <t t-if="not is_future_status and kq.loai == '1' and kq.trangthai != '0' and kq.solan_thu &gt; 0">
                                                                        <span><t t-esc="kq.tyle_thu"/>%</span>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </t>

                                                    <!-- FALLBACK KHI CHƯA CÓ KẾT QUẢ -->
                                                    <t t-else="">
                                                        <t t-set="total_days" t-value="int(o.songay or 30)"/>
                                                        <t t-foreach="range(total_days)" t-as="day_idx">
                                                            <t t-set="computed_date" t-value="o.tu_ngay + datetime.timedelta(days=day_idx)"/>
                                                            <t t-set="is_fallback_sunday" t-value="computed_date.weekday() == 6"/>
                                                            <t t-set="is_fallback_future" t-value="computed_date &gt; datetime.date.today()"/>
                                                            <t t-set="should_fallback_gray" t-value="is_fallback_sunday or is_fallback_future"/>

                                                            <div t-attf-class="day-tracking-box #{should_fallback_gray and 'box-print-rest' or ''}">
                                                                <span class="day-num-indicator">
                                                                    <span t-out="computed_date.strftime('%d/%m')"/>
                                                                </span>
                                                                <div class="day-write-space">
                                                                    <t t-if="is_fallback_future"></t>
                                                                    <t t-elif="is_fallback_sunday">N</t>
                                                                </div>
                                                                <div class="day-rate-space"></div>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </div>
                                            </div>

                                            <!-- DÒNG 1: TỔNG KẾT KẾT QUẢ CAN THIỆP -->
                                            <div class="goal-summary-badge-row">
                                                <span class="text-bold">Kết quả <strong><span t-out="o.songay"/></strong> ngày can thiệp của giáo viên:</span>
                                                Chưa đạt (-): <span class="lbl-summary-chuadat"><span t-field="muctieu.ketqua_khongdat"/></span> |
                                                Hình thành (+/-): <span class="lbl-summary-hinhthanh"><span t-field="muctieu.ketqua_hinhthanh"/></span> |
                                                Đạt (+): <span class="lbl-summary-dat"><span t-field="muctieu.ketqua_dat"/></span>
                                            </div>

                                            <!-- DÒNG 2: ĐÁNH GIÁ VÀ GHI CHÚ KIỂM DUYỆT -->
                                            <t t-if="muctieu.trangthai_kiemduyet and muctieu.trangthai_kiemduyet != '0'">
                                                <div class="goal-kiemduyet-row">
                                                    <span class="text-bold">Đánh giá của giáo viên chuyên môn:</span>
                                                    <span class="tag-kiemduyet-status">
                                                        <t t-if="muctieu.trangthai_kiemduyet == '1'">Đạt (+)</t>
                                                        <t t-elif="muctieu.trangthai_kiemduyet == '-1'">Chuyển sang tháng sau(-)</t>
                                                        <t t-elif="muctieu.trangthai_kiemduyet == '-2'">Dừng lại(-)</t>
                                                    </span>

                                                    <t t-if="muctieu.ghichu_kiemduyet">
                                                        <div class="goal-kiemduyet-ghichu">
                                                            <strong>Ý kiến/Định hướng:</strong> <t t-out="muctieu.ghichu_kiemduyet"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>

                                        </div>

                                    </div>

                                </t>
                            </t>
                        </div>

                    </div>
                </div>

                <!-- SCRIPT XỬ LÝ SAO CHÉP LIÊN KẾT ĐỒNG BỘ HIỆU ỨNG HỒ SƠ CAN THIỆP -->
                <script type="text/javascript">
                    <![CDATA[
                    function copyShareUrl(btnEl) {
                        const url = btnEl.getAttribute('data-url');
                        if (!url) {
                            alert("Chưa có liên kết chia sẻ!");
                            return;
                        }

                        if (navigator.clipboard && window.isSecureContext) {
                            navigator.clipboard.writeText(url).then(onSuccess).catch(fallbackCopy);
                        } else {
                            fallbackCopy();
                        }

                        function fallbackCopy() {
                            const tempInput = document.createElement("input");
                            tempInput.value = url;
                            document.body.appendChild(tempInput);
                            tempInput.select();
                            document.execCommand("copy");
                            document.body.removeChild(tempInput);
                            onSuccess();
                        }

                        function onSuccess() {
                            const textSpan = btnEl.querySelector('.copy-btn-text');
                            const iconEl = btnEl.querySelector('i');
                            const originalText = textSpan.innerText;

                            textSpan.innerText = "Đã chép!";
                            iconEl.className = "fa fa-check text-success";
                            btnEl.style.borderColor = "#86EFAC";
                            btnEl.style.backgroundColor = "#F0FDF4";

                            setTimeout(function() {
                                textSpan.innerText = originalText;
                                iconEl.className = "fa fa-link text-primary";
                                btnEl.style.borderColor = "#CBD5E1";
                                btnEl.style.backgroundColor = "#F8FAFC";
                            }, 2000);
                        }
                    }
                    ]]>
                </script>

            </t>
        </t>
    </template>
</odoo>