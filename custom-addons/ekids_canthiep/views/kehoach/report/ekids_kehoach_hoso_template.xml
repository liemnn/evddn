                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: 11px; background: #FFFFFF;">
                                <thead>
                                    <tr style="background: #ECFDF5; color: #065F46; text-transform: uppercase;">
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 4%; text-align: center;">TT</th>
