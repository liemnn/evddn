<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ekids_canthiep.kehoach_hoso_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._get_hoso_report_data()"/>
                <t t-set="tab1" t-value="data.get('tab1', {})"/>
                <t t-set="tab2" t-value="data.get('tab2', {})"/>
                <t t-set="hs" t-value="data.get('hocsinh', {})"/>
                <t t-set="chart" t-value="tab1.get('chart', {})"/>
                <t t-set="active_tab" t-value="data.get('active_tab', 'tab1')"/>

                <div class="container-fluid p-3" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1E293B; font-size: 12px; line-height: 1.45;">

                    <style>
                        .hs-profile-card {
                            background-color: #FFFFFF;
                            border: 1px solid #E2E8F0;
                            border-radius: 14px;
                            padding: 16px 22px;
                            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
                            position: relative;
                        }
                        .hs-avatar-box {
                            width: 68px;
                            height: 68px;
                            border-radius: 50%;
                            background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
                            border: 2px solid #BFDBFE;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: #2563EB;
                            font-size: 28px;
                            flex-shrink: 0;
                            overflow: hidden;
                        }
                        .hs-avatar-img {
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                        }
                        .hs-meta-item {
                            display: inline-flex;
                            align-items: center;
                            gap: 6px;
                            color: #475569;
                            font-size: 11.5px;
                        }
                        .hs-meta-label {
                            color: #64748B;
                            font-weight: 500;
                        }
                        .hs-meta-val {
                            color: #0F172A;
                            font-weight: 700;
                        }
                        .hoso-tabs-nav {
                            background-color: #F1F5F9;
                            border: 1px solid #E2E8F0;
                            border-radius: 12px;
                            padding: 6px;
                            display: flex;
                            align-items: center;
                            gap: 10px;
                        }
                        .hoso-tab-btn {
                            border: 1px solid transparent !important;
                            border-radius: 8px !important;
                            padding: 8px 14px !important;
                            font-size: 13px !important;
                            font-weight: 700 !important;
                            color: #64748B !important;
                            background-color: transparent !important;
                            cursor: pointer;
                            display: inline-flex !important;
                            align-items: center !important;
                            gap: 8px !important;
                            transition: all 0.2s ease;
                        }
                        .hoso-tab-btn.active {
                            color: #1D4ED8 !important;
                            background-color: #FFFFFF !important;
                            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.06) !important;
                        }
                        .tab-icon-badge {
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background-color: #E2E8F0;
                            color: #64748B;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 11px;
                        }
                        .hoso-tab-btn.active .tab-icon-badge {
                            background-color: #DBEAFE;
                            color: #1D4ED8;
                        }
                        .hoso-tab-btn-success.active .tab-icon-badge {
                            background-color: #DCFCE7 !important;
                            color: #047857 !important;
                        }
                        .hoso-tab-btn-success.active {
                            color: #047857 !important;
                        }
                        .hoso-dropdown-select {
                            appearance: none;
                            -webkit-appearance: none;
                            -moz-appearance: none;
                            background: transparent;
                            border: none;
                            outline: none;
                            font-size: 13px;
                            font-weight: 800;
                            color: #1D4ED8;
                            cursor: pointer;
                            padding-right: 18px;
                            margin: 0;
                        }
                        .hoso-dropdown-select-green {
                            color: #047857 !important;
                        }
                        .hoso-dropdown-wrapper {
                            position: relative;
                            display: inline-flex;
                            align-items: center;
                        }
                        .hoso-dropdown-wrapper::after {
                            content: "\f0d7";
                            font-family: "FontAwesome";
                            font-size: 11px;
                            color: #1D4ED8;
                            position: absolute;
                            right: 2px;
                            pointer-events: none;
                        }
                        .hoso-dropdown-wrapper-green::after {
                            color: #047857 !important;
                        }
                    </style>

                    <!-- ================= 1. HỒ SƠ HỌC SINH CARD SÁNG MÀU ================= -->
                    <div class="hs-profile-card mb-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="hs-avatar-box">
                                    <t t-if="hs.get('has_avatar')">
                                        <img t-attf-src="/web/image?model=ekids.hocsinh&amp;id=#{hs['id']}&amp;field=#{hs['avatar_field']}"
                                             class="hs-avatar-img" alt="Avatar"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-user-graduate"></i>
                                    </t>
                                </div>

                                <div>
                                    <div style="font-size: 10px; font-weight: 700; color: #2563EB; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">
                                        <i class="fa fa-school me-1 text-primary"/> <span t-out="hs.get('co_so', '')"/>
                                    </div>

                                    <div style="font-size: 19px; font-weight: 800; color: #0F172A; letter-spacing: -0.2px; line-height: 1.25; margin-bottom: 5px;">
                                        <span t-out="hs.get('name', '')"/>
                                    </div>

                                    <div class="d-flex flex-wrap align-items-center gap-3 pt-1">
                                        <div class="hs-meta-item">
                                            <i class="fa fa-cake-candles text-muted" style="font-size: 11px;"/>
                                            <span class="hs-meta-label">Ngày sinh:</span>
                                            <span class="hs-meta-val"><span t-out="hs.get('ngaysinh', '')"/></span>
                                        </div>
                                        <span style="color: #CBD5E1;">•</span>
                                        <div class="hs-meta-item">
                                            <i class="fa fa-child-reaching text-muted" style="font-size: 11px;"/>
                                            <span class="hs-meta-label">Tuổi can thiệp:</span>
                                            <span class="hs-meta-val"><span t-out="hs.get('tuoi', '')"/></span>
                                        </div>
                                        <span style="color: #CBD5E1;">•</span>
                                        <div class="hs-meta-item">
                                            <i class="fa fa-users text-muted" style="font-size: 11px;"/>
                                            <span class="hs-meta-label">Phụ huynh:</span>
                                            <span class="hs-meta-val"><span t-out="hs.get('phuhuynh', '')"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-end ps-3" style="border-left: 1px dashed #E2E8F0;">
                                <div class="mb-2">
                                    <span class="badge" style="background-color: #DCFCE7; color: #166534; border: 1px solid #BBF7D0; font-size: 11.5px; font-weight: 700; padding: 5px 12px; border-radius: 20px;">
                                        <i class="fa fa-circle text-success me-1" style="font-size: 8px;"/>
                                        <span t-out="hs.get('trang_thai', 'Đang theo học')"/>
                                    </span>
                                </div>
                                <div class="hs-meta-item justify-content-end mb-1">
                                    <span class="hs-meta-label">GV can thiệp:</span>
                                    <span class="hs-meta-val text-primary"><span t-out="tab1.get('giaovien', 'Chưa phân công')"/></span>
                                </div>
                                <div class="hs-meta-item justify-content-end">
                                    <span class="hs-meta-label">Quản lý chuyên môn:</span>
                                    <span class="hs-meta-val"><span t-out="tab1.get('quanly', 'Trần Thị Ngọc Ánh')"/></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ================= 2. THANH ĐIỀU HƯỚNG 2 TAB ================= -->
                    <div class="hoso-tabs-nav mb-3">
                        <!-- TAB 1: BÁO CÁO -->
                        <div id="btn_main_tab1" t-attf-class="hoso-tab-btn #{'active' if active_tab == 'tab1' else ''}" onclick="switchHosoMainTab('content_tab1', this)">
                            <span class="tab-icon-badge"><i class="fa fa-chart-line"/></span>
                            <span style="font-weight: 800; font-size: 13px;">Báo cáo:</span>

                            <div class="hoso-dropdown-wrapper" onclick="event.stopPropagation();">
                                <select id="select_ky_baocao" class="hoso-dropdown-select" onchange="onChangeKyBaoCao(this)">
                                    <t t-foreach="data.get('ds_baocao', [])" t-as="ky">
                                        <option t-att-value="ky['id']"
                                                t-att-selected="ky['id'] == data.get('current_plan_id') and 'selected' or None">
                                            <t t-out="ky['label']"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <span id="current_plan_badge" class="badge rounded-pill ms-1" style="background-color: #2563EB; font-size: 11px; padding: 4px 8px;">
                                <span><t t-out="tab1.get('tyle_dat', 0)"/></span>%
                            </span>
                        </div>

                        <!-- TAB 2: KẾ HOẠCH THÁNG TỚI -->
                        <div id="btn_main_tab2" t-attf-class="hoso-tab-btn hoso-tab-btn-success #{'active' if active_tab == 'tab2' else ''}" onclick="switchHosoMainTab('content_tab2', this)">
                            <span class="tab-icon-badge"><i class="fa fa-clipboard-list"/></span>
                            <span style="font-weight: 800; font-size: 13px;">Kế hoạch:</span>

                            <t t-if="data.get('ds_kehoach_thangtoi')">
                                <div class="hoso-dropdown-wrapper hoso-dropdown-wrapper-green" onclick="event.stopPropagation();">
                                    <select id="select_ky_thangtoi" class="hoso-dropdown-select hoso-dropdown-select-green" onchange="onChangeKyThangToi(this)">
                                        <t t-foreach="data.get('ds_kehoach_thangtoi', [])" t-as="kh_tt">
                                            <option t-att-value="kh_tt['id']"
                                                    t-att-selected="kh_tt['id'] == data.get('current_thangtoi_id') and 'selected' or None">
                                                <t t-out="kh_tt['label']"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <span class="badge rounded-pill ms-1" style="background-color: #059669; font-size: 10.5px; padding: 3px 8px;">
                                    <t t-out="len(data.get('ds_kehoach_thangtoi', []))"/> KH
                                </span>
                            </t>
                            <t t-else="">
                                <span style="font-weight: 700; color: #94A3B8;">Chưa có kế hoạch</span>
                            </t>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- NỘI DUNG TAB 1: BÁO CÁO KẾT QUẢ KỲ ĐÃ KẾT THÚC                             -->
                    <!-- ========================================================================= -->
                    <div id="content_tab1" class="hoso-tab-view" t-attf-style="display: #{'block' if active_tab == 'tab1' else 'none'};">
                        <t t-if="not data.get('has_plan')">
                            <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 10px; padding: 20px; text-align: center; color: #B45309; margin: 15px 0;">
                                <i class="fa fa-circle-exclamation me-1"/> Chưa có kế hoạch nào đã hoàn thành (-1) để trích xuất báo cáo.
                            </div>
                        </t>
                        <t t-else="">
                            <div class="mb-2 px-1">
                                <span class="text-muted" style="font-size: 13px;">
                                    <strong>Kỳ can thiệp:</strong>
                                    <span style="color: #1E3A8A; font-weight: 800;" t-out="tab1.get('tieu_de_hien_thi', '')"/>
                                </span>
                            </div>

                            <table style="width: 100%; border-collapse: separate; border-spacing: 8px 0; margin-bottom: 16px;">
                                <tr>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #2563EB; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Tổng mục tiêu kế hoạch</div>
                                        <div style="font-size: 17px; font-weight: 800; color: #1D4ED8; margin: 2px 0;">
                                            <span t-out="tab1.get('tong_muctieu', 0)"/> mục tiêu
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Kỳ kế hoạch đã đóng</div>
                                    </td>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #0D9488; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Kết quả đạt được</div>
                                        <div style="font-size: 17px; font-weight: 800; color: #15803D; margin: 2px 0;">
                                            <span t-out="tab1.get('tong_muctieu_dat', 0)"/> / <span t-out="tab1.get('tong_muctieu', 0)"/> mục tiêu
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Tỷ lệ hoàn thành: <strong><span t-out="tab1.get('tyle_dat', 0)"/>% KH tháng</strong></div>
                                    </td>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #E11D48; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Điểm trũng cần ưu tiên</div>
                                        <div style="font-size: 12px; font-weight: 800; color: #DC2626; margin: 4px 0;">
                                            <span t-out="tab1.get('diem_trung', 'Chưa có')"/>
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Lĩnh vực tỷ lệ đạt thấp nhất</div>
                                    </td>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #D97706; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Lĩnh vực bứt phá nhất</div>
                                        <div style="font-size: 12px; font-weight: 800; color: #B45309; margin: 4px 0;">
                                            <span t-out="tab1.get('but_pha', 'Chưa có')"/>
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Lĩnh vực tỷ lệ đạt cao nhất</div>
                                    </td>
                                </tr>
                            </table>

                            <div class="mb-3" style="background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 10px; padding: 14px 18px;">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <div style="font-size: 13px; font-weight: 800; color: #1E293B;">
                                        <i class="fa fa-chart-line text-primary me-1.5"/>
                                        <span>Sơ đồ đối chiếu tiến bộ lâm sàng (Baseline vs <t t-out="tab1.get('ten', '')"/>)</span>
                                    </div>
                                    <div style="font-size: 11px; font-weight: 700; color: #64748B;">Mức đạt chuẩn từ 80% trở lên</div>
                                </div>

                                <div class="d-flex justify-content-center align-items-center gap-4 mb-2" style="font-size: 11px; font-weight: 700;">
                                    <div class="d-flex align-items-center gap-1.5" style="color: #64748B;">
                                        <svg width="24" height="12"><line x1="0" y1="6" x2="24" y2="6" stroke="#64748B" stroke-width="2.5" stroke-dasharray="3,3"/><polygon points="12,2 16,6 12,10 8,6" fill="#FFFFFF" stroke="#64748B" stroke-width="1.5"/></svg>
                                        <span>Đánh giá ban đầu (Baseline)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1.5" style="color: #DC2626;">
                                        <svg width="24" height="12"><line x1="0" y1="6" x2="24" y2="6" stroke="#DC2626" stroke-width="2.5"/><circle cx="12" cy="6" r="4" fill="#DC2626"/></svg>
                                        <span>Đánh giá sau can thiệp (<t t-out="tab1.get('ten', '')"/>)</span>
                                    </div>
                                </div>

                                <div style="width: 100%; overflow-x: auto;">
                                    <svg viewBox="0 0 900 250" style="width: 100%; height: auto; display: block; font-family: sans-serif;">
                                        <line x1="50" y1="22" x2="860" y2="22" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="26" font-size="10" fill="#94A3B8" text-anchor="end">110%</text>
                                        <line x1="50" y1="35" x2="860" y2="35" stroke="#E2E8F0" stroke-width="1"/><text x="42" y="39" font-size="10" fill="#94A3B8" text-anchor="end">100%</text>
                                        <line x1="50" y1="61" x2="860" y2="61" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="2,2"/><text x="42" y="65" font-size="10" fill="#64748B" font-weight="bold" text-anchor="end">80%</text>
                                        <line x1="50" y1="87" x2="860" y2="87" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="91" font-size="10" fill="#94A3B8" text-anchor="end">60%</text>
                                        <line x1="50" y1="113" x2="860" y2="113" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="117" font-size="10" fill="#94A3B8" text-anchor="end">40%</text>
                                        <line x1="50" y1="139" x2="860" y2="139" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="143" font-size="10" fill="#94A3B8" text-anchor="end">20%</text>
                                        <line x1="50" y1="165" x2="860" y2="165" stroke="#CBD5E1" stroke-width="1.5"/><text x="42" y="169" font-size="10" fill="#94A3B8" text-anchor="end">0%</text>

                                        <t t-if="chart.get('polygon_dat')"><polygon t-att-points="chart['polygon_dat']" fill="#FEE2E2" opacity="0.45"/></t>
                                        <t t-if="chart.get('points_thu')"><polyline t-att-points="chart['points_thu']" fill="none" stroke="#64748B" stroke-width="2.5" stroke-dasharray="4,4"/></t>
                                        <t t-if="chart.get('points_dat')"><polyline t-att-points="chart['points_dat']" fill="none" stroke="#DC2626" stroke-width="3"/></t>

                                        <t t-foreach="chart.get('items', [])" t-as="pt">
                                            <polygon t-attf-points="#{pt['x']},#{pt['y_thu'] - 5} #{pt['x'] + 5},#{pt['y_thu']} #{pt['x']},#{pt['y_thu'] + 5} #{pt['x'] - 5},#{pt['y_thu']}" fill="#FFFFFF" stroke="#64748B" stroke-width="1.8"/>
                                            <text t-att-x="pt['x']" t-att-y="pt['y_thu'] - 8" font-size="9.5" fill="#475569" font-weight="bold" text-anchor="middle"><t t-out="pt['tyle_thu']"/>%</text>
                                            <circle t-att-cx="pt['x']" t-att-cy="pt['y_dat']" r="5.5" fill="#DC2626" stroke="#FFFFFF" stroke-width="2"/>
                                            <text t-att-x="pt['x']" t-att-y="pt['y_dat'] - 9" font-size="10.5" fill="#B91C1C" font-weight="800" text-anchor="middle"><t t-out="pt['tyle_dat']"/>%</text>
                                            <text t-att-x="pt['x']" y="185" font-size="9.5" font-weight="700" fill="#334155" text-anchor="middle">
                                                <t t-foreach="pt.get('lines', [])" t-as="line">
                                                    <tspan t-att-x="pt['x']" t-att-dy="line_index == 0 and '0' or '11'"><t t-out="line"/></tspan>
                                                </t>
                                            </text>
                                        </t>
                                    </svg>
                                </div>
                            </div>

                            <div style="font-size: 13px; font-weight: 800; color: #1E3A8A; margin-bottom: 8px; border-bottom: 1.5px solid #CBD5E1; padding-bottom: 4px;">
                                I. Chi tiết mức độ ban đầu và kết quả can thiệp
                            </div>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: 11px; background: #FFFFFF;">
                                <thead>
                                    <tr style="background: #F1F5F9; color: #334155; text-transform: uppercase;">
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 4%; text-align: center;">STT</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 10px; width: 44%; text-align: left;">Mục tiêu can thiệp</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 11%; text-align: center;">Trước CT (Baseline)</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 10%; text-align: center;">Sau CT (Kết quả)</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 11%; text-align: center;">Mức độ</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 10px; width: 20%; text-align: left;">Ý kiến / Định hướng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="tab1.get('linhvucs_grouped', [])" t-as="grp">
                                        <tr style="background-color: #F8FAFC; border-top: 2px solid #94A3B8; border-bottom: 1px solid #CBD5E1;">
                                            <td colspan="6" style="padding: 7px 12px;">
                                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                                    <div style="display: flex; align-items: center; gap: 8px;">
                                                        <i class="fa fa-folder-open text-primary" style="font-size: 13px;"/>
                                                        <span style="font-size: 12px; font-weight: 800; color: #1E3A8A; text-transform: uppercase;"><t t-out="grp['linhvuc']"/></span>
                                                        <t t-if="grp['tuoi']"><span class="badge" style="background-color: #E2E8F0; color: #334155; font-size: 10px; padding: 3px 7px; border-radius: 4px; font-weight: bold;"><t t-out="grp['tuoi']"/></span></t>
                                                        <span style="font-size: 10.5px; color: #64748B;">(<t t-out="grp['total_mt']"/> mục tiêu)</span>
                                                    </div>
                                                    <div style="font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                                                        <span style="color: #64748B;">Baseline: <strong><t t-out="grp['avg_thu']"/>%</strong></span>
                                                        <span style="color: #CBD5E1;">|</span>
