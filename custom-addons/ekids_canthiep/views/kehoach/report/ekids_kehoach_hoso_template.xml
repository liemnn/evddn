                    <!-- JAVASCRIPT ĐIỀU HƯỚNG TAB VÀ 2 DROPDOWN CHỌN KỲ -->
                    <script type="text/javascript">
                        <![CDATA[
                        function switchHosoMainTab(tabContentId, btnEl) {
                            document.getElementById('content_tab1').style.display = 'none';
                            document.getElementById('content_tab2').style.display = 'none';

                            document.getElementById('btn_main_tab1').classList.remove('active');
                            document.getElementById('btn_main_tab2').classList.remove('active');

                            document.getElementById(tabContentId).style.display = 'block';
                            btnEl.classList.add('active');

                            const currentUrl = new URL(window.location.href);
                            currentUrl.searchParams.set('active_tab', tabContentId === 'content_tab2' ? 'tab2' : 'tab1');
                            window.history.replaceState({}, '', currentUrl.toString());
                        }

                        function onChangeKyBaoCao(selectEl) {
                            const kehoachId = selectEl.value;
                            if (!kehoachId) return;

                            const url = new URL(window.location.href);
                            url.searchParams.set('kehoach_id', kehoachId);
                            url.searchParams.set('active_tab', 'tab1');
                            window.location.href = url.toString();
                        }

                        function onChangeKyThangToi(selectEl) {
                            const thangToiId = selectEl.value;
                            if (!thangToiId) return;

                            const url = new URL(window.location.href);
                            url.searchParams.set('thangtoi_id', thangToiId);
                            url.searchParams.set('active_tab', 'tab2');
                            window.location.href = url.toString();
                        }
                        ]]>
                    </script>

