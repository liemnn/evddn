<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ekids_canthiep.kehoach_hoso_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._get_hoso_report_data()"/>
                <t t-set="tab1" t-value="data.get('tab1', {})"/>
                <t t-set="hs" t-value="data.get('hocsinh', {})"/>
                <t t-set="chart" t-value="tab1.get('chart', {})"/>

                <div class="container-fluid p-3" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #0F172A; font-size: 12px; line-height: 1.45;">

                    <style>
                        .hoso-tabs-nav {
                            background-color: #F1F5F9;
                            border: 1px solid #E2E8F0;
                            border-radius: 12px;
                            padding: 6px;
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                        }
                        .hoso-select-btn {
                            border: 1px solid transparent !important;
                            border-radius: 8px !important;
                            padding: 6px 14px !important;
                            font-size: 13px !important;
                            font-weight: 700 !important;
                            color: #1D4ED8 !important;
                            background-color: #FFFFFF !important;
                            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.06) !important;
                            display: inline-flex !important;
                            align-items: center !important;
                            gap: 8px !important;
                        }
                        .tab-icon-badge {
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background-color: #DBEAFE;
                            color: #1D4ED8;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 11px;
                        }
                        .hoso-dropdown-select {
                            appearance: none;
                            -webkit-appearance: none;
                            -moz-appearance: none;
                            background: transparent;
                            border: none;
                            outline: none;
                            font-size: 13px;
                            font-weight: 800;
                            color: #1D4ED8;
                            cursor: pointer;
                            padding-right: 18px;
                            margin: 0;
                        }
                        .hoso-dropdown-wrapper {
                            position: relative;
                            display: inline-flex;
                            align-items: center;
                        }
                        .hoso-dropdown-wrapper::after {
                            content: "\f0d7";
                            font-family: "FontAwesome";
                            font-size: 11px;
                            color: #1D4ED8;
                            position: absolute;
                            right: 2px;
                            pointer-events: none;
                        }
                    </style>

                    <!-- MASTER HEADER: THÔNG TIN HỌC SINH -->
                    <div class="shadow-sm mb-3" style="background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%); color: #FFFFFF; border-radius: 12px; padding: 16px 20px; border-bottom: 3.5px solid #2563EB;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 18%; padding: 4px; color: #93C5FD; font-weight: bold;">Họ và tên trẻ:</td>
                                <td style="width: 32%; padding: 4px; color: #FDE047; font-size: 16px; font-weight: 800; letter-spacing: 0.5px;">
                                    <span t-out="hs.get('name', '')"/>
                                </td>
                                <td style="width: 18%; padding: 4px; color: #93C5FD; font-weight: bold;">Ngày sinh:</td>
                                <td style="width: 32%; padding: 4px; font-weight: bold;"><span t-out="hs.get('ngaysinh', '')"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 4px; color: #93C5FD; font-weight: bold;">Tuổi can thiệp:</td>
                                <td style="padding: 4px;"><span t-out="hs.get('tuoi', '')"/></td>
                                <td style="padding: 4px; color: #93C5FD; font-weight: bold;">Đại diện Phụ huynh:</td>
                                <td style="padding: 4px;"><span t-out="hs.get('phuhuynh', '')"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 4px; color: #93C5FD; font-weight: bold;">Giáo viên phụ trách:</td>
                                <td style="padding: 4px;"><span t-out="tab1.get('giaovien', '')"/></td>
                                <td style="padding: 4px; color: #93C5FD; font-weight: bold;">Quản lý chuyên môn:</td>
                                <td style="padding: 4px;"><span t-out="tab1.get('quanly', '')"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- THANH CHỌN KỲ BÁO CÁO (DROPDOWN CHỌN NHANH) -->
                    <div class="hoso-tabs-nav mb-3">
                        <div class="hoso-select-btn">
                            <span class="tab-icon-badge"><i class="fa fa-chart-line"/></span>
                            <span style="font-weight: 800; color: #1D4ED8; font-size: 13px;">Báo cáo:</span>

                            <div class="hoso-dropdown-wrapper">
                                <select id="select_ky_baocao" class="hoso-dropdown-select" onchange="onChangeKyBaoCao(this)">
                                    <t t-foreach="data.get('ds_baocao', [])" t-as="ky">
                                        <option t-att-value="ky['id']"
                                                t-att-selected="ky['id'] == data.get('current_plan_id') and 'selected' or None">
                                            <t t-out="ky['ten']"/> (<t t-out="ky['tu_ngay']"/> - <t t-out="ky['den_ngay']"/>)
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <span id="current_plan_badge" class="badge rounded-pill ms-1" style="background-color: #2563EB; font-size: 11px; padding: 4px 8px;">
                                <span><t t-out="tab1.get('tyle_dat', 0)"/></span>%
                            </span>
                        </div>

                        <div style="font-size: 11.5px; color: #64748B; font-weight: 600; padding-right: 8px;">
                            Tổng số: <strong><t t-out="len(data.get('ds_baocao', []))"/></strong> kỳ can thiệp
                        </div>
                    </div>

                    <!-- VÙNG NỘI DUNG CHI TIẾT BÁO CÁO -->
                    <div id="baocao_detail_container">
                        <t t-if="not data.get('has_plan')">
                            <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 10px; padding: 20px; text-align: center; color: #B45309; margin: 15px 0;">
                                <i class="fa fa-circle-exclamation me-1"/> Học sinh hiện tại chưa có kế hoạch can thiệp nào đã kết thúc để trích xuất báo cáo.
                            </div>
                        </t>
                        <t t-else="">
                            <!-- Thông tin kỳ can thiệp -->
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <span class="text-muted">
                                    <strong>Kỳ can thiệp:</strong> <span t-out="tab1.get('ten', '')"/>
                                    <t t-if="tab1.get('thoigian')">
                                        (<span t-out="tab1.get('thoigian')"/>)
                                    </t>
                                </span>
                            </div>

                            <!-- 4 Khối Chỉ Số KPI -->
                            <table style="width: 100%; border-collapse: separate; border-spacing: 8px 0; margin-bottom: 16px;">
                                <tr>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #2563EB; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Tổng mục tiêu kế hoạch</div>
                                        <div style="font-size: 17px; font-weight: 800; color: #1D4ED8; margin: 2px 0;">
                                            <span t-out="tab1.get('tong_muctieu', 0)"/> mục tiêu
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Kỳ kế hoạch đã đóng</div>
                                    </td>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #0D9488; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Kết quả đạt được</div>
                                        <div style="font-size: 17px; font-weight: 800; color: #15803D; margin: 2px 0;">
                                            <span t-out="tab1.get('tong_muctieu_dat', 0)"/> / <span t-out="tab1.get('tong_muctieu', 0)"/> mục tiêu
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Tỷ lệ hoàn thành: <strong><span t-out="tab1.get('tyle_dat', 0)"/>% KH tháng</strong></div>
                                    </td>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #E11D48; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Điểm trũng cần ưu tiên</div>
                                        <div style="font-size: 12px; font-weight: 800; color: #DC2626; margin: 4px 0;">
                                            <span t-out="tab1.get('diem_trung', 'Chưa có')"/>
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Lĩnh vực tỷ lệ đạt thấp nhất</div>
                                    </td>
                                    <td style="width: 25%; background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #D97706; border-radius: 8px; padding: 10px 12px;">
                                        <div style="font-size: 9px; font-weight: bold; text-transform: uppercase; color: #64748B;">Lĩnh vực bứt phá nhất</div>
                                        <div style="font-size: 12px; font-weight: 800; color: #B45309; margin: 4px 0;">
                                            <span t-out="tab1.get('but_pha', 'Chưa có')"/>
                                        </div>
                                        <div style="font-size: 10px; color: #475569;">Lĩnh vực tỷ lệ đạt cao nhất</div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Sơ đồ đối chiếu tiến bộ lâm sàng (SVG Line Chart) -->
                            <div class="mb-3" style="background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 10px; padding: 14px 18px;">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <div style="font-size: 13px; font-weight: 800; color: #1E293B;">
                                        <i class="fa fa-chart-line text-primary me-1.5"/>
                                        <span>Sơ đồ đối chiếu tiến bộ lâm sàng (Baseline vs <t t-out="tab1.get('ten', '')"/>)</span>
                                    </div>
                                    <div style="font-size: 11px; font-weight: 700; color: #64748B;">Mức đạt chuẩn từ 80% trở lên</div>
                                </div>

                                <div class="d-flex justify-content-center align-items-center gap-4 mb-2" style="font-size: 11px; font-weight: 700;">
                                    <div class="d-flex align-items-center gap-1.5" style="color: #64748B;">
                                        <svg width="24" height="12">
                                            <line x1="0" y1="6" x2="24" y2="6" stroke="#64748B" stroke-width="2.5" stroke-dasharray="3,3"/>
                                            <polygon points="12,2 16,6 12,10 8,6" fill="#FFFFFF" stroke="#64748B" stroke-width="1.5"/>
                                        </svg>
                                        <span>Đánh giá ban đầu (Baseline)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1.5" style="color: #DC2626;">
                                        <svg width="24" height="12">
                                            <line x1="0" y1="6" x2="24" y2="6" stroke="#DC2626" stroke-width="2.5"/>
                                            <circle cx="12" cy="6" r="4" fill="#DC2626"/>
                                        </svg>
                                        <span>Đánh giá sau can thiệp (<t t-out="tab1.get('ten', '')"/>)</span>
                                    </div>
                                </div>

                                <div style="width: 100%; overflow-x: auto;">
                                    <svg viewBox="0 0 900 250" style="width: 100%; height: auto; display: block; font-family: sans-serif;">
                                        <line x1="50" y1="22" x2="860" y2="22" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="26" font-size="10" fill="#94A3B8" text-anchor="end">110%</text>
                                        <line x1="50" y1="35" x2="860" y2="35" stroke="#E2E8F0" stroke-width="1"/><text x="42" y="39" font-size="10" fill="#94A3B8" text-anchor="end">100%</text>
                                        <line x1="50" y1="61" x2="860" y2="61" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="2,2"/><text x="42" y="65" font-size="10" fill="#64748B" font-weight="bold" text-anchor="end">80%</text>
                                        <line x1="50" y1="87" x2="860" y2="87" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="91" font-size="10" fill="#94A3B8" text-anchor="end">60%</text>
                                        <line x1="50" y1="113" x2="860" y2="113" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="117" font-size="10" fill="#94A3B8" text-anchor="end">40%</text>
                                        <line x1="50" y1="139" x2="860" y2="139" stroke="#F1F5F9" stroke-width="1"/><text x="42" y="143" font-size="10" fill="#94A3B8" text-anchor="end">20%</text>
                                        <line x1="50" y1="165" x2="860" y2="165" stroke="#CBD5E1" stroke-width="1.5"/><text x="42" y="169" font-size="10" fill="#94A3B8" text-anchor="end">0%</text>

                                        <t t-if="chart.get('polygon_dat')">
                                            <polygon t-att-points="chart['polygon_dat']" fill="#FEE2E2" opacity="0.45"/>
                                        </t>
                                        <t t-if="chart.get('points_thu')">
                                            <polyline t-att-points="chart['points_thu']" fill="none" stroke="#64748B" stroke-width="2.5" stroke-dasharray="4,4"/>
                                        </t>
                                        <t t-if="chart.get('points_dat')">
                                            <polyline t-att-points="chart['points_dat']" fill="none" stroke="#DC2626" stroke-width="3"/>
                                        </t>

                                        <t t-foreach="chart.get('items', [])" t-as="pt">
                                            <polygon t-attf-points="#{pt['x']},#{pt['y_thu'] - 5} #{pt['x'] + 5},#{pt['y_thu']} #{pt['x']},#{pt['y_thu'] + 5} #{pt['x'] - 5},#{pt['y_thu']}" fill="#FFFFFF" stroke="#64748B" stroke-width="1.8"/>
                                            <text t-att-x="pt['x']" t-att-y="pt['y_thu'] - 8" font-size="9.5" fill="#475569" font-weight="bold" text-anchor="middle"><t t-out="pt['tyle_thu']"/>%</text>
                                            <circle t-att-cx="pt['x']" t-att-cy="pt['y_dat']" r="5.5" fill="#DC2626" stroke="#FFFFFF" stroke-width="2"/>
                                            <text t-att-x="pt['x']" t-att-y="pt['y_dat'] - 9" font-size="10.5" fill="#B91C1C" font-weight="800" text-anchor="middle"><t t-out="pt['tyle_dat']"/>%</text>

                                            <text t-att-x="pt['x']" y="185" font-size="9.5" font-weight="700" fill="#334155" text-anchor="middle">
                                                <t t-foreach="pt.get('lines', [])" t-as="line">
                                                    <tspan t-att-x="pt['x']" t-att-dy="line_index == 0 and '0' or '11'"><t t-out="line"/></tspan>
                                                </t>
                                            </text>
                                        </t>
                                    </svg>
                                </div>
                            </div>

                            <!-- Bảng mục tiêu phân nhóm theo Lĩnh vực (CÓ CỘT MỨC ĐỘ) -->
                            <div style="font-size: 13px; font-weight: 800; color: #1E3A8A; margin-bottom: 8px; border-bottom: 1.5px solid #CBD5E1; padding-bottom: 4px;">
                                I. Chi tiết mức độ ban đầu và kết quả can thiệp
                            </div>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: 11px; background: #FFFFFF;">
                                <thead>
                                    <tr style="background: #F1F5F9; color: #334155; text-transform: uppercase;">
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 4%; text-align: center;">STT</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 10px; width: 44%; text-align: left;">Mục tiêu can thiệp</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 11%; text-align: center;">Trước CT (Baseline)</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 10%; text-align: center;">Sau CT (Kết quả)</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 6px; width: 11%; text-align: center;">Mức độ</th>
                                        <th style="border: 1px solid #CBD5E1; padding: 7px 10px; width: 20%; text-align: left;">Ý kiến / Định hướng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="tab1.get('linhvucs_grouped', [])" t-as="grp">
                                        <tr style="background-color: #F8FAFC; border-top: 2px solid #94A3B8; border-bottom: 1px solid #CBD5E1;">
                                            <td colspan="6" style="padding: 7px 12px;">
                                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                                    <div style="display: flex; align-items: center; gap: 8px;">
                                                        <i class="fa fa-folder-open text-primary" style="font-size: 13px;"/>
                                                        <span style="font-size: 12px; font-weight: 800; color: #1E3A8A; text-transform: uppercase;"><t t-out="grp['linhvuc']"/></span>
                                                        <t t-if="grp['tuoi']"><span class="badge" style="background-color: #E2E8F0; color: #334155; font-size: 10px; padding: 3px 7px; border-radius: 4px; font-weight: bold;"><t t-out="grp['tuoi']"/></span></t>
                                                        <span style="font-size: 10.5px; color: #64748B;">(<t t-out="grp['total_mt']"/> mục tiêu)</span>
                                                    </div>
                                                    <div style="font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                                                        <span style="color: #64748B;">Baseline: <strong><t t-out="grp['avg_thu']"/>%</strong></span>
                                                        <span style="color: #CBD5E1;">|</span>
                                                        <span t-attf-style="color: #{'#15803D' if grp['avg_dat'] &gt;= 80 else '#DC2626'};">Đạt TB: <strong><t t-out="grp['avg_dat']"/>%</strong></span>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        <t t-foreach="grp['targets']" t-as="mt">
                                            <tr t-attf-style="background-color: #{'#FFFFFF' if mt.get('muc_do') == 'Củng cố' else '#FFFDF5'};">
                                                <td style="border: 1px solid #E2E8F0; padding: 6px; text-align: center; color: #64748B;"><span t-out="mt.get('stt')"/></td>
                                                <td style="border: 1px solid #E2E8F0; padding: 6px 10px; font-weight: 500; color: #0F172A; line-height: 1.4;"><span t-out="mt.get('muctieu')"/></td>
                                                <td style="border: 1px solid #E2E8F0; padding: 6px; text-align: center; color: #475569;"><span t-out="mt.get('truoc')"/></td>
                                                <td style="border: 1px solid #E2E8F0; padding: 6px; text-align: center; font-weight: bold;">
                                                    <span t-attf-style="display: inline-block; min-width: 44px; padding: 2px 6px; border-radius: 4px; background-color: #{'#DCFCE7' if mt.get('sau') &gt;= 80 else '#FEF3C7'}; color: #{'#15803D' if mt.get('sau') &gt;= 80 else '#B45309'}; border: 1px solid #{'#BBF7D0' if mt.get('sau') &gt;= 80 else '#FDE68A'};">
                                                        <span t-out="mt.get('sau')"/>%
                                                    </span>
                                                </td>
                                                <!-- CỘT MỨC ĐỘ -->
                                                <td style="border: 1px solid #E2E8F0; padding: 6px; text-align: center; font-weight: 700;">
                                                    <span t-if="mt.get('muc_do') == 'Củng cố'"
                                                          style="display: inline-block; padding: 2px 8px; border-radius: 4px; background-color: #DCFCE7; color: #15803D; border: 1px solid #BBF7D0; font-size: 10px;">
                                                        Củng cố
                                                    </span>
                                                    <span t-else=""
                                                          style="display: inline-block; padding: 2px 8px; border-radius: 4px; background-color: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; font-size: 10px;">
                                                        Duy trì
                                                    </span>
                                                </td>
                                                <!-- Ý KIẾN / ĐỊNH HƯỚNG TỪ DINHHUONG_KIEMDUYET -->
                                                <td style="border: 1px solid #E2E8F0; padding: 6px 10px; color: #334155;">
                                                    <span t-out="mt.get('dinh_huong')"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Nhận xét cuối kỳ -->
                            <div style="font-size: 13px; font-weight: 800; color: #1E3A8A; margin-bottom: 6px;">II. Nhận xét đánh giá của giáo viên</div>
                            <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-left: 4px solid #2563EB; border-radius: 6px; padding: 10px 14px; margin-bottom: 24px; font-size: 11px; line-height: 1.55; color: #334155;">
                                <span t-out="tab1.get('nhan_xet', '')"/>
                            </div>

                            <!-- Chữ ký ba bên -->
                            <table style="width: 100%; text-align: center; border-collapse: collapse; margin-top: 15px; margin-bottom: 25px;">
                                <tr>
                                    <td style="width: 33.33%; vertical-align: top;">
                                        <div style="font-size: 10.5px; font-weight: bold; text-transform: uppercase; color: #64748B; margin-bottom: 45px;">Giáo viên phụ trách</div>
                                        <div style="font-size: 12.5px; font-weight: 800; color: #0F172A;"><span t-out="tab1.get('giaovien', '')"/></div>
                                    </td>
                                    <td style="width: 33.33%; vertical-align: top;">
                                        <div style="font-size: 10.5px; font-weight: bold; text-transform: uppercase; color: #64748B; margin-bottom: 45px;">Quản lý chuyên môn</div>
                                        <div style="font-size: 12.5px; font-weight: 800; color: #0F172A;"><span t-out="tab1.get('quanly', '')"/></div>
                                    </td>
                                    <td style="width: 33.33%; vertical-align: top;">
                                        <div style="font-size: 10.5px; font-weight: bold; text-transform: uppercase; color: #64748B; margin-bottom: 45px;">Đại diện Phụ huynh</div>
                                        <div style="font-size: 12.5px; font-weight: 800; color: #0F172A;"><span t-out="hs.get('phuhuynh', '')"/></div>
                                    </td>
                                </tr>
                            </table>
                        </t>
                    </div>

                    <!-- SCRIPT ĐIỀU HƯỚNG URL KHI CHỌN KỲ BÁO CÁO (ĐƯỢC BỌC CDATA) -->
                    <script type="text/javascript">
                        <![CDATA[
                        function onChangeKyBaoCao(selectEl) {
                            const kehoachId = selectEl.value;
                            if (!kehoachId) return;

                            const url = new URL(window.location.href);
                            url.searchParams.set('kehoach_id', kehoachId);
                            window.location.href = url.toString();
                        }
                        ]]>
                    </script>

                </div>
            </t>
        </t>
    </template>
</odoo>
