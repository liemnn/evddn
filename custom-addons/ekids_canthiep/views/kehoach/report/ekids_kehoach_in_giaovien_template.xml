<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ekids_canthiep.in_kehoach_cho_giaovien_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">
                 <div class="btn-print-container" style="text-align:right; margin-bottom: 15px;">
                    <button onclick="window.print()"
                            style="width:30px; height:auto; border:0px; background:transparent;"
                            title="In báo cáo" type="button">
                        <i class="fa fa-print" style="font-size: 18px; color: #555;"></i>
                    </button>
                    <button t-att-data-url="o.share_full_url"
                            style="width:30px; height:auto;border:0px"
                            onclick="navigator.clipboard.writeText(this.dataset.url); alert('Đã copy link để chia sẻ [Kế hoạch]!')">
                        <i class="fa fa-copy"></i>
                    </button>
                </div>
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">

                    <style>
                        /* 1. THIẾT LẬP IN FULL TOÀN BỘ TRANG GIẤY KHÔNG CĂN LỀ */
                        @page {
                            size: A4 landscape;
                            margin: 5mm !important;
                        }

                        * { box-sizing: border-box; margin: 0; padding: 0; }

                        .o_compact_print_body {
                            font-family: 'Times New Roman', Times, serif !important;
                            color: #000000;
                            font-size: 13px;
                            line-height: 1.4;
                            width: 100%;
                            padding: 4mm !important;
                        }

                        /* Khối Header trên cùng (Logo  Tiêu đề) */
                        .header-main-table { width: 100%; margin-bottom: 12px; }
                        .header-main-table td {padding: 6px 10px; vertical-align: middle; }
                        .top-logo-area { width: 45%; text-align: left; font-size: 13px; font-weight: bold; }
                        .top-title-area { width: 55%; text-align: center; }
                        .top-main-title { font-size: 16px; font-weight: bold; text-transform: uppercase; }
                        .top-sub-title { font-size: 13px; font-style: italic; margin-top: 2px; }

                        /* STYLE MA TRẬN BẢNG PROFILE HỢP NHẤT */
                        .profile-grid-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; table-layout: fixed; }
                        .profile-grid-table td { border: 1px solid #000000; padding: 5px 6px; font-size: 14px; vertical-align: middle; color: #000000; }

                        .col-lbl-left  { width: 11%; font-weight: bold; }
                        .col-val-left  { width: 22%; }
                        .col-stt       { width: 3% !important; text-align: center; font-weight: bold; padding: 5px 2px !important; }
                        .col-linhvuc   { width: 25%; }
                        .col-val-right { width: 39%; font-style: italic; text-align: center; }

                        /* Khối container mục tiêu */
                        .print-container {
                            width: 100%;
                            border: 1px solid #000000;
                            padding: 12px;
                            margin-bottom: 14px;
                            page-break-before: always;
                            page-break-inside: avoid;
                        }

                        .print-title-section { display: table; width: 100%; border-bottom: 1.5px solid #000000; padding-bottom: 4px; margin-bottom: 8px; }
                        .print-main-title { display: table-cell; width: 55%; font-size: 14px; font-weight: bold; vertical-align: bottom; text-align: left; }

                        /* Style định dạng cho phần ghi chú hiển thị dưới tên mục tiêu */
                        .goal-note-text {
                            font-size: 13px;
                            font-weight: normal;
                            font-style: italic;
                            color: #475569;
                            margin-top: 4px;
                            display: block;
                        }

                        .print-meta-text { display: table-cell; width: 45%; font-size: 13px; vertical-align: bottom; text-align: right; color: #334155; }

                        .top-row-grid { display: table; width: 100%; border-bottom: 1px solid #000000; padding-bottom: 8px; margin-bottom: 8px; }
                        .left-sub-block { display: table-cell; width: 50%; padding-right: 12px; border-right: 1px dashed #000000; vertical-align: top !important; }
                        .right-sub-block { display: table-cell; width: 50%; padding-left: 12px; vertical-align: top !important; }

                        .section-header-title { font-size: 11px; font-weight: bold; text-transform: uppercase; text-decoration: underline; margin-bottom: 4px; }
                        .criteria-table { width: 100%; border-collapse: collapse; }
                        .criteria-table th, .criteria-table td { border: 1px solid #000000; padding: 5px; font-size: 13px; vertical-align: top !important; }
                        .criteria-table th { background-color: #f2f2f2; font-weight: bold; }

                        /* ĐƯỜNG CHIA TUYỆT ĐỐI CHO HÀNG BAO QUANH PHẦN THIẾT KẾ ABC */
                        .bottom-row-grid { width: 100%; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid #000000; }
                        .abc-procedure-content { width: 100%; text-align: justify; }

                        /* 🌟 RE-DESIGN: Khối Theo dõi chạy phẳng hàng ngang rộng rãi trọn biên dưới */
                        .tracking-diary-content {
                            width: 100%;
                            margin-top: 8px;
                            display: flex;
                            flex-direction: column;
                            gap: 6px;
                        }

                        /* Layout Flexbox ngang cho dải ô vuông */
                        .day-boxes-horizontal-flow {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 4px;
                            width: 100%;
                        }

                        .text-paragraph { margin-bottom: 4px; font-size: 13px; }

                        /* Ô TIẾN TRÌNH VUÔNG VẮN KHÔNG BỊ BÓP MÉO */
                        .day-tracking-box {
                            width: 32px;
                            height: 34px;
                            border: 1px solid #000000;
                            border-radius: 4px;
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                            align-items: center;
                            background-color: #ffffff;
                            overflow: hidden;
                        }

                        .cell-number {
                            font-size: 9px;
                            font-weight: bold;
                            color: #1e293b;
                            display: block;
                            line-height: 1.2;
                            background-color: #f1f5f9;
                            border-bottom: 1px solid #e2e8f0;
                            padding: 1px 0;
                            width: 100%;
                            text-align: center;
                        }

                        .cell-write-space {
                            height: 20px;
                            width: 100%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 14px;
                            font-weight: bold;
                            color: #000000;
                        }

                        /* Lớp bôi xám nền cho ngày nghỉ, tương lai hoặc vắng */
                        .box-print-rest {
                            background-color: #f1f5f9 !important;
                        }
                        .box-print-rest .cell-number {
                            background-color: #e2e8f0 !important;
                            color: #475569 !important;
                        }
                        .box-print-rest .cell-write-space {
                            color: #64748b !important;
                            font-size: 10px !important;
                            font-weight: 800 !important;
                        }

                        .text-bold { font-weight: bold; }

                        @media print {
                            .btn-print-container { display: none !important; }
                            .day-tracking-box { border: 1px solid #000000 !important; }
                            .box-print-rest { background-color: #f1f5f9 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                        }
                    </style>

                    <div class="o_compact_print_body">

                        <table class="header-main-table">
                            <tr>
                                <td>
                                    <t t-if="o.coso_id and o.coso_id.logo">
                                       <span t-field="o.coso_id.logo" t-options="{'widget': 'image', 'style': 'max-height: 55px; max-width: 100%; display: block; margin-bottom: 5px;'}"/>
                                    </t>
                                    <t t-if="not (o.coso_id and o.coso_id.logo)">
                                        <div style="display: inline-block; width: 55px; height: 30px; border: 1px dashed #000; text-align: center; line-height: 30px; font-weight: bold; font-size: 11px; margin-bottom: 5px;">LOGO</div>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="o.coso_id and o.coso_id.header_thu_hocphi">
                                        <span t-out="o.coso_id.header_thu_hocphi"/>
                                    </t>
                                    <t t-if="not (o.coso_id and o.coso_id.header_thu_hocphi)">
                                        SỞ GIÁO DỤC VÀ ĐÀO TẠO TỈNH BẮC NINH<br/>
                                        TRUNG TÂM HTGD HÒA NHẬP TỪ SƠN
                                    </t>
                                </td>
                                <td class="top-title-area">
                                    <div class="top-main-title">KẾ HOẠCH CAN THIỆP CÁ NHÂN THÁNG</div>
                                    <div class="top-main-title" style="font-size: 17px; margin-top: 3px;"><span t-field="o.name"/></div>
                                    <div class="top-sub-title">
                                        (Từ ngày <span t-field="o.tu_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                        đến ngày <span t-field="o.den_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>)
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <t t-set="lv_list" t-value="o.kehoach_linhvuc_ids"/>
                        <t t-set="total_lv" t-value="len(lv_list)"/>
                        <t t-set="max_rows" t-value="total_lv if total_lv &gt; 8 else 8"/>

                        <table class="profile-grid-table">
                            <tr>
                                <td class="col-lbl-left">Họ và tên HS:</td>
                                <td class="col-val-left text-bold"><span t-field="o.hocsinh_id.name"/></td>
                                <td colspan="4" style="font-weight: bold; text-align: center; font-size: 13px; background-color: #ffffff; text-transform: uppercase;">
                                    LĨNH VỰC CAN THIỆP
                                </td>
                            </tr>

                            <t t-foreach="range(max_rows)" t-as="idx">
                                <t t-set="current_lv" t-value="lv_list[idx] if idx &lt; total_lv else False"/>
                                <tr>
                                    <t t-if="idx == 0">
                                        <td class="col-lbl-left">Tuổi thực tế:</td>
                                        <td class="col-val-left"><span t-field="o.hocsinh_id.tuoi"/></td>
                                    </t>
                                    <t t-if="idx == 1">
                                        <td class="col-lbl-left">Giới tính:</td>
                                        <td class="col-val-left"><span t-field="o.hocsinh_id.gioitinh"/></td>
                                    </t>
                                    <t t-if="idx == 2">
                                        <td class="col-lbl-left">Ngày sinh:</td>
                                        <td class="col-val-left"><span t-field="o.hocsinh_id.ngaysinh" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                                    </t>
                                    <t t-if="idx == 3">
                                        <td class="col-lbl-left">Liều lượng CT:</td>
                                        <td class="col-val-left"><span t-field="o.ketluan_id.dm_lieuluong_id"/></td>
                                    </t>
                                    <t t-if="idx == 4">
                                        <td class="col-lbl-left" rowspan="2">Dạng rối loạn:</td>
                                        <td class="col-val-left" rowspan="2"><span t-out="', '.join(o.ketluan_id.dm_roiloan_ids.mapped('name')) if o.ketluan_id.dm_roiloan_ids else ''"/></td>
                                    </t>
                                    <t t-if="idx == 5">
                                        </t>
                                    <t t-if="idx == 6">
                                        <td class="col-lbl-left">Mức độ:</td>
                                        <td class="col-val-left"><span t-field="o.ketluan_id.dm_mucdo_id"/></td>
                                    </t>
                                    <t t-if="idx == 7">
                                        <td class="col-lbl-left">Hình thức CT:</td>
                                        <td class="col-val-left">Bán trú / Cá nhân 1/1</td>
                                    </t>
                                    <t t-if="idx &gt; 7">
                                        <td class="col-lbl-left" style="background:#ffffff;"></td>
                                        <td class="col-val-left" style="background:#ffffff;"></td>
                                    </t>

                                    <td class="col-linhvuc" colspan="2">
                                        <span t-if="current_lv" t-field="current_lv.linhvuc_id.name"/>
                                        <span t-if="not current_lv">....</span>
                                    </td>
                                    <td class="col-linhvuc" colspan="2">
                                        <span t-if="current_lv" t-field="current_lv.tuoi_id.name"/>
                                        <span t-if="not current_lv">...</span>
                                    </td>
                                </tr>
                            </t>

                            <tr>
                                <td class="col-lbl-left">Chương trình chính:</td>
                                <td colspan="5" class="text-bold">
                                    <span t-out="o.with_context(lang='vi_VN').ketluan_id.chuongtrinh if o.ketluan_id and o.ketluan_id.chuongtrinh else 'CHƯƠNG TRÌNH CAN THIỆP TOÀN DIỆN TỪ SƠN DÀNH CHO TRẺ RỐI LẠN PHÁT TRIỂN'"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Quản lý chuyên môn:</td>
                                <td class="col-val-left"><span t-field="o.gv_kiemduyet_id.name"/></td>
                                <td class="col-lbl-left" style="text-align:right;" colspan="2">Giáo viên dạy:</td>
                                <td colspan="2" class="text-bold"><span t-field="o.gv_lapkehoach_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Tâm lý hành vi:</td>
                                <td colspan="5">
                                    - Điều trẻ thích: .........................................................................................<br/>
                                    - Điều trẻ sợ: ............................................................................................
                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Lưu ý về sức khoẻ thể chất:</td>
                                <td colspan="5">
                                    .........................................................................................................
                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Ghi chú:</td>
                                <td colspan="5">Luôn trợ giúp/làm mẫu hướng dẫn trẻ thực hiện và giảm dần gợi nhắc để trẻ tự thực hiện, khái quát hóa trong cuộc sống của trẻ.</td>
                            </tr>
                        </table>

                        <t t-foreach="o.kehoach_linhvuc_ids" t-as="lv">
                            <t t-foreach="lv.kehoach_muctieu_ids" t-as="muctieu">

                                <div class="print-container">

                                    <div class="print-title-section">
                                        <div class="print-main-title">
                                            Mục tiêu <span t-out="muctieu_index + 1"/>: <span t-field="muctieu.muctieu_id.name"/>
                                            <t t-if="muctieu.ghichu">
                                                <span class="goal-note-text">Ghi chú: <span t-field="muctieu.ghichu"/></span>
                                            </t>
                                        </div>
                                        <div class="print-meta-text">
                                            Lĩnh vực: <span t-field="lv.linhvuc_id.name"/> |
                                            Tuổi: <span t-field="lv.tuoi_id.name"/> |
                                            Chương trình: <span t-field="lv.chuongtrinh_id.name"/>
                                        </div>
                                    </div>

                                    <!-- KHỐI I VÀ II -->
                                    <div class="top-row-grid">
                                        <div class="left-sub-block">
                                            <div class="section-header-title">I. Chức năng phát triển cốt lõi và Lập luận lâm sàng</div>
                                            <div class="text-paragraph"><span t-raw="muctieu.chucnang"/></div>
                                        </div>

                                        <div class="right-sub-block">
                                            <div class="section-header-title">II. Tiêu chí đánh giá mức độ thành thục</div>
                                            <table class="criteria-table">
                                                <thead>
                                                    <tr>
                                                         <th style="width: 33.33%;">CHƯA ĐẠT (-)</th>
                                                         <th style="width: 33.33%;">ĐANG HÌNH THÀNH (+/-)</th>
                                                         <th style="width: 33.33%;">ĐẠT (+)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><span t-raw="muctieu.tieuchi_chuadat"/></td>
                                                        <td><span t-raw="muctieu.tieuchi_hinhthanh"/></td>
                                                        <td><span t-raw="muctieu.tieuchi_dat"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- KHỐI III: CHẠY NGANG HÀNG TÁCH BIỆT -->
                                    <div class="bottom-row-grid">
                                        <div class="abc-procedure-content">
                                            <div class="section-header-title">III. Thiết kế hoạt động cho giáo viên theo mô tả (ABC)</div>
                                            <div class="text-paragraph"><span t-raw="muctieu.thietke"/></div>
                                        </div>
                                    </div>

                                    <!-- 🌟 KHỐI IV: ĐÃ ĐẨY XUỐNG DÒNG RIÊNG BIỆT DÀNH TRỌN 100% CHIỀU NGANG -->
                                    <div class="tracking-diary-content">
                                        <div class="section-header-title" style="margin-bottom: 2px;">IV. Theo dõi</div>

                                        <div class="day-boxes-horizontal-flow">

                                            <!-- TRƯỜNG HỢP 1: ĐÃ KHỞI TẠO DỮ LIỆU CAN THIỆP THỰC TẾ -->
                                            <t t-if="muctieu.ketqua2muctieu_ids">
                                                <t t-foreach="muctieu.ketqua2muctieu_ids" t-as="kq">

                                                    <t t-set="is_future_status" t-value="kq.is_date_status == '1'"/>
                                                    <t t-set="should_be_gray" t-value="kq.loai in ['0', '-1'] or is_future_status"/>

                                                    <div t-attf-class="day-tracking-box #{should_be_gray and 'box-print-rest' or ''}">
                                                        <span class="cell-number">
                                                            <span t-field="kq.ngay" t-options="{'widget': 'date', 'format': 'dd/MM'}"/>
                                                        </span>

                                                        <div class="cell-write-space">
                                                            <t t-if="is_future_status"></t>
                                                            <t t-else="">
                                                                <t t-if="kq.loai == '-1'">N</t>
                                                                <t t-elif="kq.loai == '0'"></t>
                                                                <t t-else="">
                                                                    <t t-if="kq.trangthai == '1'">+</t>
                                                                    <t t-if="kq.trangthai == '2'">+/-</t>
                                                                    <t t-if="kq.trangthai == '-1'">-</t>
                                                                    <t t-if="kq.trangthai == '0' or not kq.trangthai"></t>
                                                                </t>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </t>

                                            <!-- TRƯỜNG HỢP 2: FALLBACK KHI CHƯA KHỞI TẠO KẾT QUẢ CAN THIỆP -->
                                            <t t-else="">
                                                <t t-set="total_days" t-value="int(o.songay or 30)"/>
                                                <t t-foreach="range(total_days)" t-as="day_idx">
                                                    <t t-set="computed_date" t-value="o.tu_ngay + datetime.timedelta(days=day_idx)"/>
                                                    <t t-set="is_fallback_sunday" t-value="computed_date.weekday() == 6"/>
                                                    <t t-set="is_fallback_future" t-value="computed_date &gt; datetime.date.today()"/>
                                                    <t t-set="should_fallback_gray" t-value="is_fallback_sunday or is_fallback_future"/>

                                                    <div t-attf-class="day-tracking-box #{should_fallback_gray and 'box-print-rest' or ''}">
                                                        <span class="cell-number">
                                                            <span t-out="computed_date.strftime('%d/%m')"/>
                                                        </span>
                                                        <div class="cell-write-space">
                                                            <t t-if="is_fallback_future"></t>
                                                            <t t-elif="is_fallback_sunday">N</t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </t>

                                        </div>

                                        <!-- Khối badge kết quả tổng kết biên dưới -->
                                        <div style="margin-top: 4px; padding-top: 4px; font-size: 13px; text-align: left; color: #1e293b;">
                                            <span class="text-bold">Kết quả can thiệp <span t-out="o.songay"/> của kế hoạch:
                                                Chưa đạt (-):<span class="text-bold text-danger" t-field="muctieu.ketqua_khongdat"/> ngày
                                               | Hình thành (+/-):<span class="text-bold text-warning" t-field="muctieu.ketqua_hinhthanh"/> ngày
                                               | Đạt(+):<span class="text-bold text-success" t-field="muctieu.ketqua_dat"/> ngày


                                            </span>
                                        </div>
                                    </div>
                                </div>

                            </t>
                        </t>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>