<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ekids_canthiep.in_kehoach_cho_giaovien_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">
                <div class="btn-print-container" style="text-align:right; margin-bottom: 15px;">
                    <button onclick="window.print()"
                            style="width:30px; height:auto; border:0px; background:transparent; cursor:pointer;"
                            title="In báo cáo" type="button">
                        <i class="fa fa-print" style="font-size: 20px; color: #333;"></i>
                    </button>
                    <button t-att-data-url="o.share_full_url"
                            style="width:30px; height:auto; border:0px; background:transparent; cursor:pointer;"
                            onclick="navigator.clipboard.writeText(this.dataset.url); alert('Đã copy link để chia sẻ [Kế hoạch]!')">
                        <i class="fa fa-copy" style="font-size: 18px; color: #333;"></i>
                    </button>
                </div>

                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">

                    <style>
                        @page {
                            size: A4 landscape;
                            margin: 5mm !important;
                        }

                        * {
                            box-sizing: border-box;
                            margin: 0;
                            padding: 0;
                            -webkit-print-color-adjust: exact;
                            print-color-adjust: exact;
                        }

                        .o_compact_print_body {
                            font-family: "Times New Roman", "Arial", serif !important;
                            color: #000000 !important;
                            font-size: 13.5px !important;
                            line-height: 1.25;
                            width: 100%;
                            padding: 2mm !important;
                        }

                        /* Header Profile Table */
                        .header-main-table { width: 100%; margin-bottom: 4px; }
                        .header-main-table td { padding: 2px 4px; vertical-align: middle; color: #000000 !important; font-size: 13.5px !important; }
                        .top-main-title { font-size: 16px !important; font-weight: bold !important; text-transform: uppercase; color: #000000 !important; }
                        .top-sub-title { font-size: 12px !important; font-style: italic; color: #000000 !important; }

                        .profile-grid-table { width: 100%; border-collapse: collapse; margin-bottom: 6px; table-layout: fixed; }
                        .profile-grid-table td { border: 1px solid #000000 !important; padding: 3px 5px; font-size: 12.5px !important; vertical-align: middle; color: #000000 !important; }

                        .col-lbl-left { width: 11%; font-weight: bold !important; background-color: #eeeeee !important; }
                        .col-val-left { width: 22%; }
                        .col-linhvuc  { width: 33.5%; }
                        .col-tuoi     { width: 33.5%; text-align: center; }

                        .print-container {
                            width: 100%;
                            border: 1px solid #000000 !important;
                            padding: 5px 7px;
                            margin-bottom: 6px;
                            page-break-inside: avoid !important;
                            background-color: #ffffff !important;
                        }

                        .print-title-section { display: table; width: 100%; border-bottom: 1px solid #000000 !important; padding-bottom: 2px; margin-bottom: 4px; }
                        .print-main-title { display: table-cell; width: 60%; font-size: 15px !important; vertical-align: bottom; text-align: left; color: #000000 !important; }

                        .goal-note-text {
                            font-size: 12.5px !important;
                            font-weight: normal !important;
                            font-style: italic;
                            color: #000000 !important;
                            display: block;
                        }

                        .print-meta-text { display: table-cell; width: 40%; font-size: 12px !important; vertical-align: bottom; text-align: right; color: #000000 !important; }

                        .top-row-grid { display: table; width: 100%; border-bottom: 1px dashed #000000 !important; padding-bottom: 4px; margin-bottom: 4px; }
                        .left-sub-block { display: table-cell; width: 50%; padding-right: 8px; border-right: 1px dashed #000000 !important; vertical-align: top !important; }
                        .right-sub-block { display: table-cell; width: 50%; padding-left: 8px; vertical-align: top !important; }

                        .section-header-title {
                            font-size: 13px !important;
                            font-weight: bold !important;
                            text-transform: uppercase;
                            text-decoration: underline;
                            margin-bottom: 2px;
                            color: #000000 !important;
                            page-break-after: avoid !important;
                        }

                        .text-paragraph {
                            margin-bottom: 2px;
                            font-size: 12.5px !important;
                            color: #000000 !important;
                        }

                        .criteria-table { width: 100%; border-collapse: collapse; page-break-inside: avoid !important; }
                        .criteria-table th, .criteria-table td { border: 1px solid #000000 !important; padding: 3px; font-size: 11.5px !important; vertical-align: top !important; color: #000000 !important; }
                        .criteria-table th { background-color: #eeeeee !important; font-weight: bold !important; }

                        .bottom-row-grid {
                            width: 100%;
                            margin-bottom: 4px;
                            padding-bottom: 3px;
                            border-bottom: 1px dashed #000000 !important;
                        }

                        .abc-procedure-content { width: 100%; text-align: justify; }

                        .tracking-diary-content {
                            width: 100%;
                            margin-top: 3px;
                            display: flex;
                            flex-direction: column;
                            gap: 2px;
                            page-break-inside: avoid !important;
                        }

                        .day-boxes-horizontal-flow {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 2px;
                            width: 100%;
                        }

                        /* 🌟 Ô THEO DÕI IN ẤN 3 TẦNG: NGÀY - SỐ ĐẠT - TỶ LỆ % */
                        .day-tracking-box-print {
                            width: 27px;
                            height: 46px;
                            border: 1px solid #000000 !important;
                            border-radius: 2px;
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                            align-items: center;
                            background-color: #ffffff !important;
                            overflow: hidden;
                        }

                        .cell-print-date {
                            font-size: 9px !important;
                            font-weight: bold !important;
                            color: #000000 !important;
                            line-height: 14px;
                            background-color: #f0f0f0 !important;
                            border-bottom: 1px solid #000000 !important;
                            width: 100%;
                            text-align: center;
                            height: 14px;
                        }

                        .cell-print-val {
                            height: 18px;
                            width: 100%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 12px !important;
                            font-weight: bold !important;
                            color: #000000 !important;
                            border-bottom: 1px dotted #000000 !important;
                        }

                        .cell-print-rate {
                            height: 13px;
                            width: 100%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 8.5px !important;
                            font-weight: bold !important;
                            color: #000000 !important;
                            line-height: 1;
                        }

                        /* Ô ngày nghỉ / Tương lai */
                        .box-print-rest { background-color: #eeeeee !important; }
                        .box-print-rest .cell-print-date { background-color: #dddddd !important; }

                        .lbl-summary-chuadat, .lbl-summary-hinhthanh, .lbl-summary-dat { color: #000000 !important; font-weight: bold !important; font-size: 12.5px !important; }
                        .text-bold { font-weight: bold !important; }

                        @media print {
                            .btn-print-container { display: none !important; }
                            .print-container { border: 1px solid #000000 !important; }
                            .day-tracking-box-print { border: 1px solid #000000 !important; }
                            .box-print-rest { background-color: #eeeeee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                        }
                    </style>

                    <div class="o_compact_print_body">

                        <!-- BẢNG TIÊU ĐỀ TRÊN CÙNG -->
                        <table class="header-main-table">
                            <tr>
                                <td style="width: 15%;">
                                    <t t-if="o.coso_id and o.coso_id.logo">
                                       <span t-field="o.coso_id.logo" t-options="{'widget': 'image', 'style': 'max-height: 45px; max-width: 100%; display: block; margin-bottom: 2px;'}"/>
                                    </t>
                                    <t t-if="not (o.coso_id and o.coso_id.logo)">
                                        <div style="display: inline-block; width: 45px; height: 25px; border: 1px dashed #000; text-align: center; line-height: 25px; font-weight: bold; font-size: 10px; margin-bottom: 2px; color: #000000;">LOGO</div>
                                    </t>
                                </td>
                                <td style="width: 35%;">
                                    <t t-if="o.coso_id and o.coso_id.header_thu_hocphi">
                                        <span t-out="o.coso_id.header_thu_hocphi"/>
                                    </t>
                                    <t t-if="not (o.coso_id and o.coso_id.header_thu_hocphi)">
                                        SỞ GIÁO DỤC VÀ ĐÀO TẠO TỈNH BẮC NINH<br/>
                                        TRUNG TÂM HTGD HÒA NHẬP TỪ SƠN
                                    </t>
                                </td>
                                <td class="top-title-area" style="width: 50%; text-align: right;">
                                    <div class="top-main-title">KẾ HOẠCH CAN THIỆP CÁ NHÂN THÁNG</div>
                                    <div class="top-main-title" style="font-size: 14.5px; margin-top: 1px;"><span t-field="o.name"/></div>
                                    <div class="top-sub-title">
                                        (Từ ngày <span t-field="o.tu_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                        đến ngày <span t-field="o.den_ngay" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>)
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <t t-set="lv_list" t-value="o.kehoach_linhvuc_ids"/>
                        <t t-set="total_lv" t-value="len(lv_list)"/>
                        <t t-set="max_rows" t-value="total_lv if total_lv &gt; 7 else 7"/>

                        <table class="profile-grid-table">
                            <tr>
                                <td class="col-lbl-left">Họ và tên HS:</td>
                                <td class="col-val-left text-bold"><span t-field="o.hocsinh_id.name"/></td>
                                <td colspan="2" style="font-weight: bold; text-align: center; font-size: 13px; background-color: #eeeeee; text-transform: uppercase; color: #000000;">
                                    LĨNH VỰC CAN THIỆP
                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Tuổi thực tế:</td>
                                <td class="col-val-left"><span t-field="o.hocsinh_id.tuoi"/></td>
                                <td class="col-linhvuc" style="font-weight: bold !important; text-align: center; background-color: #f5f5f5 !important;">
                                    Lĩnh vực
                                </td>
                                <td class="col-tuoi" style="font-weight: bold !important; text-align: center; background-color: #f5f5f5 !important;">
                                    Độ tuổi phát triển tương ứng
                                </td>
                            </tr>

                            <t t-foreach="range(max_rows)" t-as="idx">
                                <t t-set="current_lv" t-value="lv_list[idx] if idx &lt; total_lv else False"/>
                                <tr>
                                    <t t-if="idx == 0">
                                        <td class="col-lbl-left">Giới tính:</td>
                                        <td class="col-val-left"><span t-field="o.hocsinh_id.gioitinh"/></td>
                                    </t>
                                    <t t-if="idx == 1">
                                        <td class="col-lbl-left">Ngày sinh:</td>
                                        <td class="col-val-left"><span t-field="o.hocsinh_id.ngaysinh" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                                    </t>
                                    <t t-if="idx == 2">
                                        <td class="col-lbl-left">Liều lượng CT:</td>
                                        <td class="col-val-left"><span t-field="o.ketluan_id.dm_lieuluong_id"/></td>
                                    </t>
                                    <t t-if="idx == 3">
                                        <td class="col-lbl-left" rowspan="2">Dạng rối loạn:</td>
                                        <td class="col-val-left" rowspan="2"><span t-out="', '.join(o.ketluan_id.dm_roiloan_ids.mapped('name')) if o.ketluan_id.dm_roiloan_ids else ''"/></td>
                                    </t>
                                    <t t-if="idx == 4">
                                    </t>
                                    <t t-if="idx == 5">
                                        <td class="col-lbl-left">Mức độ:</td>
                                        <td class="col-val-left"><span t-field="o.ketluan_id.dm_mucdo_id"/></td>
                                    </t>
                                    <t t-if="idx == 6">
                                        <td class="col-lbl-left">Hình thức CT:</td>
                                        <td class="col-val-left">Bán trú / Cá nhân 1/1</td>
                                    </t>
                                    <t t-if="idx &gt; 6">
                                        <td class="col-lbl-left" style="background:#ffffff;"></td>
                                        <td class="col-val-left" style="background:#ffffff;"></td>
                                    </t>

                                    <td class="col-linhvuc">
                                        <span t-if="current_lv" t-field="current_lv.linhvuc_id.name"/>
                                        <span t-if="not current_lv">....</span>
                                    </td>
                                    <td class="col-tuoi">
                                        <span t-if="current_lv" t-field="current_lv.tuoi_id.name"/>
                                        <span t-if="not current_lv">...</span>
                                    </td>
                                </tr>
                            </t>

                            <tr>
                                <td class="col-lbl-left">Chương trình chính:</td>
                                <td colspan="3" class="text-bold">
                                    <span t-out="o.with_context(lang='vi_VN').ketluan_id.chuongtrinh if o.ketluan_id and o.ketluan_id.chuongtrinh else 'CHƯƠNG TRÌNH CAN THIỆP TOÀN DIỆN TỪ SƠN DÀNH CHO TRẺ RỐI LẠN PHÁT TRIỂN'"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Quản lý chuyên môn:</td>
                                <td class="col-val-left"><span t-field="o.gv_kiemduyet_id.name"/></td>
                                <td class="col-lbl-left" style="text-align:right;">Giáo viên dạy:</td>
                                <td class="text-bold"><span t-field="o.gv_lapkehoach_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Tâm lý và hành vi:</td>
                                <td colspan="3">
                                    - Điều trẻ thích: .........................................................................................<br/>
                                    - Điều trẻ sợ: ............................................................................................
                                </td>
                            </tr>
                            <tr>
                                <td class="col-lbl-left">Lưu ý</td>
                                <td colspan="3">
                                    <span t-field="o.ketluan_id.desc"/>
                                </td>
                            </tr>
                        </table>

                        <!-- DANH SÁCH MỤC TIÊU VÀ LƯỚI THEO DÕI -->
                        <t t-foreach="o.kehoach_linhvuc_ids" t-as="lv">
                            <t t-foreach="lv.kehoach_muctieu_ids" t-as="muctieu">

                                <div class="print-container">

                                    <div class="print-title-section">
                                        <div class="print-main-title">
                                            <strong>Mục tiêu <span t-out="muctieu_index + 1"/>:</strong> <span t-field="muctieu.name"/>
                                            <t t-if="muctieu.ghichu">
                                                <span class="goal-note-text">Ghi chú: <span t-field="muctieu.ghichu"/></span>
                                            </t>
                                        </div>
                                        <div class="print-meta-text">
                                            Lĩnh vực: <span t-field="lv.linhvuc_id.name"/> |
                                            Tuổi: <span t-field="lv.tuoi_id.name"/> |
                                            Chương trình: <span t-field="lv.chuongtrinh_id.name"/>
                                        </div>
                                    </div>

                                    <!-- KHỐI I VÀ II -->
                                    <div class="top-row-grid">
                                        <div class="left-sub-block">
                                            <div class="section-header-title">I. Chức năng phát triển cốt lõi và Lập luận lâm sàng</div>
                                            <div class="text-paragraph"><span t-raw="muctieu.chucnang"/></div>
                                        </div>

                                        <div class="right-sub-block">
                                            <!-- 🌟 VÙNG NẰM RIÊNG PHÍA TRÊN TIÊU ĐỀ MỤC II -->
                                            <div style="font-size: 12.5px; margin-bottom: 3px; text-align: right; color: #000000;">
                                                <span style="font-weight: bold; background-color: #f5f5f5; border: 1px solid #000000; padding: 1px 6px; border-radius: 3px; display: inline-block;">
                                                    Dữ liệu ban đầu: Đạt (+)
                                                    <strong><span t-field="muctieu.solan_thu_dat"/></strong>/<strong><span t-field="muctieu.solan_thu"/></strong> lần
                                                    <t t-if="muctieu.tyle_thu">
                                                        (<strong><span t-field="muctieu.tyle_thu"/>%</strong>)
                                                    </t>
                                                </span>
                                            </div>

                                            <!-- TIÊU ĐỀ VÀ BẢNG MỤC II GIỮ NGUYÊN HOÀN TOÀN -->
                                            <div class="section-header-title">II. Tiêu chí đánh giá mức độ thành thục</div>
                                            <table class="criteria-table">
                                                <thead>
                                                    <tr>
                                                         <th style="width: 33.33%;">CHƯA ĐẠT (-)</th>
                                                         <th style="width: 33.33%;">ĐANG HÌNH THÀNH (+/-)</th>
                                                         <th style="width: 33.33%;">ĐẠT (+)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><span t-raw="muctieu.tieuchi_chuadat"/></td>
                                                        <td><span t-raw="muctieu.tieuchi_hinhthanh"/></td>
                                                        <td><span t-raw="muctieu.tieuchi_dat"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- KHỐI III: THIẾT KẾ ABC -->
                                    <div class="bottom-row-grid">
                                        <div class="abc-procedure-content">
                                            <div class="section-header-title">III. Thiết kế hoạt động cho giáo viên theo mô tả (ABC)</div>
                                            <div class="text-paragraph"><span t-raw="muctieu.thietke"/></div>
                                        </div>
                                    </div>

                                    <!-- 🌟 KHỐI IV: THEO DÕI KÈM SỐ LẦN THỬ THIẾT LẬP VÀ 3 TẦNG KẾT QUẢ -->
                                    <div class="tracking-diary-content">
                                        <div class="section-header-title" style="margin-bottom: 3px;">
                                            IV. Theo dõi
                                            <span style="font-weight: normal; text-transform: none; text-decoration: none;">
                                                (Số lần thử là <strong style="color:red;"><span t-field="muctieu.solan_thu"/></strong> lần)
                                            </span>
                                        </div>

                                        <div class="day-boxes-horizontal-flow">
                                            <t t-if="muctieu.ketqua2muctieu_ids">
                                                <t t-foreach="muctieu.ketqua2muctieu_ids" t-as="kq">
                                                    <t t-set="is_future_status" t-value="kq.is_date_status == '1'"/>
                                                    <t t-set="rest_class" t-value="(kq.loai in ['0', '-1'] or is_future_status) and 'box-print-rest' or ''"/>

                                                    <div t-attf-class="day-tracking-box-print #{rest_class}">
                                                        <!-- Tầng 1: Ngày/Tháng -->
                                                        <span class="cell-print-date">
                                                            <span t-field="kq.ngay" t-options="{'widget': 'date', 'format': 'dd/MM'}"/>
                                                        </span>

                                                        <!-- Tầng 2: Số lần đạt (hoặc N khi nghỉ) -->
                                                        <div class="cell-print-val">
                                                            <t t-if="is_future_status"></t>
                                                            <t t-else="">
                                                                <t t-if="kq.loai == '-1'">N</t>
                                                                <t t-elif="kq.loai == '0'"></t>
                                                                <t t-else="">
                                                                    <t t-if="kq.trangthai != '0' and kq.solan_thu &gt; 0">
                                                                        <span t-field="kq.solan_thu_dat"/>
                                                                    </t>
                                                                </t>
                                                            </t>
                                                        </div>

                                                        <!-- Tầng 3: Tỷ lệ % -->
                                                        <div class="cell-print-rate">
                                                            <t t-if="not is_future_status and kq.loai == '1' and kq.trangthai != '0' and kq.solan_thu &gt; 0">
                                                                <span><t t-esc="kq.tyle_thu"/>%</span>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </t>

                                            <!-- Fallback khi chưa sinh dòng chi tiết ngày -->
                                            <t t-else="">
                                                <t t-set="total_days" t-value="int(o.songay or 30)"/>
                                                <t t-foreach="range(total_days)" t-as="day_idx">
                                                    <t t-set="computed_date" t-value="o.tu_ngay + datetime.timedelta(days=day_idx)"/>
                                                    <t t-set="is_fallback_sunday" t-value="computed_date.weekday() == 6"/>
                                                    <t t-set="is_fallback_future" t-value="computed_date &gt; datetime.date.today()"/>
                                                    <t t-set="should_fallback_gray" t-value="is_fallback_sunday or is_fallback_future"/>

                                                    <div t-attf-class="day-tracking-box-print #{should_fallback_gray and 'box-print-rest' or ''}">
                                                        <span class="cell-print-date">
                                                            <span t-out="computed_date.strftime('%d/%m')"/>
                                                        </span>
                                                        <div class="cell-print-val">
                                                            <t t-if="is_fallback_future"></t>
                                                            <t t-elif="is_fallback_sunday">N</t>
                                                        </div>
                                                        <div class="cell-print-rate"></div>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>

                                        <div style="margin-top: 3px; padding-top: 3px; font-size: 12.5px; text-align: left; color: #000000; border-top: 1px dashed #000000;">
                                            <span class="text-bold">Kết quả <strong><span t-out="o.songay"/></strong> ngày của kế hoạch:</span>
                                            Chưa đạt (-): <span class="lbl-summary-chuadat"><span t-field="muctieu.ketqua_khongdat"/></span> |
                                            Hình thành (+/-): <span class="lbl-summary-hinhthanh"><span t-field="muctieu.ketqua_hinhthanh"/></span> |
                                            Đạt (+): <span class="lbl-summary-dat"><span t-field="muctieu.ketqua_dat"/></span>
                                        </div>
                                    </div>

                                </div>
                            </t>
                        </t>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>