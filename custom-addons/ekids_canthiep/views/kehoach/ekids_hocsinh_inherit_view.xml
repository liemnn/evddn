<odoo>
  <data>
    <record id="ekids_canthiep.hocsinh_search" model="ir.ui.view">
        <field name="name">hocsinh.search</field>
        <field name="model">ekids.hocsinh</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Đang theo học" name="trangthai" domain="[('trangthai','=','1')]"/>
                <filter string="Đã nghỉ" name="trangthai-nghi" domain="[('trangthai','=','3')]"/>
                <filter string="Đợi đánh giá" name="trangthai-doidanhgia" domain="[('trangthai','=','2')]"/>
                <field name="name"/>
                <field name="ten"/>
                <field name="bietdanh"/>
                <field name="gioitinh"/>
            </search>
        </field>
    </record>

    <record id="ekids_canthiep.kehoach_hocsinh_inherit_list" model="ir.ui.view">
        <field name="name">Kế hoạch can thiệp</field>
        <field name="model">ekids.hocsinh</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" limit="200" default_order="id asc">
                <field name="sequence" width="25"/>
                <field name="name" width="170"/>
                <field name="gioitinh"/>
                <field name="ngaysinh"/>
                <field name="tuoi"/>
                <field name="trangthai" string="Trạng thái"
                        decoration-success="trangthai == '1'"
                        decoration-info="trangthai == '2'"
                        decoration-danger="trangthai == '3'"/>
                <field name="trangthai_kehoach" string="Kế hoạch"/>


            </list>
        </field>
    </record>

  </data>
</odoo>