<odoo>
  <data>
    <record id="ekids_canthiep.hocsinh_search" model="ir.ui.view">
        <field name="name">hocsinh.search</field>
        <field name="model">ekids.hocsinh</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Đang theo học" name="trangthai" domain="[('trangthai','=','1')]"/>
                <filter string="Đã nghỉ" name="trangthai-nghi" domain="[('trangthai','=','3')]"/>
                <filter string="Đợi đánh giá" name="trangthai-doidanhgia" domain="[('trangthai','=','2')]"/>
                <field name="name"/>
                <field name="ten"/>
                <field name="bietdanh"/>
                <field name="gioitinh"/>
            </search>
        </field>
    </record>

    <record id="ekids_canthiep.kehoach_hocsinh_inherit_list" model="ir.ui.view">
        <field name="name">Kế hoạch can thiệp</field>
        <field name="model">ekids.hocsinh</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" limit="200" default_order="id asc">
                <field name="sequence" width="25"/>
                <field name="name" width="170"/>
                <field name="gioitinh"/>
                <field name="ngaysinh"/>
                <field name="trangthai" string="Trạng thái"
                        decoration-success="trangthai == '1'"
                        decoration-info="trangthai == '2'"
                        decoration-danger="trangthai == '3'"/>
                <field name="trangthai_kehoach" string="Kế hoạch"/>


            </list>
        </field>
    </record>

    <record id="ekids_canthiep.kehoach_hocsinh_inherit_form" model="ir.ui.view">
            <field name="name">ekids.hocsinh.kehoach.form</field>
            <field name="model">ekids.hocsinh</field>
            <field name="priority" eval="50"/>
            <field name="arch" type="xml">
                <form string="Hồ sơ Chuyên môn Học sinh">
                    <header>
                        <field name="trangthai" widget="statusbar" statusbar_visible="2,1,3,4"/>
                    </header>

                    <sheet>
                        <div class="d-flex p-3 align-items-center border-bottom bg-light mb-4" style="border-radius: 6px;">
                            <field name="avatar" widget="image" class="oe_avatar m-0 me-3" options="{'preview_image': 'avatar', 'size': [70, 70]}"/>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h2 class="fw-bold m-0" style="color: #2d2544; font-size: 1.4rem;">
                                        <field name="name" readonly="1"/>
                                    </h2>
                                    <span class="badge text-bg-secondary">Mã: <field name="ma" readonly="1"/></span>
                                </div>
                                <div class="text-muted small">
                                    <strong>Tuổi thực tế:</strong> <field name="tuoi"/> |
                                    <strong>Ngày sinh:</strong> <field name="ngaysinh"/> |
                                    <strong>Thời gian theo học:</strong> <field name="thoigian_hoc"/>
                                </div>
                            </div>
                        </div>


                    </sheet>
                </form>
            </field>
        </record>



  </data>
</odoo>