<odoo>
  <data>
      <record id="ekids_canthiep.danhsach_kehoach_kanban" model="ir.ui.view">
            <field name="name">ekids.kehoach.kanban</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <kanban default_order="id desc" sample="1" class="saas_three_zone_kanban">

                    <!-- KHAI BÁO CÁC TRƯỜNG DỮ LIỆU -->
                    <field name="id"/>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="songay"/>
                    <field name="trangthai"/>
                    <field name="trangthai_pheduyet"/>
                    <field name="ngay_danhgia"/>
                    <field name="gv_danhgia"/>
                    <field name="gv_lapkehoach_id"/>
                    <field name="gv_kiemduyet_id"/>
                    <field name="gv_canthiep_id"/>
                    <field name="index"/>

                    <templates>
                        <t t-name="kanban-box">

                            <!-- HỆ THỐNG CSS ĐÁP ỨNG DI ĐỘNG & TỐI ƯU GIAO DIỆN -->
                            <style>
                                .saas_three_zone_kanban .o_kanban_record {
                                    width: 100% !important;
                                    flex: 0 0 100% !important;
                                    margin: 0 0 12px 0 !important;
                                    padding: 0 !important;
                                    background: transparent !important;
                                    border: none !important;
                                }

                                /* --- CẤU HÌNH MẶC ĐỊNH CHO MOBILE (ĐIỆN THOẠI) --- */
                                .three_zone_card {
                                    background: #FFFFFF;
                                    border: 1px solid #E4E7EC;
                                    border-radius: 16px;
                                    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
                                    transition: all 0.2s ease;
                                    flex-direction: column !important; /* Đổ dọc hoàn toàn trên điện thoại */
                                    align-items: stretch !important;
                                }

                                /* Chia khối linh hoạt cho giao diện Mobile */
                                .zone_responsive_block {
                                    width: 100% !important;
                                    min-width: 100% !important;
                                    padding-left: 0 !important;
                                    border-left: none !important;
                                    border-top: 1px dashed #EAECF0; /* Nét đứt ngăn cách các vùng */
                                    padding-top: 12px;
                                    margin-top: 6px;
                                }
                                .zone-block-1 {
                                    border-top: none !important;
                                    padding-top: 0 !important;
                                    margin-top: 0 !important;
                                }

                                .index-circle-container {
                                    align-self: flex-start;
                                    margin-bottom: 6px;
                                }

                                .zone_title {
                                    font-size: 11.5px !important;
                                    font-weight: 700 !important;
                                    text-uppercase: true;
                                    letter-spacing: 0.5px;
                                    color: #98A2B3;
                                    margin-bottom: 6px;
                                }
                                .mini_badge_user {
                                    display: inline-flex;
                                    align-items: center;
                                    padding: 3px 8px;
                                    background: #F1F5F9;
                                    border: 1px solid #E2E8F0;
                                    border-radius: 4px;
                                    font-size: 11px;
                                    color: #334155;
                                }
                                .btn-zone-action {
                                    font-size: 12.5px !important;
                                    font-weight: 700 !important;
                                    padding: 4px 10px !important;
                                    border-radius: 6px !important;
                                    background: #FFFFFF !important;
                                    border: 1px solid #D0D5DD !important;
                                    color: #344054 !important;
                                    display: inline-flex;
                                    align-items: center;
                                    gap: 4px;
                                }

                                /* --- CẤU HÌNH CHO DESKTOP (MÁY TÍNH MÀN HÌNH LỚN) --- */
                                @media (min-width: 992px) {
                                    .three_zone_card {
                                        flex-direction: row !important; /* Quay lại hàng ngang */
                                        align-items: center !important;
                                    }
                                    .three_zone_card:hover {
                                        border-color: #3B82F6 !important;
                                        box-shadow: 0 8px 20px rgba(14, 165, 233, 0.06) !important;
                                    }
                                    .index-circle-container {
                                        align-self: auto !important;
                                        margin-bottom: 0 !important;
                                    }
                                    .zone_responsive_block {
                                        border-top: none !important;
                                        padding-top: 0 !important;
                                        margin-top: 0 !important;
                                    }
                                    .zone-block-1 {
                                        flex: 1 !important;
                                        min-width: 195px !important;
                                    }
                                    .zone-block-2 {
                                        flex: 1.8 !important;
                                        min-width: 350px !important;
                                        border-left: 1px solid #EAECF0 !important;
                                        padding-left: 16px !important;
                                    }
                                    .zone-block-3 {
                                        flex: 1.5 !important;
                                        min-width: 300px !important;
                                        border-left: 1px solid #EAECF0 !important;
                                        padding-left: 16px !important;
                                    }
                                }
                            </style>

                            <!-- CONTAINER CHÍNH CỦA DÒNG -->
                            <div class="three_zone_card oe_kanban_global_click d-flex p-3 gap-2"
                                 t-attf-style="border-left: 4px solid #{record.trangthai.raw_value == 'dang_canthiep' ? '#10B981' : (record.trangthai.raw_value == 'dang_lap' ? '#F59E0B' : (record.trangthai.raw_value == 'het_hieuluc' ? '#EF4444' : '#98A2B3'))};">

                                <!-- KHỐI SỐ THỨ TỰ (INDEX): SIÊU ĐẬM NÉT, GRADIENT PASTEL TRẺ EM -->
                                <div class="index-circle-container d-flex align-items-center justify-content-center font-monospace text-white"
                                     style="width: 46px;
                                            height: 46px;
                                            border-radius: 50%;
                                            background: linear-gradient(135deg, #38BDF8 0%, #0284C7 100%);
                                            font-size: 20px;
                                            font-weight: 950; /* Tăng tối đa độ đậm đà */
                                            flex-shrink: 0;
                                            margin-right: 10px;
                                            border: 2px solid #FFFFFF;
                                            box-shadow: 0 4px 10px rgba(2, 132, 199, 0.3) !important;
                                            text-shadow: 0 1px 2px rgba(0,0,0,0.2);">
                                    <field name="index"/>
                                </div>

                                <!-- ================================================================== -->
                                <!-- VÙNG 1: KẾT LUẬN                                                   -->
                                <!-- ================================================================== -->
                                <div class="zone_responsive_block zone-block-1 d-flex flex-column justify-content-between" style="min-height: 70px;">
                                    <div>
                                        <div class="zone_title"><i class="fa fa-file-text-o me-1"></i>THÔNG TIN KẾT LUẬN</div>
                                        <div style="font-size: 12.5px; color: #344054;">
                                            <span class="fw-bold text-dark"><field name="ngay_danhgia"/></span>
                                            <span class="text-muted mx-1">|</span>
                                            <span class="text-muted">Đánh giá: <b class="text-dark"><field name="gv_danhgia"/></b></span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <button type="object" name="action_xem_ketluan" class="btn-zone-action btn btn-sm shadow-sm" onclick="event.stopPropagation();">
                                            <i class="fa fa-folder-open-o"></i> Xem Kết Luận
                                        </button>
                                    </div>
                                </div>

                                <!-- ================================================================== -->
                                <!-- VÙNG 2: KẾ HOẠCH (ĐÃ LÀM ĐẬM VÀ ĐÓNG KHỐI PHẦN SỐ NGÀY)            -->
                                <!-- ================================================================== -->
                                <div class="zone_responsive_block zone-block-2 d-flex flex-column justify-content-between" style="min-height: 70px;">
                                    <div>
                                        <div class="zone_title"><i class="fa fa-calendar me-1"></i>KẾ HOẠCH</div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <!-- Chu kỳ ngày nén ngang -->
                                            <div class="font-monospace fw-bold text-dark" style="font-size: 12.5px;">
                                                <field name="tu_ngay"/><i class="fa fa-long-arrow-right text-muted mx-1.5"></i><field name="den_ngay"/>
                                            </div>
                                            <!-- LÀM ĐẬM: Đóng khối Tag nổi bật cho trường số ngày -->
                                            <span class="badge px-2 py-1 shadow-sm"
                                                  style="background-color: #EFF6FF;
                                                         color: #1D4ED8;
                                                         border: 1px solid #BFDBFE;
                                                         font-size: 11.5px;
                                                         font-weight: 800;
                                                         border-radius: 6px;">
                                                <i class="fa fa-clock-o me-1"></i><strong><field name="songay"/></strong> ngày
                                            </span>
                                            <!-- Nhân sự nhóm lập duyệt -->
                                            <div class="d-flex gap-1">
                                                <div class="mini_badge_user" title="Người lập"><i class="fa fa-pencil text-warning me-1"></i><field name="gv_lapkehoach_id"/></div>
                                                <div class="mini_badge_user" title="Người duyệt"><i class="fa fa-shield text-info me-1"></i><field name="gv_kiemduyet_id"/></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <button type="object" name="action_xem_kehoach" class="btn-zone-action btn btn-sm shadow-sm" onclick="event.stopPropagation();">
                                            <i class="fa fa-eye text-primary"></i> Xem Kế Hoạch
                                        </button>
                                    </div>
                                </div>

                                <!-- ================================================================== -->
                                <!-- VÙNG 3: CAN THIỆP                                                  -->
                                <!-- ================================================================== -->
                                <div class="zone_responsive_block zone-block-3 d-flex align-items-center justify-content-between gap-2" style="min-height: 70px;">

                                    <div class="d-flex flex-column justify-content-between" style="height: 100%; min-height: 68px;">
                                        <div>
                                            <div class="zone_title"><i class="fa fa-graduation-cap me-1"></i>THÔNG TIN CAN THIỆP</div>
                                            <div class="mini_badge_user fw-bold" style="background: #FFF7ED; border-color: #FFEDD5; color: #C2410C; padding: 3px 8px;">
                                                <i class="fa fa-user text-orange me-1"></i>Dạy: <field name="gv_canthiep_id"/>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mt-1.5" style="font-size: 12.5px;">
                                            <t t-if="record.trangthai_pheduyet.raw_value == 'da_duyet'">
                                                <span class="badge" style="padding: 2px 6px; background-color: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; border-radius: 4px;">Đã duyệt</span>
                                            </t>
                                            <t t-elif="record.trangthai_pheduyet.raw_value == 'can_dieuchinh'">
                                                <span class="badge" style="padding: 2px 6px; background-color: #FFF1F2; color: #B91C1C; border: 1px solid #FECDD3; border-radius: 4px;">Cần sửa</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge" style="padding: 2px 6px; background-color: #F0F9FF; color: #0369A1; border: 1px solid #BAE6FD; border-radius: 4px;">Chờ duyệt</span>
                                            </t>

                                            <t t-if="record.trangthai.raw_value == 'dang_canthiep'">
                                                <span class="text-success fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Đang dạy</span>
                                            </t>
                                            <t t-elif="record.trangthai.raw_value == 'dang_lap'">
                                                <span class="text-warning fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Đang lập</span>
                                            </t>
                                            <t t-elif="record.trangthai.raw_value == 'het_hieuluc'">
                                                <span class="text-danger fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Hết hạn</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Đợi lập</span>
                                            </t>
                                        </div>
                                    </div>

                                    <div style="width: 105px; flex-shrink: 0;">
                                        <button type="object" name="action_canthiep"
                                                class="btn btn-sm btn-success w-100 fw-bold text-white shadow-sm d-flex align-items-center justify-content-center gap-1"
                                                style="height: 34px !important; border-radius: 6px !important; font-size: 13px !important; background-color: #10B981 !important; border: none !important;"
                                                onclick="event.stopPropagation();">
                                            <i class="fa fa-play-circle" style="font-size: 13px;"></i> CAN THIỆP
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
      <record id="ekids_canthiep.lap_kehoach_form" model="ir.ui.view">
            <field name="name">ekids.kehoach.workspace.form</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <form string="Thiết lập Kế hoạch Can thiệp">
                    <style>
                        /* RESET NỀN FORM */
                        .o_form_view .o_form_sheet_bg { background-color: #F8FAFC !important; padding: 20px !important;}
                        .o_form_sheet { padding: 0 !important; max-width: 100% !important; border: none !important; background: transparent !important; margin: 0 auto;}

                        /* THIẾT KẾ KHỐI HEADER */
                        .workspace-mock { background: white; border: 1px solid #CBD5E1; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.04); margin-bottom: 25px;}

                        /* Thêm justify-content: space-between để tự động đẩy nút sang mép phải */
                        .ws-header { background: #F8FAFC; padding: 15px 20px; border-bottom: 1px solid #E2E8F0; display: flex; align-items: center; justify-content: space-between; gap: 10px;}

                        .ws-body { padding: 15px; }
                        .ws-info-bar { display: flex; gap: 20px; flex-wrap: wrap; background: #EFF6FF; padding: 12px 15px; border-radius: 8px; border: 1px solid #BFDBFE;}
                        .ws-field { flex: 1; min-width: 200px; display: flex; align-items: center; gap: 10px;}
                        .ws-label { font-weight: 700; color: #1E3A8A; font-size: 14px; white-space: nowrap;}

                        /* ======================================================== */
                        /* TÙY CHỈNH BẢNG KANBAN THÀNH DẠNG TRELLO BOARD            */
                        /* ======================================================== */

                        /* Tùy chỉnh Cột (Lĩnh vực) */
                        .o_kanban_view.o_kanban_grouped .o_kanban_group {
                            background-color: #F1F5F9 !important; /* Nền xám nhạt cho cột */
                            border-radius: 12px;
                            margin-right: 15px;
                            padding: 10px;
                            border: 1px solid #E2E8F0;
                        }

                        /* Header của Cột (Tên Lĩnh vực) */
                        .o_kanban_view.o_kanban_grouped .o_kanban_header {
                            border-bottom: 2px solid #CBD5E1;
                            padding-bottom: 10px;
                            margin-bottom: 10px;
                        }
                        .o_kanban_view.o_kanban_grouped .o_kanban_header_title {
                            font-weight: 800 !important;
                            color: #1E3A8A !important;
                            font-size: 16px;
                            text-transform: uppercase;
                        }
                    </style>

                    <header>
                        <button name="action_gui_pheduyet"
                                        string="Gửi phê duyệt"
                                        type="object"
                                        icon="fa-eye"
                                        class="btn-outline-primary fw-bold"
                                        invisible="trangthai_pheduyet not in ['-1']"/>

                        <button name="action_pheduyet_dat"
                                        string="Đạt"
                                        type="object"
                                        icon="fa-eye"
                                        confirm="Bạn xác nhận [Kế hoạch] đã đạt để giáo viên tiến hành can thiệp theo thời gian trong kế hoạch"
                                        class="btn-outline-primary fw-bold"
                                        invisible="trangthai_pheduyet not in ['0']"/>

                        <button name="action_pheduyet_khongdat"
                                        string="Không đạt sửa lại"

                                        type="object"
                                        icon="fa-eye"
                                        confirm="Bạn xác nhận [Kế hoạch] chưa đạt cần trả về cho giáo viên lập kế hoạch chỉnh sửa lại ?"
                                        class="btn-outline-primary fw-bold"
                                        invisible="trangthai_pheduyet not in ['0']"/>


                        <field name="trangthai" widget="statusbar" statusbar_visible="0,2,1,-1" options="{'clickable': false}"/>
                    </header>

                    <sheet>




                        <div class="workspace-mock">

                            <div class="ws-header">
                                <div class="fw-bold text-primary fs-5">
                                    <i class="fa fa-info-circle me-1"></i> THÔNG TIN KẾ HOẠCH
                                </div>
                                <button name="action_xem_ketluan"
                                        string="Xem kết luận đánh giá"
                                        type="object"
                                        icon="fa-eye"
                                        class="btn-outline-primary btn-sm fw-bold bg-white"
                                        invisible="trangthai in ['0']"/>
                                <field name="trangthai_pheduyet" widget="statusbar" statusbar_visible="0,1,-1" options="{'clickable': false}"/>

                            </div>

                            <div class="ws-body">
                                <div class="ws-info-bar">
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-user-circle-o me-1"></i>Học sinh:</span>
                                        <field name="hocsinh_id" readonly="1" class="fw-bold"/>
                                    </div>
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-calendar-play-o me-1"></i>Từ ngày:</span>
                                        <field name="tu_ngay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important;"/>
                                    </div>
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-calendar-play-o me-1"></i>Đến ngày:</span>
                                        <field name="den_ngay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important;"/>
                                    </div>
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-clock-o me-1"></i>Kế hoạch dự kiến:</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <field name="songay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important; width: 60px; text-align: center;"/>
                                            <span class="text-muted fw-bold">ngày</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <group invisible="trangthai_pheduyet not in ['0','-1']">

                            <p>
                                <strong>Ý KIẾN CHUYÊN MÔN VỀ KẾ HOẠCH</strong>
                                <field name="desc" class="fw-bold bg-white border rounded px-2 py-1 text-dark"/>
                            </p>
                        </group>

                        <separator string="CÁC MỤC TIÊU TRONG KẾ HOẠCH"/>

                        <field name="kehoach_muctieu_ids" nolabel="1" domain="[('kehoach_id','=',id)]">

                            <list string="Danh sách Mục tiêu" decoration-muted="id == False">
                                <field name="sequence" widget="handle"/>

                                <field name="linhvuc_id" string="Lĩnh vực" class="fw-bold text-primary" style="width: 25%;"/>
                                <field name="tuoi_id" string="Độ tuổi" class="fw-bold text-danger" style="width: 15%;"/>
                                <field name="name" string="Tên Mục tiêu &amp; Mô tả" style="width: 60%;"/>
                            </list>

                            <kanban default_order="sequence" create="0" class="o_kanban_small_column">
                                <field name="sequence"/>
                                <field name="linhvuc_id"/>
                                <field name="tuoi_id"/>
                                <field name="name"/>

                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click" style="background: white; border: 1px solid #E2E8F0; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); padding: 16px; margin-bottom: 15px; display: flex; flex-direction: column; gap: 12px; transition: all 0.2s ease;">

                                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="text-muted" title="Kéo thả để sắp xếp" style="cursor: grab; font-size: 1.1rem;">
                                                        <field name="sequence" widget="handle"/>
                                                    </span>

                                                    <span class="badge" style="background-color: #EFF6FF; color: #1E3A8A; border: 1px solid #BFDBFE; font-size: 0.8rem; padding: 6px 10px; border-radius: 6px;">
                                                        <i class="fa fa-folder-open me-1 text-warning"></i> <field name="linhvuc_id"/>
                                                    </span>
                                                </div>
                                                <span class="badge" style="background-color: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; font-size: 0.8rem; padding: 6px 10px; border-radius: 6px;">
                                                    <field name="tuoi_id"/>
                                                </span>
                                            </div>

                                            <div class="fw-bold fs-6 text-dark mt-1" style="line-height: 1.5; flex-grow: 1;">
                                                <field name="name"/>
                                            </div>

                                            <div class="text-end mt-1 pt-2" style="border-top: 1px dashed #F1F5F9;">
                                                <span style="color: #2563EB; font-weight: 700; font-size: 0.85rem; padding: 4px 8px; border-radius: 4px; background: #F8FAFC; border: 1px solid #E2E8F0;">
                                                    Xem chi tiết <i class="fa fa-arrow-right ms-1"></i>
                                                </span>
                                            </div>

                                        </div>
                                    </t>
                                </templates>
                            </kanban>

                        </field>
                    </sheet>
                </form>
            </field>
        </record>


  </data>
</odoo>