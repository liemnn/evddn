<odoo>
  <data>
      <record id="ekids_canthiep.danhsach_kehoach_kanban" model="ir.ui.view">
            <field name="name">ekids.kehoach.kanban</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <kanban default_order="id desc" sample="1" class="saas_three_zone_kanban">

                    <!-- KHAI BÁO CÁC TRƯỜNG DỮ LIỆU -->
                    <field name="id"/>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="songay"/>
                    <field name="trangthai"/>
                    <field name="trangthai_pheduyet"/>
                    <field name="ngay_danhgia"/>
                    <field name="gv_danhgia"/>
                    <field name="gv_lapkehoach_id"/>
                    <field name="gv_kiemduyet_id"/>
                    <field name="gv_canthiep_id"/>
                    <field name="index"/>

                    <templates>
                        <t t-name="kanban-box">

                            <!-- HỆ THỐNG CSS ĐÁP ỨNG DI ĐỘNG & TỐI ƯU GIAO DIỆN -->
                            <style>
                                .saas_three_zone_kanban .o_kanban_record {
                                    width: 100% !important;
                                    flex: 0 0 100% !important;
                                    margin: 0 0 12px 0 !important;
                                    padding: 0 !important;
                                    background: transparent !important;
                                    border: none !important;
                                }

                                /* --- CẤU HÌNH MẶC ĐỊNH CHO MOBILE (ĐIỆN THOẠI) --- */
                                .three_zone_card {
                                    background: #FFFFFF;
                                    border: 1px solid #E4E7EC;
                                    border-radius: 16px;
                                    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
                                    transition: all 0.2s ease;
                                    flex-direction: column !important; /* Đổ dọc hoàn toàn trên điện thoại */
                                    align-items: stretch !important;
                                }

                                /* Chia khối linh hoạt cho giao diện Mobile */
                                .zone_responsive_block {
                                    width: 100% !important;
                                    min-width: 100% !important;
                                    padding-left: 0 !important;
                                    border-left: none !important;
                                    border-top: 1px dashed #EAECF0; /* Nét đứt ngăn cách các vùng */
                                    padding-top: 12px;
                                    margin-top: 6px;
                                }
                                .zone-block-1 {
                                    border-top: none !important;
                                    padding-top: 0 !important;
                                    margin-top: 0 !important;
                                }

                                .index-circle-container {
                                    align-self: flex-start;
                                    margin-bottom: 6px;
                                }

                                .zone_title {
                                    font-size: 11.5px !important;
                                    font-weight: 700 !important;
                                    text-uppercase: true;
                                    letter-spacing: 0.5px;
                                    color: #98A2B3;
                                    margin-bottom: 6px;
                                }
                                .mini_badge_user {
                                    display: inline-flex;
                                    align-items: center;
                                    padding: 3px 8px;
                                    background: #F1F5F9;
                                    border: 1px solid #E2E8F0;
                                    border-radius: 4px;
                                    font-size: 11px;
                                    color: #334155;
                                }
                                .btn-zone-action {
                                    font-size: 12.5px !important;
                                    font-weight: 700 !important;
                                    padding: 4px 10px !important;
                                    border-radius: 6px !important;
                                    background: #FFFFFF !important;
                                    border: 1px solid #D0D5DD !important;
                                    color: #344054 !important;
                                    display: inline-flex;
                                    align-items: center;
                                    gap: 4px;
                                }

                                /* --- CẤU HÌNH CHO DESKTOP (MÁY TÍNH MÀN HÌNH LỚN) --- */
                                @media (min-width: 992px) {
                                    .three_zone_card {
                                        flex-direction: row !important; /* Quay lại hàng ngang */
                                        align-items: center !important;
                                    }
                                    .three_zone_card:hover {
                                        border-color: #3B82F6 !important;
                                        box-shadow: 0 8px 20px rgba(14, 165, 233, 0.06) !important;
                                    }
                                    .index-circle-container {
                                        align-self: auto !important;
                                        margin-bottom: 0 !important;
                                    }
                                    .zone_responsive_block {
                                        border-top: none !important;
                                        padding-top: 0 !important;
                                        margin-top: 0 !important;
                                    }
                                    .zone-block-1 {
                                        flex: 1 !important;
                                        min-width: 195px !important;
                                    }
                                    .zone-block-2 {
                                        flex: 1.8 !important;
                                        min-width: 350px !important;
                                        border-left: 1px solid #EAECF0 !important;
                                        padding-left: 16px !important;
                                    }
                                    .zone-block-3 {
                                        flex: 1.5 !important;
                                        min-width: 300px !important;
                                        border-left: 1px solid #EAECF0 !important;
                                        padding-left: 16px !important;
                                    }
                                }
                            </style>

                            <!-- CONTAINER CHÍNH CỦA DÒNG -->
                            <div class="three_zone_card oe_kanban_global_click d-flex p-3 gap-2"
                                 t-attf-style="border-left: 4px solid #{record.trangthai.raw_value == 'dang_canthiep' ? '#10B981' : (record.trangthai.raw_value == 'dang_lap' ? '#F59E0B' : (record.trangthai.raw_value == 'het_hieuluc' ? '#EF4444' : '#98A2B3'))};">

                                <!-- KHỐI SỐ THỨ TỰ (INDEX): SIÊU ĐẬM NÉT, GRADIENT PASTEL TRẺ EM -->
                                <div class="index-circle-container d-flex align-items-center justify-content-center font-monospace text-white"
                                     style="width: 46px;
                                            height: 46px;
                                            border-radius: 50%;
                                            background: linear-gradient(135deg, #38BDF8 0%, #0284C7 100%);
                                            font-size: 20px;
                                            font-weight: 950; /* Tăng tối đa độ đậm đà */
                                            flex-shrink: 0;
                                            margin-right: 10px;
                                            border: 2px solid #FFFFFF;
                                            box-shadow: 0 4px 10px rgba(2, 132, 199, 0.3) !important;
                                            text-shadow: 0 1px 2px rgba(0,0,0,0.2);">
                                    <field name="index"/>
                                </div>

                                <!-- ================================================================== -->
                                <!-- VÙNG 1: KẾT LUẬN                                                   -->
                                <!-- ================================================================== -->
                                <div class="zone_responsive_block zone-block-1 d-flex flex-column justify-content-between" style="min-height: 70px;">
                                    <div>
                                        <div class="zone_title"><i class="fa fa-file-text-o me-1"></i>THÔNG TIN KẾT LUẬN</div>
                                        <div style="font-size: 12.5px; color: #344054;">
                                            <span class="fw-bold text-dark"><field name="ngay_danhgia"/></span>
                                            <span class="text-muted mx-1">|</span>
                                            <span class="text-muted">Đánh giá: <b class="text-dark"><field name="gv_danhgia"/></b></span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <button type="object" name="action_xem_ketluan" class="btn-zone-action btn btn-sm shadow-sm" onclick="event.stopPropagation();">
                                            <i class="fa fa-folder-open-o"></i> Xem Kết Luận
                                        </button>
                                    </div>
                                </div>

                                <!-- ================================================================== -->
                                <!-- VÙNG 2: KẾ HOẠCH (ĐÃ LÀM ĐẬM VÀ ĐÓNG KHỐI PHẦN SỐ NGÀY)            -->
                                <!-- ================================================================== -->
                                <div class="zone_responsive_block zone-block-2 d-flex flex-column justify-content-between" style="min-height: 70px;">
                                    <div>
                                        <div class="zone_title"><i class="fa fa-calendar me-1"></i>KẾ HOẠCH</div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <!-- Chu kỳ ngày nén ngang -->
                                            <div class="font-monospace fw-bold text-dark" style="font-size: 12.5px;">
                                                <field name="tu_ngay"/><i class="fa fa-long-arrow-right text-muted mx-1.5"></i><field name="den_ngay"/>
                                            </div>
                                            <!-- LÀM ĐẬM: Đóng khối Tag nổi bật cho trường số ngày -->
                                            <span class="badge px-2 py-1 shadow-sm"
                                                  style="background-color: #EFF6FF;
                                                         color: #1D4ED8;
                                                         border: 1px solid #BFDBFE;
                                                         font-size: 11.5px;
                                                         font-weight: 800;
                                                         border-radius: 6px;">
                                                <i class="fa fa-clock-o me-1"></i><strong><field name="songay"/></strong> ngày
                                            </span>
                                            <!-- Nhân sự nhóm lập duyệt -->
                                            <div class="d-flex gap-1">
                                                <div class="mini_badge_user" title="Người lập"><i class="fa fa-pencil text-warning me-1"></i><field name="gv_lapkehoach_id"/></div>
                                                <div class="mini_badge_user" title="Người duyệt"><i class="fa fa-shield text-info me-1"></i><field name="gv_kiemduyet_id"/></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <button type="object" name="action_xem_kehoach" class="btn-zone-action btn btn-sm shadow-sm" onclick="event.stopPropagation();">
                                            <i class="fa fa-eye text-primary"></i> Xem Kế Hoạch
                                        </button>
                                    </div>
                                </div>

                                <!-- ================================================================== -->
                                <!-- VÙNG 3: CAN THIỆP                                                  -->
                                <!-- ================================================================== -->
                                <div class="zone_responsive_block zone-block-3 d-flex align-items-center justify-content-between gap-2" style="min-height: 70px;">

                                    <div class="d-flex flex-column justify-content-between" style="height: 100%; min-height: 68px;">
                                        <div>
                                            <div class="zone_title"><i class="fa fa-graduation-cap me-1"></i>THÔNG TIN CAN THIỆP</div>
                                            <div class="mini_badge_user fw-bold" style="background: #FFF7ED; border-color: #FFEDD5; color: #C2410C; padding: 3px 8px;">
                                                <i class="fa fa-user text-orange me-1"></i>Dạy: <field name="gv_canthiep_id"/>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mt-1.5" style="font-size: 12.5px;">
                                            <t t-if="record.trangthai_pheduyet.raw_value == 'da_duyet'">
                                                <span class="badge" style="padding: 2px 6px; background-color: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; border-radius: 4px;">Đã duyệt</span>
                                            </t>
                                            <t t-elif="record.trangthai_pheduyet.raw_value == 'can_dieuchinh'">
                                                <span class="badge" style="padding: 2px 6px; background-color: #FFF1F2; color: #B91C1C; border: 1px solid #FECDD3; border-radius: 4px;">Cần sửa</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge" style="padding: 2px 6px; background-color: #F0F9FF; color: #0369A1; border: 1px solid #BAE6FD; border-radius: 4px;">Chờ duyệt</span>
                                            </t>

                                            <t t-if="record.trangthai.raw_value == 'dang_canthiep'">
                                                <span class="text-success fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Đang dạy</span>
                                            </t>
                                            <t t-elif="record.trangthai.raw_value == 'dang_lap'">
                                                <span class="text-warning fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Đang lập</span>
                                            </t>
                                            <t t-elif="record.trangthai.raw_value == 'het_hieuluc'">
                                                <span class="text-danger fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Hết hạn</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted fw-bold"><i class="fa fa-circle me-1" style="font-size:6px;"></i>Đợi lập</span>
                                            </t>
                                        </div>
                                    </div>

                                    <div style="width: 105px; flex-shrink: 0;">
                                        <button type="object" name="action_canthiep"
                                                class="btn btn-sm btn-success w-100 fw-bold text-white shadow-sm d-flex align-items-center justify-content-center gap-1"
                                                style="height: 34px !important; border-radius: 6px !important; font-size: 13px !important; background-color: #10B981 !important; border: none !important;"
                                                onclick="event.stopPropagation();">
                                            <i class="fa fa-play-circle" style="font-size: 13px;"></i> CAN THIỆP
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

      <record id="ekids_canthiep.lap_kehoach_form" model="ir.ui.view">
            <field name="name">ekids.kehoach.form</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <form string="Kế hoạch Can thiệp">

                    <header>
                        <button string="Trình phê duyệt" name="action_gui_pheduyet" type="object" class="btn-primary" invisible="trangthai_pheduyet != 'can_dieuchinh'"/>
                        <button string="Phê duyệt Đạt" name="action_pheduyet_dat" type="object" class="btn-success" invisible="trangthai == 'dang_canthiep'"/>
                        <button string="Phê duyệt Không Đạt" name="action_pheduyet_khongdat" type="object" class="btn-danger" invisible="trangthai == 'dang_canthiep'"/>
                        <field name="trangthai" widget="statusbar" statusbar_visible="doi_lap,dang_lap,dang_canthiep"/>
                    </header>

                    <sheet class="p-4 bg-white">

                        <style>
                            /* 1. Thiết kế vòng tròn chỉ số Index mầu sắc trẻ em rực rỡ */
                            .ekids_master_index {
                                width: 48px;
                                height: 48px;
                                border-radius: 50%;
                                background: linear-gradient(135deg, #38BDF8 0%, #0284C7 100%);
                                color: #FFFFFF !important;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-family: monospace;
                                font-weight: 900;
                                font-size: 20px;
                                border: 2px solid #FFFFFF;
                                box-shadow: 0 4px 10px rgba(2, 132, 199, 0.25);
                            }
                            /* Ép ô hiển thị số của Odoo chạy trần phẳng không khung viền */
                            .ekids_master_index span {
                                font-weight: 950 !important;
                                color: #FFFFFF !important;
                            }

                            /* 2. Ép các Label và Value của vùng thông tin Master phẳng, đậm nét */
                            .ekids_master_box {
                                background-color: #F8FAFC;
                                border: 1px solid #F1F5F9;
                                border-radius: 14px;
                                padding: 16px;
                            }
                            .master_label {
                                font-size: 11.5px !important;
                                font-weight: 700 !important;
                                text-uppercase: true;
                                color: #94A3B8;
                                letter-spacing: 0.5px;
                                margin-bottom: 4px;
                            }
                            .master_value {
                                font-size: 15px !important;
                                font-weight: 700 !important;
                                color: #1E293B !important;
                            }

                            /* 3. Tinh chỉnh trường Giáo viên lập duyệt thu gọn thành khối nhãn */
                            .mini_tag_field {
                                display: inline-flex;
                                align-items: center;
                                padding: 2px 6px;
                                background: #EFF6FF;
                                color: #1E4ED8;
                                border: 1px solid #BFDBFE;
                                border-radius: 5px;
                                font-size: 12px;
                                font-weight: 700;
                            }

                            /* 4. Làm đẹp bảng danh mục Lĩnh vực One2many cấp 1 */
                            .ekids_table_holder .o_field_x2many_list_row_add {
                                font-size: 13px !important;
                                font-weight: 700 !important;
                                color: #2563EB !important;
                                padding: 10px 0 !important;
                            }
                            /* Tạo phong cách nút "Thiết lập mục tiêu" phẳng thay vì icon thô */
                            .btn_setup_goals {
                                background-color: #FFFFFF !important;
                                border: 1px solid #BFDBFE !important;
                                color: #2563EB !important;
                                font-weight: 700 !important;
                                font-size: 12px !important;
                                padding: 4px 12px !important;
                                border-radius: 6px !important;
                                box-shadow: 0 1px 2px rgba(0,0,0,0.02);
                            }
                            .btn_setup_goals:hover {
                                background-color: #2563EB !important;
                                color: #FFFFFF !important;
                                border-color: #2563EB !important;
                            }
                        </style>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="ekids_master_index">
                                <field name="index" readonly="1"/>
                            </div>
                            <div>
                                <span class="text-uppercase text-muted fw-bold block" style="font-size: 10px; letter-spacing: 0.5px; color:#94A3B8;">Mã phiếu hệ thống</span>
                                <h2 class="text-xl font-black text-slate-800 leading-tight mb-0" style="font-weight: 900; color:#1E293B;">
                                    KH-<field name="name" readonly="1"/>
                                </h2>
                            </div>
                        </div>

                        <div class="row g-3 mb-4 ekids_master_box">
                            <div class="col-md-4 col-12">
                                <div class="master_label"><i class="fa fa-child text-primary me-1.5"></i>Họ và tên trẻ</div>
                                <div class="master_value"><field name="hocsinh_id" options="{'no_open': True}"/></div>
                            </div>

                            <div class="col-md-4 col-12">
                                <div class="master_label"><i class="fa fa-calendar-minus-o text-warning me-1.5"></i>Chu kỳ áp dụng</div>
                                <div class="d-flex align-items-center gap-1.5 font-monospace master_value">
                                    <span class="px-2 py-0.5 bg-white border rounded shadow-sm"><field name="tu_ngay"/></span>
                                    <i class="fa fa-long-arrow-right text-muted mx-0.5" style="font-size:11px;"></i>
                                    <span class="px-2 py-0.5 bg-white border rounded shadow-sm"><field name="den_ngay"/></span>
                                </div>
                            </div>

                            <div class="col-md-4 col-12">
                                <div class="master_label"><i class="fa fa-clock-o text-success me-1.5"></i>Quỹ thời gian</div>
                                <div class="mt-0.5">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-extrabold bg-blue-50 text-blue-700 border border-blue-200">
                                        <strong><field name="songay"/></strong> ngày can thiệp thực tế
                                    </span>
                                </div>
                            </div>
                        </div>

                        <notebook>

                            <page string="Nội dung Giáo án &amp; Mục tiêu" icon="fa-graduation-cap">
                                <div class="ekids_table_holder mt-2">

                                    <field name="kehoach_linhvuc_ids" nolabel="1">
                                        <list string="Lĩnh vực can thiệp đợt này" default_order="sequence">
                                            <field name="sequence" widget="handle"/>
                                            <field name="linhvuc_id"/>
                                            <field name="tuoi_id"/>

                                        </list>

                                        <form string="Chi tiết Mục tiêu của Lĩnh vực">
                                            <sheet class="p-4 bg-white">
                                                <div class="p-3 mb-4 rounded-3" style="background-color: #F0F9FF; border: 1px solid #BAE6FD;">
                                                    <span class="text-uppercase text-muted font-weight-bold d-block mb-1" style="font-size:10px; color:#0369A1 !important;">Lĩnh vực đang thiết lập mục tiêu</span>
                                                    <h4 class="fw-black mb-0" style="color:#0369A1; font-weight:800;"><field name="linhvuc_id" options="{'no_open': True}"/> (<field name="tuoi_id"/>)</h4>
                                                </div>

                                                <h5 class="fw-bold text-secondary mb-2" style="font-size:13px;"><i class="fa fa-check-square-o text-success me-1.5"></i>DANH SÁCH CÁC MỤC TIÊU CHI TIẾT</h5>
                                                <field name="muctieu_ids" nolabel="1">
                                                    <list editable="bottom">
                                                        <field name="sequence" widget="handle"/>
                                                        <field name="name" string="Nội dung bài học/mục tiêu can thiệp"/>
                                                        <field name="chucnang" string="Hướng dẫn lập luận lâm sàng" optional="show"/>
                                                    </list>
                                                </field>
                                            </sheet>
                                        </form>
                                    </field>
                                </div>
                            </page>

                            <page string="Ý kiến phê duyệt chuyên môn" icon="fa-commenting-o">
                                <div class="p-3 rounded-3 mt-2" style="border-left: 4px solid #7C3AED; background-color: #F8FAFC;">
                                    <h5 class="fw-extrabold mb-2 text-uppercase" style="color: #6D28D9; font-size: 13px; letter-spacing: 0.5px;">
                                        <i class="fa fa-shield me-1.5"></i>Ghi chú phê duyệt từ Hội đồng chuyên môn
                                    </h5>
                                    <field name="desc" nolabel="1" placeholder="Nội dung góp ý, chỉnh sửa kế hoạch can thiệp từ quản lý chuyên môn..."/>
                                </div>
                            </page>

                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>


  </data>
</odoo>