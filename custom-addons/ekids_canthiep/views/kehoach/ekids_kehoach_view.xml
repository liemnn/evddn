<odoo>
  <data>
      <record id="ekids_canthiep.lap_kehoach_form" model="ir.ui.view">
            <field name="name">ekids.kehoach.workspace.form</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <form string="Thiết lập Kế hoạch Can thiệp">
                    <style>
                        /* RESET NỀN FORM */
                        .o_form_view .o_form_sheet_bg { background-color: #F8FAFC !important; padding: 20px !important;}
                        .o_form_sheet { padding: 0 !important; max-width: 100% !important; border: none !important; background: transparent !important; margin: 0 auto;}

                        /* THIẾT KẾ KHỐI HEADER */
                        .workspace-mock { background: white; border: 1px solid #CBD5E1; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.04); margin-bottom: 25px;}

                        /* Thêm justify-content: space-between để tự động đẩy nút sang mép phải */
                        .ws-header { background: #F8FAFC; padding: 15px 20px; border-bottom: 1px solid #E2E8F0; display: flex; align-items: center; justify-content: space-between; gap: 10px;}

                        .ws-body { padding: 15px; }
                        .ws-info-bar { display: flex; gap: 20px; flex-wrap: wrap; background: #EFF6FF; padding: 12px 15px; border-radius: 8px; border: 1px solid #BFDBFE;}
                        .ws-field { flex: 1; min-width: 200px; display: flex; align-items: center; gap: 10px;}
                        .ws-label { font-weight: 700; color: #1E3A8A; font-size: 13px; white-space: nowrap;}

                        /* ======================================================== */
                        /* TÙY CHỈNH BẢNG KANBAN THÀNH DẠNG TRELLO BOARD            */
                        /* ======================================================== */

                        /* Tùy chỉnh Cột (Lĩnh vực) */
                        .o_kanban_view.o_kanban_grouped .o_kanban_group {
                            background-color: #F1F5F9 !important; /* Nền xám nhạt cho cột */
                            border-radius: 12px;
                            margin-right: 15px;
                            padding: 10px;
                            border: 1px solid #E2E8F0;
                        }

                        /* Header của Cột (Tên Lĩnh vực) */
                        .o_kanban_view.o_kanban_grouped .o_kanban_header {
                            border-bottom: 2px solid #CBD5E1;
                            padding-bottom: 10px;
                            margin-bottom: 10px;
                        }
                        .o_kanban_view.o_kanban_grouped .o_kanban_header_title {
                            font-weight: 800 !important;
                            color: #1E3A8A !important;
                            font-size: 14px;
                            text-transform: uppercase;
                        }
                    </style>

                    <header>
                        <field name="trangthai" widget="statusbar" statusbar_visible="0,2,1,-1" options="{'clickable': false}"/>
                    </header>

                    <sheet>

                        <div class="workspace-mock">

                            <div class="ws-header">
                                <div class="fw-bold text-primary fs-5">
                                    <i class="fa fa-info-circle me-1"></i> THÔNG TIN KẾ HOẠCH
                                </div>

                                <button name="action_xem_ketluan"
                                        string="Xem kết luận đánh giá"
                                        type="object"
                                        icon="fa-eye"
                                        class="btn-outline-primary btn-sm fw-bold bg-white"
                                        invisible="trangthai != '0'"/>
                            </div>

                            <div class="ws-body">
                                <div class="ws-info-bar">
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-user-circle-o me-1"></i>Học sinh:</span>
                                        <field name="hocsinh_id" readonly="1" class="fw-bold"/>
                                    </div>
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-calendar-play-o me-1"></i>Từ ngày:</span>
                                        <field name="tu_ngay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important;"/>
                                    </div>
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-calendar-play-o me-1"></i>Đến ngày:</span>
                                        <field name="den_ngay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important;"/>
                                    </div>
                                    <div class="ws-field">
                                        <span class="ws-label"><i class="fa fa-clock-o me-1"></i>Kế hoạch dự kiến:</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <field name="songay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important; width: 60px; text-align: center;"/>
                                            <span class="text-muted fw-bold">ngày</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <separator string="CÁC MỤC TIÊU TRONG KẾ HOẠCH"/>

                        <field name="kehoach_muctieu_ids" nolabel="1" domain="[('kehoach_id','=',id)]">

                            <list string="Danh sách Mục tiêu" decoration-muted="id == False">
                                <field name="sequence" widget="handle"/>

                                <field name="linhvuc_id" string="Lĩnh vực" class="fw-bold text-primary" style="width: 25%;"/>
                                <field name="tuoi_id" string="Độ tuổi" class="fw-bold text-danger" style="width: 15%;"/>
                                <field name="name" string="Tên Mục tiêu &amp; Mô tả" style="width: 60%;"/>
                            </list>

                            <kanban default_order="sequence" create="0" class="o_kanban_small_column">
                                <field name="sequence"/>
                                <field name="linhvuc_id"/>
                                <field name="tuoi_id"/>
                                <field name="name"/>

                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click" style="background: white; border: 1px solid #E2E8F0; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); padding: 16px; margin-bottom: 15px; display: flex; flex-direction: column; gap: 12px; transition: all 0.2s ease;">

                                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="text-muted" title="Kéo thả để sắp xếp" style="cursor: grab; font-size: 1.1rem;">
                                                        <field name="sequence" widget="handle"/>
                                                    </span>

                                                    <span class="badge" style="background-color: #EFF6FF; color: #1E3A8A; border: 1px solid #BFDBFE; font-size: 0.8rem; padding: 6px 10px; border-radius: 6px;">
                                                        <i class="fa fa-folder-open me-1 text-warning"></i> <field name="linhvuc_id"/>
                                                    </span>
                                                </div>
                                                <span class="badge" style="background-color: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; font-size: 0.8rem; padding: 6px 10px; border-radius: 6px;">
                                                    <field name="tuoi_id"/>
                                                </span>
                                            </div>

                                            <div class="fw-bold fs-6 text-dark mt-1" style="line-height: 1.5; flex-grow: 1;">
                                                <field name="name"/>
                                            </div>

                                            <div class="text-end mt-1 pt-2" style="border-top: 1px dashed #F1F5F9;">
                                                <span style="color: #2563EB; font-weight: 700; font-size: 0.85rem; padding: 4px 8px; border-radius: 4px; background: #F8FAFC; border: 1px solid #E2E8F0;">
                                                    Xem chi tiết <i class="fa fa-arrow-right ms-1"></i>
                                                </span>
                                            </div>

                                        </div>
                                    </t>
                                </templates>
                            </kanban>

                        </field>
                    </sheet>
                </form>
            </field>
        </record>


  </data>
</odoo>