<odoo>
  <data>
      <record id="ekids_canthiep.lap_kehoach_form" model="ir.ui.view">
          <field name="name">ekids.kehoach.workspace.form</field>
          <field name="model">ekids.kehoach</field>
          <field name="arch" type="xml">
              <form string="Thiết lập Kế hoạch Can thiệp">
                  <style>
                      /* RESET NỀN FORM */
                      .o_form_view .o_form_sheet_bg { background-color: #F8FAFC !important; padding: 20px !important;}
                      .o_form_sheet { padding: 0 !important; max-width: 100% !important; border: none !important; background: transparent !important; margin: 0 auto;}

                      /* THIẾT KẾ KHỐI HEADER */
                      .workspace-mock { background: white; border: 1px solid #CBD5E1; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.04); margin-bottom: 20px;}
                      .ws-header { background: #F8FAFC; padding: 15px 20px; border-bottom: 1px solid #E2E8F0; display: flex; align-items: center; gap: 10px;}
                      .ws-body { padding: 20px; }
                      .ws-info-bar { display: flex; gap: 20px; flex-wrap: wrap; background: #EFF6FF; padding: 15px; border-radius: 8px; border: 1px solid #BFDBFE;}
                      .ws-field { flex: 1; min-width: 200px; display: flex; align-items: center; gap: 10px;}
                      .ws-label { font-weight: 700; color: #1E3A8A; font-size: 13px; white-space: nowrap;}

                      /* ======================================================== */
                      /* TÙY CHỈNH BẢNG KANBAN THÀNH DẠNG TRELLO BOARD            */
                      /* ======================================================== */

                      /* Tùy chỉnh Cột (Lĩnh vực) */
                      .o_kanban_view.o_kanban_grouped .o_kanban_group {
                          background-color: #F1F5F9 !important; /* Nền xám nhạt cho cột */
                          border-radius: 12px;
                          margin-right: 15px;
                          padding: 10px;
                          border: 1px solid #E2E8F0;
                      }

                      /* Header của Cột (Tên Lĩnh vực) */
                      .o_kanban_view.o_kanban_grouped .o_kanban_header {
                          border-bottom: 2px solid #CBD5E1;
                          padding-bottom: 10px;
                          margin-bottom: 10px;
                      }
                      .o_kanban_view.o_kanban_grouped .o_kanban_header_title {
                          font-weight: 800 !important;
                          color: #1E3A8A !important;
                          font-size: 14px;
                          text-transform: uppercase;
                      }
                  </style>

                  <sheet>
                      <div class="workspace-mock">
                          <div class="ws-header">
                              <i class="fa fa-file-text-o" style="color: #2563EB; font-size: 1.2rem;"></i>
                              <span style="font-weight: 800; color: #1E293B; font-size: 15px;">LẬP KẾ HOẠCH CAN THIỆP CHO TRẺ</span>
                          </div>
                          <div class="ws-body">
                              <div class="ws-info-bar">
                                  <div class="ws-field">
                                      <span class="ws-label"><i class="fa fa-user-circle-o me-1"></i>Học sinh:</span>
                                      <field name="hocsinh_id" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important;" options="{'no_create': True}"/>
                                  </div>
                                  <div class="ws-field">
                                      <span class="ws-label"><i class="fa fa-calendar-play-o me-1"></i>Từ ngày:</span>
                                      <field name="tu_ngay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important;"/>
                                  </div>
                                  <div class="ws-field">
                                      <span class="ws-label"><i class="fa fa-calendar-check-o me-1"></i>Đến ngày:</span>
                                      <field name="den_ngay" required="1" class="fw-bold bg-white border rounded px-2 py-1 text-dark" style="border-color: #CBD5E1 !important;"/>
                                  </div>
                              </div>
                          </div>
                      </div>

                      <field name="kehoach_muctieu_ids" mode="kanban" context="{'default_group_by': 'kehoach_linhvuc_id'}">

                          <kanban  class="o_kanban_small_column">
                              <field name="linhvuc_id"/>
                              <field name="tuoi_id"/>

                              <field name="kehoach_muctieu_ids"/>

                              <templates>
                                  <t t-name="kanban-box">
                                      <div class="oe_kanban_global_click" style="background: white; border: 1px solid #BFDBFE; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.03); padding: 15px; margin-bottom: 12px; transition: 0.2s;">

                                          <div class="float-end">
                                              <a type="delete" class="text-danger" title="Xóa mục tiêu này"><i class="fa fa-trash"></i></a>
                                          </div>

                                          <div class="fw-bold fs-6 text-primary mb-3 pe-4" style="line-height: 1.4;">
                                              <i class="fa fa-bullseye me-1 text-warning"></i> <field name="muctieu_id"/>
                                          </div>

                                          <div class="border-top pt-2 mt-2">
                                              <div class="text-muted small fw-bold mb-2"><i class="fa fa-cogs"></i> Chuyên đề / Chương trình:</div>
                                              <field name="kehoach_muctieu_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                          </div>

                                      </div>
                                  </t>
                              </templates>
                          </kanban>

                          <form string="Chi tiết Mục tiêu">
                              <sheet>
                                  <div class="d-flex gap-3 mb-4 p-3 rounded" style="background: #EFF6FF; border: 1px solid #BFDBFE;">
                                      <div class="flex-grow-1">
                                          <label class="fw-bold text-muted small text-uppercase">Thuộc Lĩnh vực</label>
                                          <field name="linhvuc_id" class="fw-bold fs-5 text-primary w-100" options="{'no_create': True}"/>
                                      </div>
                                  </div>

                                  <group>
                                      <field name="kehoach_muctieu_id" class="fw-bold fs-6" options="{'no_create': True}"/>
                                      <field name="muctieu_ids" widget="many2many_tags" />
                                  </group>
                              </sheet>
                          </form>

                      </field>
                  </sheet>
              </form>
          </field>
      </record>


  </data>
</odoo>