<odoo>
  <data>

      <record id="ekids_canthiep.lap_kehoach_form" model="ir.ui.view">
            <field name="name">ekids.intervention.plan.form</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <form string="Kế hoạch Can thiệp">

                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="hocsinh_id"/>
                            </group>
                            <group>
                                <field name="tu_ngay"/>
                                <field name="den_ngay"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Lĩnh vực và Mục tiêu can thiệp">

                                <field name="kehoach_linhvuc_ids">
                                    <list string="Lĩnh vực">
                                        <field name="linhvuc_id"/>
                                        <field name="tuoi_id"/>
                                    </list>

                                    <form string="Chi tiết Lĩnh vực">
                                        <group>
                                            <group>
                                                <field name="linhvuc_id"/>
                                            </group>
                                            <group>
                                                <field name="tuoi_id"/>
                                            </group>
                                        </group>

                                        <field name="kehoach_muctieu_ids">
                                            <list string="Mục tiêu">
                                                <field name="sequence" widget="handle"/>
                                                <field name="muctieu_id"/>

                                            </list>

                                            <form string="Chi tiết Mục tiêu">
                                                <sheet>
                                                    <group>
                                                        <field name="muctieu_id"/>

                                                    </group>

                                                    <separator string="Chức năng phát triển &amp; Lập luận lâm sàng" style="color: #6D28D9;"/>
                                                    
                                                </sheet>
                                            </form>
                                        </field>
                                    </form>
                                </field>

                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


  </data>
</odoo>