<odoo>
  <data>
       <record id="ekids_canthiep.kehoach_list" model="ir.ui.view">
            <field name="name">ekids.kehoach.list</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <list string="Danh sách Kế hoạch can thiệp"
                      default_order="tu_ngay desc" create="false" delete="false">

                    <field name="index" string="STT" />
                    <field name="hocsinh_id" string="Học sinh" />

                    <field name="tu_ngay" string="Từ ngày" />
                    <field name="den_ngay" string="Đến ngày" />
                    <field name="songay" string="Số ngày" />
                    <field name="gv_lapkehoach_id" />
                    <field name="gv_kiemduyet_id" />
                    <field name="gv_canthiep_id" />
                     <field name="trangthai"/>

                </list>
            </field>
        </record>
       <record id="ekids_canthiep.kehoach_kanban" model="ir.ui.view">
            <field name="name">Kế hoạch can thiệp - Premium SaaS Design V2</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <kanban default_order="id desc" sample="1" class="ekids_premium_kehoach_v2" create="false" default_group_by="trangthai">

                    <field name="id"/>
                    <field name="index"/>
                    <field name="hocsinh_id"/>
                    <field name="gv_lapkehoach_id"/>
                    <field name="gv_kiemduyet_id"/>
                    <field name="gv_canthiep_id"/>
                    <field name="trangthai"/>
                    <field name="trangthai_pheduyet"/>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="songay"/>
                    <field name="is_gui_pheduyet"/>
                    <field name="is_pheduyet"/>

                    <templates>
                        <t t-name="kanban-box">

                            <style>
                                /* Khóa khung bao mặc định thô sơ của Odoo */
                                .ekids_premium_kehoach_v2 .o_kanban_record {
                                    width: 100% !important;
                                    flex: 0 0 100% !important;
                                    margin: 0 0 16px 0 !important;
                                    padding: 0 !important;
                                    background: transparent !important;
                                    border: none !important;
                                }

                                /* --- 📱 LAYOUT DI ĐỘNG (MOBILE FIRST) --- */
                                .k_master_card {
                                    background: #FFFFFF !important;
                                    border: 1px solid #E2E8F0 !important;
                                    border-radius: 24px !important;
                                    box-shadow: 0 4px 20px rgba(148, 163, 184, 0.06) !important;
                                    padding: 16px !important;
                                    display: flex !important;
                                    flex-direction: column !important;
                                    gap: 12px !important;
                                    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                                }

                                .k_card_header {
                                    display: flex !important;
                                    align-items: center !important;
                                    justify-content: space-between !important;
                                    padding-bottom: 12px !important;
                                    border-bottom: 1px solid #F1F5F9 !important;
                                }

                                /* Vòng tròn số ID cá tính màu xanh chủ đạo */
                                .k_avatar_index {
                                    width: 38px !important;
                                    height: 38px !important;
                                    border-radius: 12px !important;
                                    background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%) !important;
                                    color: #0369A1 !important;
                                    font-weight: 800 !important;
                                    font-size: 15px !important;
                                    display: flex !important;
                                    align-items: center !important;
                                    justify-content: center !important;
                                }

                                .k_student_name {
                                    font-size: 16px !important;
                                    font-weight: 800 !important;
                                    color: #0F172A !important;
                                    margin: 0 !important;
                                    letter-spacing: -0.3px !important;
                                }

                                /* Hộp kén chức năng phân vùng nội dung (Inner Pods) */
                                .k_inner_pod {
                                    background: #F8FAFC !important;
                                    border: 1px solid #F1F5F9 !important;
                                    border-radius: 16px !important;
                                    padding: 12px !important;
                                }

                                .k_pod_title {
                                    font-size: 11px !important;
                                    font-weight: 700 !important;
                                    color: #94A3B8 !important;
                                    text-transform: uppercase !important;
                                    letter-spacing: 0.5px !important;
                                    margin-bottom: 8px !important;
                                    display: flex !important;
                                    align-items: center !important;
                                    gap: 6px !important;
                                }

                                .k_teacher_row {
                                    display: flex !important;
                                    align-items: center !important;
                                    justify-content: space-between !important;
                                    font-size: 12.5px !important;
                                    padding: 5px 0 !important;
                                    border-bottom: 1px dashed #E2E8F0 !important;
                                }
                                .k_teacher_row:last-child {
                                    border-bottom: none !important;
                                }

                                /* Nhãn trạng thái viên thuốc chuẩn Apple */
                                .k_status_pill {
                                    padding: 6px 12px !important;
                                    border-radius: 10px !important;
                                    font-size: 12px !important;
                                    font-weight: 700 !important;
                                    display: inline-flex !important;
                                    align-items: center !important;
                                    gap: 4px !important;
                                }
                                .status_dang_lap { background: #FEF3C7 !important; color: #D97706 !important; }
                                .status_doi_duyet { background: #E0F2FE !important; color: #0369A1 !important; }
                                .status_canthiep { background: #D1FAE5 !important; color: #065F46 !important; }
                                .status_het_han { background: #FEE2E2 !important; color: #991B1B !important; }

                                /* Hệ thống nút bấm Premium có đổ bóng mềm đổ màu tương ứng nút gốc */
                                .k_btn_action {
                                    color: #FFFFFF !important;
                                    font-weight: 800 !important;
                                    font-size: 13px !important;
                                    padding: 10px 16px !important;
                                    border-radius: 14px !important;
                                    border: none !important;
                                    display: inline-flex !important;
                                    align-items: center !important;
                                    justify-content: center !important;
                                    gap: 6px !important;
                                    width: 100% !important;
                                    transition: all 0.2s ease;
                                }
                                .btn_sua { background: linear-gradient(135deg, #FBBF24 0%, #D97706 100%) !important; color: #000000 !important; box-shadow: 0 4px 14px rgba(217, 119, 6, 0.2) !important; }
                                .btn_duyet { background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%) !important; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25) !important; }
                                .btn_canthiep { background: linear-gradient(135deg, #10B981 0%, #047857 100%) !important; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25) !important; }
                                .btn_khongdat { background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%) !important; box-shadow: 0 4px 14px rgba(239, 68, 68, 0.2) !important; }
                                .btn_ketthuc { background: #64748B !important; box-shadow: 0 4px 14px rgba(100, 116, 139, 0.2) !important; }

                                .k_btn_action:hover {
                                    transform: translateY(-1px) !important;
                                    opacity: 0.95;
                                }

                                /* --- 💻 ĐỀ GIAO DIỆN KHI XEM TRÊN MÁY TÍNH (MÀN HÌNH RỘNG NẰM PHẲNG TRÊN 1 DÒNG) --- */
                                @media (min-width: 992px) {
                                    .k_master_card {
                                        flex-direction: row !important;
                                        align-items: center !important;
                                        padding: 16px 20px !important;
                                        gap: 20px !important;
                                    }
                                    .k_card_header {
                                        border-bottom: none !important;
                                        padding-bottom: 0 !important;
                                        flex-direction: column !important;
                                        align-items: flex-start !important;
                                        justify-content: center !important;
                                        gap: 6px !important;
                                    }
                                    .k_inner_pod {
                                        background: transparent !important;
                                        border: none !important;
                                        padding: 0 !important;
                                        border-radius: 0 !important;
                                    }
                                    .k_teacher_row {
                                        border-bottom: none !important;
                                        justify-content: flex-start !important;
                                        gap: 8px !important;
                                        padding: 2px 0 !important;
                                    }
                                    .k_btn_action {
                                        width: auto !important;
                                    }

                                    /* Chia cột phẳng đối xứng tuyệt đối trên Web */
                                    .k-col-1 { flex: 1.4 !important; min-width: 250px !important; }
                                    .k-col-2 { flex: 1.3 !important; min-width: 260px !important; border-left: 1px solid #E2E8F0 !important; padding-left: 20px !important; }
                                    .k-col-3 { flex: 1.2 !important; min-width: 240px !important; border-left: 1px solid #E2E8F0 !important; padding-left: 20px !important; }
                                    .k-col-4 { flex: 1.1 !important; min-width: 210px !important; border-left: 1px solid #E2E8F0 !important; padding-left: 20px !important; display: flex !important; flex-direction: column !important; align-items: flex-end !important; justify-content: space-between !important; min-height: 85px; }
                                }
                            </style>

                            <div class="o_dropdown_kanban dropdown" style="position: absolute; right: 10px; top: 10px; z-index: 10;">
                                <a class="dropdown-toggle o-no-caret btn btn-sm text-muted" role="button" data-bs-toggle="dropdown" href="#">
                                    <i class="fa fa-ellipsis-v fa-lg"></i>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item text-primary">
                                        <i class="fa fa-pencil me-2"></i> Sửa cấu trúc
                                    </a>
                                </div>
                            </div>

                            <div class="k_master_card">

                                <div class="k-col-1 d-flex flex-column gap-2">
                                    <div class="k_card_header">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="k_avatar_index"><t t-esc="record.index.raw_value"/></div>
                                            <div>
                                                <h4 class="k_student_name"><field name="hocsinh_id"/></h4>
                                                <div class="text-muted font-monospace mt-0.5" style="font-size: 11.5px;">
                                                    <i class="fa fa-hashtag me-1"></i>Mã KH: #<t t-esc="record.id.raw_value"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-md-none">
                                            <t t-if="record.trangthai.raw_value == 'dang_lap'"><span class="k_status_pill status_dang_tao">Đang lập</span></t>
                                            <t t-elif="record.trangthai.raw_value == 'dang_pheduyet'"><span class="k_status_pill status_doi_duyet">Đợi duyệt</span></t>
                                            <t t-elif="record.trangthai.raw_value == 'dang_canthiep'"><span class="k_status_pill status_canthiep">Can thiệp</span></t>
                                            <t t-else=""><span class="k_status_pill status_het_han">Hết hiệu lực</span></t>
                                        </div>
                                    </div>
                                </div>

                                <div class="k-col-2 k_inner_pod">
                                    <div class="k_pod_title"><i class="fa fa-calendar-check-o text-warning"></i> Chu kỳ kế hoạch</div>
                                    <div class="d-flex flex-column gap-1.5" style="font-size: 13px;">
                                        <div>
                                            <span class="text-muted">Từ ngày:</span> <b class="text-dark"><field name="tu_ngay"/></b>
                                        </div>
                                        <div>
                                            <span class="text-muted">Đến ngày:</span> <b class="text-dark"><field name="den_ngay"/></b>
                                        </div>
                                        <div>
                                            <span class="text-muted">Tổng thời hạn:</span>
                                            <span class="badge bg-light text-dark border fw-bold px-2 py-0.5" style="font-size:11.5px;">
                                                <t t-esc="record.songay.value"/> ngày
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="k-col-3 k_inner_pod">
                                    <div class="k_pod_title"><i class="fa fa-users text-info"></i> Ban nhân sự phụ trách</div>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="k_teacher_row">
                                            <span class="text-muted" style="font-size:11.5px;"><i class="fa fa-pencil text-muted me-1"></i>Người lập:</span>
                                            <span class="text-slate-800 fw-semibold"><field name="gv_lapkehoach_id"/></span>
                                        </div>
                                        <div class="k_teacher_row">
                                            <span class="text-muted" style="font-size:11.5px;"><i class="fa fa-shield text-muted me-1"></i>Người duyệt:</span>
                                            <span class="text-slate-800 fw-semibold"><field name="gv_kiemduyet_id"/></span>
                                        </div>
                                        <div class="k_teacher_row">
                                            <span class="text-muted" style="font-size:11.5px;"><i class="fa fa-graduation-cap text-muted me-1"></i>Can thiệp:</span>
                                            <span class="text-primary font-weight-bold" style="font-weight: 700;"><field name="gv_canthiep_id"/></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="k-col-4">
                                    <div class="d-none d-md-block">
                                        <t t-if="record.trangthai.raw_value == 'dang_lap'">
                                            <span class="k_status_pill status_dang_tao">
                                                <i class="fa fa-circle me-1" style="font-size:5px;"></i><field name="trangthai"/>
                                            </span>
                                        </t>
                                        <t t-elif="record.trangthai.raw_value == 'dang_pheduyet'">
                                            <span class="k_status_pill status_doi_duyet">
                                                <i class="fa fa-circle me-1" style="font-size:5px;"></i><field name="trangthai"/>
                                            </span>
                                        </t>
                                        <t t-elif="record.trangthai.raw_value == 'dang_canthiep'">
                                            <span class="k_status_pill status_canthiep">
                                                <i class="fa fa-circle me-1" style="font-size:5px;"></i><field name="trangthai"/>
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="k_status_pill status_het_han">
                                                <i class="fa fa-circle me-1" style="font-size:5px;"></i><field name="trangthai"/>
                                            </span>
                                        </t>
                                    </div>

                                    <div class="w-100 d-flex gap-1.5 justify-content-end align-items-center mt-2">

                                        <t t-if="record.trangthai.raw_value == 'dang_lap'">
                                            <button name="action_xem_kehoach" type="object" class="k_btn_action btn_sua" onclick="event.stopPropagation();">
                                                <i class="fa fa-pencil-square-o"></i> Sửa
                                            </button>
                                            <button t-if="record.is_gui_pheduyet.raw_value" name="action_gui_pheduyet" type="object" class="k_btn_action btn_duyet" onclick="event.stopPropagation();">
                                                <i class="fa fa-paper-plane"></i> Gửi duyệt
                                            </button>
                                        </t>

                                        <t t-if="record.trangthai.raw_value == 'dang_pheduyet' and record.is_pheduyet.raw_value">
                                            <button name="action_pheduyet_dat" type="object" class="k_btn_action btn_canthiep" onclick="event.stopPropagation();">
                                                <i class="fa fa-check"></i> Duyệt đạt
                                            </button>
                                            <button name="action_pheduyet_khongdat" type="object" class="k_btn_action btn_khongdat" onclick="event.stopPropagation();">
                                                <i class="fa fa-times"></i> Từ chối
                                            </button>
                                        </t>

                                        <t t-if="record.trangthai.raw_value == 'dang_canthiep'">
                                            <button name="action_canthiep" type="object" class="k_btn_action btn_canthiep" onclick="event.stopPropagation();">
                                                <i class="fa fa-play-circle"></i> Dạy &amp; Ghi nhận
                                            </button>
                                            <button name="action_ketthuc_kehoach" type="object" class="k_btn_action btn_ketthuc"
                                                    confirm="Bạn chắc chắc muốn kết thúc [Kế hoạch] này để chuyển sang Kế hoạch tiếp theo ?"
                                                    onclick="event.stopPropagation();">
                                                <i class="fa fa-check-circle"></i> Kết thúc
                                            </button>
                                        </t>

                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ekids_canthiep.kehoach_form" model="ir.ui.view">
            <field name="name">ekids.kehoach.form</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <form string="Kế hoạch Can thiệp">
                    <field name="is_pheduyet" invisible="1"/>
                    <field name="is_gui_pheduyet" invisible="1"/>

                    <!-- CONTROL HEADER BAR -->
                    <header>
                        <button name="action_gui_pheduyet"
                                string="Gửi phê duyệt"
                                type="object"
                                icon="fa-paper-plane"
                                class="btn-success fw-bold"
                                confirm="Bạn chắc chắn muốn gửi [Kế hoạch] lên quản lý chuyên môn để duyệt không ?"
                                invisible=" not is_gui_pheduyet"/>

                        <button name="action_pheduyet_dat"
                                string="Duyệt đồng ý [Kế hoạch]"
                                type="object"
                                icon="fa-check-circle"
                                confirm="Bạn xác nhận [Kế hoạch] đã đạt để giáo viên tiến hành can thiệp theo thời gian trong kế hoạch"
                                class="btn-success fw-bold"
                                invisible="not is_pheduyet"/>

                        <button name="action_pheduyet_khongdat"
                                string="Không đạt [Sửa lại]"
                                type="object"
                                icon="fa-times-circle"
                                confirm="Bạn xác nhận [Kế hoạch] chưa đạt cần trả về cho giáo viên lập kế hoạch chỉnh sửa lại ?"
                                class="btn-danger fw-bold"
                                invisible="not is_pheduyet"/>

                        <field name="trangthai" widget="statusbar" statusbar_visible="0,2,1,-1" options="{'clickable': false}"/>
                    </header>

                    <sheet class="p-4 bg-white">

                        <!-- SYSTEM SUPER COMPACT & ACCENT ZONE STYLE -->
                        <style>
                            /* Khối không gian bo viền tạo điểm nhấn phía đầu */
                            .ekids_header_accent_zone {
                                background: #FFFFFF;
                                border: 1px solid #E4E7EC;
                                border-radius: 16px;
                                padding: 5px;
                                box-shadow: 0 1px 3px rgba(16, 24, 40, 0.04), 0 1px 2px rgba(16, 24, 40, 0.02);
                                margin-bottom: 22px;
                            }

                            /* Vòng tròn số thứ tự Index mầu sắc trẻ em rực rỡ */
                            .ekids_master_index {
                                width: 48px;
                                height: 48px;
                                border-radius: 50%;
                                background: linear-gradient(135deg, #38BDF8 0%, #0284C7 100%);
                                color: #FFFFFF !important;
                                display: flex;
                                align-items: center;
                                justify-content: center;

                                font-weight: 900;
                                font-size: 20px;
                                border: 2px solid #FFFFFF;
                                box-shadow: 0 4px 10px rgba(2, 132, 199, 0.2);
                                flex-shrink: 0;
                            }
                            .ekids_master_index span { font-weight: 950 !important; color: #FFFFFF !important; }

                            /* Ô nhập ngày tháng tinh giản cao cấp phủ mầu pastel nhẹ */
                            .compact_date_field input {
                                padding: 4px 8px !important;
                                height: 28px !important;
                                font-size: 13px !important;
                                font-weight: 700 !important;
                                text-align: center !important;
                                border-radius: 6px !important;
                                width: 110px !important;
                                border: 1px solid #D0D5DD !important;
                                background: #F8FAFC !important;
                                color: #1E293B !important;
                                box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
                                transition: all 0.2s;
                            }
                            .compact_date_field input:focus {
                                border-color: #3B82F6 !important;
                                background: #FFFFFF !important;
                                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;
                            }

                            /* Ép buộc Badge Đỏ co khít diện tích thực tế */
                            .ekids_red_compact_badge {
                                background-color: #FEF2F2 !important;
                                color: #DC2626 !important;
                                border: 1px solid #FCA5A5 !important;
                                font-size: 12.5px !important;
                                padding: 4px 10px !important;
                                border-radius: 6px !important;
                                font-weight: 900 !important;
                                display: inline-flex !important;
                                align-items: center !important;
                                gap: 5px !important;
                                width: auto !important;
                                max-width: fit-content !important;
                            }
                            .ekids_red_compact_badge .o_field_widget,
                            .ekids_red_compact_badge span,
                            .ekids_red_compact_badge input {
                                width: auto !important;
                                max-width: 40px !important;
                                display: inline-block !important;
                                text-align: center !important;
                                color: #DC2626 !important;
                                font-weight: 900 !important;
                                background: transparent !important;
                                border: none !important;
                                padding: 0 !important;
                            }

                            /* Custom nút bấm xem kết luận đồng điệu giao diện phẳng */
                            .btn_view_review {
                                font-size: 12.5px !important;
                                font-weight: 700 !important;
                                padding: 5px 14px !important;
                                border-radius: 8px !important;
                                border: 1px solid #D0D5DD !important;
                                background: #FFFFFF !important;
                                color: #344054 !important;
                                box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05) !important;
                                transition: all 0.15s;
                            }
                            .btn_view_review:hover {
                                background: #F8FAFC !important;
                                border-color: #98A2B3 !important;
                                color: #0284C7 !important;
                            }

                            /* ----------------------------------------------------- */
                            /* CẤU HÌNH KANBAN DÒNG PHẲNG KHÔNG CLICK TOÀN THẺ         */
                            /* ----------------------------------------------------- */
                            .ekids_inner_kanban_container .o_kanban_renderer .o_kanban_record {
                                width: 100% !important;
                                flex: 0 0 100% !important;
                                margin: 0 0 10px 0 !important;
                                padding: 0 !important;
                                background: transparent !important;
                                border: none !important;
                            }
                            .linhvuc_row_card {
                                background: #FFFFFF;
                                border: 1px solid #E4E7EC;
                                border-radius: 12px;
                                padding: 14px 18px;
                                width: 100%;
                                box-shadow: 0 2px 6px rgba(16, 24, 40, 0.01);
                                transition: all 0.15s ease-in-out;
                            }
                            /* Nút nhỏ Thêm Mục Tiêu Premium Blue */
                            .btn_add_muctieu_mini {
                                background-color: #2563EB !important;
                                color: #FFFFFF !important;
                                font-weight: 700 !important;
                                font-size: 12px !important;
                                padding: 4px 12px !important;
                                border-radius: 6px !important;
                                border: none !important;
                                box-shadow: 0 2px 4px rgba(37, 99, 235, 0.15) !important;
                                transition: all 0.15s ease;
                            }
                            .btn_add_muctieu_mini:hover {
                                background-color: #1D4ED8 !important;
                                box-shadow: 0 4px 8px rgba(37, 99, 235, 0.25) !important;
                            }
                            .custom_muctieu_html_holder { border-top: 1px dashed #E4E7EC; }
                        </style>

                        <!-- ===================================================================================== -->
                        <!-- KHỐI BIÊN TRÊN ĐƯỢC BO VIỀN (ACCENT ZONE)                                             -->
                        <!-- ===================================================================================== -->
                        <div class="ekids_header_accent_zone">
                            <div class="row align-items-center justify-content-between g-3">

                                <div class="col-xl-8 col-12 d-flex align-items-center gap-3">
                                    <div class="ekids_master_index">
                                        <field name="index" readonly="1"/>
                                    </div>

                                    <div class="d-flex flex-column gap-1.5">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge text-uppercase font-weight-bold" style="background: #E0F2FE; color: #0369A1; font-size: 10px; padding: 3px 6px; border-radius: 4px; border: 1px solid #BAE6FD;">
                                                Học sinh:</span>
                                            <h3 class="text-xl font-black mb-0" style="font-weight: bold; color:#1E293B;">
                                                <field name="hocsinh_id" readonly="1" options="{'no_open': True}"/>
                                            </h3>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 13px;">

                                            <span class="d-flex align-items-center justify-content-center rounded" style="width:24px; height:24px; background:#FEF3C7; border: 1px solid #FDE68A;">
                                                <i class="fa fa-calendar text-warning" style="font-size:12px;"></i>
                                            </span>
                                            <span class="fw-bold text-secondary" style="font-size: 13px;">
                                                Thời gian của [Kế hoạch]:</span>
                                            <field name="tu_ngay" class="compact_date_field"/>
                                            <i class="fa fa-long-arrow-right text-muted mx-0.5" style="font-size:11px;"></i>
                                            <field name="den_ngay" class="compact_date_field"/>

                                            <span class="badge ekids_red_compact_badge shadow-sm">
                                                <i class="fa fa-clock-o"></i>
                                                <strong><field name="songay"/></strong> ngày
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-4 col-12 d-flex flex-column align-items-end justify-content-center gap-2">
                                     <div class="p-1.5 rounded-3 border d-flex align-items-center shadow-inner bg-slate-50" style="border-color: #E4E7EC !important;">
                                        <field name="trangthai_pheduyet" widget="statusbar" statusbar_visible="0,1,-1" options="{'clickable': false}"/>
                                    </div>
                                    <button name="action_xem_ketluan"
                                            string="Xem kết luận đánh giá"
                                            type="object" icon="fa-file-text-o"
                                            class="btn_view_review"
                                            />


                                </div>

                            </div>
                        </div>

                        <!-- ========================================================== -->
                        <!-- TẦNG 3: HỆ THỐNG TABS QUẢN LÝ GIÁO ÁN CAN THIỆP            -->
                        <!-- ========================================================== -->
                        <notebook>
                            <page string="MỤC TIÊU TRONG LĨNH VỰC CỦA KẾ HOẠCH" icon="fa-graduation-cap">
                                <div class="ekids_inner_kanban_container mt-3">
                                    <field name="kehoach_linhvuc_ids" mode="kanban" nolabel="1" options="{'no_open': True}">

                                        <kanban class="o_kanban_mobile" default_order="sequence"
                                                create="0" delete="0" edit="0" open_form_view="0">
                                            <field name="id"/>
                                            <field name="sequence"/>
                                            <field name="linhvuc_id"/>
                                            <field name="tuoi_id"/>
                                            <field name="kehoach_muctieu_ids"/>
                                            <field name="muctieu_html"/>

                                            <templates>
                                                <t t-name="kanban-box">
                                                    <div class="linhvuc_row_card">

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="d-flex align-items-center justify-content-center bg-blue-50 rounded shadow-sm" style="width:28px; height:28px; border: 1px solid #BAE6FD;">
                                                                    <i class="fa fa-folder-open text-primary" style="font-size:13px;"></i>
                                                                </div>

                                                                <h4 class="fw-bold text-dark mb-0" style="font-size: 15px; font-weight: 800;">
                                                                    <field name="linhvuc_id" options="{'no_open': True}"/>
                                                                </h4>

                                                                <span class="badge" style="background-color: #F0FDF4; color: #16A34A; border: 1px solid #BBF7D0; font-size: 12px; font-weight: 700; padding: 3px 6px; border-radius: 5px;">
                                                                    <i class="fa fa-birthday-cake me-1"></i>
                                                                    <field name="tuoi_id" options="{'no_open': True}"/>
                                                                </span>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge" style="background-color: #E0F2FE; color: #0369A1; font-weight: 800; font-size: 11.5px; padding: 5px 10px; border-radius: 6px;">
                                                                    <i class="fa fa-tasks me-1"></i> Có <t t-esc="record.kehoach_muctieu_ids.raw_value.length"></t> mục tiêu
                                                                </span>

                                                                <button type="object" name="action_xem_danhsach_ct_muctieu"
                                                                        context="{'default_kehoach_linhvuc_id':id}"
                                                                        class="btn_add_muctieu_mini">
                                                                    <i class="fa fa-plus-circle me-1"></i>Thêm/xóa [mục tiêu]
                                                                </button>
                                                            </div>
                                                        </div>

                                                        <div class="mt-3 pt-2.5 custom_muctieu_html_holder">
                                                            <t t-out="record.muctieu_html.raw_value"></t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                    </field>
                                </div>
                            </page>

                            <page string="Mô tả, ý kiến làm rõ" icon="fa-commenting-o">
                                <div class="p-3 rounded-3 mt-2" style="border-left: 4px solid #7C3AED; background-color: #F8FAFC;">
                                    <h5 class="fw-extrabold mb-2 text-uppercase" style="color: #6D28D9; font-size: 13px; letter-spacing: 0.5px;">
                                        <i class="fa fa-shield me-1.5"></i>
                                        Ghi chú nội dung
                                    </h5>
                                    <field name="desc" nolabel="1" placeholder="Nội dung góp ý, chỉnh sửa kế hoạch can thiệp từ quản lý chuyên môn..."/>
                                </div>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

  </data>
</odoo>