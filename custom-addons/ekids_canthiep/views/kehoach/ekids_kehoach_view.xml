<odoo>
  <data>
        <record id="ekids_canthiep.kehoach_kanban" model="ir.ui.view">
            <field name="name">ekids.kehoach.kanban</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <kanban default_group_by="trangthai" class="o_kanban_mobile" create="false" sample="1">

                    <field name="id"/>
                    <field name="index"/>
                    <field name="hocsinh_id"/>
                    <field name="gv_lapkehoach_id"/>
                    <field name="gv_kiemduyet_id"/>
                    <field name="gv_canthiep_id"/>
                    <field name="trangthai"/>
                    <field name="trangthai_pheduyet"/>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="is_gui_pheduyet"/>
                    <field name="is_pheduyet"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill p-3">

                                <div class="o_kanban_record_top d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-secondary text-white fw-bold px-2 py-1" title="Số thứ tự kết luận">
                                            STT: <t t-esc="record.index.value"/>
                                        </span>
                                        <strong class="o_kanban_record_title text-primary fs-5 ms-1">
                                            <field name="hocsinh_id"/>
                                        </strong>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fa fa-calendar-o me-1"/>
                                        <t t-esc="record.tu_ngay.value"/> - <t t-esc="record.den_ngay.value"/>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body mb-3 text-secondary">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="fw-bold small me-2" style="width: 110px;"><i class="fa fa-pencil text-muted me-1"/> Người lập:</span>
                                        <span><field name="gv_lapkehoach_id"/></span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="fw-bold small me-2" style="width: 110px;"><i class="fa fa-gavel text-muted me-1"/> Người duyệt:</span>
                                        <span><field name="gv_kiemduyet_id"/></span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="fw-bold small me-2" style="width: 110px;"><i class="fa fa-user-md text-muted me-1"/> Can thiệp:</span>
                                        <span><field name="gv_canthiep_id"/></span>
                                    </div>
                                </div>

                                <div class="o_kanban_record_bottom d-flex align-items-center justify-content-between border-top pt-2">

                                    <div>
                                        <span t-if="record.trangthai.raw_value == 'dang_lap'" class="badge rounded-pill bg-warning text-dark fw-bold px-2 py-1">
                                            <i class="fa fa-edit me-1"/> Đang lập
                                        </span>
                                        <span t-if="record.trangthai.raw_value == 'dang_pheduyet'" class="badge rounded-pill bg-info text-white fw-bold px-2 py-1">
                                            <i class="fa fa-hourglass-half me-1"/> Đợi duyệt
                                        </span>
                                        <span t-if="record.trangthai.raw_value == 'dang_canthiep'" class="badge rounded-pill bg-success text-white fw-bold px-2 py-1">
                                            <i class="fa fa-play-circle me-1"/> Can thiệp
                                        </span>
                                        <span t-if="record.trangthai.raw_value == 'het_hieuluc'" class="badge rounded-pill bg-danger text-white fw-bold px-2 py-1">
                                            <i class="fa fa-archive me-1"/> Hết hiệu lực
                                        </span>
                                    </div>

                                    <div class="o_kanban_buttons">

                                        <t t-if="record.trangthai.raw_value == 'dang_lap'">
                                            <button name="action_xem_kehoach" type="object" class="btn btn-warning btn-sm text-dark fw-bold px-2" title="Sửa lại kế hoạch">
                                                <i class="fa fa-pencil-square-o"/> Sửa
                                            </button>
                                            <button t-if="record.is_gui_pheduyet.raw_value" name="action_gui_pheduyet" type="object" class="btn btn-primary btn-sm ms-1 px-2" title="Gửi lên cấp quản lý xét duyệt">
                                                <i class="fa fa-paper-plane"/> Gửi duyệt
                                            </button>
                                        </t>

                                        <t t-if="record.trangthai.raw_value == 'dang_pheduyet' and record.is_pheduyet.raw_value">
                                            <button name="action_pheduyet_dat" type="object" class="btn btn-success btn-sm px-2 text-white fw-bold" title="Phê duyệt Đạt">
                                                <i class="fa fa-check"/> Duyệt đạt
                                            </button>
                                            <button name="action_pheduyet_khongdat" type="object" class="btn btn-danger btn-sm ms-1 px-2 text-white" title="Yêu cầu điều chỉnh lại">
                                                <i class="fa fa-times"/> Từ chối
                                            </button>
                                        </t>

                                        <t t-if="record.trangthai.raw_value == 'dang_canthiep'">
                                            <button name="action_canthiep" type="object" class="btn btn-success btn-sm fw-bold px-2 text-uppercase" title="Ghi nhận kết quả học tập hàng ngày">
                                                <i class="fa fa-play-circle"/> Dạy &amp; Ghi nhận
                                            </button>

                                            <button name="action_ketthuc_kehoach" type="object"
                                                    class="btn btn-secondary btn-sm ms-1 px-2"
                                                    title="Kết thúc đợt can thiệp này"
                                                    confirm="Bạn chắc chắc muốn kết thúc [Kế hoạch] này để chuyển sang Kế hoạch tiếp theo ?">
                                                <i class="fa fa-check-circle"/> Kết thúc
                                            </button>
                                        </t>

                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ekids_canthiep.kehoach_form" model="ir.ui.view">
            <field name="name">ekids.kehoach.form</field>
            <field name="model">ekids.kehoach</field>
            <field name="arch" type="xml">
                <form string="Kế hoạch Can thiệp">
                    <field name="is_pheduyet" invisible="1"/>
                    <field name="is_gui_pheduyet" invisible="1"/>

                    <!-- CONTROL HEADER BAR -->
                    <header>
                        <button name="action_gui_pheduyet"
                                string="Gửi phê duyệt"
                                type="object"
                                icon="fa-paper-plane"
                                class="btn-success fw-bold"
                                confirm="Bạn chắc chắn muốn gửi [Kế hoạch] lên quản lý chuyên môn để duyệt không ?"
                                invisible=" not is_gui_pheduyet"/>

                        <button name="action_pheduyet_dat"
                                string="Duyệt đồng ý [Kế hoạch]"
                                type="object"
                                icon="fa-check-circle"
                                confirm="Bạn xác nhận [Kế hoạch] đã đạt để giáo viên tiến hành can thiệp theo thời gian trong kế hoạch"
                                class="btn-success fw-bold"
                                invisible="not is_pheduyet"/>

                        <button name="action_pheduyet_khongdat"
                                string="Không đạt [Sửa lại]"
                                type="object"
                                icon="fa-times-circle"
                                confirm="Bạn xác nhận [Kế hoạch] chưa đạt cần trả về cho giáo viên lập kế hoạch chỉnh sửa lại ?"
                                class="btn-danger fw-bold"
                                invisible="not is_pheduyet"/>

                        <field name="trangthai" widget="statusbar" statusbar_visible="0,2,1,-1" options="{'clickable': false}"/>
                    </header>

                    <sheet class="p-4 bg-white">

                        <!-- SYSTEM SUPER COMPACT & ACCENT ZONE STYLE -->
                        <style>
                            /* Khối không gian bo viền tạo điểm nhấn phía đầu */
                            .ekids_header_accent_zone {
                                background: #FFFFFF;
                                border: 1px solid #E4E7EC;
                                border-radius: 16px;
                                padding: 5px;
                                box-shadow: 0 1px 3px rgba(16, 24, 40, 0.04), 0 1px 2px rgba(16, 24, 40, 0.02);
                                margin-bottom: 22px;
                            }

                            /* Vòng tròn số thứ tự Index mầu sắc trẻ em rực rỡ */
                            .ekids_master_index {
                                width: 48px;
                                height: 48px;
                                border-radius: 50%;
                                background: linear-gradient(135deg, #38BDF8 0%, #0284C7 100%);
                                color: #FFFFFF !important;
                                display: flex;
                                align-items: center;
                                justify-content: center;

                                font-weight: 900;
                                font-size: 20px;
                                border: 2px solid #FFFFFF;
                                box-shadow: 0 4px 10px rgba(2, 132, 199, 0.2);
                                flex-shrink: 0;
                            }
                            .ekids_master_index span { font-weight: 950 !important; color: #FFFFFF !important; }

                            /* Ô nhập ngày tháng tinh giản cao cấp phủ mầu pastel nhẹ */
                            .compact_date_field input {
                                padding: 4px 8px !important;
                                height: 28px !important;
                                font-size: 13px !important;
                                font-weight: 700 !important;
                                text-align: center !important;
                                border-radius: 6px !important;
                                width: 110px !important;
                                border: 1px solid #D0D5DD !important;
                                background: #F8FAFC !important;
                                color: #1E293B !important;
                                box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
                                transition: all 0.2s;
                            }
                            .compact_date_field input:focus {
                                border-color: #3B82F6 !important;
                                background: #FFFFFF !important;
                                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;
                            }

                            /* Ép buộc Badge Đỏ co khít diện tích thực tế */
                            .ekids_red_compact_badge {
                                background-color: #FEF2F2 !important;
                                color: #DC2626 !important;
                                border: 1px solid #FCA5A5 !important;
                                font-size: 12.5px !important;
                                padding: 4px 10px !important;
                                border-radius: 6px !important;
                                font-weight: 900 !important;
                                display: inline-flex !important;
                                align-items: center !important;
                                gap: 5px !important;
                                width: auto !important;
                                max-width: fit-content !important;
                            }
                            .ekids_red_compact_badge .o_field_widget,
                            .ekids_red_compact_badge span,
                            .ekids_red_compact_badge input {
                                width: auto !important;
                                max-width: 40px !important;
                                display: inline-block !important;
                                text-align: center !important;
                                color: #DC2626 !important;
                                font-weight: 900 !important;
                                background: transparent !important;
                                border: none !important;
                                padding: 0 !important;
                            }

                            /* Custom nút bấm xem kết luận đồng điệu giao diện phẳng */
                            .btn_view_review {
                                font-size: 12.5px !important;
                                font-weight: 700 !important;
                                padding: 5px 14px !important;
                                border-radius: 8px !important;
                                border: 1px solid #D0D5DD !important;
                                background: #FFFFFF !important;
                                color: #344054 !important;
                                box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05) !important;
                                transition: all 0.15s;
                            }
                            .btn_view_review:hover {
                                background: #F8FAFC !important;
                                border-color: #98A2B3 !important;
                                color: #0284C7 !important;
                            }

                            /* ----------------------------------------------------- */
                            /* CẤU HÌNH KANBAN DÒNG PHẲNG KHÔNG CLICK TOÀN THẺ         */
                            /* ----------------------------------------------------- */
                            .ekids_inner_kanban_container .o_kanban_renderer .o_kanban_record {
                                width: 100% !important;
                                flex: 0 0 100% !important;
                                margin: 0 0 10px 0 !important;
                                padding: 0 !important;
                                background: transparent !important;
                                border: none !important;
                            }
                            .linhvuc_row_card {
                                background: #FFFFFF;
                                border: 1px solid #E4E7EC;
                                border-radius: 12px;
                                padding: 14px 18px;
                                width: 100%;
                                box-shadow: 0 2px 6px rgba(16, 24, 40, 0.01);
                                transition: all 0.15s ease-in-out;
                            }
                            /* Nút nhỏ Thêm Mục Tiêu Premium Blue */
                            .btn_add_muctieu_mini {
                                background-color: #2563EB !important;
                                color: #FFFFFF !important;
                                font-weight: 700 !important;
                                font-size: 12px !important;
                                padding: 4px 12px !important;
                                border-radius: 6px !important;
                                border: none !important;
                                box-shadow: 0 2px 4px rgba(37, 99, 235, 0.15) !important;
                                transition: all 0.15s ease;
                            }
                            .btn_add_muctieu_mini:hover {
                                background-color: #1D4ED8 !important;
                                box-shadow: 0 4px 8px rgba(37, 99, 235, 0.25) !important;
                            }
                            .custom_muctieu_html_holder { border-top: 1px dashed #E4E7EC; }
                        </style>

                        <!-- ===================================================================================== -->
                        <!-- KHỐI BIÊN TRÊN ĐƯỢC BO VIỀN (ACCENT ZONE)                                             -->
                        <!-- ===================================================================================== -->
                        <div class="ekids_header_accent_zone">
                            <div class="row align-items-center justify-content-between g-3">

                                <div class="col-xl-8 col-12 d-flex align-items-center gap-3">
                                    <div class="ekids_master_index">
                                        <field name="index" readonly="1"/>
                                    </div>

                                    <div class="d-flex flex-column gap-1.5">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge text-uppercase font-weight-bold" style="background: #E0F2FE; color: #0369A1; font-size: 10px; padding: 3px 6px; border-radius: 4px; border: 1px solid #BAE6FD;">
                                                Học sinh:</span>
                                            <h3 class="text-xl font-black mb-0" style="font-weight: bold; color:#1E293B;">
                                                <field name="hocsinh_id" readonly="1" options="{'no_open': True}"/>
                                            </h3>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 13px;">

                                            <span class="d-flex align-items-center justify-content-center rounded" style="width:24px; height:24px; background:#FEF3C7; border: 1px solid #FDE68A;">
                                                <i class="fa fa-calendar text-warning" style="font-size:12px;"></i>
                                            </span>
                                            <span class="fw-bold text-secondary" style="font-size: 13px;">
                                                Thời gian của [Kế hoạch]:</span>
                                            <field name="tu_ngay" class="compact_date_field"/>
                                            <i class="fa fa-long-arrow-right text-muted mx-0.5" style="font-size:11px;"></i>
                                            <field name="den_ngay" class="compact_date_field"/>

                                            <span class="badge ekids_red_compact_badge shadow-sm">
                                                <i class="fa fa-clock-o"></i>
                                                <strong><field name="songay"/></strong> ngày
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-4 col-12 d-flex flex-column align-items-end justify-content-center gap-2">
                                     <div class="p-1.5 rounded-3 border d-flex align-items-center shadow-inner bg-slate-50" style="border-color: #E4E7EC !important;">
                                        <field name="trangthai_pheduyet" widget="statusbar" statusbar_visible="0,1,-1" options="{'clickable': false}"/>
                                    </div>
                                    <button name="action_xem_ketluan"
                                            string="Xem kết luận đánh giá"
                                            type="object" icon="fa-file-text-o"
                                            class="btn_view_review"
                                            />


                                </div>

                            </div>
                        </div>

                        <!-- ========================================================== -->
                        <!-- TẦNG 3: HỆ THỐNG TABS QUẢN LÝ GIÁO ÁN CAN THIỆP            -->
                        <!-- ========================================================== -->
                        <notebook>
                            <page string="MỤC TIÊU TRONG LĨNH VỰC CỦA KẾ HOẠCH" icon="fa-graduation-cap">
                                <div class="ekids_inner_kanban_container mt-3">
                                    <field name="kehoach_linhvuc_ids" mode="kanban" nolabel="1" options="{'no_open': True}">

                                        <kanban class="o_kanban_mobile" default_order="sequence"
                                                create="0" delete="0" edit="0" open_form_view="0">
                                            <field name="id"/>
                                            <field name="sequence"/>
                                            <field name="linhvuc_id"/>
                                            <field name="tuoi_id"/>
                                            <field name="kehoach_muctieu_ids"/>
                                            <field name="muctieu_html"/>

                                            <templates>
                                                <t t-name="kanban-box">
                                                    <div class="linhvuc_row_card">

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="d-flex align-items-center justify-content-center bg-blue-50 rounded shadow-sm" style="width:28px; height:28px; border: 1px solid #BAE6FD;">
                                                                    <i class="fa fa-folder-open text-primary" style="font-size:13px;"></i>
                                                                </div>

                                                                <h4 class="fw-bold text-dark mb-0" style="font-size: 15px; font-weight: 800;">
                                                                    <field name="linhvuc_id" options="{'no_open': True}"/>
                                                                </h4>

                                                                <span class="badge" style="background-color: #F0FDF4; color: #16A34A; border: 1px solid #BBF7D0; font-size: 12px; font-weight: 700; padding: 3px 6px; border-radius: 5px;">
                                                                    <i class="fa fa-birthday-cake me-1"></i>
                                                                    <field name="tuoi_id" options="{'no_open': True}"/>
                                                                </span>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge" style="background-color: #E0F2FE; color: #0369A1; font-weight: 800; font-size: 11.5px; padding: 5px 10px; border-radius: 6px;">
                                                                    <i class="fa fa-tasks me-1"></i> Có <t t-esc="record.kehoach_muctieu_ids.raw_value.length"></t> mục tiêu
                                                                </span>

                                                                <button type="object" name="action_xem_danhsach_ct_muctieu"
                                                                        context="{'default_kehoach_linhvuc_id':id}"
                                                                        class="btn_add_muctieu_mini">
                                                                    <i class="fa fa-plus-circle me-1"></i>Thêm/xóa [mục tiêu]
                                                                </button>
                                                            </div>
                                                        </div>

                                                        <div class="mt-3 pt-2.5 custom_muctieu_html_holder">
                                                            <t t-out="record.muctieu_html.raw_value"></t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                    </field>
                                </div>
                            </page>

                            <page string="Mô tả, ý kiến làm rõ" icon="fa-commenting-o">
                                <div class="p-3 rounded-3 mt-2" style="border-left: 4px solid #7C3AED; background-color: #F8FAFC;">
                                    <h5 class="fw-extrabold mb-2 text-uppercase" style="color: #6D28D9; font-size: 13px; letter-spacing: 0.5px;">
                                        <i class="fa fa-shield me-1.5"></i>
                                        Ghi chú nội dung
                                    </h5>
                                    <field name="desc" nolabel="1" placeholder="Nội dung góp ý, chỉnh sửa kế hoạch can thiệp từ quản lý chuyên môn..."/>
                                </div>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

  </data>
</odoo>