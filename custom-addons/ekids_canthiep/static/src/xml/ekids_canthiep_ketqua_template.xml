<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_canthiep.CanThiepKetQuaWidgetTemplate">
        <div class="w-100 bg-white p-3 rounded-3 border mt-2 d-flex flex-column gap-3 shadow-sm">

            <style>
                .ekids-matrix-grid { display: flex; flex-wrap: wrap; gap: 6px; width: 100%; }

                .matrix-double-box {
                    display: flex;
                    flex-direction: column;
                    width: 33px;
                    border: 1px solid #CBD5E1;
                    border-radius: 5px;
                    overflow: hidden;
                    cursor: pointer;
                    user-select: none;
                    transition: all 0.12s ease-in-out;
                }
                .matrix-double-box:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 3px 6px rgba(0,0,0,0.1);
                }

                .box-day-num {
                    height: 20px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11.5px;
                    font-weight: 800;
                    background-color: #F8FAFC;
                    color: #1E293B;
                    border-bottom: 1px solid #E2E8F0;
                }

                .box-result-sym {
                    height: 19px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11px;
                    font-weight: 900;
                    background-color: #FFFFFF;
                }

                .matrix-double-box.empty { border-color: #CBD5E1; }
                .matrix-double-box.empty .box-result-sym { color: #94A3B8; background-color: #FFFFFF; }

                /* Quá khứ - Đạt (+): Xanh lá */
                .matrix-double-box.success { border-color: #22C55E !important; }
                .matrix-double-box.success .box-day-num { background-color: #DCFCE7 !important; color: #15803D !important; }
                .matrix-double-box.success .box-result-sym { background-color: #BBF7D0 !important; color: #15803D !important; }

                /* Quá khứ - Đang hình thành (+/-): Vàng */
                .matrix-double-box.warning { border-color: #EAB308 !important; }
                .matrix-double-box.warning .box-day-num { background-color: #FEF3C7 !important; color: #854D0E !important; }
                .matrix-double-box.warning .box-result-sym { background-color: #FDE047 !important; color: #854D0E !important; }

                /* Quá khứ - Chưa đạt (-): Đỏ */
                .matrix-double-box.danger { border-color: #EF4444 !important; }
                .matrix-double-box.danger .box-day-num { background-color: #FEF2F2 !important; color: #991B1B !important; }
                .matrix-double-box.danger .box-result-sym { background-color: #FCA5A5 !important; color: #991B1B !important; }

                .matrix-double-box.none-canthiep { border-color: #94A3B8 !important; }
                .matrix-double-box.none-canthiep .box-result-sym { background-color: #F1F5F9 !important; color: #475569 !important; }

                /* TƯƠNG LAI: Màu xám nhẹ phẳng lỳ */
                .matrix-double-box.bg-future-gray { border-color: #E2E8F0 !important; opacity: 0.65; }
                .matrix-double-box.bg-future-gray .box-day-num { background-color: #F1F5F9 !important; color: #CBD5E1 !important; }
                .matrix-double-box.bg-future-gray .box-result-sym { background-color: #F8FAFC !important; color: #E2E8F0 !important; }

                /* TODAY HÔM NAY THỰC TẾ: Bôi màu xám đậm định vị */
                .matrix-double-box.today-marker { border-color: #334155 !important; border-width: 1.5px !important; }
                .matrix-double-box.today-marker .box-day-num { background-color: #475569 !important; color: #FFFFFF !important; }
                .matrix-double-box.today-marker .box-result-sym { background-color: #64748B !important; color: #FFFFFF !important; }

                /* Ô ĐANG ĐƯỢC CHỌN FOCUS KHUNG VIỀN ĐỎ RỰC */
                .matrix-double-box.is-active-focus {
                    border-color: #DC2626 !important;
                    border-width: 2px !important;
                    box-shadow: 0 0 6px rgba(220, 38, 38, 0.45) !important;
                }
                .matrix-double-box.is-active-focus .box-day-num { background-color: #334155 !important; color: #FFFFFF !important; }
                .matrix-double-box.is-active-focus .box-result-sym { background-color: #475569 !important; color: #FFFFFF !important; }

                /* RADIO BLOCK CHỌN KẾT QUẢ NHANH 1 CHẠM */
                .status-picker-container { display: flex; gap: 8px; width: 100%; }
                .status-block-btn {
                    flex: 1;
                    height: 40px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 800;
                    font-size: 12px;
                    border-radius: 6px;
                    border: 1px solid #CBD5E1;
                    background-color: #FFFFFF;
                    color: #475569;
                    cursor: pointer;
                    transition: all 0.15s ease;
                }
                .status-block-btn.btn-dat:hover { background-color: #F0FDF4; border-color: #22C55E; color: #16A34A; }
                .status-block-btn.btn-hinhthanh:hover { background-color: #FFFDF2; border-color: #EAB308; color: #D97706; }
                .status-block-btn.btn-chuadat:hover { background-color: #FEF2F2; border-color: #EF4444; color: #DC2626; }

                .status-block-btn.btn-dat.active { background-color: #DCFCE7 !important; border-color: #22C55E !important; color: #15803D !important; box-shadow: 0 2px 4px rgba(34,197,94,0.2); }
                .status-block-btn.btn-hinhthanh.active { background-color: #FEF3C7 !important; border-color: #EAB308 !important; color: #854D0E !important; box-shadow: 0 2px 4px rgba(234,179,8,0.2); }
                .status-block-btn.btn-chuadat.active { background-color: #FEF2F2 !important; border-color: #EF4444 !important; color: #991B1B !important; box-shadow: 0 2px 4px rgba(239,68,68,0.2); }

                .panel-accent-border { border-left: 5px solid #64748B !important; }
                .panel-accent-border.c-1 { border-left-color: #22C55E !important; background-color: #F0FDF4 !important; }
                .panel-accent-border.c-2 { border-left-color: #EAB308 !important; background-color: #FFFDF2 !important; }
                .panel-accent-border.c-minus-1 { border-left-color: #EF4444 !important; background-color: #FEF2F2 !important; }
            </style>

            <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-2 mb-2 gap-2">
                <div class="fw-bold text-success d-flex align-items-center gap-1.5" style="font-size: 13px; letter-spacing: 0.2px;">
                    <i class="fa fa-history"></i> NHẬT KÝ TIẾN ĐỘ CAN THIỆP (TRÊN: NGÀY THỨ | DƯỚI: KẾT QUẢ):
                </div>

                <div class="d-flex align-items-center gap-2 fw-bold" style="font-size: 12px;">
                    <span class="badge bg-slate-100 text-slate-700 border px-3 py-1.5 rounded" style="background-color: #E2E8F0 !important; color: #334155 !important;">
                        <t t-esc="state.summary.dat"/>/<t t-esc="state.summary.total"/> (Đạt <t t-esc="state.summary.phantram"/>%)
                    </span>
                    <span class="badge px-2.5 py-1.5 rounded" style="background-color: #DCFCE7 !important; color: #16A34A !important; border: 1px solid #BBF7D0 !important;">
                        <t t-esc="state.summary.dat"/>(+)
                    </span>
                    <span class="badge px-2.5 py-1.5 rounded" style="background-color: #FEF3C7 !important; color: #D97706 !important; border: 1px solid #FCD34D !important;">
                        <t t-esc="state.summary.hinhthanh"/>(+/-)
                    </span>
                    <span class="badge px-2.5 py-1.5 rounded" style="background-color: #FEF2F2 !important; color: #DC2626 !important; border: 1px solid #FCA5A5 !important;">
                        <t t-esc="state.summary.chuadat"/>(-)
                    </span>
                </div>
            </div>

            <div class="ekids-matrix-grid">
                <t t-foreach="state.daysGrid" t-as="day" t-key="day.dayNum">
                    <div t-attf-class="matrix-double-box #{day.statusClass} #{state.selectedDay and state.selectedDay.dayNum == day.dayNum ? 'is-active-focus' : ''}"
                         t-att-title="day.tooltipText"
                         t-on-click="() => this.onDayClick(day)">
                        <div class="box-day-num"><t t-esc="day.dayNum"/></div>
                        <div class="box-result-sym"><t t-esc="day.symbol"/></div>
                    </div>
                </t>
            </div>

            <t t-if="state.selectedDay">

                <div t-if="state.selectedDay.isFuture"
                     class="w-100 p-3 mt-1 rounded border shadow-inner d-flex align-items-center justify-content-between"
                     style="border-left: 5px solid #EF4444 !important; background-color: #FEF2F2 !important; color: #991B1B !important;">
                    <span class="fw-bold" style="font-size: 13px;">
                        <i class="fa fa-ban me-1.5"></i>
                        Ngày này trong tương lai không thể cập nhật kết quả!
                    </span>
                    <button type="button" class="btn-close shadow-none" style="font-size:10px;" t-on-click="() => this.state.selectedDay = null"></button>
                </div>

                <div t-else=""
                     t-attf-class="w-100 p-3 mt-1 rounded border shadow-inner d-flex flex-column gap-2 panel-accent-border #{state.selectedDay.trangthaiValue === '1' ? 'c-1' : (state.selectedDay.trangthaiValue === '2' ? 'c-2' : (state.selectedDay.trangthaiValue === '-1' ? 'c-minus-1' : ''))}">

                    <div class="d-flex align-items-center justify-content-between border-bottom pb-1.5" style="border-color: rgba(0,0,0,0.08) !important;">
                        <span class="fw-bold text-dark" style="font-size: 13px;">
                            <i class="fa fa-edit text-primary"></i> Nhật ký ngày chi tiết:
                            <span class="text-primary font-monospace ms-1" style="font-size:14px;"><t t-esc="state.selectedDay.dateDisplayStr"/></span>
                            (Ngày thứ <t t-esc="state.selectedDay.dayNum"/>)
                        </span>
                        <button type="button" class="btn-close shadow-none" style="font-size:10px;" t-on-click="() => this.state.selectedDay = null"></button>
                    </div>

                    <div class="row g-2 align-items-start mt-1">
                        <div class="col-md-5 text-start">
                            <label class="fw-bold text-muted small mb-1">BẤM CHỌN KẾT QUẢ ĐÁNH GIÁ NHANH:</label>
                            <div class="status-picker-container">
                                <div t-attf-class="status-block-btn btn-dat #{state.selectedDay.trangthaiValue === '1' ? 'active' : ''}"
                                     t-on-click="() => this.selectQuickStatus('1')">
                                    <i class="fa fa-check-circle me-1"></i> (+) ĐẠT
                                </div>
                                <div t-attf-class="status-block-btn btn-hinhthanh #{state.selectedDay.trangthaiValue === '2' ? 'active' : ''}"
                                     t-on-click="() => this.selectQuickStatus('2')">
                                    <i class="fa fa-adjust me-1"></i> (+/-) HÌNH THÀNH
                                </div>
                                <div t-attf-class="status-block-btn btn-chuadat #{state.selectedDay.trangthaiValue === '-1' ? 'active' : ''}"
                                     t-on-click="() => this.selectQuickStatus('-1')">
                                    <i class="fa fa-times-circle me-1"></i> (-) CHƯA ĐẠT
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7 text-start">
                            <label class="fw-bold text-muted small mb-1">MÔ TẢ / COMMENT CHI TIẾT TIẾN TRÌNH:</label>
                            <textarea id="matrix_quick_desc" class="form-control form-control-sm bg-white" rows="2"
                                      placeholder="Nhập ghi chú hoặc biểu hiện cụ thể của học sinh trong ngày..."><t t-esc="state.selectedDay.comment"/></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-2 pt-2 border-top" style="border-color: rgba(0,0,0,0.08) !important;">
                        <button type="button" class="btn btn-xs btn-light border bg-white" t-on-click="() => this.state.selectedDay = null">Đóng khay</button>
                        <button t-if="!props.readonly" type="button" class="btn btn-xs btn-primary fw-bold" style="background-color:#2563EB !important;"
                            t-on-click="() => this.saveInlineData()">Xác nhận lưu ngày</button>
                    </div>
                </div>

            </t>

        </div>
    </t>
</templates>