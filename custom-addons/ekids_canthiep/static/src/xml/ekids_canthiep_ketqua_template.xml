<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_canthiep.CanThiepKetQuaWidgetTemplate">
        <div class="w-100 bg-white px-3.5 py-2.5 rounded-3 border mt-1 d-flex flex-column shadow-sm" style="gap: 8px;">

            <style>
                .ekids-matrix-grid { display: flex; flex-wrap: wrap; gap: 7px; width: 100%; }

                .matrix-modern-card {
                    display: flex;
                    flex-direction: column;
                    width: 48px;
                    height: 68px;
                    border: 1.5px solid #94A3B8;
                    border-radius: 6px;
                    cursor: pointer;
                    user-select: none;
                    transition: all 0.15s ease-in-out;
                    background-color: #FFFFFF;
                    overflow: hidden;
                    box-sizing: border-box;
                    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
                }
                .matrix-modern-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 10px rgba(0,0,0,0.12);
                    border-color: #2563EB !important;
                }

                .card-hdr-date {
                    height: 18px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 10.5px;
                    font-weight: 700;
                    color: #334155;
                    background-color: #E2E8F0;
                    width: 100%;
                    flex-shrink: 0;
                    border-bottom: 1.5px solid #94A3B8;
                }

                .card-body-metric {
                    flex: 1;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    padding: 1px 0;
                    line-height: 1;
                }
                .metric-sym {
                    font-size: 9.5px;
                    font-weight: 800;
                    line-height: 1;
                    margin-bottom: 1px;
                    opacity: 0.9;
                }
                .metric-val {
                    font-size: 15px;
                    font-weight: 700;
                    line-height: 1;
                    letter-spacing: -0.5px;
                }

                .card-ftr-pill {
                    height: 15px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11.5px;
                    font-weight: 800;
                    margin: 0 2px 2px 2px;
                    border-radius: 3px;
                    background-color: #F1F5F9;
                    color: #64748B;
                    border: 1px solid #CBD5E1;
                    letter-spacing: -0.2px;
                }

                .card-is-dat { border: 1.5px solid #16A34A !important; background-color: #F0FDF4 !important; }
                .card-is-dat .card-hdr-date { background-color: #BBF7D0 !important; color: #166534 !important; border-bottom-color: #16A34A !important; }
                .card-is-dat .metric-sym { color: #15803D !important; }
                .card-is-dat .metric-val { color: #15803D !important; }
                .card-is-dat .card-ftr-pill { background-color: #16A34A !important; color: #FFFFFF !important; border-color: #15803D !important; }

                .card-is-hinhthanh { border: 1.5px solid #CA8A04 !important; background-color: #FEFCE8 !important; }
                .card-is-hinhthanh .card-hdr-date { background-color: #FEF08A !important; color: #854D0E !important; border-bottom-color: #CA8A04 !important; }
                .card-is-hinhthanh .metric-sym { color: #A16207 !important; }
                .card-is-hinhthanh .metric-val { color: #854D0E !important; }
                .card-is-hinhthanh .card-ftr-pill { background-color: #EAB308 !important; color: #FFFFFF !important; border-color: #CA8A04 !important; }

                .card-is-chuadat { border: 1.5px solid #DC2626 !important; background-color: #FEF2F2 !important; }
                .card-is-chuadat .card-hdr-date { background-color: #FECACA !important; color: #991B1B !important; border-bottom-color: #DC2626 !important; }
                .card-is-chuadat .metric-sym { color: #DC2626 !important; }
                .card-is-chuadat .metric-val { color: #991B1B !important; }
                .card-is-chuadat .card-ftr-pill { background-color: #EF4444 !important; color: #FFFFFF !important; border-color: #DC2626 !important; }

                .card-is-today { border: 2px solid #0F172A !important; }
                .card-is-today .card-hdr-date { background-color: #0F172A !important; color: #FFFFFF !important; border-bottom-color: #0F172A !important; }

                .card-is-rest { border: 1.5px solid #94A3B8 !important; background-color: #F8FAFC !important; }
                .card-is-rest .card-hdr-date { background-color: #E2E8F0 !important; color: #475569 !important; border-bottom-color: #94A3B8 !important; }

                .card-is-future { border: 1.5px dashed #CBD5E1 !important; background-color: #FAFAFA !important; }
                .card-is-future .card-hdr-date { background-color: #F1F5F9 !important; color: #94A3B8 !important; border-bottom: 1px dashed #CBD5E1 !important; }

                .is-active-focus {
                    border: 2px solid #2563EB !important;
                    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.3) !important;
                }

                .badge-flat { font-size: 11.5px; font-weight: 700; padding: 4px 8px; border-radius: 5px; border: 1px solid transparent; }
                .b-danger { background-color: #FEF2F2; color: #991B1B; border-color: #FCA5A5; }
                .b-warning { background-color: #FEFCE8; color: #854D0E; border-color: #FDE047; }
                .b-success { background-color: #F0FDF4; color: #166534; border-color: #86EFAC; }
                .b-total { background-color: #F1F5F9; color: #1E293B; border-color: #CBD5E1; }

                .panel-flat-clean { border: 1px solid #CBD5E1 !important; border-left: 4px solid #2563EB !important; background-color: #F8FAFC !important; border-radius: 7px; }

                .trial-calc-bar input::-webkit-outer-spin-button,
                .trial-calc-bar input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
                .trial-calc-bar input[type=number] { -moz-appearance: textfield; }

                .notice-inline-pill {
                    background-color: #F0FDF4; border: 1px solid #86EFAC; border-radius: 12px; padding: 2px 8px; color: #166534; font-size: 11px; display: inline-flex; align-items: center; gap: 4px; line-height: 1.25;
                }
            </style>

            <!-- HÀNG 1: TIÊU ĐỀ + THỐNG KÊ -->
            <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-1.5 gap-2">
                <div class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 13.5px;">
                    <i class="fa fa-calendar text-primary"></i> LỊCH TIẾN TRÌNH CAN THIỆP
                </div>
                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                    <span class="badge-flat b-danger">Chưa đạt (-): <t t-esc="state.summary.chuadat"/></span>
                    <span class="badge-flat b-warning">Hình thành (+/-): <t t-esc="state.summary.hinhthanh"/></span>
                    <span class="badge-flat b-success">Đạt (+): <t t-esc="state.summary.dat"/></span>
                    <span class="badge-flat b-total"><t t-esc="state.summary.totalEvaluated"/>/<t t-esc="state.summary.total"/> (<t t-esc="state.summary.phantram"/>%)</span>
                </div>
            </div>

            <!-- HÀNG 2: LƯỚI MA TRẬN Ô NGÀY (HIỆN ĐẦY ĐỦ CẢ KHI DB KHÔNG CÓ BẢN GHI) -->
            <div class="ekids-matrix-grid">
                <t t-foreach="state.daysGrid" t-as="day" t-key="day.dayNum">
                    <div t-attf-class="matrix-modern-card
                                      #{state.selectedDay and state.selectedDay.dayNum == day.dayNum ? 'is-active-focus' : ''}
                                      #{day.loai === '0' ? 'card-is-future' : ''}
                                      #{day.loai === '-1' ? 'card-is-rest' : ''}
                                      #{day.loai === '1' and day.is_date_status === '0' ? 'card-is-today' : ''}
                                      #{day.loai === '1' and day.trangthaiValue === '1' ? 'card-is-dat' : ''}
                                      #{day.loai === '1' and day.trangthaiValue === '2' ? 'card-is-hinhthanh' : ''}
                                      #{day.loai === '1' and day.trangthaiValue === '-1' ? 'card-is-chuadat' : ''}"
                         t-att-title="day.tooltipText"
                         t-on-click="() => this.onDayClick(day)">

                        <div class="card-hdr-date"><t t-esc="day.dateShortStr"/></div>

                        <t t-if="day.loai === '-1'">
                            <div class="d-flex align-items-center justify-content-center flex-grow-1 fw-bold text-muted" style="font-size: 15px;">N</div>
                        </t>
                        <t t-elif="day.loai === '0'">
                            <div class="flex-grow-1"></div>
                        </t>
                        <t t-else="">
                            <div class="card-body-metric">
                                <t t-if="day.trangthaiValue !== '0'">
                                    <span class="metric-sym">
                                        <t t-if="day.trangthaiValue === '1'">[+]</t>
                                        <t t-elif="day.trangthaiValue === '2'">[+/-]</t>
                                        <t t-elif="day.trangthaiValue === '-1'">[-]</t>
                                    </span>
                                    <span class="metric-val"><t t-esc="day.solan_thu_dat !== undefined ? day.solan_thu_dat : 0"/></span>
                                </t>
                                <t t-else="">
                                    <span class="text-muted opacity-40 fs-5">•</span>
                                </t>
                            </div>
                            <div class="card-ftr-pill">
                                <t t-if="day.trangthaiValue !== '0'"><t t-esc="day.tyle_thu || 0"/>%</t>
                                <t t-else=""><span>-</span></t>
                            </div>
                        </t>
                    </div>
                </t>
            </div>

            <!-- HÀNG 3: KHAY NHẬP LIỆU GỌN GÀNG -->
            <t t-if="state.selectedDay">
                <div t-if="state.selectedDay.loai === '0'"
                     class="w-100 px-3 py-1.5 rounded border d-flex align-items-center justify-content-between"
                     style="border-left: 4px solid #EF4444 !important; background-color: #FEF2F2 !important; color: #991B1B !important; font-size: 12.5px;">
                    <span class="fw-bold"><i class="fa fa-exclamation-triangle me-2"/>Ngày tương lai chưa diễn ra, không thể cập nhật!</span>
                    <button type="button" class="btn-close shadow-none" style="font-size:9px;" t-on-click="() => this.state.selectedDay = null"></button>
                </div>

                <div t-elif="state.selectedDay.loai === '-1'"
                     class="w-100 px-3 py-1.5 rounded border d-flex align-items-center justify-content-between"
                     style="border-left: 4px solid #64748B !important; background-color: #F1F5F9 !important; color: #334155 !important; font-size: 12.5px;">
                    <span class="fw-bold"><i class="fa fa-info-circle me-2"/>Ngày nghỉ (Không đi học), không can thiệp!</span>
                    <button type="button" class="btn-close shadow-none" style="font-size:9px;" t-on-click="() => this.state.selectedDay = null"></button>
                </div>

                <div t-else="" class="w-100 px-3 py-2 rounded border shadow-sm d-flex flex-column panel-flat-clean" style="gap: 6px;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 px-2.5 py-1.5 rounded border trial-calc-bar"
                         style="background-color: #FFFFFF; border-color: #E2E8F0 !important;">

                        <div class="d-flex align-items-center gap-2">
                            <span class="badge px-2 py-1 rounded text-primary fw-bold border border-primary bg-light d-flex align-items-center gap-1" style="font-size: 12.5px;">
                                <i class="fa fa-calendar-check-o"></i>
                                <t t-esc="state.selectedDay.dateDisplayStr"/>
                                <span class="text-muted fw-normal small">(Ngày thứ <t t-esc="state.selectedDay.dayNum"/> của kế hoạch)</span>
                            </span>
                            <div class="notice-inline-pill">
                                <i class="fa fa-info-circle text-success"></i>
                                <span>Chỉ Đạt (+) khi tỷ lệ thử &gt;= 80%</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-1.5">
                            <span class="fw-bold text-success" style="font-size: 11px; text-transform: uppercase;">Nhập số lần đạt (+):</span>
                            <input type="number"
                                   class="form-control text-center fw-bolder text-success shadow-none p-0"
                                   style="width: 50px; height: 30px; font-size: 16px; border: 1.5px solid #86EFAC; border-radius: 5px; background-color: #F0FDF4;"
                                   min="0"
                                   t-att-max="state.selectedDay.solan_thu || 99"
                                   t-att-value="state.selectedDay.solan_thu_dat !== undefined ? state.selectedDay.solan_thu_dat : 0"
                                   t-on-input="(ev) => this.onInputSolanThuDat(ev)"/>

                            <span class="text-secondary fw-light" style="font-size: 18px; line-height: 1;">/</span>

                            <div class="d-flex align-items-center justify-content-center fw-bold text-dark bg-light border rounded"
                                 style="width: 44px; height: 30px; font-size: 14px;" title="Số lần thử quy định">
                                <t t-esc="state.selectedDay.solan_thu || 0"/> Lần
                            </div>

                            <i class="fa fa-arrow-right text-muted opacity-40 mx-0.5" style="font-size: 11px;"></i>

                            <div class="badge d-flex align-items-center justify-content-center fw-bolder"
                                 t-attf-style="height: 30px; min-width: 48px; font-size: 13px; border-radius: 5px; #{state.selectedDay.tyle_thu &gt;= 80 ? 'background-color: #16A34A; color: white;' : state.selectedDay.tyle_thu &gt;= 40 ? 'background-color: #EAB308; color: white;' : 'background-color: #EF4444; color: white;'}">
                                Đạt <t t-esc="state.selectedDay.tyle_thu || 0"/>%
                            </div>

                            <i class="fa fa-arrow-right text-muted opacity-40 mx-0.5" style="font-size: 11px;"></i>

                            <div class="d-flex align-items-center">
                                <t t-if="state.selectedDay.trangthaiValue === '1'">
                                    <span class="badge px-2 py-1 rounded-pill fw-bold text-success border border-success bg-light" style="font-size: 11px;">
                                        <i class="fa fa-check-circle"></i> Đạt (+)
                                    </span>
                                </t>
                                <t t-elif="state.selectedDay.trangthaiValue === '2'">
                                    <span class="badge px-2 py-1 rounded-pill fw-bold text-warning border border-warning bg-light" style="font-size: 11px;">
                                        <i class="fa fa-adjust"></i> Hình thành (+/-)
                                    </span>
                                </t>
                                <t t-elif="state.selectedDay.trangthaiValue === '-1' or (state.selectedDay.solan_thu_dat === 0 and state.selectedDay.solan_thu &gt; 0)">
                                    <span class="badge px-2 py-1 rounded-pill fw-bold text-danger border border-danger bg-light" style="font-size: 11px;">
                                        <i class="fa fa-times-circle"></i> Chưa đạt (-)
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="badge px-2 py-1 rounded-pill fw-bold bg-light text-muted border" style="font-size: 11px;">Chưa đánh giá</span>
                                </t>
                            </div>

                            <button type="button" class="btn-close shadow-none ms-1" style="font-size:9px;" title="Đóng khung nhập" t-on-click="() => this.state.selectedDay = null"></button>
                        </div>
                    </div>

                    <div class="w-100">
                        <textarea id="matrix_quick_desc"
                                  class="form-control form-control-sm bg-white shadow-none"
                                  rows="2"
                                  style="font-size: 12.5px; border-color: #CBD5E1;"
                                  placeholder="Mô tả biểu hiện của trẻ trong buổi can thiệp..."><t t-esc="state.selectedDay.comment"/>
                        </textarea>
                    </div>

                    <div class="d-flex align-items-center justify-content-start gap-2 pt-1 border-top" style="border-color: #E2E8F0 !important;">
                        <button t-if="!props.readonly"
                                type="button"
                                class="btn btn-sm btn-primary fw-bold px-3 py-1 d-flex align-items-center gap-1 shadow-sm"
                                style="background-color:#2563EB !important; border-radius: 5px; font-size: 12.5px;"
                                t-on-click="() => this.saveInlineData()">
                            <i class="fa fa-check"></i>
                            <span>Lưu kết quả</span>
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-light border bg-white text-secondary px-3 py-1"
                                style="border-radius: 5px; font-size: 12.5px;"
                                t-on-click="() => this.state.selectedDay = null">
                            <span>Đóng lại</span>
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>