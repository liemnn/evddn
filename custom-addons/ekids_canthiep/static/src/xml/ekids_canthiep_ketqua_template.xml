<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_canthiep.CanThiepKetQuaWidgetTemplate">
        <div class="w-100 bg-white p-3 rounded-3 border mt-2 d-flex flex-column gap-3 shadow-sm">

            <style>
                .ekids-matrix-grid { display: flex; flex-wrap: wrap; gap: 6px; width: 100%; }

                .matrix-double-box {
                    display: flex;
                    flex-direction: column;
                    width: 33px;
                    border: 1px solid #CBD5E1;
                    border-radius: 5px;
                    overflow: hidden;
                    cursor: pointer;
                    user-select: none;
                    transition: all 0.12s ease-in-out;
                }
                .matrix-double-box:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 3px 6px rgba(0,0,0,0.1);
                }

                .box-day-num {
                    height: 20px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11.5px;
                    font-weight: 800;
                    background-color: #F8FAFC;
                    color: #1E293B;
                    border-bottom: 1px solid #E2E8F0;
                }

                .box-result-sym {
                    height: 19px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11px;
                    font-weight: 900;
                    background-color: #FFFFFF;
                }

                /* Trạng thái trống mặc định */
                .c-empty { border-color: #CBD5E1; }
                .c-empty .box-result-sym { color: #94A3B8; background-color: #FFFFFF; }

                /* CHUẨN MÀU ĐẠT (+): XANH LÁ CHUẨN MẪU */
                .c-success { border-color: #22C55E; }
                .c-success .box-day-num { background-color: #E8FBF0 !important; color: #15803D !important; }
                .c-success .box-result-sym { background-color: #E8FBF0 !important; color: #15803D !important; }

                /* CHUẨN MÀU ĐANG HÌNH THÀNH (+/-): VÀNG CHUẨN MẪU */
                .c-warning { border-color: #EAB308; }
                .c-warning .box-day-num { background-color: #FEF9E6 !important; color: #B45309 !important; }
                .c-warning .box-result-sym { background-color: #FEF9E6 !important; color: #B45309 !important; }

                /* CHUẨN MÀU CHƯA ĐẠT (-): ĐỎ CHUẨN MẪU */
                .c-danger { border-color: #EF4444; }
                .c-danger .box-day-num { background-color: #FEEFEE !important; color: #991B1B !important; }
                .c-danger .box-result-sym { background-color: #FEEFEE !important; color: #991B1B !important; }

                .c-none { border-color: #94A3B8 !important; }
                .c-none .box-result-sym { background-color: #F1F5F9 !important; color: #475569 !important; }

                /* CHUẨN MÀU NGÀY TƯƠNG LAI: Nền xám nhẹ chữ đen nhìn rõ số */
                .c-future { border-color: #E2E8F0 !important; opacity: 0.95; }
                .c-future .box-day-num { background-color: #F1F5F9 !important; color: #1E293B !important; font-weight: 800 !important; }
                .c-future .box-result-sym { background-color: #FFFFFF !important; color: #E2E8F0 !important; }

                /* CHUẨN MÀU NGÀY TODAY HÔM NAY THỰC TẾ: Đường viền dày sẫm màu */
                .c-today { border-color: #334155 !important; border-width: 2px !important; }
                .c-today:not(.c-success):not(.c-warning):not(.c-danger) .box-day-num { background-color: #475569 !important; color: #FFFFFF !important; }
                .c-today:not(.c-success):not(.c-warning):not(.c-danger) .box-result-sym { background-color: #64748B !important; color: #FFFFFF !important; }

                /* FOCUS ĐANG CLICK CHỌN Ô BẤT KỲ: Lên khung viền đỏ chuẩn nét */
                .is-active-focus {
                    border-color: #DC2626 !important;
                    border-width: 2px !important;
                    box-shadow: 0 0 6px rgba(220, 38, 38, 0.45) !important;
                }
                .is-active-focus:not(.c-success):not(.c-warning):not(.c-danger) .box-day-num { background-color: #334155 !important; color: #FFFFFF !important; }
                .is-active-focus:not(.c-success):not(.c-warning):not(.c-danger) .box-result-sym { background-color: #475569 !important; color: #FFFFFF !important; }

                /* CỤM CONTAINER TIÊU ĐỀ HỖ TRỢ XUỐNG DÒNG TỰ ĐỘNG KHI CHẬT */
                .panel-header-row {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    flex-wrap: wrap;
                    gap: 12px;
                }

                .panel-title-text {
                    flex: 1 1 auto;
                    min-width: 200px;
                }

                .status-picker-header {
                    display: flex;
                    gap: 6px;
                    align-items: center;
                    flex-wrap: wrap;
                    flex: 0 1 auto;
                }

                .status-block-btn {
                    height: 30px;
                    padding: 0 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 800;
                    font-size: 11.5px;
                    border-radius: 4px;
                    border: 1px solid #CBD5E1;
                    background-color: #FFFFFF;
                    color: #475569;
                    cursor: pointer;
                    transition: all 0.12s ease;
                    white-space: nowrap;
                }
                .status-block-btn.btn-chuadat:hover { background-color: #FEEFEE; border-color: #EF4444; color: #991B1B; }
                .status-block-btn.btn-hinhthanh:hover { background-color: #FEF9E6; border-color: #EAB308; color: #B45309; }
                .status-block-btn.btn-dat:hover { background-color: #E8FBF0; border-color: #22C55E; color: #15803D; }

                .status-block-btn.btn-chuadat.active { background-color: #FEEFEE !important; border-color: #EF4444 !important; color: #991B1B !important; }
                .status-block-btn.btn-hinhthanh.active { background-color: #FEF9E6 !important; border-color: #EAB308 !important; color: #B45309 !important; }
                .status-block-btn.btn-dat.active { background-color: #E8FBF0 !important; border-color: #22C55E !important; color: #15803D !important; }

                /* KHAY FORM MÀU TRẮNG XÁM TINH TẾ, PHẲNG SẠCH CHUẨN UI */
                .panel-flat-clean {
                    border-left: 5px solid #64748B !important;
                    background-color: #F8FAFC !important;
                }

                /* 🌟 PHÂN TÁCH ĐIỀU KIỆN MOBILE CHUYÊN BIỆT BẰNG MEDIA QUERY */
                @media (max-width: 576px) {
                    .panel-header-row {
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 10px;
                    }
                    .status-picker-container-wrapper {
                        width: 100%;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 4px;
                    }
                    .status-picker-header {
                        width: 100%;
                        justify-content: space-between;
                    }
                    .status-block-btn {
                        flex: 1;
                        justify-content: center;
                        padding: 0 4px;
                        font-size: 11px;
                        height: 34px; /* Tăng diện tích chạm trên màn hình cảm ứng di động */
                    }
                    .mobile-footer-actions {
                        width: 100%;
                        display: flex;
                        gap: 8px;
                    }
                    .mobile-footer-actions button {
                        flex: 1;
                        height: 38px;
                    }
                }
            </style>

            <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-2 mb-2 gap-2">
                <div class="fw-bold text-success d-flex align-items-center gap-1.5" style="font-size: 13px; letter-spacing: 0.2px;">
                    <i class="fa fa-history"></i> TIẾN ĐỘ CAN THIỆP (TRÊN: NGÀY THỨ | DƯỚI: KẾT QUẢ):
                </div>

                <div class="d-flex align-items-center gap-2 fw-bold" style="font-size: 16px;">
                    <span class="badge bg-slate-100 text-slate-700 border px-3 py-1.5 rounded" style="background-color: #E2E8F0 !important; color: #334155 !important;">
                        <t t-esc="state.summary.dat"/>/<t t-esc="state.summary.total"/> (Đạt <t t-esc="state.summary.phantram"/>%)
                    </span>
                    <span class="badge px-2.5 py-1.5 rounded" style="background-color: #E8FBF0 !important; color: #15803D !important; border: 1px solid #22C55E !important;">
                        <t t-esc="state.summary.dat"/>(+)
                    </span>
                    <span class="badge px-2.5 py-1.5 rounded" style="background-color: #FEF9E6 !important; color: #B45309 !important; border: 1px solid #EAB308 !important;">
                        <t t-esc="state.summary.hinhthanh"/>(+/-)
                    </span>
                    <span class="badge px-2.5 py-1.5 rounded" style="background-color: #FEEFEE !important; color: #991B1B !important; border: 1px solid #EF4444 !important;">
                        <t t-esc="state.summary.chuadat"/>(-)
                    </span>
                </div>
            </div>

            <div class="ekids-matrix-grid">
                <t t-foreach="state.daysGrid" t-as="day" t-key="day.dayNum">
                    <div t-attf-class="matrix-double-box
                                      #{state.selectedDay and state.selectedDay.dayNum == day.dayNum ? 'is-active-focus' : ''}
                                      #{day.is_date_status === '1' ? 'c-future' : ''}
                                      #{day.is_date_status === '0' ? 'c-today' : ''}
                                      #{day.is_date_status !== '1' and day.trangthaiValue === '1' ? 'c-success' : ''}
                                      #{day.is_date_status !== '1' and day.trangthaiValue === '2' ? 'c-warning' : ''}
                                      #{day.is_date_status !== '1' and day.trangthaiValue === '-1' ? 'c-danger' : ''}
                                      #{day.is_date_status !== '1' and day.trangthaiValue === '0' and day.is_date_status !== '0' ? 'c-empty' : ''}"
                         t-att-title="day.tooltipText"
                         t-on-click="() => this.onDayClick(day)">

                        <div class="box-day-num"><t t-esc="day.dayNum"/></div>

                        <div class="box-result-sym">
                            <t t-if="day.is_date_status === '1'"></t>
                            <t t-else="">
                                <t t-if="day.trangthaiValue === '1'">+</t>
                                <t t-if="day.trangthaiValue === '2'">+/-</t>
                                <t t-if="day.trangthaiValue === '-1'">-</t>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <t t-if="state.selectedDay">

                <div t-if="state.selectedDay.is_date_status === '1'"
                     class="w-100 p-3 mt-1 rounded border shadow-inner d-flex align-items-center justify-content-between"
                     style="border-left: 5px solid #EF4444 !important; background-color: #FEEFEE !important; color: #991B1B !important;">
                    <span class="fw-bold" style="font-size: 13px;">
                        <i class="fa fa-ban me-1.5"></i>
                        Ngày này trong tương lai không thể cập nhật kết quả!
                    </span>
                    <button type="button" class="btn-close shadow-none" style="font-size:10px;" t-on-click="() => this.state.selectedDay = null"></button>
                </div>

                <div t-else="" class="w-100 p-3 mt-1 rounded border shadow-inner d-flex flex-column gap-2 panel-flat-clean">

                    <div class="panel-header-row border-bottom pb-2" style="border-color: rgba(0,0,0,0.08) !important;">
                        <span class="panel-title-text fw-bold text-dark" style="font-size: 13px;">
                            <i class="fa fa-edit text-primary"></i> Kết quả ngày:
                            <span class="text-primary font-monospace ms-1" style="font-size:15px; font-weight:700;">
                                <t t-esc="state.selectedDay.dateDisplayStr"/>
                            </span>
                            <span class="text-muted ms-1" style="font-size:12px; font-weight:normal;">
                                (Ngày thứ <t t-esc="state.selectedDay.dayNum"/> của kế hoạch)
                            </span>
                        </span>

                        <div class="status-picker-container-wrapper">
                            <div class="status-picker-header">
                                <div t-attf-class="status-block-btn btn-chuadat #{state.selectedDay.trangthaiValue === '-1' ? 'active' : ''}"
                                     t-on-click="() => this.selectQuickStatus('-1')">
                                    <i class="fa fa-times-circle me-1"></i> Chưa đạt (-)
                                </div>
                                <div t-attf-class="status-block-btn btn-hinhthanh #{state.selectedDay.trangthaiValue === '2' ? 'active' : ''}"
                                     t-on-click="() => this.selectQuickStatus('2')">
                                    <i class="fa fa-adjust me-1"></i> Hình thành (+/-)
                                </div>
                                <div t-attf-class="status-block-btn btn-dat #{state.selectedDay.trangthaiValue === '1' ? 'active' : ''}"
                                     t-on-click="() => this.selectQuickStatus('1')">
                                    <i class="fa fa-check-circle me-1"></i> Đạt (+)
                                </div>
                                <button type="button" class="btn-close shadow-none d-none d-sm-inline-block ms-2" style="font-size:10px;" t-on-click="() => this.state.selectedDay = null"></button>
                            </div>
                        </div>
                    </div>

                    <div class="w-100 text-start mt-1">
                        <label class="fw-bold text-muted small mb-1">MÔ TẢ CHI TIẾT TIẾN TRÌNH:</label>
                        <textarea id="matrix_quick_desc" class="form-control form-control-sm bg-white" rows="2"
                                  placeholder="Nhập ghi chú hoặc biểu hiện cụ thể của học sinh trong ngày..."><t t-esc="state.selectedDay.comment"/></textarea>
                    </div>

                    <div class="mobile-footer-actions d-flex justify-content-end gap-2 mt-1 pt-2 border-top" style="border-color: rgba(0,0,0,0.08) !important;">
                        <button type="button" class="btn btn-xs btn-light border bg-white" t-on-click="() => this.state.selectedDay = null">Đóng khay</button>
                        <button t-if="!props.readonly" type="button" class="btn btn-xs btn-primary fw-bold" style="background-color:#2563EB !important;"
                            t-on-click="() => this.saveInlineData()">Xác nhận lưu</button>
                    </div>
                </div>

            </t>

        </div>
    </t>
</templates>