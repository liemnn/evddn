<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_canthiep.CanThiepKeHoachWidgetTemplate">
        <div class="w-100 d-flex flex-column gap-3 mt-2 px-0">

            <style>
                .o_field_widget[name="kehoach_linhvuc_ids"] { width: 100% !important; max-width: 100% !important; display: block !important; }
                .custom-folder-bar { background-color: #F8FAFC !important; border: 1px solid #E2E8F0 !important; border-radius: 12px !important; }
                .badge-purple-light { background-color: #F3E8FF !important; color: #6B21A8 !important; border: 1px solid #E9D5FF !important; }

                /* Định dạng ô ngày nhật ký tiến độ */
                .day-box { width: 24px; height: 28px; font-size: 10px; font-weight: bold; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #CBD5E1; border-radius: 4px; background-color: #FFF; }
                .day-box.warning { background-color: #FEF3C7; color: #D97706; border-color: #FCD34D; }
                .day-box.danger { background-color: #FEF2F2; color: #DC2626; border-color: #FCA5A5; }
                .day-box.success { background-color: #DCFCE7; color: #16A34A; border-color: #BBF7D0; }
                .day-box.empty { background-color: #F8FAFC; color: #94A3B8; border-color: #E2E8F0; }

                /* Hiệu ứng di chuột vào dòng mục tiêu để giáo viên biết có thể click */
                .target-header-row { cursor: pointer; transition: background-color 0.15s ease; }
                .target-header-row:hover { background-color: #F1F5F9 !important; }

                /* Cấu trúc Box Tiêu chí đánh giá phân cấp lâm sàng */
                .crit-box { flex: 1; min-width: 250px; padding: 12px; border-radius: 6px; font-size: 12.5px; line-height: 1.5; text-align: justify; }
                .crit-box.danger { background-color: #FEF2F2; border: 1px solid #FCA5A5; color: #1E293B; }
                .crit-box.warning { background-color: #FFFDF2; border: 1px solid #FDE047; color: #1E293B; }
                .crit-box.success { background-color: #F0FDF4; border: 1px solid #BBF7D0; color: #1E293B; }
            </style>

            <t t-foreach="state.groupedData" t-as="lv" t-key="lv.kehoach_linhvuc_id">
                <div class="w-100 custom-folder-bar overflow-hidden mb-2">

                    <div class="d-flex align-items-center justify-content-between py-2 px-3 w-100" style="min-height: 46px; cursor: pointer;"
                         t-on-click="() => this.toggleLinhVucCollapse(lv.kehoach_linhvuc_id)">

                        <div class="d-flex align-items-center gap-2">
                            <i t-attf-class="fa #{state.collapsedLinhVuc[lv.kehoach_linhvuc_id] ? 'fa-chevron-right' : 'fa-chevron-down'} text-muted opacity-75" style="font-size: 12px; margin-right: 2px;"></i>
                            <i class="fa fa-folder text-warning" style="font-size: 17px; color: #EAB308 !important;"></i>
                            <span class="fw-bold text-dark ms-1" style="font-size: 14.5px; color: #1E293B !important;">
                                <t t-esc="lv.linhvuc"/>
                            </span>

                            <span class="mx-1 text-muted opacity-50">|</span>

                            <span t-if="lv.tuoi" class="badge badge-purple-light rounded px-2 py-0.5 fw-bold" style="font-size: 11px;">
                                <t t-esc="lv.tuoi"/>
                            </span>
                            <span class="mx-1 text-muted opacity-50">|</span>
                            <span t-if="lv.chuongtrinh" class="badge badge-purple-light rounded px-2 py-0.5 fw-bold" style="font-size: 11px;">
                                <t t-esc="lv.chuongtrinh"/>
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2" t-on-click.stop="">
                            <span class="badge px-2.5 py-1 fw-bold" style="font-size: 11.5px; background-color: #EFF6FF; color: #1E40AF; border: 1px solid #BFDBFE; border-radius: 20px;">
                                Tiến độ đạt <t t-esc="lv.tong_muctieu_dat"/>/<t t-esc="lv.tong_muctieu"/>mục tiêu
                            </span>


                        </div>
                    </div>

                    <div t-if="!state.collapsedLinhVuc[lv.kehoach_linhvuc_id]" class="p-0 bg-white border-top w-100 shadow-inner">
                        <div class="d-flex flex-column w-100">

                            <t t-foreach="lv.muctieus" t-as="muctieu" t-key="muctieu.id">
                                <div class="w-100 p-0 border-bottom d-flex flex-column">

                                    <div class="d-flex align-items-center justify-content-between w-100 p-3 target-header-row"
                                         t-on-click="() => this.toggleTargetDetail(muctieu.id)">

                                        <div class="d-flex align-items-start gap-3" style="max-width: 75%;">
                                            <span class="fw-bold text-opacity-75 font-monospace" style="font-size: 14px; min-width: 15px;">
                                                <t t-esc="muctieu_index+1"/>
                                            </span>
                                            <span class="fw-semibold text-slate-800" style="font-size: 13.5px; color: #1E293B;">
                                                <t t-esc="muctieu.muctieu_id[1]"/>
                                            </span>
                                        </div>

                                        <div class="d-flex align-items-center gap-3" t-on-click.stop="">
                                            <div class="d-flex align-items-center gap-2">
                                                <span t-if="muctieu.kehoach_muctieu_thangtruoc_id" class="badge fw-bold px-2 py-0.5"
                                                      style="font-size: 10.5px; color: #EF4444; background-color: #FEF2F2; border: 1px solid #FEE2E2; border-radius: 4px;">
                                                    <i class="fa fa-history me-0.5"></i>Tháng trước chuyển sang
                                                    ( <span  style="font-weight:bold;" >
                                                        <t t-esc="muctieu.sothang_da_chuyenttiep"/>
                                                    </span> )
                                                </span>
                                                <span t-else="" class="badge fw-bold px-2 py-0.5"
                                                      style="font-size: 10.5px; color: #16A34A; background-color: #F0FDF4; border: 1px solid #DCFCE7; border-radius: 4px;">
                                                    <i class="fa fa-star me-0.5"></i>Mới
                                                </span>
                                            </div>

                                            <button type="button" class="btn btn-link p-1 text-decoration-none shadow-none d-flex align-items-center gap-1"
                                                    t-on-click="() => this.toggleNoteInline(muctieu.id)"
                                                    style="height: 24px; cursor: pointer;">
                                                <i class="fa fa-commenting" t-attf-style="font-size: 16px; color: #{muctieu.ghichu ? '#10B981' : '#94A3B8'};"></i>
                                                <span style="font-size: 12px; color: #475569; font-weight: 600;">Ghi chú</span>
                                            </button>

                                            <button type="button" class="btn btn-link p-0 text-decoration-none text-muted"
                                                    t-on-click="() => this.toggleTargetDetail(muctieu.id)">
                                                <i t-attf-class="fa #{state.expandedTargets[muctieu.id] ? 'fa-chevron-up' : 'fa-chevron-down'}" style="font-size: 13px;"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div t-if="state.expandedTargets[muctieu.id]" class="w-100 p-3 border-top d-flex flex-column gap-3"
                                         style="background-color: #FAFAFA; border-color: #E2E8F0;">

                                        <div t-if="state.activeNotes[muctieu.id]" class="w-100 p-3 bg-white rounded-3 border inline-note-box shadow-sm mb-1">
                                            <div class="fw-bold text-dark mb-1" style="font-size: 12px;">
                                                <i class="fa fa-pencil-square-o text-primary"></i> Ghi chú cho mục tiêu:</div>

                                            <textarea class="form-control form-control-sm note-textarea mb-2"
                                                      t-att-value="muctieu.ghichu_clean || ''"
                                                      rows="6"
                                                      style="font-size: 14px;"
                                                      placeholder="Nhập tiến trình hoặc ghi chú cụ thể..."></textarea>

                                            <div class="d-flex justify-content-end gap-2">
                                                <button type="button" class="btn btn-xs btn-light border"
                                                        t-on-click="() => this.toggleNoteInline(muctieu.id)">Hủy
                                                </button>
                                                <button type="button" class="btn btn-xs btn-primary"
                                                        style="background-color: #2563EB !important;"
                                                        t-on-click="(ev) => this.saveNoteInline(muctieu, ev)">Lưu ghi chú
                                                </button>
                                            </div>
                                        </div>

                                        <div class="row g-3 w-100 m-0 pt-1">
                                            <div class="col-md-6 ps-0 pe-md-3 text-start">
                                                <div class="fw-bold text-success mb-1" style="font-size: 12px; letter-spacing: 0.3px;">
                                                    <i class="fa fa-star"></i> CHỨC NĂNG PHÁT TRIỂN CỐT LÕI:
                                                </div>
                                                <div style="font-size: 12.5px; color: #4A5568; line-height: 1.6; text-align: justify;">
                                                    <t t-out="muctieu.chucnang || 'Không có'"/>
                                                </div>
                                            </div>

                                            <div class="col-md-6 pe-0 ps-md-3 text-start" style="border-left: 1px dashed #E2E8F0;">
                                                <div class="fw-bold text-warning mb-1" style="font-size: 12px; letter-spacing: 0.3px; color: #EA580C !important;">
                                                    <i class="fa fa-magic"></i> THIẾT KẾ HOẠT ĐỘNG CHO GIÁO VIÊN:
                                                </div>
                                                <div style="font-size: 12.5px; color: #4A5568; line-height: 1.6; text-align: justify;">
                                                    <t t-out="muctieu.thietke || 'Không có'"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="w-100 d-flex flex-column gap-2 mt-2">
                                            <div class="fw-bold text-uppercase" style="font-size: 11px; color: #94A3B8; letter-spacing: 0.5px;">
                                                <i class="fa fa-check-square-o"></i> Tiêu chí đánh giá lâm sàng phân cấp:
                                            </div>
                                            <div class="d-flex flex-wrap gap-3 w-100 m-0">
                                                <div class="crit-box danger d-flex flex-column gap-1">
                                                    <span class="fw-bold text-danger" style="font-size: 11.5px;">(-) Chưa đạt:</span>
                                                    <t t-out="muctieu.tieuchi_chuadat || 'Chưa định nghĩa tiêu chí chưa đạt.'"/>
                                                </div>

                                                <div class="crit-box warning d-flex flex-column gap-1">
                                                    <span class="fw-bold" style="font-size: 11.5px; color: #B45309;">(+/-) Đang hình thành:</span>
                                                    <t t-out="muctieu.tieuchi_hinhthanh || 'Chưa định nghĩa tiêu chí đang hình thành.'"/>
                                                </div>

                                                <div class="crit-box success d-flex flex-column gap-1">
                                                    <span class="fw-bold text-success" style="font-size: 11.5px;">(+) Đạt:</span>
                                                    <t t-out="muctieu.tieuchi_dat || 'Chưa định nghĩa tiêu chí đạt.'"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="w-100 d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                            <t t-if="muctieu.kehoach_muctieu_thangtruoc_id">
                                                <span class="text-muted" style="font-size: 11px; font-style: italic; color: #94A3B8 !important;">
                                                    <i class="fa fa-lock"></i> Mục tiêu chuyển từ tháng trước sang (Không thể xóa)
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <button type="button" class="btn btn-xs btn-outline-danger" style="font-size: 11px;"
                                                        t-on-click="() => this.removeTargetFromPlan(muctieu.id)">
                                                    <i class="fa fa-trash-o"></i> Xóa khỏi kế hoạch
                                                </button>
                                            </t>
                                        </div>

                                    </div>

                                </div>
                            </t>

                        </div>
                    </div>

                </div>
            </t>

        </div>
    </t>
</templates>