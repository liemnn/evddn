<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_dashboard.CanthiepDashboardTemplate">
        <div class="ek-dashboard-root">
            <!-- Hiệu ứng đang tải -->
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center" style="height: 300px;">
                <i class="fa fa-spinner fa-spin fa-2x text-primary me-2"/>
                <span style="font-weight: 700; color: #3b6e8c;">Đang tổng hợp dữ liệu...</span>
            </div>

            <div class="ek-container" t-if="!state.loading and state.data">
                <!-- TOP BAR: TIÊU ĐỀ & BỘ LỌC CƠ SỞ + THÁNG -->
                <div class="ek-topbar">
                    <div class="ek-title-group">
                        <h2><i class="fa fa-child" style="color: var(--purple);"/> HOẠT ĐỘNG CAN THIỆP CỦA TRẺ</h2>
                        <p>Quản lý kế hoạch khung 6 tháng, phê duyệt kế hoạch tháng và giám sát chấm điểm tuần</p>
                    </div>

                    <div class="ek-topbar-right">
                        <!-- Bộ lọc Cơ sở -->
                        <div class="ek-select-box">

                            <i class="fa fa-building text-muted" style="margin-right: 6px; font-size: 12px;"/>
                            <select t-model="state.centerId" t-on-change="onChangeCenter">
                                <t t-foreach="state.data.centers" t-as="cs" t-key="cs.id">
                                    <option t-att-value="cs.id">
                                        <t t-esc="cs.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <!-- Bộ lọc Tháng -->
                        <div class="ek-select-box">
                            <i class="fa fa-calendar text-muted" style="margin-right: 6px; font-size: 12px;"/>
                            <select t-model="state.monthStr" t-on-change="onChangeMonth">
                                <t t-foreach="state.data.months_options" t-as="m" t-key="m.value">
                                    <option t-att-value="m.value">
                                        <t t-esc="m.label"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 1: 5 THẺ KPI -->
                <div class="ek-iep-strip">
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Học sinh theo học tháng này</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Hồ sơ học sinh', 'ekids.hocsinh', [['trangthai', '=', '1']])">
                                Hồ sơ Học sinh <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num">
                            <t t-esc="state.data.kpi.total_students"/> <span style="font-size: 13px; font-weight: 600; color: var(--text-sub);">trẻ</span>
                        </div>
                        <div class="ek-stat-foot"><span>Đang theo học</span></div>
                    </div>

                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Có kế hoạch khung (6 tháng)</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Kế hoạch khung 6 tháng', 'ekids.kehoach_ketluan', [['trangthai', '=', '1']])">
                                Kế hoạch 6 tháng <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div class="ek-stat-num" style="color: var(--primary);">
                                <t t-esc="state.data.kpi.students_with_6m"/> <span style="font-size: 13px; color: var(--text-sub);">/ <t t-esc="state.data.kpi.total_students"/></span>
                            </div>
                            <div class="ek-gauge-circle" t-out="getMiniGaugeSvg(state.data.kpi.pct_khung_int, '#3b6e8c')"/>
                        </div>
                        <div class="ek-stat-foot">
                            <span style="color: var(--primary); font-weight: 700;">Bao phủ <t t-esc="state.data.kpi.pct_khung"/>% học sinh</span>
                        </div>
                    </div>

                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Số kế hoạch đã được lập</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Tất cả kế hoạch', 'ekids.kehoach')">
                                Tất cả Kế hoạch <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num"><t t-esc="state.data.kpi.total_plans_all_time"/></div>
                        <div class="ek-stat-foot"><span>Lũy kế toàn trung tâm</span></div>
                    </div>

                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Kế hoạch đã lập trong tháng</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Kế hoạch tháng', 'ekids.kehoach')">
                                Lập Kế hoạch <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div class="ek-stat-num" style="color: var(--green);">
                                <t t-esc="state.data.kpi.plans_in_month"/> <span style="font-size: 13px; color: var(--text-sub);">/ <t t-esc="state.data.kpi.total_students"/></span>
                            </div>
                            <div class="ek-gauge-circle" t-out="getMiniGaugeSvg(state.data.kpi.pct_thang_int, '#16a34a')"/>
                        </div>
                        <div class="ek-stat-foot">
                            <span style="color: var(--green); font-weight: 700;">Đạt <t t-esc="state.data.kpi.pct_thang"/>% sĩ số tháng</span>
                        </div>
                    </div>

                    <div class="ek-stat-card highlight-purple">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title" style="color: var(--purple);">Kế hoạch đang can thiệp</span>
                            <button class="ek-link-pill" style="color: var(--purple); border-color: #d8b4fe;" t-on-click="() => this.openList('Kế hoạch đang can thiệp', 'ekids.kehoach', [['state', '=', 'dangcanthiep']])">
                                Đánh giá <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num" style="color: var(--purple);"><t t-esc="state.data.kpi.active_plans_in_month"/></div>
                        <div class="ek-stat-foot">
                            <span style="color: var(--purple); font-weight: 700;">Đã duyệt &amp; đang can thiệp</span>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 2: BIỂU ĐỒ SO SÁNH & TÌNH TRẠNG XỬ LÝ -->
                <div class="ek-visual-row">
                    <div class="ek-card">
                    <div class="ek-card-head">
                        <span class="ek-card-title">
                            <i class="fa fa-bar-chart" style="color: #2563eb;"/> So sánh Số lượng học sinh &amp; Kế hoạch
                        </span>
                        <div class="ek-legend-inline">
                            <span style="color: #1d4ed8;">
                                <i class="ek-dot" style="background: #2563eb;"/>Cột: Số lượng Học sinh
                            </span>
                            <span style="color: #b91c1c;">
                                <i class="ek-dot" style="background: #dc2626;"/>Đường: Số lượng Kế hoạch đã lập
                            </span>
                        </div>
                    </div>
                    <div style="margin-top: auto; padding-top: 8px;" t-out="getComboChartSvg()"/>
                </div>

                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title"><i class="fa fa-sliders" style="color: var(--amber);"/> Theo dõi tình trạng hồ sơ kế hoạch</span>
                            <span style="font-size: 11.5px; font-weight: 700; color: var(--text-sub);"><t t-esc="state.monthStr"/></span>
                        </div>

                        <div>
                            <div style="display: flex; justify-content: space-between; font-size: 11.5px; font-weight: 700; color: var(--text-sub);">
                                <span>Đang can thiệp: <t t-esc="state.data.ops_status.active"/></span>
                                <span>Cần lập kế hoạch cho trẻ: <t t-esc="state.data.ops_status.draft + state.data.ops_status.to_approve + state.data.ops_status.no_plan"/></span>
                            </div>
                            <div class="ek-stacked-bar">
                                <div t-attf-style="width: #{state.data.ops_status.pct_active}%; background: #16a34a;"/>
                                <div t-attf-style="width: #{state.data.ops_status.pct_draft}%; background: #3b6e8c;"/>
                                <div t-attf-style="width: #{state.data.ops_status.pct_approve}%; background: #d97706;"/>
                                <div t-attf-style="width: #{state.data.ops_status.pct_no_plan}%; background: #dc2626;"/>
                            </div>
                        </div>

                        <div class="ek-ops-grid">
                            <div class="ek-ops-item info-blue">
                                <div class="ek-ops-top">
                                    <span class="ek-ops-lbl" style="color: var(--primary);">Số kế hoạch đang lập</span>
                                    <i class="fa fa-pencil-square-o" style="color: var(--primary);"/>
                                </div>
                                <div class="ek-ops-val" style="color: var(--primary);"><t t-esc="state.data.ops_status.draft"/></div>
                                <div class="ek-ops-foot">
                                    <span>Giáo viên đang lập kế hoạch</span>
                                    <button class="ek-link-pill" t-on-click="() => this.openList('Kế hoạch đang lập', 'ekids.kehoach', [['state', '=', 'draft']])">
                                        Vào lập Kế hoạch <i class="fa fa-arrow-right"/>
                                    </button>
                                </div>
                            </div>

                            <div class="ek-ops-item warn-amber">
                                <div class="ek-ops-top">
                                    <span class="ek-ops-lbl" style="color: var(--amber);">Số kế hoạch đợi duyệt</span>
                                    <i class="fa fa-hourglass-half" style="color: var(--amber);"/>
                                </div>
                                <div class="ek-ops-val" style="color: var(--amber);"><t t-esc="state.data.ops_status.to_approve"/></div>
                                <div class="ek-ops-foot">
                                    <span>Chờ phê duyệt</span>
                                    <button class="ek-link-pill amber" t-on-click="() => this.openList('Kế hoạch đợi duyệt', 'ekids.kehoach', [['state', '=', 'choduyet']])">
                                        Kiểm duyệt <i class="fa fa-arrow-right"/>
                                    </button>
                                </div>
                            </div>

                            <div class="ek-ops-item warn-amber">
                                <div class="ek-ops-top">
                                    <span class="ek-ops-lbl" style="color: var(--amber);">Số kế hoạch sắp hết hạn</span>
                                    <i class="fa fa-clock-o" style="color: var(--amber);"/>
                                </div>
                                <div class="ek-ops-val" style="color: var(--amber);"><t t-esc="state.data.ops_status.expiring"/></div>
                                <div class="ek-ops-foot">
                                    <span>Sắp đến hạn kết thúc kế hoạch</span>

                                </div>
                            </div>

                            <div class="ek-ops-item warn-red">
                                <div class="ek-ops-top">
                                    <span class="ek-ops-lbl" style="color: var(--red);">Học sinh chưa có kế hoạch</span>
                                    <i class="fa fa-user-times" style="color: var(--red);"/>
                                </div>
                                <div class="ek-ops-val" style="color: var(--red);"><t t-esc="state.data.ops_status.no_plan"/></div>
                                <div class="ek-ops-foot">
                                    <span>Chưa lập Kế hoạch tháng</span>
                                    <button class="ek-link-pill red" t-on-click="() => this.openList('Học sinh đang theo học', 'ekids.hocsinh', [['trangthai', '=', '1']])">
                                        Lập Kế hoạch ngay <i class="fa fa-arrow-right"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 3: BẢNG THỐNG KÊ CẬP NHẬT TUẦN -->
                <div class="ek-card" style="margin-bottom: 0;">
                    <div class="ek-card-head">
                        <span class="ek-card-title">
                            <i class="fa fa-check-square-o" style="color: var(--green);"/>
                            Thống kê giáo viên cập nhật kết quả can thiệp của tuần này
                        </span>

                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <div class="ek-filter-pills">
                                <button t-attf-class="ek-pill-btn #{state.rowFilter === 'all' ? 'active' : ''}" t-on-click="() => this.setRowFilter('all')">
                                    Tất cả (<t t-esc="state.data.weekly.total_plans"/> kế hoạch)
                                </button>
                                <button t-attf-class="ek-pill-btn #{state.rowFilter === 'pending' ? 'active' : ''}" style="color: var(--red);" t-on-click="() => this.setRowFilter('pending')">
                                    Chưa cập nhật trong tuần này(<t t-esc="state.data.weekly.pending_count"/>)
                                </button>
                                <button t-attf-class="ek-pill-btn #{state.rowFilter === 'done' ? 'active' : ''}" style="color: var(--green);" t-on-click="() => this.setRowFilter('done')">
                                    Đã cập nhật trong tuần này(<t t-esc="state.data.weekly.done_count"/>)
                                </button>
                            </div>

                        </div>
                    </div>

                    <div class="ek-scroll-box">
                        <table class="ek-tbl">
                            <thead>
                                <tr>
                                    <th style="width: 55px; text-align: center;">TT</th>
                                    <th style="width: 22%;">Học sinh</th>
                                    <th style="width: 30%;">Kế hoạch can thiệp tháng</th>
                                    <th style="width: 24%;">Giáo viên phụ trách</th>
                                    <th style="width: 120px; text-align: center;">Cập nhật trong tuần này</th>

                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="filteredWeeklyStudents.length === 0">
                                    <tr>
                                        <td colspan="6" style="text-align: center; padding: 24px; color: var(--text-sub);">
                                            Không có kế hoạch nào khớp bộ lọc trong tuần này.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="filteredWeeklyStudents" t-as="st" t-key="st.student_id">
                                    <t t-foreach="st.plans" t-as="plan" t-key="plan.plan_id">
                                        <tr t-att-class="plan_last ? 'student-group-end' : ''">
                                            <t t-if="plan_first">
                                                <td t-att-rowspan="st.plans.length" class="student-cell" style="text-align: center;">
                                                    <t t-esc="st.stt"/>
                                                </td>
                                                <td t-att-rowspan="st.plans.length" class="student-cell">
                                                    <t t-esc="st.student_name"/>
                                                    <div t-if="st.plans.length > 1" style="font-size: 11px; color: var(--text-sub); font-weight: 600; margin-top: 2px;">
                                                        <t t-esc="st.plans.length"/> kế hoạch
                                                    </div>
                                                </td>
                                            </t>
                                            <td>
                                                <span class="ek-plan-tag" t-att-style="plan.tag_style">
                                                    <t t-esc="plan.plan_name"/>
                                                </span>
                                            </td>
                                            <td>
                                                <span t-attf-class="ek-teacher-name #{!plan.is_done ? 'missing' : ''}">
                                                    <i t-attf-class="fa fa-user-circle-o #{plan.is_done ? 'text-muted' : ''}"/>
                                                    <t t-esc="plan.teacher_name"/>
                                                </span>
                                            </td>
                                            <td style="text-align: center;">
                                                <span t-if="plan.is_done" class="ek-badge-x">X</span>
                                            </td>

                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>