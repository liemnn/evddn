<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_dashboard.VanhanhDashboardTemplate">
        <div class="ek-vh-root">
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center" style="height: 300px;">
                <i class="fa fa-spinner fa-spin fa-2x text-primary me-2"/>
                <span style="font-weight: 700; color: #2563eb;">Đang tổng hợp dữ liệu vận hành...</span>
            </div>

            <div class="ek-container" t-if="!state.loading and state.data">
                <!-- TOP BAR: TIÊU ĐỀ & BỘ LỌC CƠ SỞ + THÁNG -->
                <div class="ek-topbar">
                    <div class="ek-title-group">
                        <h2><i class="fa fa-pie-chart" style="color: var(--primary);"/> QUẢN TRỊ HOẠT ĐỘNG TRUNG TÂM</h2>
                        <p>Tổng quan doanh thu, học phí, nhân sự giáo viên, quỹ lương và thu chi vận hành</p>
                    </div>

                    <div class="ek-topbar-right">
                        <div class="ek-select-box">
                            <i class="fa fa-building" style="color: var(--text-sub); margin-right: 6px; font-size: 12px;"/>
                            <select t-model="state.centerId" t-on-change="onChangeCenter">
                                <t t-foreach="state.data.centers" t-as="cs" t-key="cs.id">
                                    <option t-att-value="cs.id">
                                        <t t-esc="cs.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="ek-select-box">
                            <i class="fa fa-calendar" style="color: var(--text-sub); margin-right: 6px; font-size: 12px;"/>
                            <select t-model="state.monthStr" t-on-change="onChangeMonth">
                                <t t-foreach="state.data.months_options" t-as="m" t-key="m.value">
                                    <option t-att-value="m.value">
                                        <t t-esc="m.label"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 1: 4 THẺ KPI CÔ ĐỌNG -->
                <div class="ek-kpi-strip">
                    <!-- 1. Doanh thu lũy kế năm -->
                    <div class="ek-stat-card hero-green">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title" style="color: var(--green);">Doanh thu năm (T01 - T<t t-esc="state.data.thang"/>)</span>
                            <span style="font-size: 11px; font-weight: 800; color: var(--green); background: var(--green-soft); padding: 2px 7px; border-radius: 5px;">
                                <t t-esc="state.data.kpi.year_growth"/>
                            </span>
                        </div>
                        <div class="ek-stat-num" style="color: var(--green);">
                            <t t-esc="state.data.kpi.year_revenue_str"/> <span style="font-size: 14px; font-weight: 700;"><t t-esc="state.data.kpi.year_revenue_unit"/></span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Học phí: <strong><t t-esc="state.data.kpi.year_tuition_str"/></strong> • Thu ngoài: <strong><t t-esc="state.data.kpi.year_other_income_str"/></strong></span>
                        </div>
                    </div>

                    <!-- 2. Học sinh & Vắng mặt hôm nay -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Học sinh đang học</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Hồ sơ học sinh', 'ekids.hocsinh', [['trangthai', '=', '1']])">
                                Hồ sơ HS <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num">
                            <t t-esc="state.data.kpi.total_students"/> <span style="font-size: 13.5px; font-weight: 600; color: var(--text-sub);">trẻ</span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Vắng hôm nay: <strong style="color: var(--red);"><t t-esc="state.data.kpi.absent_students_today"/> trẻ</strong></span>
                            <button class="ek-link-pill red" t-on-click="() => this.openList('Điểm danh học sinh', 'ekids.hocsinh')">
                                Điểm danh <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </div>

                    <!-- 3. Giáo viên & Nghỉ phép -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Giáo viên trung tâm</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Danh sách giáo viên', 'ekids.giaovien')">
                                Danh sách <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num">
                            <t t-esc="state.data.kpi.total_teachers"/> <span style="font-size: 13.5px; font-weight: 600; color: var(--text-sub);">GV</span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Nghỉ hôm nay: <strong style="color: var(--amber);"><t t-esc="state.data.kpi.absent_teachers_today"/> GV</strong></span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Lịch nghỉ phép giáo viên', 'ekids.giaovien_nghiphep')">
                                Lịch nghỉ <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </div>

                    <!-- 4. Quỹ lương & Chi vận hành tháng -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Tổng chi tháng <t t-esc="state.data.thang"/></span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Sổ thu chi', 'ekids.thuchi')">
                                Sổ thu chi <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num" style="color: var(--text-main);">
                            <t t-esc="state.data.kpi.month_expense_str"/> <span style="font-size: 14px; font-weight: 700;">tr đ</span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Lương: <strong><t t-esc="state.data.kpi.month_salary_str"/></strong> • Chi khác: <strong><t t-esc="state.data.kpi.month_other_expense_str"/></strong></span>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 2: BIỂU ĐỒ LỢI NHUẬN (TRÁI) + BIỂU ĐỒ TRÒN HỌC PHÍ (PHẢI) -->
                <div class="ek-main-visual-row">
                    <!-- Biểu đồ 1: Lợi nhuận hàng tháng -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title"><i class="fa fa-line-chart" style="color: var(--green);"/> Lợi nhuận hàng tháng từ đầu năm (Triệu đ)</span>
                            <div class="ek-legend-inline">
                                <span style="color: #16a34a;"><i class="ek-dot" style="background: #22c55e;"/>Cột: Lợi nhuận tháng</span>
                                <span style="color: #d97706;"><i class="ek-dot" style="background: #d97706;"/>Đường: Xu hướng</span>
                            </div>
                        </div>
                        <div style="margin-top: auto;" t-out="getComboChartSvg('profit')"/>
                    </div>

                    <!-- Biểu đồ tròn Donut: Cơ cấu Học phí tháng này -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title">
                                <i class="fa fa-pie-chart" style="color: var(--primary);"/> Học phí tháng <t t-esc="state.data.thang"/> (<t t-esc="state.data.tuition_donut.total_str"/>)
                            </span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Quản lý học phí', 'ekids.hocphi')">
                                Vào học phí <i class="fa fa-arrow-right"/>
                            </button>
                        </div>

                        <div class="ek-donut-layout">
                            <div class="ek-donut-svg" t-out="getDonutSvg()"/>
                            <div class="ek-donut-info">
                                <div class="ek-donut-item">
                                    <span><i class="ek-dot" style="background: #16a34a;"/>Đã thu</span>
                                    <strong style="color: var(--green);">
                                        <t t-esc="state.data.tuition_donut.paid_str"/> (<t t-esc="state.data.tuition_donut.paid_pct"/>%)
                                    </strong>
                                </div>
                                <div class="ek-donut-item">
                                    <span><i class="ek-dot" style="background: #dc2626;"/>Chưa thu</span>
                                    <strong style="color: var(--red);">
                                        <t t-esc="state.data.tuition_donut.unpaid_str"/> (<t t-esc="state.data.tuition_donut.unpaid_pct"/>%)
                                    </strong>
                                </div>
                                <div class="ek-donut-item">
                                    <span><i class="ek-dot" style="background: #f59e0b;"/>Miễn giảm</span>
                                    <strong style="color: var(--amber);">
                                        <t t-esc="state.data.tuition_donut.exempt_str"/> (<t t-esc="state.data.tuition_donut.exempt_pct"/>%)
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 3 - HÀNG 1: THU HỌC PHÍ & LƯƠNG THỰC CHI (CHIA 2 CỘT RỘNG) -->
                <div class="ek-sub-visual-row">
                    <!-- Cột 1: Biểu đồ Thu học phí từ đầu năm -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title"><i class="fa fa-money" style="color: var(--primary);"/> Thu học phí từ đầu năm (Tr đ)</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Chi tiết thu học phí', 'ekids.hocphi')">
                                Chi tiết <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div style="margin-top: auto;" t-out="getComboChartSvg('tuition')"/>
                    </div>

                    <!-- Cột 2: Biểu đồ Lương thực chi từ đầu năm -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title"><i class="fa fa-credit-card" style="color: var(--purple);"/> Lương thực chi từ đầu năm (Tr đ)</span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Bảng lương giáo viên', 'ekids.luong')">
                                Bảng lương <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div style="margin-top: auto;" t-out="getComboChartSvg('salary')"/>
                    </div>
                </div>

                <!-- TẦNG 3 - HÀNG 2: BIỂU ĐỒ THU & CHI FULL WIDTH + KHOẢN CHI NỔI BẬT BÊN PHẢI -->
                <div class="ek-card" style="margin-bottom: 0;">
                    <div class="ek-card-head">
                        <span class="ek-card-title"><i class="fa fa-exchange" style="color: var(--amber);"/> Tổng hợp Thu &amp; Chi vận hành theo tháng (Tr đ)</span>
                        <div class="ek-legend-inline">
                            <span style="color: #16a34a;"><i class="ek-dot" style="background: #16a34a;"/>Cột: Tổng thu</span>
                            <span style="color: #dc2626;"><i class="ek-dot" style="background: #dc2626;"/>Đường: Tổng chi</span>
                            <span style="color: var(--primary); background: var(--primary-soft); padding: 2px 8px; border-radius: 5px;">
                                Thu ngoài T<t t-esc="state.data.thang"/>: <t t-esc="state.data.top_expenses.other_income_str"/>
                            </span>
                        </div>
                    </div>

                    <div class="ek-io-split">
                        <!-- Trái: Biểu đồ Thu & Chi rộng rãi -->
                        <div t-out="getComboChartSvg('io')"/>

                        <!-- Phải: Thanh tỷ trọng khoản chi nổi bật tháng này -->
                        <div class="ek-mini-bars">
                            <div style="font-size: 12px; font-weight: 800; color: var(--text-main); text-transform: uppercase;">
                                Cơ cấu khoản chi nổi bật T<t t-esc="state.data.thang"/> (<t t-esc="state.data.top_expenses.total_other_expense_str"/>)
                            </div>
                            <t t-foreach="state.data.top_expenses.items" t-as="item" t-key="item_index">
                                <div class="ek-hbar-row">
                                    <span class="ek-hbar-lbl"><t t-esc="item.label"/></span>
                                    <div class="ek-hbar-track">
                                        <div class="ek-hbar-fill" t-attf-style="width: #{item.pct}%; background: #{item.color};"/>
                                    </div>
                                    <span class="ek-hbar-val"><t t-esc="item.val_str"/></span>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>