<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_dashboard.VanhanhDashboardTemplate">
        <div class="ek-vh-root">
            <div t-if="state.dang_tai" class="d-flex justify-content-center align-items-center" style="height: 300px;">
                <i class="fa fa-spinner fa-spin fa-2x text-primary me-2"/>
                <span style="font-weight: 700; color: #2563eb;">Đang tổng hợp dữ liệu vận hành...</span>
            </div>

            <div class="ek-container" t-if="!state.dang_tai and state.dulieu">
                <!-- TOP BAR: TIÊU ĐỀ & BỘ LỌC CƠ SỞ + THÁNG -->
                <div class="ek-topbar">
                    <div class="ek-title-group">
                        <h2><i class="fa fa-pie-chart" style="color: var(--primary);"/> QUẢN TRỊ HOẠT ĐỘNG TRUNG TÂM</h2>
                        <p>Tổng quan doanh thu, học phí, nhân sự giáo viên, quỹ lương và thu chi vận hành</p>
                    </div>

                    <div class="ek-topbar-right">
                        <div class="ek-select-box">
                            <i class="fa fa-building" style="color: var(--text-sub); margin-right: 6px; font-size: 12px;"/>
                            <select t-model="state.coso_id" t-on-change="khiDoiCoSo">
                                <t t-foreach="state.dulieu.ds_coso" t-as="cs" t-key="cs.id">
                                    <option t-att-value="cs.id">
                                        <t t-esc="cs.ten"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="ek-select-box">
                            <i class="fa fa-calendar" style="color: var(--text-sub); margin-right: 6px; font-size: 12px;"/>
                            <select t-model="state.thang_nam" t-on-change="khiDoiThang">
                                <t t-foreach="state.dulieu.ds_thang" t-as="th" t-key="th.giatri">
                                    <option t-att-value="th.giatri">
                                        <t t-esc="th.nhan"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 1: 4 THẺ KPI CÔ ĐỌNG -->
                <div class="ek-kpi-strip">
                    <!-- 1. Tổng hợp Thu - Chi - Lợi nhuận đến hôm nay -->
                    <div class="ek-stat-card hero-green">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title" style="color: var(--green);">
                                Lợi nhuận đến <t t-esc="state.dulieu.kpi.ngay_hientai_str"/>
                            </span>
                            <span style="font-size: 11px; font-weight: 800; color: var(--green); background: var(--green-soft); padding: 2px 7px; border-radius: 5px;">
                                <t t-esc="state.dulieu.kpi.tang_truong_nam"/>
                            </span>
                        </div>
                        <div class="ek-stat-num" style="color: var(--green);">
                            <t t-esc="state.dulieu.kpi.loi_nhuan_nam"/> <span style="font-size: 14px; font-weight: 700;"><t t-esc="state.dulieu.kpi.don_vi_loi_nhuan"/></span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Tổng thu: <strong style="color: #15803d;"><t t-esc="state.dulieu.kpi.tong_doanh_thu_nam"/></strong></span>
                            <span>Tổng chi: <strong style="color: #dc2626;"><t t-esc="state.dulieu.kpi.tong_chi_nam"/></strong></span>
                        </div>
                    </div>

                    <!-- 2. Học sinh & Biến động tháng (Mới / Nghỉ) + Vắng mặt hôm nay -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Học sinh đang học</span>
                            <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Hồ sơ học sinh', 'ekids.hocsinh', [['trangthai', '=', '1']])">
                                Hồ sơ HS <i class="fa fa-angle-right"/>
                            </button>
                        </div>

                        <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 6px; flex-wrap: wrap;">
                            <div class="ek-stat-num">
                                <t t-esc="state.dulieu.kpi.tong_hocsinh"/> <span style="font-size: 13.5px; font-weight: 600; color: var(--text-sub);">trẻ</span>
                            </div>

                            <div style="display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 800;">
                                <span style="background: var(--green-soft); color: var(--green); padding: 2px 6px; border-radius: 5px;" title="Học sinh mới nhập học trong tháng">
                                    +<t t-esc="state.dulieu.kpi.hocsinh_moi_thang"/> mới
                                </span>
                                <span style="background: var(--amber-soft); color: var(--amber); padding: 2px 6px; border-radius: 5px;" title="Học sinh nghỉ học trong tháng">
                                    -<t t-esc="state.dulieu.kpi.hocsinh_nghi_thang"/> nghỉ
                                </span>
                            </div>
                        </div>

                        <div class="ek-stat-meta">
                            <span>Vắng hôm nay: <strong style="color: var(--red);"><t t-esc="state.dulieu.kpi.hocsinh_vang_homnay"/> trẻ</strong></span>
                            <button class="ek-link-pill red" t-on-click="() => this.moDanhSach('Điểm danh học sinh', 'ekids.hocsinh')">
                                Điểm danh <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </div>

                    <!-- 3. Giáo viên & Nghỉ phép -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Giáo viên trung tâm</span>
                            <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Danh sách giáo viên', 'ekids.giaovien')">
                                Danh sách <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num">
                            <t t-esc="state.dulieu.kpi.tong_giaovien"/> <span style="font-size: 13.5px; font-weight: 600; color: var(--text-sub);">GV</span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Nghỉ hôm nay: <strong style="color: var(--amber);"><t t-esc="state.dulieu.kpi.giaovien_nghi_homnay"/> GV</strong></span>
                            <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Lịch nghỉ phép giáo viên', 'ekids.giaovien_nghiphep')">
                                Lịch nghỉ <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </div>

                    <!-- 4. Quỹ lương & Chi vận hành tháng -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Tổng chi tháng <t t-esc="state.dulieu.thang"/></span>
                            <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Sổ thu chi', 'ekids.thuchi')">
                                Sổ thu chi <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num" style="color: var(--text-main);">
                            <t t-esc="state.dulieu.kpi.tong_chi_thang"/> <span style="font-size: 14px; font-weight: 700;">tr đ</span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Lương: <strong><t t-esc="state.dulieu.kpi.chi_luong_thang"/></strong> • Chi khác: <strong><t t-esc="state.dulieu.kpi.chi_khac_thang"/></strong></span>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 2: BIỂU ĐỒ TỔNG THU - TỔNG CHI - LỢI NHUẬN (TRÁI) + BIỂU ĐỒ TRÒN HỌC PHÍ (PHẢI) -->
                <div class="ek-main-visual-row">
                    <!-- Biểu đồ 1: Tổng thu, Tổng chi & Lợi nhuận hàng tháng -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title">
                                <i class="fa fa-line-chart" style="color: var(--green);"/> Tổng thu, Tổng chi &amp; Lợi nhuận từ đầu năm (Tr đ)
                            </span>
                            <div class="ek-legend-inline">
                                <span style="color: #1d4ed8;"><i class="ek-dot" style="background: #2563eb;"/>Cột: Tổng thu</span>
                                <span style="color: #dc2626;"><i class="ek-dot" style="background: #ef4444;"/>Cột: Tổng chi</span>
                                <span style="color: #15803d;"><i class="ek-dot" style="background: #16a34a;"/>Đường: Lợi nhuận</span>
                            </div>
                        </div>
                        <div style="margin-top: auto;" t-out="veBieuDoTongHopTaiChinh()"/>
                    </div>

                    <!-- Biểu đồ tròn Donut: Cơ cấu Học phí tháng này -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title">
                                <i class="fa fa-pie-chart" style="color: var(--primary);"/> Học phí tháng <t t-esc="state.dulieu.thang"/> (<t t-esc="state.dulieu.hocphi_thang.tong_hocphi_str"/>)
                            </span>
                            <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Quản lý học phí', 'ekids.hocphi')">
                                Vào học phí <i class="fa fa-arrow-right"/>
                            </button>
                        </div>

                        <div class="ek-donut-layout">
                            <div class="ek-donut-svg" t-out="veBieuDoTronHocPhi()"/>
                            <div class="ek-donut-info">
                                <div class="ek-donut-item">
                                    <span><i class="ek-dot" style="background: #16a34a;"/>Đã thu</span>
                                    <strong style="color: var(--green);">
                                        <t t-esc="state.dulieu.hocphi_thang.da_thu_str"/> (<t t-esc="state.dulieu.hocphi_thang.tyle_da_thu"/>%)
                                    </strong>
                                </div>
                                <div class="ek-donut-item">
                                    <span><i class="ek-dot" style="background: #dc2626;"/>Chưa thu</span>
                                    <strong style="color: var(--red);">
                                        <t t-esc="state.dulieu.hocphi_thang.chua_thu_str"/> (<t t-esc="state.dulieu.hocphi_thang.tyle_chua_thu"/>%)
                                    </strong>
                                </div>
                                <div class="ek-donut-item">
                                    <span><i class="ek-dot" style="background: #f59e0b;"/>Miễn giảm</span>
                                    <strong style="color: var(--amber);">
                                        <t t-esc="state.dulieu.hocphi_thang.mien_giam_str"/> (<t t-esc="state.dulieu.hocphi_thang.tyle_mien_giam"/>%)
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 3 - HÀNG 1: THU HỌC PHÍ & LƯƠNG THỰC CHI (CHIA 2 CỘT RỘNG) -->
                <div class="ek-sub-visual-row">
                    <!-- Cột 1: Biểu đồ Thu học phí từ đầu năm -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title"><i class="fa fa-money" style="color: var(--primary);"/> Thu học phí từ đầu năm (Tr đ)</span>
                            <div class="ek-legend-inline">
                                <span style="color: #2563eb;"><i class="ek-dot" style="background: #2563eb;"/>Cột: Thu học phí</span>
                                <span style="color: #16a34a;"><i class="ek-dot" style="background: #16a34a;"/>Đường: Xu hướng</span>
                                <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Chi tiết thu học phí', 'ekids.hocphi')">
                                    Chi tiết <i class="fa fa-angle-right"/>
                                </button>
                            </div>
                        </div>
                        <div style="margin-top: auto;" t-out="veBieuDoKetHop('thu_hocphi')"/>
                    </div>

                    <!-- Cột 2: Biểu đồ Lương thực chi từ đầu năm -->
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title"><i class="fa fa-credit-card" style="color: var(--purple);"/> Lương thực chi từ đầu năm (Tr đ)</span>
                            <div class="ek-legend-inline">
                                <span style="color: #7c3aed;"><i class="ek-dot" style="background: #7c3aed;"/>Cột: Lương thực chi</span>
                                <span style="color: #d97706;"><i class="ek-dot" style="background: #d97706;"/>Đường: Xu hướng</span>
                                <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Bảng lương giáo viên', 'ekids.luong')">
                                    Bảng lương <i class="fa fa-angle-right"/>
                                </button>
                            </div>
                        </div>
                        <div style="margin-top: auto;" t-out="veBieuDoKetHop('chi_luong')"/>
                    </div>
                </div>

                <!-- TẦNG 3 - HÀNG 2: TỔNG HỢP NGUỒN CHI THEO THÁNG (BIỂU ĐỒ CỘT) + KHOẢN CHI NỔI BẬT BÊN PHẢI -->
                <div class="ek-card" style="margin-bottom: 0;">
                    <div class="ek-card-head">
                        <span class="ek-card-title"><i class="fa fa-bar-chart" style="color: var(--red);"/> Tổng hợp nguồn chi vận hành theo tháng (Tr đ)</span>
                        <div class="ek-legend-inline">
                            <span style="color: #dc2626;"><i class="ek-dot" style="background: #ef4444;"/>Cột: Số tiền chi theo tháng</span>
                            <button class="ek-link-pill" t-on-click="() => this.moDanhSach('Sổ chi vận hành', 'ekids.thuchi')">
                                Chi tiết sổ chi <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </div>

                    <div class="ek-io-split">
                        <!-- Trái: Biểu đồ cột Số tiền chi theo tháng -->
                        <div t-out="veBieuDoKetHop('nguon_chi')"/>

                        <!-- Phải: Thanh tỷ trọng khoản chi nổi bật tháng này -->
                        <div class="ek-mini-bars">
                            <div style="font-size: 12px; font-weight: 800; color: var(--text-main); text-transform: uppercase;">
                                Cơ cấu khoản chi nổi bật T<t t-esc="state.dulieu.thang"/> (<t t-esc="state.dulieu.khoanchi_noibat.tong_chi_khac_str"/>)
                            </div>
                            <t t-foreach="state.dulieu.khoanchi_noibat.ds_khoanchi" t-as="kc" t-key="kc_index">
                                <div class="ek-hbar-row">
                                    <span class="ek-hbar-lbl"><t t-esc="kc.ten"/></span>
                                    <div class="ek-hbar-track">
                                        <div class="ek-hbar-fill" t-attf-style="width: #{kc.tyle}%; background: #{kc.mau};"/>
                                    </div>
                                    <span class="ek-hbar-val"><t t-esc="kc.giatri_str"/></span>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>