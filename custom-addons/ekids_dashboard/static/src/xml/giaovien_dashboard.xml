<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ekids_dashboard.GiaovienDashboardTemplate">
        <div class="ek-gv-root">
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center" style="height: 300px;">
                <i class="fa fa-spinner fa-spin fa-2x text-primary me-2"/>
                <span style="font-weight: 700; color: #2563eb;">Đang tải không gian làm việc giáo viên...</span>
            </div>

            <div t-if="!state.loading and state.data and !state.data.has_teacher" class="alert alert-warning m-4">
                Tài khoản hiện tại chưa được liên kết với hồ sơ Giáo viên (`ekids.giaovien`). Vui lòng liên hệ Quản trị viên cơ sở.
            </div>

            <div class="ek-container" t-if="!state.loading and state.data and state.data.has_teacher">
                <!-- TOP BAR -->
                <div class="ek-topbar">
                    <div class="ek-teacher-profile">
                        <div class="ek-avatar">
                            <img t-if="state.data.teacher.avatar_b64"
                                 t-attf-src="data:image/png;base64,#{state.data.teacher.avatar_b64}"
                                 alt="Avatar Giáo viên"/>
                            <i t-else="" class="fa fa-graduation-cap"/>
                        </div>
                        <div class="ek-title-group">
                            <h2>
                                <t t-esc="state.data.teacher.name"/>
                                <span class="ek-role-badge"><i class="fa fa-graduation-cap"/> Giáo viên Can thiệp</span>
                            </h2>
                            <p>
                                <t t-esc="state.data.teacher.coso_name"/> • Tuần hiện tại: <strong><t t-esc="state.data.teacher.tuan_str"/></strong>
                            </p>
                        </div>
                    </div>

                    <div class="ek-topbar-right">
                        <div class="ek-select-box">
                            <i class="fa fa-calendar" style="color: var(--text-sub); margin-right: 6px; font-size: 12px;"/>
                            <select t-model="state.monthStr" t-on-change="onChangeMonth">
                                <t t-foreach="state.data.months_options" t-as="m" t-key="m.value">
                                    <option t-att-value="m.value"><t t-esc="m.label"/></option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 1: 4 THẺ KPI CÁ NHÂN -->
                <div class="ek-kpi-strip">
                    <!-- 1. Trẻ phụ trách -->
                    <div class="ek-stat-card hero-purple">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title" style="color: var(--purple);">Trẻ phụ trách tháng này</span>
                            <button class="ek-link-pill" t-on-click="() => this.goiActionCoSo('action_danhsach_hocsinh_lap_kehoach')">
                                Lập kế hoạch <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 6px; flex-wrap: wrap;">
                            <div class="ek-stat-num" style="color: var(--purple);">
                                <t t-esc="state.data.kpi.tong_hs"/> <span style="font-size: 13.5px; font-weight: 600; color: var(--text-sub);">trẻ</span>
                            </div>
                            <div style="display: inline-flex; gap: 4px; font-size: 11px; font-weight: 800;">
                                <span style="background: var(--green-soft); color: var(--green); padding: 2px 7px; border-radius: 5px;">
                                    <t t-esc="state.data.kpi.hs_da_co_kh"/> đã có Kế hoạch
                                </span>
                                <span style="background: var(--red-soft); color: var(--red); padding: 2px 7px; border-radius: 5px;">
                                    <t t-esc="state.data.kpi.hs_chua_co_kh"/> chưa có Kế hoạch
                                </span>
                            </div>
                        </div>

                    </div>

                    <!-- 2. Tiến độ cập nhật tuần này -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Cập nhật kết quả tuần này</span>
                            <span style="font-size: 11px; font-weight: 800; background: var(--amber-soft); color: var(--amber); padding: 2px 7px; border-radius: 5px;">
                                <t t-esc="state.data.kpi.tyle_cham_tuan"/>% hoàn thành
                            </span>
                        </div>
                        <div class="ek-stat-num">
                            <t t-esc="state.data.kpi.done_plans"/> <span style="font-size: 14px; font-weight: 600; color: var(--text-sub);">/ <t t-esc="state.data.kpi.tong_kh_tuan"/> kế hoạch</span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Còn <strong style="color: var(--red);"><t t-esc="state.data.kpi.pending_plans"/> kế hoạch</strong> chưa cập nhật kết quả trong tuần</span>

                        </div>
                    </div>

                    <!-- 3. Nghỉ phép & Vắng mặt trong tháng -->
                    <div class="ek-stat-card">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title">Chuyên cần của bạn T<t t-esc="state.data.thang"/>/<t t-esc="state.data.nam"/></span>
                            <button class="ek-link-pill" t-on-click="() => this.openList('Đơn nghỉ phép của tôi', 'ekids.giaovien_nghiphep', [['giaovien_id', '=', state.data.teacher.id]], {'default_giaovien_id': state.data.teacher.id})">
                                Đăng ký nghỉ <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div style="display: flex; align-items: baseline; gap: 16px;">
                            <div>
                                <div class="ek-stat-num" style="font-size: 20px; color: var(--amber);">
                                    <t t-esc="state.data.kpi.ngay_nghi_phep"/> <span style="font-size: 12px; font-weight: 600;">ngày</span>
                                </div>
                                <div style="font-size: 11px; color: var(--text-sub); font-weight: 600;">Nghỉ phép tháng</div>
                            </div>
                            <div style="width: 1px; height: 28px; background: #e2e8f0;"/>
                            <div>
                                <div class="ek-stat-num" style="font-size: 20px; color: var(--red);">
                                    <t t-esc="state.data.kpi.buoi_vang_mat"/> <span style="font-size: 12px; font-weight: 600;">buổi</span>
                                </div>
                                <div style="font-size: 11px; color: var(--text-sub); font-weight: 600;">Vắng mặt tháng</div>
                            </div>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Theo dõi nghỉ phép &amp; chấm công tháng</span>
                        </div>
                    </div>

                    <!-- 4. Lương thực lĩnh tháng hiện tại -->
                    <div class="ek-stat-card hero-green">
                        <div class="ek-stat-head">
                            <span class="ek-stat-title" style="color: var(--green);">Lương thực lĩnh T<t t-esc="state.data.thang"/>/<t t-esc="state.data.nam"/></span>
                            <button class="ek-link-pill green" t-on-click="() => this.openList('Bảng lương của tôi', 'ekids.luong', [['giaovien_id', '=', state.data.teacher.id]])">
                                Lương tháng của bạn <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                        <div class="ek-stat-num" style="color: var(--green); font-size: 20px;">
                            <t t-esc="state.data.kpi.luong_thuclinh_str"/> <span style="font-size: 13px; font-weight: 700;">vnđ</span>
                        </div>
                        <div class="ek-stat-meta">
                            <span>Thưởng: <strong style="color: #15803d;"><t t-esc="state.data.kpi.phucap_str"/></strong></span>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 2: BIỂU ĐỒ LƯƠNG THỰC LĨNH & TÌNH TRẠNG HỒ SƠ -->
                <div class="ek-visual-row">
                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title">
                                <i class="fa fa-line-chart" style="color: var(--green);"/> Biểu đồ lương thực lĩnh trong năm tài chính (Triệu đồng)
                            </span>
                            <div class="ek-legend-inline">
                                <span style="color: #16a34a;"><i class="ek-dot" style="background: #16a34a;"/>Cột: Lương thực lĩnh</span>
                                <span style="color: #2563eb;"><i class="ek-dot" style="background: #2563eb;"/>Đường: Xu hướng</span>
                            </div>
                        </div>
                        <div style="margin-top: auto;" t-out="getSalaryChartSvg()"/>
                    </div>

                    <div class="ek-card">
                        <div class="ek-card-head">
                            <span class="ek-card-title">
                                <i class="fa fa-folder-open" style="color: var(--amber);"/> Tình trạng hồ sơ kế hoạch phụ trách
                            </span>
                        </div>

                        <div class="ek-ops-grid">
                            <div class="ek-ops-item green">
                                <span class="ek-ops-lbl" style="color: var(--green);">Đang can thiệp</span>
                                <div class="ek-ops-val" style="color: var(--green);"><t t-esc="state.data.ops.dang_canthiep"/></div>
                                <div class="ek-ops-foot">
                                    <span>Đã duyệt &amp; áp dụng</span>
                                </div>
                            </div>

                            <div class="ek-ops-item blue">
                                <span class="ek-ops-lbl" style="color: var(--primary);">Đang soạn / Chờ duyệt</span>
                                <div class="ek-ops-val" style="color: var(--primary);"><t t-esc="state.data.ops.soan_cho_duyet"/></div>
                                <div class="ek-ops-foot">
                                    <span>Chưa phê duyệt</span>
                                </div>
                            </div>

                            <div class="ek-ops-item amber">
                                <span class="ek-ops-lbl" style="color: var(--amber);">Kế hoạch sắp hết hạn</span>
                                <div class="ek-ops-val" style="color: var(--amber);"><t t-esc="state.data.ops.sap_hethan"/></div>
                                <div class="ek-ops-foot">
                                    <span>Trong 10 ngày tới</span>
                                </div>
                            </div>

                            <div class="ek-ops-item red">
                                <span class="ek-ops-lbl" style="color: var(--red);">Trẻ chưa có kế hoạch</span>
                                <div class="ek-ops-val" style="color: var(--red);"><t t-esc="state.data.ops.chua_co_kh"/></div>
                                <div class="ek-ops-foot">
                                    <span>Cần tạo KH tháng</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TẦNG 3: BẢNG DANH SÁCH TRẺ PHỤ TRÁCH & CẬP NHẬT TUẦN -->
                <div class="ek-card" style="margin-bottom: 0;">
                    <div class="ek-card-head">
                        <span class="ek-card-title">
                            <i class="fa fa-check-square-o" style="color: var(--purple);"/>
                            Danh sách trẻ phụ trách &amp; Cập nhật kết quả tuần này (<t t-esc="state.data.teacher.tuan_str"/>)
                        </span>

                        <div class="ek-filter-pills">
                            <button t-attf-class="ek-pill-btn #{state.rowFilter === 'all' ? 'active' : ''}" t-on-click="() => this.setRowFilter('all')">
                                Tất cả (<t t-esc="state.data.student_rows.length"/>)
                            </button>
                            <button t-attf-class="ek-pill-btn #{state.rowFilter === 'pending' ? 'active' : ''}" style="color: var(--red);" t-on-click="() => this.setRowFilter('pending')">
                                Chưa cập nhật tuần này (<t t-esc="state.data.kpi.pending_plans"/>)
                            </button>
                            <button t-attf-class="ek-pill-btn #{state.rowFilter === 'done' ? 'active' : ''}" style="color: var(--green);" t-on-click="() => this.setRowFilter('done')">
                                Đã cập nhật tuần này (<t t-esc="state.data.kpi.done_plans"/>)
                            </button>
                            <button t-attf-class="ek-pill-btn #{state.rowFilter === 'no_plan' ? 'active' : ''}" style="color: var(--amber);" t-on-click="() => this.setRowFilter('no_plan')">
                                Chưa có kế hoạch (<t t-esc="state.data.kpi.hs_chua_co_kh"/>)
                            </button>
                        </div>
                    </div>

                    <div class="ek-scroll-box">
                        <table class="ek-tbl">
                            <thead>
                                <tr>
                                    <th style="width: 50px; text-align: center;">TT</th>
                                    <th style="width: 22%;">Học sinh</th>
                                    <th style="width: 30%;">Kế hoạch can thiệp</th>
                                    <th style="width: 12%; text-align: center;">Ca / tuần</th>
                                    <th style="width: 20%; text-align: center;">Cập nhật tuần này</th>
                                    <th style="width: 12%; text-align: right;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-if="filteredRows.length === 0">
                                    <td colspan="6" style="text-align: center; padding: 24px; color: var(--text-sub);">
                                        Không có dữ liệu phù hợp với bộ lọc đang chọn.
                                    </td>
                                </tr>
                                <t t-foreach="filteredRows" t-as="row" t-key="row_index">
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: var(--text-sub);"><t t-esc="row.stt"/></td>
                                        <td style="font-weight: 800; color: var(--text-main);"><t t-esc="row.student_name"/></td>
                                        <td>
                                            <span t-if="row.plan_name" class="ek-plan-tag"><t t-esc="row.plan_name"/></span>
                                            <span t-else="" style="color: var(--red); font-style: italic; font-size: 12px;">
                                                <i class="fa fa-exclamation-triangle"/> Chưa lập kế hoạch tháng
                                            </span>
                                        </td>
                                        <td style="text-align: center; font-weight: 600;">
                                            <t t-esc="row.so_ca"/> ca
                                        </td>
                                        <td style="text-align: center;">
                                            <span t-if="row.status === 'done'" class="ek-status-badge done">
                                                <i class="fa fa-check-circle"/> Đã cập nhật (<t t-esc="row.last_date"/>)
                                            </span>
                                            <span t-elif="row.status === 'pending'" class="ek-status-badge pending">
                                                <i class="fa fa-clock-o"/> Chưa cập nhật
                                            </span>
                                            <span t-else="" class="ek-status-badge missing">
                                                <i class="fa fa-file-o"/> Chưa có kế hoạch
                                            </span>
                                        </td>
                                        <td style="text-align: right;">
                                            <button t-if="row.status === 'done'" class="ek-link-pill green" t-on-click="() => this.openPlanForm(row.plan_id)">
                                                Xem / Sửa
                                            </button>
                                            <button t-elif="row.status === 'pending'" class="ek-link-pill purple" t-on-click="() => this.openPlanForm(row.plan_id)">
                                                Cập nhật kết quả
                                            </button>
                                            <button t-else="" class="ek-link-pill red" t-on-click="() => this.openPlanForm(false, row.student_id)">
                                                Lập kế hoạch
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>