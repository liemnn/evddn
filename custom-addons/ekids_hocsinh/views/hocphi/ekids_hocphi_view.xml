<odoo>
  <data>

    <record id="action_print_multi_hocphi" model="ir.actions.server">
        <field name="name">In Học Phí</field>
        <field name="model_id" ref="model_ekids_hocphi"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_hocphi"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = env.ref('ekids_hocsinh.action_phieuthus').report_action(records)
        </field>
    </record>
    <record id="ekids_hocsinh.action_chuyen_trangthai_dangtinh" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đang tính]</field>
        <field name="model_id" ref="model_ekids_hocphi"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_hocphi"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('-1')
        </field>
    </record>

    <record id="ekids_hocsinh.action_chuyen_trangthai_da_kiemtra" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đã kiểm tra]</field>
        <field name="model_id" ref="model_ekids_hocphi"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_hocphi"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('0')
        </field>
    </record>

    <record id="ekids_hocsinh.action_chuyen_trangthai_da_tienmat" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đã đóng-Tiền mặt]</field>
        <field name="model_id" ref="model_ekids_hocphi"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_hocphi"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('10')
        </field>
    </record>

    <record id="ekids_hocsinh.action_chuyen_trangthai_da_chuyenkhoan" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đã đóng-Chuyển khoản]</field>
        <field name="model_id" ref="model_ekids_hocphi"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_hocphi"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('11')
        </field>
    </record>

    <record id="ekids_hocsinh.action_chuyen_trangthai_da_xuat_hoadon" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đã xuất Hóa đơn]</field>
        <field name="model_id" ref="model_ekids_hocphi"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_hocphi"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('3')
        </field>
    </record>

    <record id="ekids_hocsinh.action_chuyen_trangthai_no_hocphi" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đang nợ học phí]</field>
        <field name="model_id" ref="model_ekids_hocphi"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_hocphi"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('2')
        </field>
    </record>



    <record id="ekids_hocsinh.hocphi_search" model="ir.ui.view">
        <field name="name">hocphi.search</field>
        <field name="model">ekids.hocphi</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Đang tính" name="trangthai" domain="[('trangthai','=','-1')]"/>
                <filter string="Đã kiểm tra" name="trangthai" domain="[('trangthai','=','0')]"/>
                <filter string="Phụ huynh đã đóng(cần kiểm tra)" name="trangthai" domain="[('trangthai','=','01')]"/>
                <filter string="Đã đóng[Tiền mặt]" name="trangthai" domain="[('loai','=','10')]"/>
                <filter string="Đã đóng[Chuyển khoản]" name="trangthai" domain="[('loai','=','11')]"/>
                <filter string="Đã xuất [Hóa đơn]" name="trangthai" domain="[('trangthai','=','3')]"/>
                <filter string="Đang nợ học phí" name="trangthai" domain="[('trangthai','=','2')]"/>

                <field name="hocsinh_id"/>
                <group expand="1" string="Group By">
                    <filter name="group_by_tinh"
                        string="Trạng thải tính học phí"
                        context="{'group_by':'trangthai'}"/>

                </group>

            </search>
        </field>
    </record>

    <record id="ekids_hocsinh.hocphi_list" model="ir.ui.view">
        <field name="name">Học phí</field>
        <field name="model">ekids.hocphi</field>
        <field name="arch" type="xml">
            <list create="false" delete="true" limit="200" default_order="hocsinh_id asc,id desc">
                <header>
                    <button name="action_xacthuc_tinhlai_hocphi_theo_thang"
                        type="object"
                        string="Tính lại"
                        class="btn-primary"
                        confirm="Bạn chắc chắn muốn tính lại [Học phí] ?
  Thao tác này chỉ áp dụng cho trạng thái [Đang tính].Khi tính lại dữ liệu sẽ bị xóa và tính toán lại !"
                        display="always"/>
                    <button name="action_in_ban_xacnhan"
                        type="object"
                        string="In"
                        class="btn-primary"
                        display="always"/>

                </header>
                <field name="sequence" width="25"/>
                <field name="hocsinh_id" width="170"/>
                <button name="action_in_hocphi"
                            type="object"
                            string=""
                            width="15"
                            class="fa fa-print"
                            title="In học phí của học sinh tháng này"

                        />

                <field name="ngay_nhaphoc" string="Ngày học" optional="hide" width="100"/>
                <field name="ngay_nghihoc" string="Ngày nghỉ" optional="hide" width="100"/>
                <field name="thoigian_hoc" string="Thời gian" optional="hide" width="100"/>
                <field name="trangthai_hocsinh" string="Trạng thái học"  optional="hide" width="100"
                       decoration-success="trangthai_hocsinh == '1'"
                        decoration-info="trangthai_hocsinh == '2'"
                        decoration-danger="trangthai_hocsinh == '3'"/>



                <field name="songay_dihoc" width="30"/>
                <field name="tien_bantru" sum="Total" widget="integer"/>
                <field name="tien_ca" sum="Total" widget="integer"/>
                <field name="tien_duoctru" sum="Total" widget="integer"/>
                <field name="hocphi" sum="Total" widget="integer"/>
                <field name="tyle_giamhocphi" />
                <field name="hocphi_giam" sum="Total" widget="integer"/>
                <field name="hocphi_phaidong" sum="Total" widget="integer"/>
                <field name="trangthai" width="150"
                       decoration-warning="trangthai == '-1'"
                       decoration-info="trangthai == '0'"
                       decoration-muted="trangthai == '10'"
                       decoration-primary="trangthai == '11'"
                       decoration-success="trangthai == '3'"
                       decoration-danger="trangthai == '2'"
                />
                 <field name="loai" string="Hình thức" optional="hide" width="70"/>
                 <field name="ngay_dong_hocphi" string="Ngày đóng" optional="hide" width="70"/>





            </list>
        </field>
    </record>

    <record id="ekids_hocsinh.hocphi_kanban_view" model="ir.ui.view">
        <field name="name">Kanban Học Phi</field>
        <field name="model">ekids.hocphi</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <kanban default_group_by="trangthai" create="false" delete="false" limit="200" default_order="hocsinh_id asc,id desc">
                <field name="trangthai" />
                <field name="hocsinh_id"/>
                <header>
                    <button name="action_xacthuc_tinhlai_hocphi_theo_thang"
                        type="object"
                        string="Tính lại"
                        class="btn-primary"
                        confirm="Bạn chắc chắn muốn tính lại học phí ? nếu xác nhận hệ dữ liệu sẽ mất và hoc phí quay trở lại mặc định !"
                        display="always"/>
                </header>


                <t t-name="kanban-box">
                    <div class="box-user" t-attf-class="oe_kanban_card oe_kanban_global_click">
                    <!-- Vùng ảnh -->
                        <div class="user-avatar">
                            <img t-att-src="kanban_image('ekids.hocsinh', 'avatar', record.hocsinh_id.raw_value)" class="oe_kanban_avatar"/>
                        </div>

                        <!-- Vùng thông tin -->
                        <div class="info">
                            <h3>
                                Tháng <field name="thang_id"/>
                                /<field name="nam_id"/>
                            </h3>
                            <h2>
                                <field name="hocsinh_id"/>
                                <span class="fee">
                                    <field name="hocphi_phaidong"/> vnđ
                                </span>
                            </h2>

                        </div>
                        </div>

                </t>
            </kanban>
        </field>
    </record>

    <record id="ekids_hocsinh.hocphi_form" model="ir.ui.view">
        <field name="name">Thông tin Học phí (Optimized Space)</field>
        <field name="model">ekids.hocphi</field>
        <field name="arch" type="xml">
            <form string="Quản lý Học phí học sinh" class="o_form_sheet_bg">
                <field name="is_chot_hocphi" invisible="1"/>
                <header>
                    <button name="%(ekids_hocsinh.action_phieuthus)d" type="action" class="btn btn-primary" string="In phiếu thu" icon="fa-print"/>
                    <button name="action_xacthuc_tinhlai_hocphi_hocsinh" invisible="is_show_tinhtoan_lai == False" type="object" confirm="Bạn chắc chắn muốn tính toán lại chứ?" class="btn btn-secondary" string="Tính lại [Học phí]"/>
                    <button name="action_chot_hocphi_khi_hocsinh_nghi"
                            invisible="not is_chot_hocphi"
                            type="object"
                            confirm="Hết tháng này học sinh sẽ nghỉ học bạn chắc chắn muốn chốt lại toàn bộ [Học phí] trong tháng?"
                            class="btn btn-secondary"
                            string="Chốt Học phí"/>

                    <field name="trangthai" widget="statusbar" statusbar_visible="-1,0,10,11,3,2" options="{'clickable': true}"
                           invisible="is_dong_hocphi_theoky == True" />
                    <field name="trangthai" widget="statusbar" statusbar_visible="-1,0,10,11,12,3,2"
                            readonly="is_dl_locked"
                           options="{'clickable': true}"
                           invisible="is_dong_hocphi_theoky == False"/>
                </header>

                <sheet class="p-3" style="background-color: #f1f5f9; max-width: 1400px; margin: 0 auto;">
                    <field name="is_dl_locked" invisible="1"/>

                    <!-- 1. HEADER THÔNG TIN HỌC SINH (SIÊU GỌN) -->
                    <div class="bg-white px-3 py-2 rounded-2 shadow-sm mb-2 d-flex flex-wrap justify-content-between align-items-center" style="border-left: 4px solid #2563eb !important;">
                        <div class="d-flex align-items-center" style="gap: 20px;">
                            <div>
                                <span class="text-muted fw-bold d-block" style="font-size: 0.6rem; text-transform: uppercase;">Học sinh</span>
                                <field name="hocsinh_id" readonly="1" class="fw-bold fs-5 text-primary mb-0" options="{'no_open': True}"/>
                            </div>
                            <div class="border-start ps-3">
                                <span class="text-muted fw-bold d-block" style="font-size: 0.6rem; text-transform: uppercase;">Tháng học</span>
                                <span class="fw-bold text-dark">THÁNG <field name="thang_id" readonly="1" class="oe_inline"/></span>
                            </div>
                            <div class="border-start ps-3">
                                <span class="text-muted fw-bold d-block" style="font-size: 0.6rem; text-transform: uppercase;">Khối lượng</span>
                                <span class="badge bg-light text-dark border px-2 py-0.5 fw-bold">
                                    <field name="songay_dihoc" readonly="1" class="oe_inline text-info"/> ngày đi học
                                </span>
                            </div>
                        </div>

                        <!-- Khu vực Ví tiền -->
                        <div class="d-flex align-items-center" style="gap: 10px;" invisible="is_dong_hocphi_theoky == False">
                            <div class="bg-light border rounded-pill px-3 py-1 d-flex align-items-center">
                                <i class="fa fa-google-wallet text-success me-2"/>
                                <div class="d-flex flex-column">
                                    <span style="font-size: 0.55rem; text-transform: uppercase;" class="text-muted fw-bold">Ví học sinh</span>
                                    <span class="fw-bold text-success"><field name="sotien_vi" readonly="1" widget="integer" nolabel="1"/> đ</span>
                                </div>
                            </div>
                            <button name="action_nop_hocphi_qua_vi"
                                    invisible="is_show_vi_thanhtoan == False"
                                    type="object"
                                    class="btn btn-success btn-sm rounded-pill fw-bold px-3 py-1 shadow-sm"
                                    string="Thanh toán"
                                    confirm="Xác nhận trừ tiền từ Ví để đóng học phí?"/>
                        </div>
                    </div>

                    <!-- 2. KHU VỰC TRUNG TÂM (TỐI ƯU CHIỀU CAO & KHOẢNG TRẮNG) -->
                    <div class="row g-2 mb-2">

                        <!-- Cột Trái: Cấu trúc tiền (Giảm padding dọc cho đỡ tốn chỗ) -->
                        <div class="col-lg-7 d-flex flex-column">
                            <div class="bg-white rounded-2 shadow-sm p-3 d-flex flex-column flex-grow-1 border">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                    <span class="fw-bold text-uppercase text-dark" style="font-size: 0.8rem;">
                                        <i class="fa fa-calculator text-primary me-1"/> Cấu trúc tính tiền học phí
                                    </span>
                                    <span class="badge bg-success text-white px-2 py-0.5" style="font-size: 0.65rem;">Chuẩn quy định</span>
                                </div>

                                <div class="flex-grow-1 py-1">
                                    <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom">
                                        <span class="text-dark fw-semibold" style="font-size: 0.9rem;">1. Dịch vụ Ca (Can thiệp)</span>
                                        <div class="d-flex align-items-baseline">
                                            <field name="tien_ca" class="oe_inline text-end fw-bold text-dark" widget="integer" nolabel="1"/>
                                            <span class="ms-1 text-muted small" style="font-size: 0.75rem;">đ</span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom">
                                        <span class="text-dark fw-semibold" style="font-size: 0.9rem;">2. Lớp chung / Bán trú</span>
                                        <div class="d-flex align-items-baseline">
                                            <field name="tien_bantru" class="oe_inline text-end fw-bold text-dark" widget="integer" nolabel="1"/>
                                            <span class="ms-1 text-muted small" style="font-size: 0.75rem;">đ</span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom">
                                        <span class="text-secondary fw-semibold" style="font-size: 0.9rem;">3. Các khoản được trừ (-)</span>
                                        <div class="d-flex align-items-baseline text-danger">
                                            <span class="me-1">-</span>
                                            <field name="tien_duoctru" class="oe_inline text-end fw-bold" widget="integer" nolabel="1"/>
                                            <span class="ms-1 text-muted small" style="font-size: 0.75rem;">đ</span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom">
                                        <span class="text-danger fw-semibold" style="font-size: 0.9rem;">4. Giảm theo chính sách</span>
                                        <div class="d-flex align-items-baseline text-danger">
                                            <span class="me-1">-</span>
                                            <field name="hocphi_giam" class="oe_inline text-end fw-bold" widget="integer" nolabel="1"/>
                                            <span class="ms-1 text-muted small" style="font-size: 0.75rem;">đ</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Khối tổng tiền (Gọn gàng, bám sát nội dung) -->
                                <div class="mt-2 p-2.5 rounded-2 text-white d-flex justify-content-between align-items-center shadow-sm" style="background: #0f172a !important;">
                                    <div class="d-flex flex-column">
                                        <span class="text-uppercase fw-bold" style="font-size: 0.65rem; opacity: 0.8;">Tổng phải đóng thực tế</span>
                                        <span class="text-success fw-bold" style="font-size: 0.7rem;"><i class="fa fa-check-circle me-1"/> Đã khớp số liệu</span>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <field name="hocphi_phaidong" class="fw-black mb-0 oe_inline text-end text-white" style="font-size: 1.25rem; font-weight: 900; line-height: 1;" widget="integer" nolabel="1"/>
                                        <span class="ms-1 fw-bold text-white opacity-75" style="font-size: 0.8rem;">VNĐ</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cột Phải: Thiết lập chính sách (Thu hẹp chiều cao, căn giữa nội dung) -->
                        <div class="col-lg-5 d-flex flex-column">
                            <div class="bg-white rounded-2 shadow-sm p-3 d-flex flex-column flex-grow-1 border">
                                <div class="d-flex align-items-center pb-1 mb-2 border-bottom">
                                    <i class="fa fa-sliders text-primary me-1"/>
                                    <span class="fw-bold text-uppercase text-dark" style="font-size: 0.8rem;">Thiết lập chính sách giảm</span>
                                </div>

                                <div class="flex-grow-1 d-flex flex-column justify-content-center py-2">
                                    <group class="mb-0">
                                        <field name="dm_chinhsach_giam_id" string="Diện chính sách" readonly="1"/>
                                        <field name="is_giamhocphi_dacthu" string="Giảm đặc thù" widget="boolean_toggle" readonly="is_dl_locked"/>
                                        <field name="tyle_giamhocphi" string="% Giảm tổng" widget="percent" class="fw-bold text-danger" invisible="is_giamhocphi_dacthu == True" readonly="is_dl_locked"/>
                                        <field name="tyle_giamhocphi_bantru" string="% Giảm lớp chung" widget="percent" class="fw-bold text-danger" invisible="is_giamhocphi_dacthu == False" readonly="is_dl_locked"/>
                                        <field name="tyle_giamhocphi_ca" string="% Giảm can thiệp" widget="percent" class="fw-bold text-danger" invisible="is_giamhocphi_dacthu == False" readonly="is_dl_locked"/>
                                    </group>
                                </div>

                                <div class="text-muted fst-italic text-center pt-1 border-top" style="font-size: 0.7rem;">
                                    Hệ thống tự động tính toán lại khi thay đổi cấu hình.
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- 3. KHU VỰC CHI TIẾT BÊN DƯỚI -->
                    <div class="bg-white rounded-2 shadow-sm p-2 border">
                        <notebook class="custom-app-notebook">
                            <page name="hocphi_ca_ids" string="Chi tiết Dịch vụ Ca [+]">
                                <field name="hocphi_ca_ids" context="{'default_coso_id': coso_id}" readonly="is_dl_locked"/>
                            </page>
                            <page name="hocphi_bantru_ids" string="Chi tiết Lớp chung [+]">
                                <field name="hocphi_bantru_ids" context="{'default_coso_id': coso_id}" readonly="is_dl_locked"/>
                            </page>
                            <page name="hocphi_duoctru_ids" string="Chi tiết Khoản được trừ [-]">
                                <field name="hocphi_duoctru_ids" context="{'default_coso_id': coso_id}" readonly="is_dl_locked"/>
                            </page>
                        </notebook>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="ekids_hocsinh.hocphi_bantru" model="ir.ui.view">
        <field name="name">Tiền bán trú</field>
        <field name="model">ekids.hocphi_bantru</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="tien" sum="Total" widget="integer"/>
            </list>
        </field>
    </record>

    <record id="ekids_hocsinh.hocphi_ca" model="ir.ui.view">
        <field name="name">Tiền can thiệp theo ca</field>
        <field name="model">ekids.hocphi_ca</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="dm_ca_id" context="{'default_coso_id':context.get('default_coso_id')}"/>
                <field name="soca"/>
                <field name="tien" sum="Total" widget="integer"/>
            </list>
        </field>
    </record>



    <record id="ekids_hocsinh.hocphi_duoctru" model="ir.ui.view">
        <field name="name">Tiền Được giảm khi nghỉ</field>
        <field name="model">ekids.hocphi_duoctru</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="tien" sum="Total" widget="integer"/>

            </list>
        </field>
    </record>

  </data>
</odoo>