<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ekids_hocsinh.hocphi_thang_baocao_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="font-size: 13.5px; font-family: 'Times New Roman', Times, serif;">

                        <!-- NÚT IN (Chỉ hiển thị trên giao diện web, ẩn khi xuất file PDF) -->
                        <div class="text-end mb-2 px-2 print-hide">
                            <button onclick="window.print();" class="btn btn-secondary btn-sm" style="font-size: 13.5px;">
                                <i class="fa fa-print"/> In báo cáo
                            </button>
                        </div>

                        <!-- CSS TỐI ƯU TRÀN VIỀN 100% CHIỀU RỘNG -->
                        <style>
                            @media print {
                                .print-hide {
                                    display: none !important;
                                }
                                body {
                                    font-size: 12px;
                                }
                            }
                            /* Ép toàn bộ khung layout mở rộng full màn hình, loại bỏ lề mặc định */
                            body, .o_report_layout_standard, .o_layout, .page {
                                width: 100% !important;
                                max-width: 100% !important;
                                margin: 0 !important;
                                padding: 5px !important;
                            }
                            /* Bảng dữ liệu chiếm trọn không gian, hỗ trợ cuộn ngang mượt mà */
                            .table-responsive {
                                width: 100% !important;
                                margin: 0 !important;
                                padding: 0 !important;
                                overflow-x: auto;
                                -webkit-overflow-scrolling: touch;
                            }
                            .report-table {
                                width: 100% !important;
                                max-width: none !important;
                            }
                            .report-table th, .report-table td {
                                white-space: nowrap;
                                vertical-align: middle !important;
                                padding: 6px 8px !important;
                            }
                            .col-hocsinh {
                                min-width: 140px;
                                max-width: 200px;
                                white-space: normal !important;
                                word-break: break-word;
                            }
                        </style>

                        <!-- HEADER BÁO CÁO -->
                        <div class="text-center mb-3 mt-1">
                            <h3 class="fw-bold text-uppercase m-0" style="font-size: 17px; color: #000; letter-spacing: 0.3px;">
                                BẢNG CHI TIẾT HỌC PHÍ THÁNG <span t-esc="data.get('thang_label', '')"/>/<span t-esc="data.get('nam_label', '')"/>
                            </h3>
                            <div class="fst-italic text-dark mt-1" style="font-size: 14px;">
                                Cơ sở: <span t-esc="data.get('coso_name', '')"/>
                            </div>
                        </div>

                        <!-- BẢNG DỮ LIỆU FULL CHIỀU RỘNG -->
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm align-middle report-table" style="border-color: #000; font-size: 13.5px; color: #000;">
                                <thead>
                                    <tr class="text-center bg-light fw-bold" style="vertical-align: middle;">
                                        <th rowspan="2" class="fw-bold" style="width: 35px;">TT</th>
                                        <th rowspan="2" class="fw-bold col-hocsinh">Họ và tên học sinh</th>

                                        <!-- HEADER CỘT ĐỘNG -->
                                        <th t-foreach="data.get('dynamic_columns', [])" t-as="col" class="fw-bold">
                                            <span t-esc="col.get('name', '')"/>
                                        </th>

                                        <!-- CỘT KHÁC -->
                                        <th rowspan="2" class="fw-bold" style="width: 80px;">Khác</th>

                                        <!-- HEADER CỐ ĐỊNH -->
                                        <th rowspan="2" class="fw-bold" style="width: 95px;">Trừ tháng trước</th>
                                        <th rowspan="2" class="fw-bold" style="width: 95px;">Trừ chính sách</th>
                                        <th rowspan="2" class="fw-bold" style="width: 110px;">Tổng phải đóng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data.get('rows', [])" t-as="r">
                                        <td class="text-center fw-bold"><t t-esc="r.get('stt', 0)"/></td>
                                        <td class="col-hocsinh"><t t-esc="r.get('hocsinh_name', '')"/></td>

                                        <!-- SỐ TIỀN CỘT ĐỘNG -->
                                        <td t-foreach="data.get('dynamic_columns', [])" t-as="col" class="text-end">
                                            <span t-esc="r.get('col_amounts', {}).get(str(col.get('id')), 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>

                                        <!-- SỐ TIỀN CỘT KHÁC -->
                                        <td class="text-end">
                                            <span t-esc="r.get('tien_khac', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>

                                        <!-- SỐ TIỀN CỐ ĐỊNH -->
                                        <td class="text-end text-danger">
                                            <span t-esc="r.get('giam_thang_truoc', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>
                                        <td class="text-end text-danger">
                                            <span t-esc="r.get('giam_chinh_sach', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            <span t-esc="r.get('tong_phai_dong', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold bg-light" style="vertical-align: middle;">
                                        <td colspan="2" class="text-center fw-bold">TỔNG CỘNG</td>

                                        <!-- TỔNG CỘNG CỘT ĐỘNG -->
                                        <td t-foreach="data.get('dynamic_columns', [])" t-as="col" class="text-end fw-bold">
                                            <span t-esc="data.get('totals', {}).get(str(col.get('id')), 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>

                                        <!-- TỔNG CỘT KHÁC -->
                                        <td class="text-end fw-bold">
                                            <span t-esc="data.get('totals', {}).get('khac', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>

                                        <!-- TỔNG CỘT CỐ ĐỊNH -->
                                        <td class="text-end text-danger fw-bold">
                                            <span t-esc="data.get('totals', {}).get('giam_thang_truoc', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>
                                        <td class="text-end text-danger fw-bold">
                                            <span t-esc="data.get('totals', {}).get('giam_chinh_sach', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>
                                        <td class="text-end text-success fw-bold">
                                            <span t-esc="data.get('totals', {}).get('tong_phai_dong', 0.0)" t-options="{'widget': 'integer'}"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>