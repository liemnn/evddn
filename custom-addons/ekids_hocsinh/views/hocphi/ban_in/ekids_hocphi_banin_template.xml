<odoo>
    <template id="ekids_hocsinh.action_hocphi_banin_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: Arial, sans-serif;">

                    <!-- NÚT IN (Ẩn khi in ấn) -->
                    <div class="btn-print-container text-end mb-2 px-2 print-hide" style="text-align: right;">
                        <button onclick="window.print()"
                                style="width:30px; height:auto; border:0px; background:transparent; cursor: pointer;"
                                title="In báo cáo" type="button">
                            <i class="fa fa-print" style="font-size: 18px; color: #555;"></i>
                        </button>
                    </div>

                    <table width="100%" border="0">
                        <tr>
                            <td style="text-align:center;">
                                <h3 style="font-size:18px; font-weight: bold; text-transform: uppercase; margin-bottom: 15px;">
                                    BẢN XÁC NHẬN ĐÓNG HỌC PHÍ THÁNG <t t-esc="thang"/>/<t t-esc="nam"/>
                                </h3>
                            </td>
                        </tr>
                    </table>

                    <!-- KHUNG CUỘN KẾT HỢP GHIM HEADER VÀ CỘT TÊN HỌC SINH -->
                    <div class="table-responsive">
                        <table width="100%" border="1" cellspacing="0" cellpadding="0" class="box-table">
                            <thead>
                                <tr>
                                    <t t-foreach="table_data[0]" t-as="header">
                                        <th t-attf-class="#{ 'sticky-col-header' if header_index == 1 else '' }">
                                            <t t-esc="header"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="table_data[1:]" t-as="row">
                                    <tr>
                                        <t t-foreach="enumerate(row)" t-as="item">
                                            <td t-attf-class="col-#{item[0]} #{ 'sticky-col-cell' if item[0] == 1 else '' }">
                                                <t t-esc="item[1]"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <style>
                        /* 1. ÉP KHỔ GIẤY A4 VÀ TRÀN VIỀN 100% */
                        @page {
                            size: A4;
                            margin: 10mm 10mm 10mm 10mm !important;
                        }

                        body, .o_report_layout_standard, .o_layout, .page {
                            width: 100% !important;
                            max-width: 100% !important;
                            margin: 0 !important;
                            padding: 5px !important;
                        }

                        /* 2. CÁC THIẾT LẬP KHI MÁY IN CHẠY */
                        @media print {
                            .btn-print-container {
                                display: none !important;
                            }
                            body, .page {
                                margin-top: 0px !important;
                                padding-top: 0px !important;
                            }
                            /* Khi in thì bỏ sticky để bảng trải dài tự nhiên theo trang giấy */
                            .box-table th, .sticky-col-header, .sticky-col-cell {
                                position: static !important;
                            }
                        }

                        *:not(i) {
                            font-family: Arial, sans-serif !important;
                        }

                        /* 3. KHUNG CUỘN VÀ TÍNH NĂNG STICKY (GHIM HEADER  CỘT TÊN) */
                        .table-responsive {
                            width: 100% !important;
                            max-height: 75vh;
                            margin: 0 !important;
                            padding: 0 !important;
                            overflow: auto;
                            -webkit-overflow-scrolling: touch;
                        }

                        .box-table {
                            border-collapse: collapse;
                            width: 100% !important;
                            max-width: none !important;
                            table-layout: auto;
                        }

                        /* Ghim cố định Header (Hàng tiêu đề) */
                        .box-table th {
                            position: sticky;
                            top: 0;
                            z-index: 3;
                            background-color: #f2f2f2;
                            color: #212529;
                            border: 1px solid #ccc;
                            font-size: 14px;
                            height: 35px;
                            padding: 5px;
                            text-align: center;
                            white-space: nowrap;
                        }

                        .box-table td {
                            border: 1px solid #ccc;
                            font-size: 13px;
                            padding: 5px;
                            white-space: nowrap;
                            background-color: #ffffff;
                        }

                        /* Ghim cố định Cột 1 (Tên học sinh) */
                        .sticky-col-header {
                            left: 0;
                            z-index: 4;
                            background-color: #e9ecef !important;
                        }

                        .sticky-col-cell {
                            position: sticky;
                            left: 0;
                            z-index: 2;
                            background-color: #f8f9fa !important;
                            font-weight: bold;
                        }

                        /* 4. ĐỘ RỘNG CÁC CỘT */
                        td.col-0 { width: 5%; text-align: center !important; padding: 5px !important; }
                        td.col-1 { width: 20%; text-align: left !important; padding: 5px !important; white-space: normal !important; min-width: 150px; }
                        td.col-2 { width: 10%; text-align: right !important; padding: 5px !important; }
                        td.col-3 { width: 10%; text-align: right !important; padding: 5px !important; }
                        td.col-4 { width: 10%; text-align: right !important; font-weight: bold; padding: 5px !important; }
                        td.col-5 { width: 20%; padding: 5px !important; }
                        td.col-6 { width: 20%; padding: 5px !important; }

                        thead {
                            display: table-header-group;
                        }

                        .page {
                            padding: 0px;
                            margin: 0px;
                        }
                    </style>

                </div>
            </t>
        </t>
    </template>
</odoo>