<odoo>
    <data>

        <!-- 1. LIST VIEW: GIỮ NGUYÊN -->
        <record model="ir.ui.view" id="ekids_hocsinh.hocsinh_lichsu_canthiep_list">
            <field name="name">hocsinh_lichsu_canthiep list</field>
            <field name="model">ekids.hocsinh_lichsu_canthiep</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="thoigian_hoc" string="Thời gian"/>
                    <field name="is_thoigian_hoc" widget="boolean_toggle"/>
                    <field name="desc"/>
                    <field name="trangthai"
                           decoration-success="trangthai == '1'"
                           decoration-danger="trangthai == '-1'"/>
                </list>
            </field>
        </record>

        <!-- 2. KANBAN VIEW: THIẾT KẾ LẠI TRỰC QUAN, RÕ RÀNG & CHUẨN MOBILE -->
        <record model="ir.ui.view" id="ekids_hocsinh.hocsinh_lichsu_canthiep_kanban">
            <field name="name">hocsinh_lichsu_canthiep.kanban</field>
            <field name="model">ekids.hocsinh_lichsu_canthiep</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_order="tu_ngay desc, sequence">
                    <field name="id"/>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="thoigian_hoc"/>
                    <field name="is_thoigian_hoc"/>
                    <field name="desc"/>
                    <field name="trangthai"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="d-flex flex-column position-relative"
                                 style="border-radius: 12px; padding: 14px 16px; border: 1.5px solid #e2e8f0; background: #ffffff; box-shadow: 0 2px 6px rgba(15,23,42,0.04); margin-bottom: 8px;">

                                <!-- Menu 3 chấm góc trên bên phải -->
                                <div class="o_dropdown_kanban dropdown" style="position: absolute; right: 8px; top: 10px; z-index: 10;">
                                    <a class="dropdown-toggle o-no-caret btn btn-sm text-muted px-2 py-1" role="button" data-bs-toggle="dropdown" href="#">
                                        <i class="fa fa-ellipsis-v"></i>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item text-primary fw-semibold">
                                            <i class="fa fa-pencil me-2"></i> Chỉnh sửa
                                        </a>
                                        <a role="menuitem" type="delete"
                                           confirm="Xóa bản ghi này sẽ làm mất dữ liệu. Bạn có chắc chắn không?"
                                           class="dropdown-item text-danger fw-semibold">
                                            <i class="fa fa-trash-o me-2"></i> Xóa
                                        </a>
                                    </div>
                                </div>

                                <!-- Vùng click mở Form View (chừa phần chân thẻ cho nút toggle) -->
                                <div class="oe_kanban_global_click">
                                    <!-- Header: Tên cơ sở / nơi can thiệp + Badge trạng thái -->
                                    <div class="d-flex align-items-start justify-content-between gap-2 pe-4 mb-2">
                                        <div style="font-size: 14.5px; color: #0f172a; font-weight: 800; line-height: 1.35;">
                                            <i class="fa fa-building-o me-1.5" style="color: #3b6e8c;"></i>
                                            <field name="name"/>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <field name="trangthai" widget="badge"
                                                   decoration-success="trangthai == '1'"
                                                   decoration-danger="trangthai == '-1'"/>
                                        </div>
                                    </div>

                                    <!-- Dải thời gian & Tổng thời lượng -->
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 mb-2"
                                         style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 12.5px;">
                                        <div class="d-flex align-items-center fw-bold text-dark">
                                            <i class="fa fa-calendar-o text-primary me-1.5"></i>
                                            <field name="tu_ngay"/>
                                            <i class="fa fa-long-arrow-right text-muted mx-2" style="opacity: 0.6;"/>
                                            <t t-if="record.den_ngay.raw_value">
                                                <field name="den_ngay"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-success fw-bold">Nay</span>
                                            </t>
                                        </div>

                                        <span class="badge rounded-pill"
                                              style="background-color: #e0f2fe; color: #0369a1; font-weight: 700; font-size: 11.5px; padding: 4px 10px;">
                                            <i class="fa fa-clock-o me-1"></i>
                                            <field name="thoigian_hoc"/>
                                        </span>
                                    </div>

                                    <!-- Ghi chú (nếu có) -->
                                    <t t-if="record.desc.raw_value">
                                        <div class="text-muted mb-2"
                                             style="font-size: 12.5px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            <i class="fa fa-align-left me-1" style="opacity: 0.5;"></i>
                                            <field name="desc"/>
                                        </div>
                                    </t>
                                </div>

                                <!-- Footer: Nút gạt Cộng vào thời gian học (tách ngoài global_click để bấm trực tiếp) -->
                                <div class="d-flex align-items-center justify-content-between pt-2 mt-1"
                                     style="border-top: 1px dashed #e2e8f0; font-size: 12px;">
                                    <span class="fw-bold" style="color: #475569;">
                                        <i class="fa fa-plus-circle me-1" style="color: #d97706;"></i> Cộng vào thời gian học
                                    </span>
                                    <div>
                                        <field name="is_thoigian_hoc" widget="boolean_toggle"/>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- 3. FORM VIEW: THIẾT KẾ LẠI GỌN ĐẸP, ĐẦY ĐỦ TRƯỜNG & RESPONSIVE WEB/MOBILE -->
        <record id="ekids_hocsinh.hocsinh_lichsu_canthiep_form" model="ir.ui.view">
            <field name="name">hocsinh_lichsu_canthiep.form.premium</field>
            <field name="model">ekids.hocsinh_lichsu_canthiep</field>
            <field name="arch" type="xml">
                <form string="Lịch sử Học tập / Can thiệp">
                    <sheet class="p-0">
                        <style>
                            .ek-ls-wrap {
                                padding: 14px 16px;
                                background: #ffffff;
                            }
                            .ek-ls-card {
                                background: #f8fafc;
                                border: 1.5px solid #e2e8f0;
                                border-radius: 12px;
                                padding: 14px;
                            }
                            .ek-ls-header {
                                font-size: 13px;
                                font-weight: 800;
                                color: #1e293b;
                                text-transform: uppercase;
                                letter-spacing: 0.3px;
                                margin-bottom: 12px;
                                display: flex;
                                align-items: center;
                                gap: 6px;
                            }
                            .ek-ls-row-top {
                                display: grid;
                                grid-template-columns: 2fr 1fr;
                                gap: 10px;
                                margin-bottom: 10px;
                            }
                            .ek-ls-row-dates {
                                display: grid;
                                grid-template-columns: 1fr 1fr 1fr;
                                gap: 10px;
                                margin-bottom: 10px;
                            }
                            .ek-ls-box {
                                background: #ffffff;
                                border: 1.5px solid #cbd5e1;
                                border-radius: 10px;
                                padding: 8px 12px;
                                display: flex;
                                flex-direction: column;
                                justify-content: center;
                            }
                            .ek-ls-box.duration-box {
                                background: #f0f9ff;
                                border-color: #7dd3fc;
                            }
                            .ek-ls-lbl {
                                font-size: 10.5px;
                                font-weight: 800;
                                color: #475569 !important;
                                text-transform: uppercase;
                                letter-spacing: 0.3px;
                                margin-bottom: 4px;
                                display: flex;
                                align-items: center;
                            }
                            .ek-ls-box input,
                            .ek-ls-box select,
                            .ek-ls-box textarea {
                                border: none !important;
                                box-shadow: none !important;
                                background: transparent !important;
                                padding: 0 !important;
                                color: #0f172a !important;
                                font-weight: 700 !important;
                                font-size: 14px !important;
                                width: 100% !important;
                            }
                            .ek-ls-duration-val {
                                font-size: 14.5px;
                                font-weight: 800;
                                color: #0369a1;
                            }

                            /* Khối công tắc Cộng vào thời gian học */
                            .ek-ls-toggle-strip {
                                background: #ffffff;
                                border: 1.5px solid #e08e0b;
                                border-radius: 10px;
                                padding: 9px 12px;
                                margin-bottom: 10px;
                                display: flex;
                                align-items: center;
                                gap: 10px;
                            }
                            .ek-ls-toggle-icon {
                                width: 32px;
                                height: 32px;
                                background: #fef3c7;
                                border-radius: 8px;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                color: #d97706;
                                font-size: 14px;
                                flex-shrink: 0;
                            }
                            .ek-ls-toggle-body {
                                flex-grow: 1;
                                min-width: 0;
                            }
                            .ek-ls-toggle-title {
                                font-size: 12.5px;
                                font-weight: 800;
                                color: #92400e;
                                text-transform: uppercase;
                                display: block;
                            }
                            .ek-ls-toggle-desc {
                                font-size: 11.5px;
                                color: #475569;
                                margin: 0;
                                line-height: 1.35;
                            }

                            /* Responsive trên Mobile ( 576px) */
                            @media (max-width: 576px) {
                                .ek-ls-wrap { padding: 8px 10px; }
                                .ek-ls-card { padding: 10px; }
                                .ek-ls-row-top,
                                .ek-ls-row-dates {
                                    grid-template-columns: 1fr;
                                    gap: 8px;
                                }
                                .ek-ls-toggle-strip {
                                    flex-wrap: wrap;
                                }
                                .ek-ls-toggle-action {
                                    margin-left: auto;
                                }
                            }
                        </style>

                        <field name="sequence" invisible="1"/>
                        <field name="coso_id" invisible="1"/>
                        <field name="hocsinh_id" invisible="1"/>

                        <div class="ek-ls-wrap">
                            <div class="ek-ls-card">
                                <div class="ek-ls-header">
                                    <i class="fa fa-history text-primary"/> QUÁ TRÌNH HỌC TẬP / CAN THIỆP TRƯỚC ĐÂY
                                </div>

                                <!-- DÒNG 1: NƠI HỌC TẬP & TRẠNG THÁI -->
                                <div class="ek-ls-row-top">
                                    <div class="ek-ls-box">
                                        <span class="ek-ls-lbl">
                                            <i class="fa fa-building-o me-1.5 text-primary"/> NƠI HỌC TẬP / CAN THIỆP
                                        </span>
                                        <field name="name" placeholder="VD: Trung tâm Ánh Sao, Mầm non Hoa Hồng..."/>
                                    </div>

                                    <div class="ek-ls-box">
                                        <span class="ek-ls-lbl">
                                            <i class="fa fa-tag me-1.5 text-secondary"/> TRẠNG THÁI
                                        </span>
                                        <field name="trangthai" widget="selection"/>
                                    </div>
                                </div>

                                <!-- DÒNG 2: TỪ NGÀY - ĐẾN NGÀY - THỜI GIAN TỰ TÍNH -->
                                <div class="ek-ls-row-dates">
                                    <div class="ek-ls-box">
                                        <span class="ek-ls-lbl" style="color: #15803d !important;">
                                            <i class="fa fa-calendar-check-o me-1.5"/> TỪ NGÀY
                                        </span>
                                        <field name="tu_ngay"/>
                                    </div>

                                    <div class="ek-ls-box">
                                        <span class="ek-ls-lbl" style="color: #b91c1c !important;">
                                            <i class="fa fa-calendar-times-o me-1.5"/> ĐẾN NGÀY
                                        </span>
                                        <field name="den_ngay" placeholder="(Đang theo học...)"/>
                                    </div>

                                    <div class="ek-ls-box duration-box">
                                        <span class="ek-ls-lbl" style="color: #0369a1 !important;">
                                            <i class="fa fa-clock-o me-1.5"/> THỜI GIAN THEO HỌC
                                        </span>
                                        <div class="ek-ls-duration-val">
                                            <field name="thoigian_hoc" readonly="1"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- DÒNG 3: CỘNG VÀO THỜI GIAN HỌC (is_thoigian_hoc) -->
                                <div class="ek-ls-toggle-strip">
                                    <div class="ek-ls-toggle-icon">
                                        <i class="fa fa-calculator"/>
                                    </div>
                                    <div class="ek-ls-toggle-body">
                                        <span class="ek-ls-toggle-title">Cộng vào thời gian học</span>
                                        <p class="ek-ls-toggle-desc">
                                            <strong>Khi bật:</strong> Khoảng thời gian này sẽ được cộng dồn vào tổng thời gian theo học của trẻ.
                                        </p>
                                    </div>
                                    <div class="ek-ls-toggle-action">
                                        <field name="is_thoigian_hoc" widget="boolean_toggle"/>
                                    </div>
                                </div>

                                <!-- DÒNG 4: GHI CHÚ -->
                                <div class="ek-ls-box">
                                    <span class="ek-ls-lbl">
                                        <i class="fa fa-align-left me-1.5 text-primary"/> GHI CHÚ / CHI TIẾT CAN THIỆP
                                    </span>
                                    <field name="desc" placeholder="Ghi chú thêm về phương pháp can thiệp, lý do chuyển trường, hoặc nhận xét của giáo viên cũ..."/>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>