<odoo>
    <data>

        <record id="ekids_hocsinh.hocphi_dm_thu_bantru_search" model="ir.ui.view">
            <field name="name">hocphi_dm_thu_bantru.search</field>
            <field name="model">ekids.hocphi_dm_thu_bantru</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Đang hoạt động" name="trangthai" domain="[('trangthai','=',1)]"/>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record  id="ekids_hocsinh.hocphi_dm_thu_bantru_list_view" model="ir.ui.view">
            <field name="name">Dm thu bán trú</field>
            <field name="model">ekids.hocphi_dm_thu_bantru</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name" width="200"/>
                    <field name="loai"/>
                    <field name="tien"/>
                    <field name="desc"/>
                    <field name="is_hoantien_khi_nghi"  width="100" widget="boolean_toggle" string="Hoàn tiền"/>
                    <field name="is_giam_hocphi"  width="100" widget="boolean_toggle" string="Giảm học phí"/>
                    <field name="trangthai"
                           decoration-success="trangthai == '1'"
                           decoration-danger="trangthai == '0'"/>
                </list>
            </field>
        </record>

        <record id="ekids_hocsinh.hocphi_dm_thu_bantru_form" model="ir.ui.view">
            <field name="name">Danh mục thu bán trú</field>
            <field name="model">ekids.hocphi_dm_thu_bantru</field>
            <field name="arch" type="xml">
                <form string="Cơ sở">
                    <sheet>
                        <style>
                            .ekids_custom_card { background: #ffffff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: 20px; height: 100%; border: 1px solid #f1f5f9; }
                            .ekids_card_title { color: #1e3a8a; font-size: 13px; font-weight: 800; text-transform: uppercase; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; }
                            .ekids_card_title i { color: #6366f1; margin-right: 8px; font-size: 16px; }
                            .setting-box { background: #f8fafc; border-radius: 8px; padding: 10px 15px; margin-bottom: 12px; border: 1px solid #e2e8f0; }
                            .variable-guide { background: #f1f5f9; border-left: 4px solid #6366f1; border-radius: 8px; padding: 15px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
                            .variable-item { margin-bottom: 8px; display: flex; align-items: flex-start; }
                            .variable-code { background: #e2e8f0; color: #e11d48; padding: 2px 6px; border-radius: 4px; font-weight: 800; margin-right: 10px; font-size: 0.85rem; min-width: 160px; display: inline-block; }
                        </style>

                        <div class="oe_title mb-4">
                            <div class="text-muted d-flex align-items-center mb-1">
                                <i class="fa fa-building-o me-2"/> <field name="coso_id" readonly="1" options="{'no_open': True}"/>
                            </div>
                            <label for="name" class="oe_edit_only fw-bold" string="Tên loại hình thu [Bán trú / Dịch vụ]"/>
                            <h1 class="text-primary fw-bolder">
                                <field name="name" placeholder="VD: Tiền ăn bán trú / Tiền đưa đón..."/>
                            </h1>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="ekids_custom_card">
                                    <div class="ekids_card_title">
                                        <i class="fa fa-pencil-square-o"/> Thông tin chung &amp; Định mức
                                    </div>
                                    <group>
                                        <field name="loai" string="Loại hình thu"/>
                                        <field name="tien" string="Số tiền (VNĐ)" class="fw-bold text-success fs-4"/>
                                        <field name="desc" string="Ghi chú" placeholder="Mô tả nội bộ..."/>
                                    </group>

                                    <div class="setting-box d-flex justify-content-between align-items-center mt-3" style="background: #fff5f5; border-color: #feb2b2;">
                                        <span class="fw-bold text-danger"><i class="fa fa-users me-2"/>Thiết lập [Riêng] cho học sinh áp dụng cho khoản thu này</span>
                                        <field name="is_apdung_rieng" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="ekids_custom_card">
                                    <div class="ekids_card_title">
                                        <i class="fa fa-cogs"/> Trạng thái &amp; Cấu hình
                                    </div>

                                    <group>
                                        <field name="trangthai" string="Trạng thái" widget="badge" decoration-success="trangthai == '1'"/>
                                    </group>

                                    <div class="setting-box d-flex justify-content-between align-items-center mt-3">
                                        <span class="fw-bold" style="color: #334155;">Là khoản học phí (phục vụ học tập)</span>
                                        <field name="is_hocphi" widget="boolean_toggle" nolabel="1"/>
                                    </div>

                                    <div class="setting-box d-flex justify-content-between align-items-center">
                                        <span class="fw-bold" style="color: #334155;">Được tính toán giảm [học phí] (nếu có)</span>
                                        <field name="is_giam_hocphi" widget="boolean_toggle" nolabel="1"/>
                                    </div>

                                    <div class="setting-box">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold" style="color: #334155;">Sẽ hoàn tiền khi học sinh nghỉ</span>
                                            <field name="is_hoantien_khi_nghi" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                        <div invisible="is_hoantien_khi_nghi" class="mt-3 border-top pt-2">
                                            <group>
                                                <field name="tyle_hoan_rieng"  class="text-danger fw-bold"/>
                                            </group>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3" invisible="not is_formula">
                            <div class="col-12">
                                <div class="ekids_custom_card">
                                    <div class="ekids_card_title">
                                        <i class="fa fa-code"/> Hướng dẫn các biến sử dụng trong công thức
                                    </div>
                                    <div class="variable-guide">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="variable-item">
                                                    <span class="variable-code">$NGAY_DIHOC_QUYDINH</span>
                                                    <span class="text-dark small">Ngày đi học quy định trong tháng</span>
                                                </div>
                                                <div class="variable-item">
                                                    <span class="variable-code">$NGAY_HOC</span>
                                                    <span class="text-dark small">Số ngày [Học] thực tế tháng trước</span>
                                                </div>
                                                <div class="variable-item">
                                                    <span class="variable-code">$VANG_MAT</span>
                                                    <span class="text-dark small">Số ngày [Vắng mặt] không báo trước</span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="variable-item">
                                                    <span class="variable-code">$NGHI_CO_PHEP</span>
                                                    <span class="text-dark small">Số ngày [Nghỉ có phép] thực tế</span>
                                                </div>
                                                <div class="variable-item">
                                                    <span class="variable-code">$NHATRUONG_NGHI</span>
                                                    <span class="text-dark small">Số ngày [Nhà trường cho nghỉ]</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2" invisible="not is_apdung_rieng">
                            <div class="col-12">
                                <div class="ekids_custom_card" style="padding: 0; overflow: hidden;">
                                    <notebook>
                                        <page name="hocsinh_ids" string="DANH SÁCH HỌC SINH ĐANG THU KHOẢN NÀY">
                                            <field name="hocsinh_ids"
                                                   domain="[('coso_id', '=', coso_id),('trangthai', '=', '1')]"
                                                   context="{'default_coso_id': coso_id}"
                                                   class="m-0 p-0 border-0">

                                                <list>
                                                    <field name="name" string="Họ và tên"/>
                                                    <field name="bietdanh" string="Biệt danh"/>
                                                    <field name="gioitinh" string="Giới tính"/>
                                                    <field name="ngaysinh" string="Ngày sinh"/>
                                                    <field name="trangthai" widget="badge" decoration-success="trangthai == '1'"/>
                                                </list>

                                                <kanban>
                                                    <field name="name"/>
                                                    <field name="bietdanh"/>
                                                    <field name="trangthai"/>
                                                    <templates>
                                                        <t t-name="kanban-box">
                                                            <div class="oe_kanban_global_click d-flex align-items-center p-2 border-bottom">
                                                                <div class="oe_kanban_details">
                                                                    <strong class="o_kanban_record_title text-primary"><field name="name"/></strong>
                                                                    <div t-if="record.bietdanh.value" class="small text-muted">
                                                                        Biệt danh: <field name="bietdanh"/>
                                                                    </div>
                                                                    <div class="mt-1">
                                                                        <field name="trangthai" widget="badge" decoration-success="trangthai == '1'"/>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </templates>
                                                </kanban>
                                            </field>
                                        </page>
                                    </notebook>
                                </div>
                            </div>
                        </div>

                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
