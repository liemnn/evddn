<odoo>
  <data>

     <record id="ekids_giaovien.action_phieuluongs" model="ir.actions.server">
        <field name="name">In Phiếu Lương</field>
        <field name="model_id" ref="model_ekids_luong"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_luong"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = env.ref('ekids_giaovien.action_phieuluong').report_action(records)
        </field>
    </record>
    <record id="ekids_giaovien.action_chuyen_trangthai_dang_tinh" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đang tính]</field>
        <field name="model_id" ref="model_ekids_luong"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_luong"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('-1')
        </field>
    </record>

    <record id="ekids_giaovien.action_chuyen_trangthai_da_rasoat" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Đã rà soát]</field>
        <field name="model_id" ref="model_ekids_luong"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_luong"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('0')
        </field>
    </record>

     <record id="ekids_giaovien.action_chuyen_trangthai_da_nhanluong" model="ir.actions.server">
        <field name="name">Chuyển trạng thái [Giáo viên đã nhận lương]</field>
        <field name="model_id" ref="model_ekids_luong"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_ekids_luong"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = records.action_chuyen_trangthai('1')
        </field>
    </record>



     <record id="ekids_giaovien.luong_search" model="ir.ui.view">
        <field name="name">luong.search</field>
        <field name="model">ekids.luong</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Đang tính" name="trangthai" domain="[('trangthai','=','-1')]"/>
                <filter string="Đã rà soát" name="trangthai" domain="[('trangthai','=','0')]"/>
                <filter string="Đã nhận lương" name="trangthai" domain="[('trangthai','=','1')]"/>
                <field name="giaovien_id"/>
                <field name="nam_id"/>
                <field name="thang_id"/>
                <group expand="1" string="Group By">
                    <filter name="group_by_trangthai"
                        string="Trạng thái tính lương"
                        context="{'group_by':'trangthai'}"/>
                </group>
            </search>
        </field>
     </record>





    <!--kanban lương thang-->

    <record id="ekids_giaovien.luong_list" model="ir.ui.view">
        <field name="name">Lương giáo viên</field>
        <field name="model">ekids.luong</field>
        <field name="arch" type="xml">
            <list create="false" delete="true" limit="200" default_order="giaovien_id asc">
                <header>
                    <button name="action_xacthuc_tinhlai_luong_theo_thang"
                        type="object"
                        string="Tính lại"
                        class="btn-primary"
                            confirm="Bạn chắc chắn muốn tính lại [Lương] ?
  Thao tác này chỉ áp dụng cho trạng thái [Đang tính].Khi tính lại dữ liệu sẽ bị xóa và tính toán lại !"
                         display="always"/>
                    <button name="action_in_ban_xacnhan"
                        type="object"
                        string="In"
                        class="btn-primary"
                        display="always"/>
                </header>
                <field name="sequence" width="25"/>
                <field name="giaovien_id" width="200"/>
                <button name="action_in_luong"
                            type="object"
                            string=""
                            width="15"
                            class="fa fa-print"
                            title="In Lương của Giáo viên tháng này"

                        />
                <field name="dilam_tungay" string="Làm từ ngày"  width="100"  optional="hide"/>
                <field name="dilam_denngay" string="Ngày nghỉ"  width="100" optional="hide"/>
                <field name="trangthai_giaovien" string="Trạng thái làm"  width="100" optional="hide"
                       decoration-success="trangthai_giaovien == '1'"
                        decoration-danger="trangthai_giaovien == '0'"/>

                <field name="tham_nien" width="70" />
                <field name="ngaycong" width="70" string="Công" />
                <field name="so_ngaynghi" width="40" />
                <field name="tong_cong" sum="Total" string="1.Được(+)" widget="integer"/>
                <field name="tong_tru" sum="Total" string="2.Bị(-)" widget="integer"/>
                <field name="nhatruong_thuho" sum="Total" widget="integer" string="3.Giáo viên đóng" width="100"/>
                <field name="tong_thongtin" sum="Total" widget="integer" string="4. Nhà trường đóng" width="100"/>
                <field name="luong" sum="Total" widget="integer" string="5.Lương=1-2" width="100"/>
                <field name="tong_nhatruong_chi" sum="Total" widget="integer" string="6.Tổng chi=4+5" width="100"/>




                <field name="trangthai" width="150"
                       decoration-warning="trangthai == '-1'"
                       decoration-info="trangthai == '0'"
                       decoration-success="trangthai == '1'"

                />
                 <field name="tong_thuong" sum="Total" widget="integer" string="LCB"   optional="hide"/>
                <field name="tong_thongtin_2" sum="Total" widget="integer" string="Thông tin"  optional="hide"/>

            </list>
        </field>
    </record>
        <!--        kanban view-->
    <record id="ekids_giaovien.luong_kanban" model="ir.ui.view">
        <field name="name">luong.kanban.premium.compact</field>
        <field name="model">ekids.luong</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" delete="true" default_order="giaovien_id asc, id desc">

                <field name="id"/>
                <field name="giaovien_id"/>
                <field name="thang_id"/>
                <field name="nam_id"/>
                <field name="luong"/>
                <field name="trangthai"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click d-flex flex-column position-relative"
                             style="border-radius: 14px; padding: 15px; border: 1px solid #e2e8f0; background: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 10px;">



                            <div class="d-flex align-items-center mb-3 pe-4">
                                <div class="rounded-circle d-flex justify-content-center align-items-center me-2 flex-shrink-0"
                                     style="width: 36px; height: 36px; background-color: #eff6ff; border: 1px solid #bfdbfe;">
                                    <i class="fa fa-user text-primary" style="font-size: 16px;"></i>
                                </div>
                                <strong style="font-size: 16px; color: #1e3a8a; font-weight: 800; line-height: 1.2;">
                                    <field name="giaovien_id"/>
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span style="font-size: 13px; font-weight: 700; color: #475569; background-color: #f8fafc; padding: 5px 10px; border-radius: 8px; border: 1px dashed #cbd5e1;">
                                    <i class="fa fa-calendar text-muted me-1"></i> Kỳ <field name="thang_id"/>/<field name="nam_id"/>
                                </span>

                                <div class="mt-1">
                                    <field name="trangthai" widget="badge"
                                           decoration-warning="trangthai == '-1'"
                                           decoration-info="trangthai == '0'"
                                           decoration-success="trangthai == '1'"/>
                                </div>
                            </div>

                            <div class="text-center p-3 mt-auto" style="background: linear-gradient(to right, #f0fdf4, #dcfce7); border-radius: 10px; border: 1px solid #86efac;">
                                <div style="font-size: 11px; color: #166534; font-weight: 800; text-transform: uppercase; margin-bottom: 4px;">
                                    THỰC LĨNH
                                </div>
                                <div style="font-size: 24px; color: #15803d; font-weight: 900; line-height: 1.2;">
                                    <field name="luong" widget="integer"/> <span style="font-size: 14px; font-weight: 700;">VNĐ</span>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ekids_giaovien.luong_form" model="ir.ui.view">
        <field name="name">Thông tin lương giáo viên - Standard Polished UI</field>
        <field name="model">ekids.luong</field>
        <field name="arch" type="xml">
            <form string="Quản lý lương giáo viên">
                <header>
                     <button name="%(ekids_giaovien.action_phieuluong)d" type="action" string="In Phiếu Lương" icon="fa-print" class="btn btn-primary fw-bold px-3 shadow-sm"/>
                     <button name="action_xacthuc_tinhlai_luong_giaovien" type="object" invisible="is_show_tinhtoan_lai==False" string="Tính lại Lương" icon="fa-refresh" confirm="Khi tính lại Lương dữ liệu cũ sẽ bị xóa. Bạn muốn tính lại chứ?" class="btn btn-outline-secondary fw-semibold"/>

                     <field name="trangthai" widget="statusbar" statusbar_visible="-1,0,1"
                            statusbar_colors='{"-1":"blue","0":"green","1":"red"}'
                            options="{'clickable': true}"
                            readonly="is_dl_locked"
                            groups="ekids_core.tinhluong"/>
                </header>

                <sheet>
                    <field name="is_dl_locked" invisible="1"/>
                    <style>
                        /* 1. Header trên cùng */
                        .ekids-header-bar {
                            padding-bottom: 12px;
                            margin-bottom: 14px;
                            border-bottom: 2px solid #e2e8f0;
                        }

                        .ekids-day-badge {
                            background: #f0f9ff;
                            border: 1.5px solid #0284c7;
                            border-radius: 9px;
                            padding: 6px 14px;
                            display: inline-flex;
                            align-items: center;
                            gap: 8px;
                            box-shadow: 0 1px 3px rgba(2, 132, 199, 0.1);
                        }

                        /* 2. Hộp Card 2 cột chính */
                        .ekids-panel {
                            background: #ffffff;
                            border: 1.5px solid #cbd5e1;
                            border-radius: 12px;
                            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
                            height: 100%;
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                        }
                        .ekids-panel-header {
                            background: #f1f5f9;
                            border-bottom: 1.5px solid #cbd5e1;
                            padding: 10px 16px;
                            font-size: 14px;
                            font-weight: 800;
                            color: #1e293b;
                            text-transform: uppercase;
                            letter-spacing: 0.3px;
                        }

                        /* 3. Bảng các dòng số liệu */
                        .ekids-row-item {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            padding: 12px 16px;
                            border-bottom: 1px dashed #e2e8f0;
                            font-size: 15px;
                        }
                        .ekids-row-item:last-child {
                            border-bottom: none;
                        }

                        .ekids-num-badge {
                            width: 24px;
                            height: 24px;
                            background: #e2e8f0;
                            color: #1e293b;
                            font-size: 12px;
                            font-weight: 800;
                            border-radius: 6px;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            margin-right: 10px;
                            flex-shrink: 0;
                        }

                        /* Thanh Banner tổng tiền dùng Table Layout chống tràn tuyệt đối */
                        .ekids-banner-table {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .ekids-banner-table td {
                            padding: 0 !important;
                            vertical-align: middle !important;
                            border: none !important;
                        }

                        .ekids-total-banner-green {
                            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
                            border-radius: 10px;
                            padding: 14px 14px;
                            margin: 12px;
                            color: #ffffff;
                            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
                        }
                        .ekids-total-banner-blue {
                            background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
                            border-radius: 10px;
                            padding: 14px 14px;
                            margin: 12px;
                            color: #ffffff;
                            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
                        }

                        /* 4. Font chữ Notebook bảng dưới */
                        .o_notebook .nav-tabs .nav-link {
                            font-size: 14px !important;
                            font-weight: 800 !important;
                            padding: 10px 18px !important;
                        }
                        .o_notebook .o_list_table {
                            font-size: 15px !important;
                        }
                        .o_notebook .o_list_table th {
                            font-size: 14px !important;
                            font-weight: 800 !important;
                            color: #1e293b !important;
                            background-color: #f8fafc !important;
                            padding: 10px 12px !important;
                        }
                        .o_notebook .o_list_table td {
                            padding: 10px 12px !important;
                            color: #0f172a !important;
                            font-weight: 500 !important;
                        }
                    </style>

                    <!-- ================= HEADER: GIÁO VIÊN + THÁNG + SỐ NGÀY CÔNG ================= -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center ekids-header-bar">
                        <!-- Trái: Tên giáo viên -->
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-user-circle text-primary" style="font-size: 26px;"/>
                            <span class="text-muted fw-bold" style="font-size: 14.5px;">Giáo viên:</span>
                            <field name="giaovien_id" readonly="1" options="{'no_open': True}"
                                   class="fw-bolder text-dark mb-0"
                                   style="font-size: 21px !important; font-weight: 900 !important;"/>
                        </div>

                        <!-- Phải: Tháng lương + Số ngày công -->
                        <div class="d-flex align-items-center flex-wrap" style="gap: 16px;">
                            <div class="fw-bold text-dark" style="font-size: 15px; letter-spacing: 0.3px;">
                                <i class="fa fa-calendar-o me-1 text-primary"/> LƯƠNG THÁNG <field name="thang_id" readonly="1" class="oe_inline text-primary fw-bolder"/>
                            </div>

                            <div class="ekids-day-badge">
                                <i class="fa fa-clock-o" style="font-size: 18px; color: #0284c7;"/>
                                <span style="font-size: 14px; font-weight: 700; color: #0369a1;">Số ngày công đi làm:</span>
                                <span style="font-size: 18px; font-weight: 900; color: #0f172a; line-height: 1;">
                                    <field name="so_ngaycong" readonly="1" class="oe_inline mb-0"/>
                                </span>
                                <span style="font-size: 13.5px; font-weight: 700; color: #475569;">ngày</span>
                            </div>
                        </div>
                    </div>

                    <!-- ================= 2 KHỐI CARD CÂN XỨNG: LƯƠNG GV & NHÀ TRƯỜNG CHI ================= -->
                    <div class="row align-items-stretch mb-3 mx-0">

                        <!-- CỘT TRÁI (COL-6): I. LƯƠNG GIÁO VIÊN -->
                        <div class="col-md-6 ps-0 pe-md-2 mb-3 mb-md-0">
                            <div class="ekids-panel">
                                <div>
                                    <div class="ekids-panel-header d-flex justify-content-between align-items-center">
                                        <span><i class="fa fa-money me-1.5 text-success"/> I. LƯƠNG GIÁO VIÊN</span>
                                        <span class="badge bg-secondary-subtle text-secondary" style="font-size: 11px;">Thực lĩnh</span>
                                    </div>

                                    <!-- 1. Các khoản được cộng -->
                                    <div class="ekids-row-item">
                                        <div class="d-flex align-items-center">
                                            <span class="ekids-num-badge">1</span>
                                            <i class="fa fa-plus-circle text-success me-2"/>
                                            <span class="fw-bold text-dark">Các khoản được cộng [+]</span>
                                        </div>
                                        <div class="d-flex align-items-center" style="gap: 4px;">
                                            <span class="text-muted fw-bold me-1">+</span>
                                            <field name="tong_cong" class="oe_inline fw-bold text-dark"
                                                   style="font-size: 17px !important; display: inline-block !important;" widget="integer" nolabel="1"/>
                                            <span class="ms-1 fw-bold text-muted small">VNĐ</span>
                                        </div>
                                    </div>

                                    <!-- 2. Các khoản bị trừ -->
                                    <div class="ekids-row-item" style="padding-top: 13px; padding-bottom: 13px;">
                                        <div class="d-flex flex-column gap-1">
                                            <!-- Tiêu đề khoản trừ -->
                                            <div class="d-flex align-items-center">
                                                <span class="ekids-num-badge" style="background: #fee2e2; color: #dc2626;">2</span>
                                                <i class="fa fa-minus-circle text-danger me-2"/>
                                                <span class="fw-bold text-danger" style="font-size: 15.5px;">Các khoản bị trừ [-]</span>
                                            </div>

                                            <!-- Dòng text thu hộ -->
                                            <div class="ms-4 ps-2 mt-1">
                                                <span style="font-size: 14px; font-weight: 700; color: #475569;">
                                                    (Nhà trường thu hộ:
                                                    <strong style="font-size: 16px; font-weight: 900; color: #b91c1c;">
                                                        <field name="nhatruong_thuho" readonly="1" class="oe_inline" widget="integer"/>
                                                    </strong>
                                                    <span style="font-size: 13px; font-weight: 800; color: #b91c1c;"> đ</span>)
                                                </span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center" style="gap: 4px;">
                                            <span class="text-danger fw-bold me-1" style="font-size: 18px;">-</span>
                                            <field name="tong_tru" class="oe_inline fw-bold text-danger"
                                                   style="font-size: 18px !important; font-weight: 900 !important; display: inline-block !important;" widget="integer" nolabel="1"/>
                                            <span class="ms-1 fw-bold text-muted small">VNĐ</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- BANNER TỔNG LƯƠNG THỰC LĨNH: DÙNG BẢNG CHỐNG TRÀN VÀ ĐÈ CHỮ -->
                                <div class="ekids-total-banner-green">
                                    <table class="ekids-banner-table">
                                        <tr>
                                            <td class="text-start" style="width: 45%;">
                                                <span class="fw-bold text-uppercase" style="font-size: 13px; letter-spacing: 0.3px;">THỰC LĨNH = [1] - [2]</span>
                                            </td>
                                            <td class="text-end" style="width: 55%; white-space: nowrap;">
                                                <field name="luong" class="oe_inline mb-0"
                                                       style="font-size: 23px !important; font-weight: 900 !important; color: #ffffff !important; line-height: 1 !important; display: inline !important;"
                                                       widget="integer" nolabel="1"/>
                                                <span class="ms-1.5 fw-bold" style="font-size: 13.5px !important; color: #ffffff !important; display: inline !important;">VNĐ</span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- CỘT PHẢI (COL-6): II. THÔNG TIN KHÁC & NHÀ TRƯỜNG THỰC CHI -->
                        <div class="col-md-6 pe-0 ps-md-2">
                            <div class="ekids-panel">
                                <div>
                                    <div class="ekids-panel-header d-flex justify-content-between align-items-center">
                                        <span><i class="fa fa-building-o me-1.5 text-primary"/> II. THÔNG TIN KHÁC &amp; CHI PHÍ</span>
                                        <span class="badge bg-secondary-subtle text-secondary" style="font-size: 11px;">Thực chi</span>
                                    </div>

                                    <!-- 3. Nhà trường chi cho giáo viên -->
                                    <div class="ekids-row-item">
                                        <div class="d-flex align-items-center">
                                            <span class="ekids-num-badge">3</span>
                                            <i class="fa fa-handshake-o text-primary me-2"/>
                                            <span class="fw-bold text-dark">Nhà trường chi cho giáo viên</span>
                                        </div>
                                        <div class="d-flex align-items-center" style="gap: 4px;">
                                            <field name="tong_thongtin" class="oe_inline fw-bold text-dark"
                                                   style="font-size: 17px !important; display: inline-block !important;" widget="integer" nolabel="1"/>
                                            <span class="ms-1 fw-bold text-muted small">VNĐ</span>
                                        </div>
                                    </div>

                                    <!-- 4. Thông tin khác -->
                                    <div class="ekids-row-item">
                                        <div class="d-flex align-items-center">
                                            <span class="ekids-num-badge">4</span>
                                            <i class="fa fa-info-circle text-secondary me-2"/>
                                            <span class="fw-bold text-dark">Thông tin khác</span>
                                        </div>
                                        <div class="d-flex align-items-center" style="gap: 4px;">
                                            <field name="tong_thongtin_2" class="oe_inline fw-bold text-dark"
                                                   style="font-size: 17px !important; display: inline-block !important;" widget="integer" nolabel="1"/>
                                            <span class="ms-1 fw-bold text-muted small">VNĐ</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- BANNER TỔNG NHÀ TRƯỜNG THỰC CHI: DÙNG BẢNG CHỐNG TRÀN VÀ ĐÈ CHỮ -->
                                <div class="ekids-total-banner-blue">
                                    <table class="ekids-banner-table">
                                        <tr>
                                            <td class="text-start" style="width: 45%;">
                                                <span class="fw-bold text-uppercase" style="font-size: 13px; letter-spacing: 0.3px;">THỰC CHI = [I] + [3]</span>
                                            </td>
                                            <td class="text-end" style="width: 55%; white-space: nowrap;">
                                                <field name="tong_nhatruong_chi" class="oe_inline mb-0"
                                                       style="font-size: 23px !important; font-weight: 900 !important; color: #ffffff !important; line-height: 1 !important; display: inline !important;"
                                                       widget="integer" nolabel="1"/>
                                                <span class="ms-1.5 fw-bold" style="font-size: 13.5px !important; color: #ffffff !important; display: inline !important;">VNĐ</span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ================= NOTEBOOK CHI TIẾT BẢNG LƯƠNG ================= -->
                    <notebook>
                        <page name="luong_cong_ids" string="1. ĐƯỢC CỘNG (+)">
                            <field name="luong_cong_ids"
                                   context="{'default_luong_id': id, 'default_loai': '1'}"
                                   domain="[('luong_id', '=', id), ('loai', '=', '1')]"
