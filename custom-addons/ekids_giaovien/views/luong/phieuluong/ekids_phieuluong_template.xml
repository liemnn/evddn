<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_phieuluong">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <t t-call="web.basic_layout">

                    <div class="page" style="font-family: Arial, sans-serif;">
                        <!-- THANH CÔNG CỤ: IN & CHIA SẺ ĐỒNG BỘ GIAO DIỆN VIÊN THUỐC -->
                        <div class="btn-print-container" style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin-bottom: 14px;">
                            <!-- Nút In ấn -->
                            <button type="button"
                                    onclick="window.print()"
                                    class="btn btn-sm d-inline-flex align-items-center gap-1.5"
                                    title="In phiếu lương"
                                    style="font-size: 13px; font-weight: 600; border-radius: 20px; padding: 4px 14px; border: 1px solid #CBD5E1; color: #475569; background: #F8FAFC; cursor: pointer; text-decoration: none;">
                                <i class="fa fa-print text-primary" style="font-size: 13px; margin-right: 5px;"/>
                                <span>In</span>
                            </button>

                            <!-- Nút Chia sẻ link -->
                            <button type="button"
                                    class="btn btn-sm d-inline-flex align-items-center gap-1.5"
                                    t-att-data-url="o.share_url"
                                    onclick="copyShareUrl(this)"
                                    title="Sao chép liên kết chia sẻ phiếu lương"
                                    style="font-size: 13px; font-weight: 600; border-radius: 20px; padding: 4px 14px; border: 1px solid #CBD5E1; color: #475569; background: #F8FAFC; cursor: pointer; text-decoration: none;">
                                <i class="fa fa-link text-primary" style="font-size: 13px; margin-right: 5px;"/>
                                <span class="copy-btn-text">Chia sẻ</span>
                            </button>
                        </div>

                        <span t-field="o.coso_id.header_thu_hocphi" class="box-header"/>

                        <table width="100%" border="0" style="font-size:14px; margin-bottom: 8px;">
                            <tr>
                                <td>Giáo viên: <strong t-field="o.giaovien_id.name"/></td>
                                <td>Đi làm: <strong t-field="o.so_ngaycong"/>/<strong t-field="o.so_ngaycong_quydinh"/> ngày</td>
                                <td>
                                    <h2 style="font-size:16px;font-weight: bold;
                                            text-align:center;margin:0px;padding:0px;text-transform: uppercase;">
                                        THÔNG BÁO LƯƠNG THÁNG <span t-field="o.thang_id.name"/>
                                        /<span t-field="o.thang_id.nam_id.name"/>
                                    </h2>
                                </td>
                            </tr>
                        </table>

                        <table class="box-table" width="100%" border="1" cellspacing="0" cellpadding="0" style="font-size:13px;border-width:1px !important">
                            <tr t-if="o.tong_cong">
                                <td width="5%" style="text-align:center"><b>1</b></td>
                                <td width="50%"><b>KHOẢN ĐƯỢC TÍNH LƯƠNG (+)</b></td>
                                <td width="30%"><b>LÀM RÕ</b></td>
                                <td width="15%">
                                    <div style="font-weight:bold;font-size:13px;text-align:right;vertical-align:top;"
                                         t-field="o.tong_cong"/>
                                </td>
                            </tr>
                            <t t-foreach="o.luong_cong_ids" t-as="luong_cong_id">
                                <tr>
                                    <td style="text-align:center">-</td>
                                    <td style="text-align:left;padding:2px;">
                                        <span t-field="luong_cong_id.name"/>
                                    </td>
                                    <td style="text-align:left;padding:2px;">
                                        <span t-field="luong_cong_id.desc"/>
                                    </td>
                                    <td style="text-align:right;padding:2px;">
                                        <span t-field="luong_cong_id.tien"/>
                                    </td>
                                </tr>
                            </t>

                            <tr>
                                <td style="text-align:center"><b>2</b></td>
                                <td><b>KHOẢN BỊ TRỪ(-)</b></td>
                                <td></td>
                                <td>
                                    <div colspan="2"
                                         style="font-weight:bold;font-size:13px;text-align:right;vertical-align:top;"
                                         t-field="o.tong_tru"/>
                                </td>
                            </tr>
                            <t t-foreach="o.luong_tru_ids" t-as="luong_tru_id">
                                <tr>
                                    <td style="text-align:center">-</td>
                                    <td style="text-align:left;">
                                        <span t-field="luong_tru_id.name"/>
                                    </td>
                                    <td style="text-align:left;">
                                        <span t-field="luong_tru_id.desc"/>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="luong_tru_id.tien"/>
                                    </td>
                                </tr>
                            </t>

                            <tr t-if="o.tong_thongtin">
                                <td style="text-align:center"><b>3</b></td>
                                <td><b>THÔNG TIN </b></td>
                                <td></td>
                                <td>
                                    <div colspan="2"
                                         style="font-weight:bold;font-size:13px;text-align:right;vertical-align:top;"
                                         t-field="o.tong_thongtin"/>
                                </td>
                            </tr>
                            <t t-foreach="o.nhatruong_chitra_ids" t-as="nhatruong_chitra_id">
                                <tr>
                                    <td style="text-align:center">-</td>
                                    <td style="text-align:left;">
                                        <span t-field="nhatruong_chitra_id.name"/>
                                    </td>
                                    <td style="text-align:left;">
                                        <span t-field="nhatruong_chitra_id.desc"/>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="nhatruong_chitra_id.tien"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="o.luong_thongtin_ids" t-as="luong_thongtin_id">
                                <tr>
                                    <td style="text-align:center">-</td>
                                    <td style="text-align:left;">
                                        <span t-field="luong_thongtin_id.name"/>
                                    </td>
                                    <td style="text-align:left;">
                                        <span t-field="luong_thongtin_id.desc"/>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="luong_thongtin_id.tien"/>
                                    </td>
                                </tr>
                            </t>

                            <tr>
                                <td style="text-align:center"></td>
                                <td style="text-align:right;"><b>LƯƠNG GIÁO VIÊN THỰC LĨNH</b></td>
                                <td style="text-align:right;"><b>ĐƯỢC TÍNH =[1]-[2]</b></td>
                                <td>
                                    <div colspan="2"
                                         style="font-weight:bold;font-size:16px;text-align:right;vertical-align:top;"
                                         t-field="o.luong"/>
                                </td>
                            </tr>
                        </table>

                        <style>
                            @media print {
                                .btn-print-container {
                                    display: none !important;
                                }
                                body, .page {
                                    margin-top: 0px !important;
                                    padding-top: 0px !important;
                                }
                            }

                            *:not(i) {
                                font-family: Arial, sans-serif !important;
                            }

                            .box-table td {
                                border-color: inherit;
                                border-style: solid;
                                border: 1px solid #ccc;
                                font-size:13px;
                                padding:5px;
                            }

                            .page {
                                page-break-before: always;
                                page-break-after: always;
                                page-break-inside: avoid;
                                padding:0px;
                                margin:0px;
                            }

                            .box-header {
                                text-align:center !important;
                                border-style: solid;
                                border: 0px solid #ccc;
                                font-size:13px !important;
                            }
                        </style>

                    </div>
                </t>

                <!-- SCRIPT XỬ LÝ COPY LINK ĐỒNG BỘ HIỆU ỨNG VÀ TRẠNG THÁI -->
                <script type="text/javascript">
                    <![CDATA[
                    function copyShareUrl(btnEl) {
                        let url = btnEl.getAttribute('data-url');
                        if (!url) {
                            url = window.location.href;
                        }

                        if (navigator.clipboard && window.isSecureContext) {
                            navigator.clipboard.writeText(url).then(onSuccess).catch(fallbackCopy);
                        } else {
                            fallbackCopy();
                        }

                        function fallbackCopy() {
                            const tempInput = document.createElement("input");
                            tempInput.value = url;
                            document.body.appendChild(tempInput);
                            tempInput.select();
                            document.execCommand("copy");
                            document.body.removeChild(tempInput);
                            onSuccess();
                        }

                        function onSuccess() {
                            const textSpan = btnEl.querySelector('.copy-btn-text');
                            const iconEl = btnEl.querySelector('i');
                            const originalText = textSpan.innerText;

                            textSpan.innerText = "Đã chép!";
                            iconEl.className = "fa fa-check text-success";
                            btnEl.style.borderColor = "#86EFAC";
                            btnEl.style.backgroundColor = "#F0FDF4";

                            setTimeout(function() {
                                textSpan.innerText = originalText;
                                iconEl.className = "fa fa-link text-primary";
                                btnEl.style.borderColor = "#CBD5E1";
                                btnEl.style.backgroundColor = "#F8FAFC";
                            }, 2000);
                        }
                    }
                    ]]>
                </script>

            </t>
        </t>
    </template>
</odoo>