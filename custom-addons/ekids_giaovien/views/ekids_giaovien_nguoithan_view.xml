<odoo>
    <data>

        <record model="ir.ui.view" id="ekids_giaovien.giaovien_nguoithan_list">
            <field name="name">giaovien_nguoithan</field>
            <field name="model">ekids.giaovien_nguoithan</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                   <field name="sequence" widget="handle"/>
                   <field name="name" />
                   <field name="gioitinh" />
                   <field name="ngaysinh" />
                   <field name="tuoi" />
                   <field name="dienthoai" />
                   <field name="quanhe" />
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="ekids_giaovien.giaovien_nguoithan_kanban">
            <field name="name">giaovien_nguoithan.kanban.premium</field>
            <field name="model">ekids.giaovien_nguoithan</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_order="sequence, id">

                    <field name="id"/>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="gioitinh"/>
                    <field name="ngaysinh"/>
                    <field name="tuoi"/>
                    <field name="dienthoai"/>
                    <field name="quanhe"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_dropdown_kanban dropdown" style="position: absolute; right: 10px; top: 10px; z-index: 10;">
                                <a class="dropdown-toggle o-no-caret btn btn-sm text-muted" role="button" data-bs-toggle="dropdown" href="#">
                                    <i class="fa fa-ellipsis-v fa-lg"></i>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item text-primary">
                                        <i class="fa fa-pencil me-2"></i> Chỉnh sửa
                                    </a>
                                    <a role="menuitem" type="delete"
                                       confirm="Xóa bản ghi này sẽ làm mất dữ liệu. Bạn có chắc chắn không?"
                                       class="dropdown-item text-danger">
                                        <i class="fa fa-trash-o me-2"></i> Xóa
                                    </a>
                                </div>
                            </div>
                            <div class="oe_kanban_global_click d-flex align-items-center position-relative"
                                 style="border-radius: 14px; padding: 15px; border: 1px solid #e2e8f0; background: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 8px; transition: transform 0.2s ease;">



                                <div class="me-3 d-flex justify-content-center align-items-center flex-shrink-0"
                                     style="width: 52px; height: 52px; background-color: #f8fafc; border-radius: 50%; border: 2px solid #e2e8f0;">
                                    <i class="fa fa-users text-primary" style="font-size: 22px;"></i>
                                </div>

                                <div class="flex-grow-1 overflow-hidden pe-3">

                                    <div class="d-flex flex-wrap align-items-center mb-1 gap-2">
                                        <strong class="text-truncate" style="font-size: 16px; color: #1e293b; font-weight: 800; max-width: 100%;">
                                            <field name="name"/>
                                        </strong>
                                        <span style="background-color: #eff6ff; color: #3b82f6; border: 1px solid #bfdbfe; padding: 3px 8px; font-weight: 700; border-radius: 6px; font-size: 11px; white-space: nowrap;">
                                            <field name="quanhe"/>
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-center mt-1 mb-1" style="font-size: 14px; font-weight: 700; color: #475569;">
                                        <div style="width: 20px;"><i class="fa fa-phone" style="color: #10b981;"></i></div>
                                        <t t-if="record.dienthoai.raw_value">
                                            <field name="dienthoai"/>
                                        </t>
                                        <t t-else="">
                                            <em style="opacity: 0.5; font-weight: 500;">(Chưa cập nhật SĐT)</em>
                                        </t>
                                    </div>

                                    <div class="d-flex align-items-center text-muted" style="font-size: 12px; font-weight: 600;">
                                        <div style="width: 20px;"><i class="fa fa-birthday-cake text-warning"></i></div>
                                        <div class="text-truncate">
                                            <t t-if="record.ngaysinh.raw_value">
                                                <field name="ngaysinh"/>
                                            </t>
                                            <t t-else="">
                                                <span style="opacity: 0.5;">--/--/----</span>
                                            </t>
                                            <span class="mx-1">•</span>
                                            <span style="color: #64748b;"><field name="tuoi"/> tuổi</span>
                                            <span class="mx-1">•</span>
                                            <span style="color: #64748b;"><field name="gioitinh"/></span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record id="ekids_giaovien.giaovien_nguoithan_form" model="ir.ui.view">
            <field name="name">giaovien_nguoithan.form.premium</field>
            <field name="model">ekids.giaovien_nguoithan</field>
            <field name="arch" type="xml">
                <form string="Thông tin Người thân Giáo viên">
                    <sheet class="p-4" style="border: none !important; background-color: #f8fafc;">

                        <style>
                            /* Ô nhập liệu bo góc hiện đại */
                            .modern-input {
                                border: 1.5px solid #e2e8f0 !important;
                                border-radius: 8px !important;
                                padding: 8px 12px !important;
                                font-weight: 600 !important;
                                background-color: #ffffff !important;
                                width: 100%;
                                color: #1e293b !important;
                                transition: all 0.2s;
                            }
                            .modern-input:focus-within {
                                border-color: #3b82f6 !important;
                                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15) !important;
                            }

                            /* Tiêu đề mục nhỏ gọn, tinh tế */
                            .section-title {
                                font-size: 11px;
                                font-weight: 700;
                                color: #64748b;
                                margin-bottom: 6px;
                                text-transform: uppercase;
                                letter-spacing: 0.5px;
                                display: flex;
                                align-items: center;
                                gap: 6px;
                            }

                            /* Khối header chứa tên phối màu Gradient nhẹ */
                            .profile-header-box {
                                background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
                                border: 1px solid #e2e8f0;
                                border-radius: 14px;
                                padding: 20px;
                                margin-bottom: 20px;
                                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
                            }
                        </style>

                        <field name="sequence" invisible="1"/>
                        <field name="giaovien_id" invisible="1"/>

                        <div class="profile-header-box">
                            <div class="row align-items-center">
                                <div class="col-lg-8 col-md-7 mb-3 mb-md-0">
                                    <div class="section-title">Họ và tên Người thân</div>
                                    <field name="name" class="modern-input"
                                           style="font-size: 22px !important; font-weight: 800 !important; color: #1e3a8a !important;"
                                           placeholder="VD: Nguyễn Văn A..."/>
                                </div>
                                <div class="col-lg-4 col-md-5">
                                    <div class="section-title">Mối quan hệ với giáo viên</div>
                                    <field name="quanhe" class="modern-input" style="padding: 10px 12px !important;"/>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-7 col-12 mb-3 mb-md-0">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-sm">
                                    <div class="section-title">
                                        <i class="fa fa-id-card text-primary"></i> Thông tin cá nhân
                                    </div>
                                    <div class="row">
                                        <div class="col-12 mb-3">
                                            <div class="section-title" style="font-size: 10px; color: #94a3b8;">Giới tính</div>
                                            <field name="gioitinh" class="modern-input" style="padding: 7px 12px !important;"/>
                                        </div>
                                        <div class="col-sm-6 col-12 mb-3 mb-sm-0">
                                            <div class="section-title" style="font-size: 10px; color: #94a3b8;">Ngày sinh</div>
                                            <field name="ngaysinh" class="modern-input"/>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div class="col-md-5 col-12">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-sm">
                                    <div class="section-title">
                                        <i class="fa fa-phone text-success"></i> Liên hệ khẩn cấp
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="section-title" style="font-size: 10px; color: #94a3b8;">Số điện thoại di động</div>
                                            <field name="dienthoai" class="modern-input" placeholder="Nhập số điện thoại liên lạc..."/>
                                            <div class="mt-3 text-muted d-flex align-items-start" style="font-size: 12px; font-weight: 500; line-height: 1.4;">
                                                <i class="fa fa-info-circle text-info me-2 mt-1"/>
                                                <span>Thông tin này dùng để liên lạc trực tiếp với người nhà của giáo viên trong các trường hợp cần thiết hoặc khẩn cấp tại cơ sở.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </sheet>
                </form>
            </field>
        </record>



</data>
</odoo>
