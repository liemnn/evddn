<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="baocao_canthiep_template">
        <t t-call="web.basic_layout">
            <t t-set="report_data" t-value="data or {}"/>
            <div class="page" style="font-family: 'Times New Roman', Times, serif; font-size: 13.5px; line-height: 1.45; padding: 20px; color: #000000; max-width: 1020px; margin: 0 auto;">

                <!-- TIÊU ĐỀ BÁO CÁO -->
                <div style="text-align: center; margin-bottom: 22px;">
                    <h3 style="font-size: 18px; font-weight: bold; text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">
                        KẾT QUẢ SỬ DỤNG PHẦN MỀM KẾ HOẠCH CÁ NHÂN
                    </h3>
                </div>

                <!-- BẢNG BÁO CÁO -->
                <table style="width: 100%; border-collapse: collapse; border: 1.5px solid #000000; text-align: center;">
                    <thead>
                        <tr style="font-weight: bold; text-transform: uppercase; font-size: 12.5px; background-color: #F8FAFC;">
                            <th style="border: 1px solid #000000; padding: 8px 3px; width: 4%;">STT</th>
                            <th style="border: 1px solid #000000; padding: 8px 6px; width: 20%;">TÊN CƠ SỞ</th>
                            <th style="border: 1px solid #000000; padding: 8px 4px; width: 10%;">
                                SỐ LƯỢNG<br/>HỌC SINH
                            </th>
                            <th style="border: 1px solid #000000; padding: 8px 4px; width: 16%;">
                                HS ĐÃ NHẬP KẾT LUẬN<br/>&amp; CHỈ ĐỊNH
                            </th>
                            <th style="border: 1px solid #000000; padding: 8px 4px; width: 12%;">
                                HS ĐÃ CÓ<br/>KẾ HOẠCH
                            </th>
                            <!-- 3 CỘT MỚI: THÁNG NÀY (ĐÃ DUYỆT) - THÁNG TỚI (ĐÃ DUYỆT) - ĐỢI DUYỆT -->
                            <th style="border: 1px solid #000000; padding: 8px 4px; width: 11%; background-color: #EFF6FF;">
                                KH <span t-out="report_data.get('label_thangnay', 'Tháng này')"/><br/>
                                <span style="font-size: 11px; font-weight: normal; color: #1D4ED8;">(Đã duyệt)</span>
                            </th>
                            <th style="border: 1px solid #000000; padding: 8px 4px; width: 11%;">
                                KH <span t-out="report_data.get('label_thangtoi', 'Tháng tới')"/><br/>
                                <span style="font-size: 11px; font-weight: normal; color: #15803D;">(Đã duyệt)</span>
                            </th>
                            <th style="border: 1px solid #000000; padding: 8px 4px; width: 10%; background-color: #FFFBEB;">
                                ĐANG ĐỢI<br/>DUYỆT
                            </th>
                            <th style="border: 1px solid #000000; padding: 8px 4px; width: 6%;">GHI CHÚ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="report_data.get('rows', [])" t-as="row">
                            <tr style="font-size: 13.5px;">
                                <td style="border: 1px solid #000000; padding: 8px 3px; text-align: center;">
                                    <span t-out="row.get('stt')"/>
                                </td>
                                <td style="border: 1px solid #000000; padding: 8px 8px; text-align: left; font-weight: 500;">
                                    <span t-out="row.get('ten_coso')"/>
                                </td>
                                <td style="border: 1px solid #000000; padding: 8px 4px; text-align: center;">
                                    <span t-out="row.get('so_hocsinh')"/>
                                </td>
                                <td style="border: 1px solid #000000; padding: 8px 4px; text-align: center;">
                                    <span t-out="row.get('so_hs_ketluan')"/>
                                </td>
                                <td style="border: 1px solid #000000; padding: 8px 4px; text-align: center;">
                                    <span t-out="row.get('so_hs_kehoach')"/>
                                </td>
                                <!-- GIÁ TRỊ 3 CỘT -->
                                <td style="border: 1px solid #000000; padding: 8px 4px; text-align: center; font-weight: 600; background-color: #F8FAFC;">
                                    <span t-out="row.get('kh_thangnay', 0)"/>
                                </td>
                                <td style="border: 1px solid #000000; padding: 8px 4px; text-align: center;">
                                    <span t-out="row.get('kh_thangtoi', 0)"/>
                                </td>
                                <td style="border: 1px solid #000000; padding: 8px 4px; text-align: center; color: #B45309; font-weight: 500;">
                                    <span t-out="row.get('kh_choxuly', 0)"/>
                                </td>
                                <td style="border: 1px solid #000000; padding: 8px 4px; text-align: left;">
                                    <span t-out="row.get('ghichu')"/>
                                </td>
                            </tr>
                        </t>

                        <!-- DÒNG TỔNG CỘNG -->
                        <tr style="font-weight: bold; background-color: #F1F5F9; font-size: 13.5px;">
                            <td colspan="2" style="border: 1px solid #000000; padding: 9px; text-align: center; text-transform: uppercase;">
                                Tổng cộng
                            </td>
                            <td style="border: 1px solid #000000; padding: 9px; text-align: center;">
                                <span t-out="report_data.get('tong_so_hs', 0)"/>
                            </td>
                            <td style="border: 1px solid #000000; padding: 9px; text-align: center;">
                                <span t-out="report_data.get('tong_hs_kl', 0)"/>
                            </td>
                            <td style="border: 1px solid #000000; padding: 9px; text-align: center;">
                                <span t-out="report_data.get('tong_hs_kh', 0)"/>
                            </td>
                            <td style="border: 1px solid #000000; padding: 9px; text-align: center; background-color: #E2E8F0;">
                                <span t-out="report_data.get('tong_kh_nay', 0)"/>
                            </td>
                            <td style="border: 1px solid #000000; padding: 9px; text-align: center;">
                                <span t-out="report_data.get('tong_kh_toi', 0)"/>
                            </td>
                            <td style="border: 1px solid #000000; padding: 9px; text-align: center; color: #B45309;">
                                <span t-out="report_data.get('tong_kh_cho', 0)"/>
                            </td>
                            <td style="border: 1px solid #000000; padding: 9px;"></td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </t>
    </template>
</odoo>