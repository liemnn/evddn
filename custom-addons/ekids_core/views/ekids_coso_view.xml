<odoo>
    <data>



       <record id="ekids_core.coso_search_view" model="ir.ui.view">
          <field name="name">ekids.search.coso</field>
          <field name="model">ekids.coso</field>
          <field name="arch" type="xml">
            <search string="Tìm kiếm Cơ sở">
              <!-- Bộ lọc mặc định -->
              <filter string="Đang thuê" name="trangthai" domain="[('trangthai','=','1')]"/>
              <group expand="1" string="Group By">
                <filter name="group_by_tinh"
                    string="Tỉnh thành"
                    context="{'group_by':'dm_tinh_id'}"/>
                <filter name="group_by_xa"
                    string="Xã"
                    context="{'group_by':'dm_xa_id'}"/>
                <filter name="group_by_trangthai"
                    string="Trạng thái"
                    context="{'group_by':'trangthai'}"/>
              </group>

              <!-- Cho phép search theo các field -->
              <field name="name"/>
              <field name="fullname"/>
              <field name="masothue"/>
              <field name="dm_tinh_id" string="Tình thành"/>
              <field name="dienthoai" string="Số điện thoại"/>
            </search>
          </field>
        </record>

        <record id="ekids_core.coso_kanban_view" model="ir.ui.view">
            <field name="name">Cơ sở</field>
            <field name="model">ekids.coso</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <kanban  default_group_by="trangthai">

                    <t t-name="kanban-box">
                        <div class="box-user">
                            <!-- Vùng ảnh -->
                            <div class="student-avatar">
                                <field name="logo" widget="image"/>
                            </div>

                            <!-- Vùng thông tin -->
                            <div class="info">
                                <h2>
                                    <field name="name"/>
                                </h2>
                                <div class="item-list" >
                                     <div class="item">
                                      <div class="item-text">Thuê từ ngày</div>
                                      <div class="item-info">
                                         <field name="thue_tungay"/>
                                      </div>
                                    </div>
                                    <div class="item">
                                      <div class="item-text">Đến ngày</div>
                                      <div class="item-info">
                                         <field name="thue_denngay"/>
                                      </div>
                                    </div>
                                     <div class="item">
                                      <div class="item-text">Tỉnh</div>
                                      <div class="item-info">
                                         <field name="dm_tinh_id"/>
                                      </div>
                                    </div>
                                </div>


                            </div>
                        </div>


                    </t>
                </kanban>
            </field>
        </record>



        <record model="ir.ui.view" id="ekids_core.coso_list_view">
            <field name="name">Quản lý Cơ sở</field>
            <field name="model">ekids.coso</field>
            <field name="arch" type="xml">
                <list>

                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="masothue"/>
                    <field name="dm_tinh_id"/>
                    <field name="dm_xa_id"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="ekids_core.coso_form_view">
            <field name="name">Form Cơ sở</field>
            <field name="model">ekids.coso</field>
            <field name="arch" type="xml">
                <form string="Cơ sở">
                    <sheet>
                        <field name="is_admin" invisible="1"/>

                        <style>
                            .ekids_custom_card { background: #ffffff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: 20px; height: 100%; border: 1px solid #f1f5f9; }
                            .ekids_card_title { color: #1e3a8a; font-size: 13px; font-weight: 800; text-transform: uppercase; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; }
                            .ekids_card_title i { color: #6366f1; margin-right: 8px; font-size: 16px; }
                            .ekids_toggle_row { border: 1px dashed #cbd5e1; background-color: #f8fafc; border-radius: 8px; padding: 10px 15px; }
                            .info-box { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 15px; border-radius: 6px; }
                        </style>

                        <div class="row mb-4 align-items-center">
                            <div class="col-auto">
                                <field name="logo" widget="image" class="oe_avatar shadow-sm bg-white border"/>
                            </div>
                            <div class="col">
                                <div class="oe_title">
                                    <div class="d-flex align-items-center mb-1">
                                        <field name="ma" placeholder="Mã CS" readonly="not is_admin" class="fw-bold text-danger me-2" style="max-width: 100px; font-size: 1.2rem;"/>
                                        <h1 class="m-0 p-0">
                                            <field name="name" placeholder="Tên cơ sở (Ngắn gọn)" readonly="not is_admin" class="text-primary"/>
                                        </h1>
                                    </div>
                                    <field name="fullname" placeholder="Tên đầy đủ của cơ sở / công ty..." class="fw-bold text-muted fs-6 mb-1 d-block"/>
                                    <field name="slogan" placeholder="Slogan / Thông điệp..." class="text-info font-italic d-block"/>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="ekids_custom_card">
                                    <div class="ekids_card_title">
                                        <i class="fa fa-map-marker"/> Thông tin Liên hệ &amp; Địa chỉ
                                    </div>
                                    <group>
                                        <field name="masothue" string="Mã số thuế"/>
                                        <field name="email" string="Email" widget="email"/>
                                        <field name="dienthoai" string="Điện thoại" widget="phone"/>
                                    </group>
                                    <hr class="text-muted opacity-25"/>
                                    <group>
                                        <field name="dm_tinh_id" string="Tỉnh / Thành phố" readonly="not is_admin" options="{'no_create': True}"/>
                                        <field name="dm_xa_id" string="Phường / Xã" options="{'no_create': True}"/>
                                        <field name="diachi_chitiet" string="Số nhà / Đường" placeholder="VD: Số 123 Đường ABC..."/>
                                    </group>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="ekids_custom_card">
                                    <div class="ekids_card_title">
                                        <i class="fa fa-server"/> Quản lý Dịch vụ &amp; Hệ thống
                                    </div>
                                    <group>
                                        <field name="thue_tungay" string="Ngày bắt đầu thuê" readonly="not is_admin"/>
                                        <field name="thue_denngay" string="Ngày hết hạn" readonly="not is_admin"/>
                                        <field name="trangthai" string="Trạng thái HĐ" readonly="1" widget="badge" decoration-success="trangthai == '1'"/>
                                    </group>
                                    <hr class="text-muted opacity-25"/>
                                    <group>
                                        <field name="user_id" string="Người quản lý (Admin)" readonly="not is_admin" widget="many2one_avatar_user"/>
                                        <field name="desc" string="Ghi chú thêm" placeholder="Mô tả nội bộ..."/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <notebook class="mt-2">

                            <page name="coso_ids" string="THỜI GIAN HOẠT ĐỘNG">
                                <div class="p-3">
                                    <div class="fw-bold mb-3 text-muted"><i class="fa fa-calendar-check-o me-2"/> TICK CHỌN CÁC NGÀY CƠ SỞ CÓ HOẠT ĐỘNG (LÀM VIỆC)</div>
                                    <div class="ekids_toggle_row d-flex justify-content-between align-items-center" style="max-width: 600px;">
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold text-dark mb-1">T2</span>
                                            <field name="hd_t2" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold text-dark mb-1">T3</span>
                                            <field name="hd_t3" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold text-dark mb-1">T4</span>
                                            <field name="hd_t4" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold text-dark mb-1">T5</span>
                                            <field name="hd_t5" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold text-dark mb-1">T6</span>
                                            <field name="hd_t6" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold text-dark mb-1">T7</span>
                                            <field name="hd_t7" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold text-danger mb-1">CN</span>
                                            <field name="hd_t8" widget="boolean_toggle" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </page>

                            <page name="config_lock" string="CẤU HÌNH KHÓA DỮ LIỆU">
                                <div class="row p-3">
                                    <div class="col-md-6">
                                        <div class="fw-bold mb-3 text-muted"><i class="fa fa-lock me-2"/> THỜI GIAN KHÓA SỔ (THÁNG)</div>
                                        <group>
                                            <field name="sothang_khoa_dl_chitieu" string="Khóa sổ Chi tiêu sau (tháng)"/>
                                            <field name="sothang_khoa_dl_diemdanh" string="Khóa sổ Điểm danh sau (tháng)"/>


                                        </group>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="fw-bold mb-3 text-muted"><i class="fa fa-money me-2"/> CÁC TRẠNG THÁI CHO PHÉP SỬA LƯƠNG</div>
                                        <group>
                                            <field name="trangthai_luong_khoa_dl" placeholder="Ví dụ ='-1,0,...'"/>
                                        </group>

                                        <div class="info-box mt-3 small">
                                            <strong class="text-dark d-block mb-2">Bảng tra cứu Mã trạng thái Học phí:</strong>
                                            <div class="row">
                                                <div class="col-6">
                                                    <div><b class="text-danger">-1</b> : Đang tính</div>
                                                    <div><b class="text-primary">0</b> : Đã kiểm tra</div>
                                                    <div><b class="text-warning">1</b> : Đã nhận lương</div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="fw-bold mb-3 text-muted"><i class="fa fa-money me-2"/> CÁC TRẠNG THÁI CHO PHÉP SỬA HỌC PHÍ</div>
                                        <group>
                                            <field name="trangthai_hocphi_khoa_dl" placeholder="Ví dụ ='-1,0,...'"/>
                                        </group>

                                        <div class="info-box mt-3 small">
                                            <strong class="text-dark d-block mb-2">Bảng tra cứu Mã trạng thái [Lương]:</strong>
                                            <div class="row">
                                                {
                                                  "-1": {
                                                    "name": "Đang tính",
                                                    "edit": true,
                                                    "trangthai_tieptheo": ["0", "2"]
                                                  },
                                                  "0": {
                                                    "name": "Đã kiểm tra",
                                                    "edit": true,
                                                    "trangthai_tieptheo": ["-1", "01", "10", "11", "12"]
                                                  },
                                                  "01": {
                                                    "name": "Phụ huynh đã đóng",
                                                    "edit": false,
                                                    "trangthai_tieptheo": ["10", "11", "12", "3"]
                                                  },
                                                  "10": {
                                                    "name": "Đã đóng [Tiền mặt]",
                                                    "edit": false,
                                                    "trangthai_tieptheo": ["3"]
                                                  },
                                                  "11": {
                                                    "name": "Đã đóng [Chuyển khoản]",
                                                    "edit": false,
                                                    "trangthai_tieptheo": ["3"]
                                                  },
                                                  "12": {
                                                    "name": "Đã đóng [Ví HS]",
                                                    "edit": false,
                                                    "trangthai_tieptheo": ["3"]
                                                  },
                                                  "3": {
                                                    "name": "Đã xuất [Hóa đơn]",
                                                    "edit": false,
                                                    "trangthai_tieptheo": []
                                                  },
                                                  "2": {
                                                    "name": "Nợ học phí",
                                                    "edit": true,
                                                    "trangthai_tieptheo": ["01", "10", "11", "12"]
                                                  }
                                                }
                                                <div class="col-6">
                                                    <div><b class="text-danger">-1</b> : Đang tính</div>
                                                    <div><b class="text-primary">0</b> : Đã kiểm tra</div>
                                                    <div><b class="text-warning">01</b> : Phụ huynh đã đóng</div>
                                                    <div><b class="text-success">10</b> : Đã đóng [Tiền mặt]</div>
                                                </div>
                                                <div class="col-6">
                                                    <div><b class="text-success">11</b> : Đã đóng [Chuyển khoản]</div>
                                                    <div><b class="text-success">12</b> : Đã đóng [Ví HS]</div>
                                                    <div><b class="text-info">3</b> : Đã xuất [Hóa đơn]</div>
                                                    <div><b class="text-danger">2</b> : Nợ học phí</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                </div>

                            </page>

                            <page name="branches" string="CƠ SỞ THÀNH VIÊN">
                                <div class="p-3">
                                    <field name="coso_ids" widget="many2many_tags" string="Các cơ sở thành viên" placeholder="Thêm cơ sở trực thuộc..."/>
                                </div>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>




        <!-- actions opening views on models -->

        <record  id="ekids_core.coso_action_window" model="ir.actions.act_window">
            <field name="name">Quản lý Cơ sở</field>
            <field name="res_model">ekids.coso</field>
            <field name="view_mode">kanban,list,form</field>
             <field name="context">{'search_default_trangthai': '1',}</field>
        </record>


        <!-- Kanban View -->
        <record id="ekids_core.coso_kanban_action_window_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="ekids_core.coso_kanban_view"/>
            <field name="act_window_id" ref="ekids_core.coso_action_window"/>
        </record>






    </data>
</odoo>
