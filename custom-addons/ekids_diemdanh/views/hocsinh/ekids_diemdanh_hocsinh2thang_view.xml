<odoo>
    <data>
         <record id="ekids_diemdanh.diemdanh_hocsinh2thang_search" model="ir.ui.view">
            <field name="name">diemdanh_hocsinh2thang.search</field>
            <field name="model">ekids.diemdanh_hocsinh2thang</field>
            <field name="arch" type="xml">
                <search>
                    <field name="hocsinh_id"/>
                </search>
            </field>
        </record>

         <record id="ekids_diemdanh.diemdanh_hocsinh2thang_list" model="ir.ui.view">
            <field name="name">Diem Danh</field>
            <field name="model">ekids.diemdanh_hocsinh2thang</field>
            <field name="arch" type="xml">
                <list  create="false" delete="true" limit="200" default_order="hocsinh_id asc">
                    <field name="is_dl_locked" column_invisible="True"/>
                    <header>
                        <button name="action_xoa_taolai_diemdanh"
                            type="object"
                            string="Xóa làm lại"
                            class="btn-primary"
                            display="always"
                            confirm="Nếu bạn xác nhận toàn bộ dữ liệu điểm danh sẽ xóa toàn bộ và xác nhận lại"
                        />
                    </header>

                    <field name="sequence" width="25" />
                    <field name="hocsinh_id" width="170"  readonly="true"/>

                    <button name="action_open_popup_thongtin_diemdanh_hocsinh"
                            type="object"
                            string=""
                            width="15"
                            class="fa fa-pencil-square-o"
                            title="Xem chi tiết thông tin [Điểm danh/Học bù/Bỏ sung] của học sinh!"

                        />
                    <field name="hocbu_conlai" string="Bù" width="30"/>
                    <field name="d1" widget="widget_diemdanh_hocsinh" invisible="is_d1_nghi" width="30" />
                    <field name="d2" widget="widget_diemdanh_hocsinh" invisible="is_d2_nghi" width="30" />
                    <field name="d3" widget="widget_diemdanh_hocsinh" invisible="is_d3_nghi" width="30" />
                    <field name="d4" widget="widget_diemdanh_hocsinh" invisible="is_d4_nghi" width="30" />
                    <field name="d5" widget="widget_diemdanh_hocsinh" invisible="is_d5_nghi" width="30" />
                    <field name="d6" widget="widget_diemdanh_hocsinh" invisible="is_d6_nghi" width="30" />
                    <field name="d7" widget="widget_diemdanh_hocsinh" invisible="is_d7_nghi" width="30" />
                    <field name="d8" widget="widget_diemdanh_hocsinh" invisible="is_d8_nghi" width="30" />
                    <field name="d9" widget="widget_diemdanh_hocsinh" invisible="is_d9_nghi" width="30" />

                    <field name="d10" widget="widget_diemdanh_hocsinh" invisible="is_d10_nghi" width="30" />

                    <field name="d11" widget="widget_diemdanh_hocsinh" invisible="is_d11_nghi" width="30" />
                    <field name="d12" widget="widget_diemdanh_hocsinh" invisible="is_d12_nghi" width="30" />
                    <field name="d13" widget="widget_diemdanh_hocsinh" invisible="is_d13_nghi" width="30" />
                    <field name="d14" widget="widget_diemdanh_hocsinh" invisible="is_d14_nghi" width="30" />
                    <field name="d15" widget="widget_diemdanh_hocsinh" invisible="is_d15_nghi" width="30" />
                    <field name="d16" widget="widget_diemdanh_hocsinh" invisible="is_d16_nghi" width="30" />
                    <field name="d17" widget="widget_diemdanh_hocsinh" invisible="is_d17_nghi" width="30" />
                    <field name="d18" widget="widget_diemdanh_hocsinh" invisible="is_d18_nghi" width="30" />
                    <field name="d19" widget="widget_diemdanh_hocsinh" invisible="is_d19_nghi" width="30" />
                    <field name="d20" widget="widget_diemdanh_hocsinh" invisible="is_d20_nghi" width="30" />

                    <field name="d21" widget="widget_diemdanh_hocsinh" invisible="is_d21_nghi" width="30" />
                    <field name="d22" widget="widget_diemdanh_hocsinh" invisible="is_d22_nghi" width="30" />
                    <field name="d23" widget="widget_diemdanh_hocsinh" invisible="is_d23_nghi" width="30" />
                    <field name="d24" widget="widget_diemdanh_hocsinh" invisible="is_d24_nghi" width="30" />
                    <field name="d25" widget="widget_diemdanh_hocsinh" invisible="is_d25_nghi" width="30" />
                    <field name="d26" widget="widget_diemdanh_hocsinh" invisible="is_d26_nghi" width="30" />
                    <field name="d27" widget="widget_diemdanh_hocsinh" invisible="is_d27_nghi" width="30" />
                    <field name="d28" widget="widget_diemdanh_hocsinh" invisible="is_d28_nghi" width="30" />
                    <field name="d29" widget="widget_diemdanh_hocsinh" invisible="is_d29_nghi" width="30" />
                    <field name="d30" widget="widget_diemdanh_hocsinh" invisible="is_d30_nghi" width="30" />
                    <field name="d31" widget="widget_diemdanh_hocsinh" invisible="is_d31_nghi" width="30" />


                </list>
            </field>
        </record>

        <record id="ekids_diemdanh.diemdanh_hocsinh2thang_form" model="ir.ui.view">
            <field name="name">Form Điểm Danh  Học Bù Nâng Cấp</field>
            <field name="model">ekids.diemdanh_hocsinh2thang</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Điểm danh và Học bù tháng">
                    <sheet>
                        <!-- 1. Header Tên Học Sinh Gọn Gàng -->
                        <div class="card border-0 shadow-sm px-3 py-2 mb-3 bg-white rounded" style="border-left: 4px solid #6c5ce7 !important;">
                            <div class="d-flex align-items-center justify-content-between">
                                <h3 class="mb-0 font-weight-bold text-dark" style="font-size: 20px;">
                                    <i class="fa fa-user-circle text-purple mr-2"/>
                                    <field name="hocsinh_id" readonly="1" options="{'no_open': True}"/>
                                </h3>
                                <span class="badge badge-pill badge-light text-muted border px-2 py-1" style="font-size: 11px;">
                                    <i class="fa fa-calendar-alt mr-1"/> Quản lý tháng
                                </span>
                            </div>
                        </div>

                        <!-- 2. Khu vực thống kê 2 cột có Icon sinh động và Font số to rõ -->
                        <div class="row">
                            <!-- Cột 1: Thông tin điểm danh -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card border-0 shadow-sm p-3 bg-white rounded h-100" style="border-left: 3px solid #0984e3 !important;">
                                    <div class="font-weight-bold text-primary mb-3" style="font-size: 12px; letter-spacing: 0.5px;">
                                        <i class="fa fa-calendar-check-o mr-1"/> THÔNG TIN ĐIỂM DANH
                                    </div>
                                    <div class="o_stat_container">
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-flag text-info mr-2" style="width: 16px; text-align: center;"/> Quy định</span>
                                            <field name="tong_dihoc_kehoach" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-check-circle text-success mr-2" style="width: 16px; text-align: center;"/> Thực tế</span>
                                            <field name="tong_dihoc_diemdanh" readonly="1" class="font-weight-bold text-success" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-moon-o text-secondary mr-2" style="width: 16px; text-align: center;"/> Nghỉ cả ngày</span>
                                            <field name="tong_nghi_cangay" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-clock-o text-warning mr-2" style="width: 16px; text-align: center;"/> Nghỉ nửa buổi</span>
                                            <field name="tong_dihoc_nuabuoi" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between pt-1">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-envelope-o text-primary mr-2" style="width: 16px; text-align: center;"/> Xin nghỉ phép</span>
                                            <field name="tong_nghiphep" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cột 2: Học bù & Tăng cường -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card border-0 shadow-sm p-3 bg-white rounded h-100" style="border-left: 3px solid #e17055 !important;">
                                    <div class="font-weight-bold mb-3" style="font-size: 12px; letter-spacing: 0.5px; color: #d35400 !important;">
                                        <i class="fa fa-refresh mr-1"/> HỌC BÙ &amp; TĂNG CƯỜNG
                                    </div>
                                    <div class="o_stat_container">
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-history text-secondary mr-2" style="width: 16px; text-align: center;"/> Tồn tháng trước</span>
                                            <field name="hocbu_thangtruoc" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-plus-circle text-info mr-2" style="width: 16px; text-align: center;"/> Phát sinh mới</span>
                                            <field name="hocbu_thangnay" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-check-square-o text-success mr-2" style="width: 16px; text-align: center;"/> Đã dạy bù</span>
                                            <field name="hocbu_da_day" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-weight: 600; font-size: 13px;"><i class="fa fa-exclamation-circle text-danger mr-2" style="width: 16px; text-align: center;"/> Còn lại</span>
                                            <field name="hocbu_conlai" readonly="1" class="font-weight-bold text-danger" style="font-size: 18px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between pt-1">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-bolt text-warning mr-2" style="width: 16px; text-align: center;"/> Tăng cường</span>
                                            <field name="tangcuong_da_day" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Notebook Chi Tiết Phía Dưới (Giữ nguyên tuyệt đối dữ liệu gốc) -->
                        <div class="card border-0 shadow-sm mt-2 bg-white rounded p-2">
                            <notebook>
                                <page name="hocbu_thangnay_ids" string="Ca nghỉ đợi học bù (-)">
                                    <field name="hocbu_thangnay_ids" context="{'default_coso_id': coso_id}"/>
                                </page>
                                <page name="hocbu_da_day_ids" string="Ca đã học bù (+)">
                                    <field name="hocbu_da_day_ids" context="{'default_coso_id': coso_id}"/>
                                </page>
                                <page name="tangcuong_ids" string="Ca tăng cường (+)">
                                    <field name="tangcuong_ids" context="{'default_coso_id': coso_id}"/>
                                </page>
                            </notebook>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>