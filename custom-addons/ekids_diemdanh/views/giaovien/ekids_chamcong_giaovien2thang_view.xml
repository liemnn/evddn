<odoo>
    <data>
         <record id="ekids_diemdanh.chamcong_giaovien2thang_search" model="ir.ui.view">
            <field name="name">chamcong_giaovien2thang.search</field>
            <field name="model">ekids.chamcong_giaovien2thang</field>
            <field name="arch" type="xml">
                <search>
                    <field name="giaovien_id"/>
                </search>
            </field>
         </record>

         <record id="ekids_diemdanh.chamcong_giaovien2thang_list" model="ir.ui.view">
            <field name="name">Diem Danh</field>
            <field name="model">ekids.chamcong_giaovien2thang</field>
            <field name="arch" type="xml">
                <list  create="false" delete="true" limit="200" default_order="giaovien_id asc">
                    <header>
                        <button name="action_xoa_taolai_congviec2thang"
                            type="object"
                            string="Xóa làm lại"
                            class="btn-primary"
                            display="always"
                             confirm="Bạn chắc chắn muốn xóa đi toàn bộ làm lại ?"
                        />
                    </header>
                    <field name="sequence" width="25" />
                    <field name="giaovien_id" width="150"  readonly="true"/>
                    <button name="action_xem_thongtin_dilam" width="30"
                            type="object"
                            string=""
                            class="fa fa-pencil-square-o"
                            title="Thông tin chấm công/nghỉ của Giáo viên"

                        />
                    <field name="tong_dilam_chamcong"   width="45" string="Tổng"/>
                    <field name="d1" widget="widget_giaovien_chamcong" invisible="is_d1_nghi" width="30" />
                    <field name="d2" widget="widget_giaovien_chamcong" invisible="is_d2_nghi" width="30" />
                    <field name="d3" widget="widget_giaovien_chamcong" invisible="is_d3_nghi" width="30" />
                    <field name="d4" widget="widget_giaovien_chamcong" invisible="is_d4_nghi" width="30" />
                    <field name="d5" widget="widget_giaovien_chamcong" invisible="is_d5_nghi" width="30" />
                    <field name="d6" widget="widget_giaovien_chamcong" invisible="is_d6_nghi" width="30" />
                    <field name="d7" widget="widget_giaovien_chamcong" invisible="is_d7_nghi" width="30" />
                    <field name="d8" widget="widget_giaovien_chamcong" invisible="is_d8_nghi" width="30" />
                    <field name="d9" widget="widget_giaovien_chamcong" invisible="is_d9_nghi" width="30" />

                    <field name="d10" widget="widget_giaovien_chamcong" invisible="is_d10_nghi" width="30" />

                    <field name="d11" widget="widget_giaovien_chamcong" invisible="is_d11_nghi" width="30" />
                    <field name="d12" widget="widget_giaovien_chamcong" invisible="is_d12_nghi" width="30" />
                    <field name="d13" widget="widget_giaovien_chamcong" invisible="is_d13_nghi" width="30" />
                    <field name="d14" widget="widget_giaovien_chamcong" invisible="is_d14_nghi" width="30" />
                    <field name="d15" widget="widget_giaovien_chamcong" invisible="is_d15_nghi" width="30" />
                    <field name="d16" widget="widget_giaovien_chamcong" invisible="is_d16_nghi" width="30" />
                    <field name="d17" widget="widget_giaovien_chamcong" invisible="is_d17_nghi" width="30" />
                    <field name="d18" widget="widget_giaovien_chamcong" invisible="is_d18_nghi" width="30" />
                    <field name="d19" widget="widget_giaovien_chamcong" invisible="is_d19_nghi" width="30" />
                    <field name="d20" widget="widget_giaovien_chamcong" invisible="is_d20_nghi" width="30" />

                    <field name="d21" widget="widget_giaovien_chamcong" invisible="is_d21_nghi" width="30" />
                    <field name="d22" widget="widget_giaovien_chamcong" invisible="is_d22_nghi" width="30" />
                    <field name="d23" widget="widget_giaovien_chamcong" invisible="is_d23_nghi" width="30" />
                    <field name="d24" widget="widget_giaovien_chamcong" invisible="is_d24_nghi" width="30" />
                    <field name="d25" widget="widget_giaovien_chamcong" invisible="is_d25_nghi" width="30" />
                    <field name="d26" widget="widget_giaovien_chamcong" invisible="is_d26_nghi" width="30" />
                    <field name="d27" widget="widget_giaovien_chamcong" invisible="is_d27_nghi" width="30" />
                    <field name="d28" widget="widget_giaovien_chamcong" invisible="is_d28_nghi" width="30" />
                    <field name="d29" widget="widget_giaovien_chamcong" invisible="is_d29_nghi" width="30" />
                    <field name="d30" widget="widget_giaovien_chamcong" invisible="is_d30_nghi" width="30" />
                    <field name="d31" widget="widget_giaovien_chamcong" invisible="is_d31_nghi" width="30" />

                </list>
            </field>
        </record>
        <record id="ekids_diemdanh.chamcong_giaovien2thang_form" model="ir.ui.view">
            <field name="name">Form Chấm Công Giáo Viên Nâng Cấp</field>
            <field name="model">ekids.chamcong_giaovien2thang</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Chấm công giáo viên tháng">
                    <sheet>
                        <!-- 1. Header Tên Giáo Viên Gọn Gàng -->
                        <div class="card border-0 shadow-sm px-3 py-2 mb-3 bg-white rounded" style="border-left: 4px solid #0984e3 !important;">
                            <div class="d-flex align-items-center justify-content-between">
                                <h3 class="mb-0 font-weight-bold text-dark" style="font-size: 20px;">
                                    <i class="fa fa-user-tie text-primary mr-2"/>
                                    <field name="giaovien_id" readonly="1" options="{'no_open': True}"/>
                                </h3>
                                <span class="badge badge-pill badge-light text-muted border px-2 py-1" style="font-size: 11px;">
                                    <i class="fa fa-calendar-alt mr-1"/> Chấm công tháng
                                </span>
                            </div>
                        </div>

                        <!-- 2. Khu vực thống kê 2 cột có Icon sinh động và Font số to rõ -->
                        <div class="row">
                            <!-- Cột 1: Thông tin chấm công trong tháng -->
                            <div class="col-12 col-lg-7 mb-2">
                                <div class="card border-0 shadow-sm p-3 bg-white rounded h-100" style="border-left: 3px solid #0984e3 !important;">
                                    <div class="font-weight-bold text-primary mb-3" style="font-size: 12px; letter-spacing: 0.5px;">
                                        <i class="fa fa-clock-o mr-1"/> THÔNG TIN CHẤM CÔNG TRONG THÁNG
                                    </div>
                                    <div class="o_stat_container">
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-flag text-info mr-2" style="width: 16px; text-align: center;"/> Quy định đi làm</span>
                                            <field name="tong_dilam_kehoach" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-check-circle text-success mr-2" style="width: 16px; text-align: center;"/> Thực tế đi làm</span>
                                            <field name="tong_dilam_chamcong" readonly="1" class="font-weight-bold text-success" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-exclamation-triangle text-warning mr-2" style="width: 16px; text-align: center;"/> Số ngày đi muộn</span>
                                            <field name="tong_dilam_muon" readonly="1" class="font-weight-bold text-warning" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-moon-o text-secondary mr-2" style="width: 16px; text-align: center;"/> Nghỉ làm cả ngày</span>
                                            <field name="tong_nghi_cangay" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-hourglass-half text-info mr-2" style="width: 16px; text-align: center;"/> Đi làm nửa buổi</span>
                                            <field name="tong_dilam_nuabuoi" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between pt-1">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-envelope-o text-primary mr-2" style="width: 16px; text-align: center;"/> Ngày phép xin nghỉ</span>
                                            <field name="tong_nghiphep" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cột 2: Ngày phép giáo viên -->
                            <div class="col-12 col-lg-5 mb-2">
                                <div class="card border-0 shadow-sm p-3 bg-white rounded h-100" style="border-left: 3px solid #00b894 !important;">
                                    <div class="font-weight-bold mb-3" style="font-size: 12px; letter-spacing: 0.5px; color: #00b894 !important;">
                                        <i class="fa fa-calendar-check-o mr-1"/> NGÀY PHÉP GIÁO VIÊN
                                    </div>
                                    <div class="o_stat_container">
                                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-ticket text-info mr-2" style="width: 16px; text-align: center;"/> Được phép</span>
                                            <field name="phep_duocphep" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                            <span class="text-muted" style="font-size: 13px;"><i class="fa fa-check-square-o text-success mr-2" style="width: 16px; text-align: center;"/> Đã sử dụng</span>
                                            <field name="phep_da_sudung" readonly="1" class="font-weight-bold text-dark" style="font-size: 16px;"/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between pt-2">
                                            <span class="text-muted font-weight-bold" style="font-size: 13px;"><i class="fa fa-star text-warning mr-2" style="width: 16px; text-align: center;"/> Còn trong năm</span>
                                            <field name="phep_con_trongnam" readonly="1" class="font-weight-bold text-success" style="font-size: 18px;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
