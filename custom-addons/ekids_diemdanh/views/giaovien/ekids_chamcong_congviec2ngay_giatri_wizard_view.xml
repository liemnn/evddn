<odoo>
    <data>
     <record model="ir.ui.view" id="ekids_diemdanh.chamcong_congviec2ngay_giatri_wizard_form">
        <field name="name">chamcong_congviec2ngay_giatri_wizard Form</field>
        <field name="model">ekids.chamcong_congviec2ngay_giatri_wizard</field>
        <field name="arch" type="xml">
            <form string="Điểm danh ngày">
                <!-- Mở rộng khung modal một chút để vừa vặn với vùng nhập liệu lớn hơn -->
                <style>
                    .modal-dialog {
                        max-width: 460px !important;
                    }
                </style>

                <sheet class="p-3 m-0">
                    <field name="congviec2thang_giatri_id" invisible="1"/>

                    <!-- Thanh ngày tháng nhỏ gọn, tối giản -->
                    <div class="d-flex align-items-center justify-content-between px-2 pb-2 mb-3 border-bottom">
                        <span class="text-muted fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">
                            <i class="fa fa-calendar text-primary me-1"/> NGÀY CHẤM CÔNG
                        </span>
                        <div class="fw-bold text-dark px-3 py-1 bg-light border rounded" style="font-size: 14px;">
                            <field name="ngay" readonly="1" class="d-inline"/>
                        </div>
                    </div>

                    <!-- Khung card được mở rộng và làm nổi bật hơn -->
                    <div class="card border rounded-4 p-4 bg-white shadow-sm mx-auto" style="max-width: 420px;">
                        <div class="text-center text-muted fw-bold mb-3" style="font-size: 12px; letter-spacing: 1px;">
                            GIÁ TRỊ KHỐI LƯỢNG THỰC TẾ
                        </div>

                        <!-- Ô nhập số được phóng to, chữ to rõ ràng, dễ bấm -->
                        <div class="mb-3">
                            <field name="giatri" class="form-control form-control-lg fw-bold text-dark text-center py-3 border rounded-3" style="font-size: 28px !important; letter-spacing: 1px;"/>
                        </div>

                        <!-- Ghi chú hướng dẫn -->
                        <div class="p-2.5 text-muted fst-italic bg-light rounded-3 text-center" style="font-size: 12px; line-height: 1.4;">
                            <i class="fa fa-info-circle text-warning me-1"/> Nhập giá trị phù hợp với định mức quy định sử dụng dấu "." làm phân cách
                        </div>
                    </div>
                </sheet>

                <footer style="padding: 10px 15px !important;">
                    <button name="action_capnhat_ketqua_congviec2ngay_giatri"
                            type="object" string="Cập nhật kết quả"
                            class="btn btn-primary fw-bold px-4 py-2"/>
                    <button string="Hủy" special="cancel" class="btn btn-secondary px-3 py-2"/>
                </footer>
            </form>
        </field>
    </record>


    </data>
</odoo>
