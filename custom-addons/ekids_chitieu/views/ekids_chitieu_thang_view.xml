<odoo>
    <data>

         <record model="ir.ui.view" id="ekids_chitieu.chitieu_thang_list">
            <field name="name">Chi</field>
            <field name="model">ekids.chitieu_thang</field>
            <field name="arch" type="xml">
                 <list editable="bottom" limit="300"  default_order="sequence asc">
                    <field name="sequence" string="STT" width="5"/>
                    <field name="sequence" widget="handle" width="20"/>
                    <field name="nam_id" width="70"/>
                    <field name="name" width="150"/>

                    <field name="tong_chi"/>

                    <field name="tong_chi_tm" string="Chi tiền mặt"/>
                    <field name="tong_chi_ck" string="Chi chuyển khoản"/>
                    <field name="tong_thu"/>

                 </list>
            </field>
        </record>


        <!-- explicit list view definition -->
        <record id="ekids_chitieu.chitieu_thang_kanban" model="ir.ui.view">
            <field name="name">Thang</field>
            <field name="model">ekids.chitieu_thang</field>
            <field name="arch" type="xml">
                <kanban >

                    <t t-name="kanban-box">
                       <div class="box">
                            <h2 class="title">
                                <field name="name"/>
                            </h2>

                            <div class="item-list">
                               <div class="item">
                                  <div class="item-text">Tổng thu khác</div>
                                  <div class="item-info">
                                      <field name="tong_thu" widget="integer"/>
                                  </div>
                                </div>
                                <div class="item">
                                  <div class="item-text">Tổng chi</div>
                                  <div class="item-info">
                                      <field name="tong_chi" widget="integer"/>
                                  </div>
                                </div>
                            </div>
                        </div>
                    </t>

                </kanban>
            </field>
        </record>



        <record id="ekids_chitieu.chitieu_thang_form" model="ir.ui.view">
            <field name="name">Form Chi Tiêu Tháng - Premium UI</field>
            <field name="model">ekids.chitieu_thang</field>
            <field name="arch" type="xml">
                <form edit="is_dl_locked == False" delete="is_dl_locked == False">
                    <sheet>
                        <style>
                            /* Dashboard Cards bên phải */
                            .kh-dashboard { display: flex; gap: 15px; margin-bottom: 25px; justify-content: flex-end; }
                            .kh-card { background: #fff; padding: 15px 25px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 15px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
                            .kh-card-icon { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; }
                            .kh-card-text { font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; }
                            .kh-card-val { font-size: 18px; font-weight: 900; color: #1e293b; }
                        </style>

                        <field name="coso_id" invisible="1"/>
                        <field name="is_dl_locked" invisible="1"/>

                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div class="oe_title">
                                <label for="name" string="Kỳ chi tiêu"/>
                                <h1><field name="name" readonly="id" class="text-primary"/></h1>
                            </div>

                            <div class="kh-dashboard">
                                <div class="kh-card">
                                    <div class="kh-card-icon" style="background: #dcfce7; color: #166534;"><i class="fa fa-money"/></div>
                                    <div>
                                        <div class="kh-card-text">Tiền mặt</div>
                                        <div class="kh-card-val"><field name="tong_chi_tm" readonly="id"/> vnđ</div>
                                    </div>
                                </div>
                                <div class="kh-card">
                                    <div class="kh-card-icon" style="background: #dbeafe; color: #1e40af;"><i class="fa fa-university"/></div>
                                    <div>
                                        <div class="kh-card-text">Chuyển khoản</div>
                                        <div class="kh-card-val"><field name="tong_chi_ck" readonly="id"/> vnđ</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <notebook>
                            <page name="chi_ids" string="CÁC KHOẢN [CHI]">
                                <field name="chi_ids" context="{'default_coso_id': coso_id}" readonly="is_dl_locked">

                                    <list editable="bottom" limit="300"  default_order="ngaychi asc">
                                        <field name="sequence" widget="handle"/>
                                        <field name="ngaychi" width="150"/>
                                        <field name="tien" sum="Total" width="150" widget="integer" class="fw-bold text-success"/>
                                        <field name="dm_loaichi_id" width="150"
                                               domain="[('trangthai','=','1'),('loai','=','0')]"
                                               context="{'default_coso_id':context.get('default_coso_id')}"/>
                                        <field name="desc"/>
                                        <field name="loai"  decoration-success="loai == '1'" decoration-danger="loai == '0'" width="100"/>
                                        <field name="create_uid" string="Người tạo"/>
                                        <field name="create_date" string="Ngày tạo"/>
                                     </list>

                                    <kanban>
                                        <field name="ngaychi"/>
                                        <field name="dm_loaichi_id"/>
                                        <field name="tien"/>
                                        <field name="loai"  decoration-success="loai == '1'" decoration-danger="loai == '0'" width="100"/>


                                        <templates>
                                            <t t-name="kanban-box">
                                                <div class="oe_kanban_global_click d-flex justify-content-between align-items-center p-3 border-bottom shadow-sm mb-2 rounded bg-white">
                                                    <div>
                                                        <strong class="o_kanban_record_title text-dark mb-1 d-block" style="font-size: 1rem;">
                                                            <field name="dm_loaichi_id"/>
                                                        </strong>
                                                        <div class="text-muted small">
                                                            <i class="fa fa-calendar me-1"/> <field name="ngaychi"/>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <strong class="text-danger" style="font-size: 1.1rem;">
                                                            <field name="tien"/>
                                                        </strong>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>

                            <page name="thu_ids" string="CÁC KHOẢN [THU KHÁC] NGOÀI HỌC PHÍ">
                                <field name="thu_ids" context="{'default_coso_id': coso_id}" readonly="is_dl_locked">

                                    <list editable="bottom" limit="300" default_order="ngaychi asc">
                                        <field name="ngaychi" width="150"/>
                                        <field name="tien" sum="Total" width="150" widget="integer" class="fw-bold text-success"/>
                                        <field name="dm_loaichi_id" width="150"
                                               domain="[('trangthai','=','1'),('loai','=','1')]"
                                               context="{'default_coso_id':context.get('default_coso_id')}"/>
                                        <field name="desc"/>
                                        <field name="loai"  decoration-success="loai == '1'" decoration-danger="loai == '0'" width="100"/>
                                        <field name="create_uid" string="Người tạo"/>
                                        <field name="create_date" string="Ngày tạo"/>
                                     </list>

                                    <kanban>
                                        <field name="ngaychi"/>
                                        <field name="dm_loaichi_id"/>
                                        <field name="tien"/>
                                        <field name="loai"  decoration-success="loai == '1'" decoration-danger="loai == '0'" width="100"/>

                                        <templates>
                                            <t t-name="kanban-box">
                                                <div class="oe_kanban_global_click d-flex justify-content-between align-items-center p-3 border-bottom shadow-sm mb-2 rounded bg-white">
                                                    <div>
                                                        <strong class="o_kanban_record_title text-dark mb-1 d-block" style="font-size: 1rem;">
                                                            <field name="dm_loaichi_id"/>
                                                        </strong>
                                                        <div class="text-muted small">
                                                            <i class="fa fa-calendar me-1"/> <field name="ngaychi"/>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <strong class="text-success" style="font-size: 1.1rem;">
                                                            <field name="tien"/>
                                                        </strong>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>


                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
